/**
 * 首页模块配置（与 demo pages/index/home-config.ts 对齐，quickstart 仅包含通话、聊天）
 */
export type ModuleItem = {
  id: string;
  title: string;
  icon: string;
  description: string;
  route: string;
  /** 目标页是否为 tabBar 页面（需要用 switchTab 跳转） */
  isTabbar: boolean;
}

export const HOME_MODULES: ModuleItem[] = [
  {
    id: 'call',
    title: '通话',
    icon: '/static/images/index/call-icon.png',
    description: '呼铃通知·通话悬浮窗·通话卡顿优化',
    route: '/pages/scenes/call/index',
    isTabbar: false
  } as ModuleItem,
  {
    id: 'chat',
    title: '聊天',
    icon: '/static/images/index/chat-icon.png',
    description: '群组聊天·好友通讯录·语音消息·资料多端同步',
    route: '/pages/scenes/chat/conversationList/conversationList',
    isTabbar: true
  } as ModuleItem
]
