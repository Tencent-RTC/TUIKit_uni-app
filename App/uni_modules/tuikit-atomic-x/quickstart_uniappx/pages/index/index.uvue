<template>
  <view class="page">
    <view class="navbar" :style="{ paddingTop: statusBarHeight + 'px' }">
      <view class="navbar-content">
        <view class="navbar-left">
          <image class="logo-image" src="/static/images/logo.png" mode="aspectFit"></image>
        </view>
        <image class="avatar" :src="avatarURL" mode="aspectFill" @tap="handleAvatarTap"></image>
      </view>
    </view>

    <scroll-view class="main-content" direction="vertical" :show-scrollbar="false">
      <view v-for="(row, rowIndex) in moduleRows" :key="rowIndex" class="module-row">
        <view
          v-for="(module, index) in row"
          :key="module.id"
          :class="['module-card', index == row.length - 1 ? 'module-card-last' : '']"
          @tap="navigateToModule(module)"
        >
          <view class="card-header">
            <view class="card-header-left">
              <image class="card-icon" :src="module.icon" mode="aspectFit"></image>
              <text class="card-title">{{ module.title }}</text>
              <view class="ui-badge">
                <text class="badge-text">UI组件</text>
              </view>
            </view>
            <text class="arrow-icon">›</text>
          </view>
          <view class="card-info">
            <text class="card-description">{{ module.description }}</text>
          </view>
        </view>
        <!-- 奇数个模块时补位，保持两列等宽 -->
        <view v-if="row.length == 1" class="module-card-placeholder"></view>
      </view>
      <view class="footer-placeholder"></view>
    </scroll-view>
  </view>
</template>

<script setup lang="uts">
import { ref, computed } from 'vue'
import { onLoad } from '@dcloudio/uni-app'
import { useLoginState, type UserProfileParam } from '@/uni_modules/tuikit-atomic-x/state/LoginState'
import { HOME_MODULES, type ModuleItem } from './home-config.uts'

const DEFAULT_AVATAR: string = 'https://web.sdk.qcloud.com/component/TUIKit/assets/avatar_21.png'

const statusBarHeight = ref<number>(0)
const { loginUserInfo, logout } = useLoginState()

const avatarURL = computed((): string => {
  const info: UserProfileParam | null = loginUserInfo.value
  const url: string = info?.avatarURL ?? ''
  return url.length > 0 ? url : DEFAULT_AVATAR
})

/** 两个一行排列 */
const moduleRows = computed((): ModuleItem[][] => {
  const rows: ModuleItem[][] = []
  for (let i: number = 0; i < HOME_MODULES.length; i += 2) {
    rows.push(HOME_MODULES.slice(i, i + 2))
  }
  return rows
})

/** 跳转逻辑与 demo 一致：无路由提示开发中；tabBar 页用 switchTab，其余 navigateTo */
const navigateToModule = (module: ModuleItem): void => {
  if (module.route.length == 0) {
    uni.showToast({ title: '功能开发中', icon: 'none' })
    return
  }
  if (module.isTabbar) {
    uni.switchTab({ url: module.route })
    return
  }
  uni.navigateTo({ url: module.route })
}

/**
 * 点击头像：demo 中跳转"个人中心"，quickstart 不包含该页面，这里直接提供退出登录
 */
const handleAvatarTap = (): void => {
  uni.showModal({
    title: '提示',
    content: '确定退出登录？',
    success: (res): void => {
      if (res.confirm) {
        logout({
          success: (): void => { uni.reLaunch({ url: '/pages/login/login' }) },
          fail: (_: number, msg: string): void => { uni.showToast({ title: msg, icon: 'none' }) }
        })
      }
    }
  })
}

onLoad((_options: OnLoadOptions): void => {
  statusBarHeight.value = uni.getSystemInfoSync().statusBarHeight
})
</script>

<style>
.page {
  flex: 1;
  background-color: #f5f5f5;
}

.navbar {
  background-color: #ffffff;
  border-bottom-width: 1rpx;
  border-bottom-color: #e5e5e5;
  border-bottom-style: solid;
}

.navbar-content {
  height: 129rpx;
  padding: 20rpx 36rpx;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}

.navbar-left {
  flex-direction: row;
  align-items: center;
}

.logo-image {
  width: 260rpx;
  height: 60rpx;
}

.avatar {
  width: 60rpx;
  height: 60rpx;
  border-radius: 30rpx;
}

.main-content {
  flex: 1;
  padding-top: 24rpx;
}

.footer-placeholder {
  height: 46rpx;
}

.module-row {
  flex-direction: row;
  padding: 0 36rpx;
  margin-bottom: 28rpx;
}

.module-card {
  flex: 1;
  background-color: #ffffff;
  border-radius: 18rpx;
  margin-right: 28rpx;
  flex-direction: column;
}

.module-card-last {
  margin-right: 0;
}

.module-card-placeholder {
  flex: 1;
}

.card-header {
  padding: 28rpx 24rpx 0;
  border-radius: 18rpx;
  background-image: linear-gradient(to bottom, #CCDFFF, #ffffff);
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}

.card-header-left {
  flex-direction: row;
  align-items: center;
}

.card-icon {
  width: 48rpx;
  height: 48rpx;
}

.card-title {
  font-size: 32rpx;
  line-height: 36rpx;
  font-weight: 700;
  color: #000000;
  margin: 0 12rpx;
}

.ui-badge {
  background-color: #73A1F0;
  border-radius: 4rpx;
  padding: 0 8rpx;
}

.badge-text {
  font-size: 24rpx;
  line-height: 36rpx;
  color: #ffffff;
}

.card-info {
  padding: 24rpx;
  height: 120rpx;
}

.card-description {
  font-size: 24rpx;
  color: #6C7077;
  line-height: 36rpx;
}

.arrow-icon {
  font-size: 46rpx;
  color: #d8d8d8;
}
</style>
