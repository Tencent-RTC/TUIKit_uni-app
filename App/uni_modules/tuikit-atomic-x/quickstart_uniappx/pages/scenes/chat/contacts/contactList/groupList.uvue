<template>
	<view class="page">
		<CustomNavbar title="我的群聊" :showBack="true" @back="handleBack" />
		<view class="page-content">
			<GroupList
				@groupSelect="handleGroupClick"
			/>
		</view>
	</view>
</template>

<script setup lang="uts">

import CustomNavbar from '@/uni_modules/tuikit-atomic-x/components/CustomNavbar/CustomNavbar.uvue'
import { GroupList } from '@/uni_modules/tuikit-atomic-x/components/Contact'

const handleBack = (): void => {
	uni.navigateBack({ delta: 1 })
}

const handleGroupClick = (group: any): void => {
	console.log(`点击群聊: ${group}`)
	const gObj: UTSJSONObject = group as UTSJSONObject
	const gid: string = (gObj['groupID'] as string) ?? ''
	uni.navigateTo({
		url: `/pages/scenes/chat/chat/index?conversationID=group_${gid}`
	})
}
</script>

<style>
.page {
	flex: 1;
	background-color: #f5f5f5;
}

.page-content {
	flex: 1;
}
</style>