<template>
	<view class="add-group-page">
		<CustomNavbar title="添加群聊" :showBack="true" @back="handleBack" />

		<!-- 页面内容 -->
		<view class="page-content">
			<AddGroup
				@groupSelect="handleGroupSelect"
			/>
		</view>
	</view>
</template>

<script setup lang="uts">

import AddGroup from '@/uni_modules/tuikit-atomic-x/components/Contact/AddGroup.uvue'
import CustomNavbar from '@/uni_modules/tuikit-atomic-x/components/CustomNavbar/CustomNavbar.uvue'
import { GroupMemberRole } from '@/uni_modules/tuikit-atomic-x/types/group'
import { setPageData, VERIFY_DATA } from '@/pages/utils/pageDataStore'

/**
 * 处理返回按钮点击
 */
const handleBack = (): void => {
	uni.navigateBack({
		delta: 1
	})
}

const handleGroupSelect = (group: any): void => {
	const gObj: UTSJSONObject = group as UTSJSONObject
	const selfRoleRaw: any | null = gObj['selfRole']
	if (selfRoleRaw == 0) {
		setPageData(VERIFY_DATA, {
			type: 'group',
			groupInfo: gObj
		})
		uni.navigateTo({
			url: '/pages/scenes/chat/contacts/applicationVerify/index?type=group'
		})
	} else {
		uni.showToast({
			title: '已加入该群组'
		})
	}
}
</script>

<style>
.add-group-page {
	flex: 1;
	background-color: #f5f5f5;
}

.page-content {
	flex: 1;
}
</style>
