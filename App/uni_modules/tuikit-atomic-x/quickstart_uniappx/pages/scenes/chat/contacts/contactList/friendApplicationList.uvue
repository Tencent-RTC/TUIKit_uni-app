<template>
	<view class="page">
		<CustomNavbar title="新的联系人" :showBack="true" @back="handleBack" />
		<view class="page-content">
			<FriendApplicationList
				@itemClick="handleItemClick"
				@accept="handleAccept"
				@reject="handleReject"
			/>
		</view>
	</view>
</template>

<script setup lang="uts">

import CustomNavbar from '@/uni_modules/tuikit-atomic-x/components/CustomNavbar/CustomNavbar.uvue'
import { FriendApplicationList } from '@/uni_modules/tuikit-atomic-x/components/Contact'
import { setPageData, INFO_DATA } from '@/pages/utils/pageDataStore'

const handleBack = (): void => {
	uni.navigateBack({ delta: 1 })
}

const handleItemClick = (item: any): void => {
	console.log(`点击好友申请: ${item}`)
	setPageData(INFO_DATA, { applicationInfo: item })
	uni.navigateTo({
		url: '/pages/scenes/chat/contacts/contactInfo/index?type=newContact'
	})
}

const handleAccept = (item: any): void => {
	const itemObj: UTSJSONObject = item as UTSJSONObject
	const uid: string = (itemObj['userID'] as string) ?? ''
	console.log(`已同意好友申请: ${uid}`)
}

const handleReject = (item: any): void => {
	const itemObj: UTSJSONObject = item as UTSJSONObject
	const uid: string = (itemObj['userID'] as string) ?? ''
	console.log(`已拒绝好友申请: ${uid}`)
}
</script>

<style>
.page {
	flex: 1;
	background-color: #f5f5f5;
}

.page-content {
	flex: 1;
}
</style>
