<template>
  <scroll-view class="container" :scroll-y="true" :show-scrollbar="false">
    <view class="guide-box">
      <view v-for="(item, index) in entryInfos" :key="index" class="single-box" @tap="handleEntry(item)">
        <image class="icon" mode="aspectFit" :src="item.icon"></image>
        <view class="single-content">
          <text class="label">{{ item.title }}</text>
          <text class="desc">{{ item.desc }}</text>
        </view>
      </view>
    </view>
  </scroll-view>
</template>

<script setup lang="uts">
type CallEntry = {
  icon: string;
  title: string;
  desc: string;
  navigateTo: string;
}

const AUDIO_CARD: string = 'https://web.sdk.qcloud.com/component/miniApp/resources/audio-card.png'
const VIDEO_CARD: string = 'https://web.sdk.qcloud.com/component/miniApp/resources/video-card.png'

/** 入口与 demo pages/scenes/call/index.vue 一致：type=0 语音，type=1 视频 */
const entryInfos: CallEntry[] = [
  { icon: AUDIO_CARD, title: '语音通话', desc: '丢包率70%仍可正常语音通话', navigateTo: '/pages/scenes/call/singleCall?type=0' } as CallEntry,
  { icon: VIDEO_CARD, title: '视频通话', desc: '丢包率50%仍可正常视频通话', navigateTo: '/pages/scenes/call/singleCall?type=1' } as CallEntry,
  { icon: AUDIO_CARD, title: '多人语音通话', desc: '丢包率70%仍可正常语音通话', navigateTo: '/pages/scenes/call/groupCall?type=0' } as CallEntry,
  { icon: VIDEO_CARD, title: '多人视频通话', desc: '丢包率50%仍可正常视频通话', navigateTo: '/pages/scenes/call/groupCall?type=1' } as CallEntry
]

const handleEntry = (item: CallEntry): void => {
  uni.navigateTo({ url: item.navigateTo })
}
</script>

<style>
.container {
  flex: 1;
  height: 100%;
  background-color: #f4f5f9;
}

.guide-box {
  padding: 16px;
}

.single-box {
  flex-direction: row;
  align-items: center;
  border-radius: 10px;
  background-color: #ffffff;
  margin-bottom: 16px;
}

.icon {
  width: 180px;
  height: 144px;
}

.single-content {
  flex: 1;
  padding: 36px 20px 36px 20px;
}

.label {
  font-size: 18px;
  color: #333333;
  font-weight: 700;
}

.desc {
  font-size: 14px;
  color: #333333;
  margin-top: 4px;
}
</style>
