<template>
  <view class="call-page">
    <view class="call-header">
      <view class="call-back" @tap="handleBack">
        <text class="call-back-text">×</text>
      </view>
      <text class="call-title">{{ layoutTemplate === 'Grid' ? '多人通话' : '通话中' }}</text>
    </view>

    <view class="call-body">
      <view class="call-icon">
        <text class="call-icon-text">{{ layoutTemplate === 'Grid' ? '⊞' : '☎' }}</text>
      </view>
      <text class="call-hint">音视频通话组件占位页</text>
      <text class="call-sub">layoutTemplate: {{ layoutTemplate }}</text>
      <text class="call-sub">SDK TUICallKit 未集成，当前仅占位</text>
    </view>

    <view class="call-footer">
      <view class="call-hangup" @tap="handleHangup">
        <text class="call-hangup-text">挂断</text>
      </view>
    </view>
  </view>
</template>

<script setup lang="uts">
import { ref } from 'vue'
import { onLoad, onBackPress } from '@dcloudio/uni-app'

const layoutTemplate = ref<string>('Float')

onLoad((options: OnLoadOptions): void => {
  const opt: UTSJSONObject = options as UTSJSONObject
  const tpl: any | null = opt['layoutTemplate']
  if (typeof tpl === 'string') {
    layoutTemplate.value = tpl
  }
})

onBackPress((): boolean => {
  handleHangup()
  return true
})

const handleBack = (): void => {
  handleHangup()
}

const handleHangup = (): void => {
  const pages: any = getCurrentPages() as any
  if (pages.length > 1) {
    uni.navigateBack({
      delta: 1
    })
  } else {
    uni.reLaunch({
      url: '/pages/scenes/chat/conversationList/conversationList'
    })
  }
}
</script>

<style>
.call-page {
  flex: 1;
  height: 100vh;
  background-color: #1c1c1e;
  display: flex;
  flex-direction: column;
}

.call-header {
  height: 88rpx;
  padding: 0 24rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
}

.call-back {
  width: 56rpx;
  height: 56rpx;
  border-radius: 28rpx;
  background-color: rgba(255, 255, 255, 0.1);
  justify-content: center;
  align-items: center;
}

.call-back-text {
  font-size: 36rpx;
  color: #ffffff;
  line-height: 56rpx;
}

.call-title {
  flex: 1;
  text-align: center;
  color: #ffffff;
  font-size: 32rpx;
  margin-right: 56rpx;
}

.call-body {
  flex: 1;
  justify-content: center;
  align-items: center;
}

.call-icon {
  width: 200rpx;
  height: 200rpx;
  border-radius: 100rpx;
  background-color: rgba(255, 255, 255, 0.08);
  justify-content: center;
  align-items: center;
  margin-bottom: 40rpx;
}

.call-icon-text {
  font-size: 120rpx;
  color: #ffffff;
}

.call-hint {
  font-size: 36rpx;
  color: #ffffff;
  margin-bottom: 16rpx;
}

.call-sub {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.5);
  margin-top: 8rpx;
}

.call-footer {
  padding: 48rpx 24rpx 80rpx;
  justify-content: center;
  align-items: center;
}

.call-hangup {
  width: 160rpx;
  height: 160rpx;
  border-radius: 80rpx;
  background-color: #ff3b30;
  justify-content: center;
  align-items: center;
}

.call-hangup-text {
  font-size: 30rpx;
  color: #ffffff;
}
</style>
