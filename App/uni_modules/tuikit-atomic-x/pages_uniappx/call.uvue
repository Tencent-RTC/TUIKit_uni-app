<template>
	<view class="call-view-container">
		<view class="call-content" :style="{ paddingTop: layoutTemplate == 'Grid' ? gridPaddingTopPx + 'px' : '0px' }">
			<call-core-view class="call-core-view" :layoutTemplate="layoutTemplate" :participantAvatars="participantAvatars" :volumeLevelIcons="volumeLevelIcons" :waitingAnimation="waitingAnimation" :networkQualityIcons="networkQualityIcons">
			</call-core-view>
		</view>
		<CallTopBar />

		<view class="button-panel-wrapper">
			<CallBottomButton />
		</view>
	</view>
</template>

<script setup lang="uts">
	import { ref, watch, computed } from 'vue';
	import { onLoad, onBackPress } from '@dcloudio/uni-app';
	import { useCallState, type UseCallStateReturn } from '../state/CallState.uts';
	import CallBottomButton from '../components/CallBottomButton.uvue';
	import CallTopBar from '../components/CallTopBar.uvue';
	import { downloadParticipantAvatars } from '@/uni_modules/tuikit-atomic-x/utils/avatarHelper.uts';
	import { getStaticResourcePath } from '@/uni_modules/tuikit-atomic-x';

	const cs: UseCallStateReturn = useCallState();
	const layoutTemplate = ref<string>('Grid')
	// 布局是否已完成初始判定，避免 activeCall 深层更新反复覆盖用户/原生的大小窗切换
	let layoutInitialized: boolean = false

	// Grid 模式下的顶部 padding
	const gridPaddingTopPx = computed((): number => {
		const screenWidth: number = uni.getSystemInfoSync().screenWidth
		const extraPx: number = screenWidth / 750.0 * 200.0
		return extraPx
	})

	onLoad((options: OnLoadOptions): void => {
		const opt: UTSJSONObject = options as UTSJSONObject
		const tpl: any | null = opt['layoutTemplate']
		if (typeof tpl == 'string') {
			layoutTemplate.value = tpl as string
			console.log('Received layoutTemplate:', tpl)
		}
	})

	onBackPress((options: OnBackPressOptions): boolean => {
		if (options.from == 'navigateBack') {
			return false
		}
		return true
	})

	// 监听 activeCall 确定初始 Grid/Float 布局（仅初始化一次，之后不覆盖用户/原生的大小窗切换）
	watch((): any | null => { return cs.activeCall.value }, (newVal: any | null, _oldVal: any | null) => {
		if (newVal == null) return
		if (layoutInitialized) return
		const callObj: UTSJSONObject = newVal as UTSJSONObject
		const inviteeIds: any[] | null = callObj["inviteeIds"] as any[] | null
		const chatGroupId: string = (callObj["chatGroupId"] as string | null) ?? ''
		const isMulti: boolean = (inviteeIds != null && inviteeIds.length > 1) || chatGroupId.length > 0
		const newTemplate: string = isMulti ? 'Grid' : 'Float'
		layoutInitialized = true
		if (layoutTemplate.value != newTemplate) {
			console.log('[CallPage] layoutTemplate init:', layoutTemplate.value, '->', newTemplate)
			layoutTemplate.value = newTemplate
		}
	}, { immediate: true, deep: true })

	// 原生自定义组件（CallCoreView）无法解析 /static 相对路径，需转为绝对路径
	const waitingAnimation = ref<string>(getStaticResourcePath("/static/images/callview-loading.gif"))

	function buildVolumeLevelIcons(): UTSJSONObject {
		return {
			"Mute": getStaticResourcePath("/static/images/callview-self-mute.png"),
			"Low": getStaticResourcePath("/static/images/callview-network.png"),
			"Medium": getStaticResourcePath("/static/images/callview-network.png"),
			"High": getStaticResourcePath("/static/images/callview-network.png"),
			"Peak": getStaticResourcePath("/static/images/callview-network.png")
		} as UTSJSONObject
	}

	function buildNetworkQualityIcons(): UTSJSONObject {
		return {
			"BAD": getStaticResourcePath("/static/images/callview-network-bad.png"),
			"VERY_BAD": getStaticResourcePath("/static/images/callview-network-bad.png")
		} as UTSJSONObject
	}

	const volumeLevelIcons = ref<UTSJSONObject>(buildVolumeLevelIcons())

	const networkQualityIcons = ref<UTSJSONObject>(buildNetworkQualityIcons())

	const participantAvatars = ref<UTSJSONObject>({} as UTSJSONObject)

	function updateParticipantAvatars(participants: any[]): void {
		if (participants.length == 0) {
			participantAvatars.value = {} as UTSJSONObject
			return
		}
		downloadParticipantAvatars(participants).then((avatarMap: UTSJSONObject): void => {
			console.log('[CallPage] participantAvatars updated')
			participantAvatars.value = avatarMap
			// 头像更新后刷新资源图标路径（触发原生组件重新渲染）
			volumeLevelIcons.value = buildVolumeLevelIcons()
			networkQualityIcons.value = buildNetworkQualityIcons()
		})
	}

	// 监听 allParticipants 变化，更新头像
	watch((): any[] => { return cs.allParticipants.value as any[] }, (newVal: any[]) => {
		console.log('[CallPage] allParticipants changed, count:', newVal.length)
		updateParticipantAvatars(newVal)
	}, { immediate: true, deep: true })
</script>

<style>
	.call-view-container {
		position: fixed;
		top: 0;
		left: 0;
		right: 0;
		bottom: 0;
		background: rgba(15, 16, 20, 0.5);
		overflow: hidden;
	}

	/* 内容区始终撑满整个窗口，不依赖会随页面栈上下文变化的 windowHeight */
	.call-content {
		width: 100%;
		height: 100%;
		pointer-events: none;
	}

	.call-core-view {
		width: 100%;
		height: 100%;
	}

	.button-panel-wrapper {
		position: absolute;
		bottom: 0;
		left: 0;
		right: 0;
	}
</style>
