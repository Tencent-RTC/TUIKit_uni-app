<template>
  <view
    v-if="visible"
    class="room-sheet-mask"
    @tap="handleMaskClick"
  >
    <view
      class="room-sheet"
      :class="theme == 'dark' ? 'room-sheet--dark' : 'room-sheet--light'"
      @tap.stop
    >
      <view class="room-sheet-head" @tap.stop="handleClose">
        <image
          v-if="showHandle"
          class="room-sheet-handle"
          src="/uni_modules/tuikit-atomic-x/static/room/room_lineImage.png"
          mode="aspectFit"
        />
      </view>
      <text
        v-if="title.length > 0"
        class="room-sheet-title"
        :class="theme == 'dark' ? 'room-sheet-title--dark' : 'room-sheet-title--light'"
      >{{ title }}</text>
      <slot></slot>
    </view>
  </view>
</template>

<script setup lang="uts">
type Props = {
  visible: boolean
  title?: string
  showHandle?: boolean
  closeOnMaskClick?: boolean
  // 'light' | 'dark'
  theme?: string
}

const props = withDefaults(defineProps<Props>(), {
  title: '',
  showHandle: true,
  closeOnMaskClick: true,
  theme: 'light'
})

const emit = defineEmits<{
  close: []
}>()

const handleMaskClick = (): void => {
  if (!props.closeOnMaskClick) return
  emit('close')
}

const handleClose = (): void => {
  emit('close')
}
</script>

<style>
.room-sheet-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 9998;
  background-color: rgba(0, 0, 0, 0.6);
  flex-direction: column;
  justify-content: flex-end;
}

.room-sheet {
  border-top-left-radius: 48rpx;
  border-top-right-radius: 48rpx;
  flex-direction: column;
}

/* uvue 不支持后代选择器，主题色用修饰类直接挂在目标元素上 */
.room-sheet--light {
  background-color: #FFFFFF;
}

.room-sheet--dark {
  background-color: #1F2229;
}

.room-sheet-head {
  flex-direction: column;
}

.room-sheet-handle {
  width: 72rpx;
  height: 9rpx;
  align-self: center;
  margin-top: 24rpx;
}

.room-sheet-title {
  padding: 0 32rpx;
  font-size: 36rpx;
  font-weight: 500;
  margin: 40rpx 0 20rpx;
}

.room-sheet-title--light {
  color: #4F586B;
}

.room-sheet-title--dark {
  color: #FFFFFF;
}
</style>
