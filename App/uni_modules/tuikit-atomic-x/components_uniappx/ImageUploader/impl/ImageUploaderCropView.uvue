<template>
	<view class="crop-page">
		<view class="status-bar" :style="{ height: statusBarHeight + 'px' }"></view>

		<view class="crop-container">
			<view class="image-container" @touchstart="onTouchStart" @touchmove="onTouchMove"
				@touchend="onTouchEnd">
				<image class="source-image" :src="displayImagePath"
					:style="imageStyle" @load="onImageLoad">
				</image>

				<view class="crop-overlay">
					<view class="crop-hole" :style="cropHoleStyle"></view>
					<view class="crop-frame" :class="cropFrameClass" :style="cropFrameStyle"></view>
				</view>
			</view>
		</view>

		<view class="bottom-bar">
			<text class="cancel-btn" @tap="onCancel">{{ localizedString('cancel') }}</text>
			<view class="spacer"></view>
			<view class="confirm-btn" @tap="onConfirm">
				<text class="confirm-text">{{ localizedString('done') }}</text>
			</view>
		</view>

		<canvas canvas-id="cropCanvas" class="crop-canvas"
			:style="{ width: canvasSize.width + 'px', height: canvasSize.height + 'px' }"></canvas>
	</view>
</template>

<script setup lang="uts">

import { ref, computed, onMounted, onReady, getCurrentInstance } from 'vue'
import { onLoad } from '@dcloudio/uni-app'
import { CropOverlayShape } from '../ImageUploader.uts'
import { localizedString } from '../locales/Localizable.uts'
import { ImageUploaderCrop, type CropRegion, type CanvasOutputSize } from './ImageUploaderCrop.uts'

/**
 * 触摸事件
 */
type TouchEventLike = {
	touches: TouchPoint[]
}

/**
 * 触摸点
 */
type TouchPoint = {
	clientX: number
	clientY: number
}

/**
 * 压缩选项
 */
type CompressOptions = {
	src: string
	quality: number
	rotate: number
	compressedWidth?: number
	compressedHeight?: number
	success: (res: any) => void
	fail: () => void
}

/**
 * getImageInfo 回调
 */
type GetImageInfoSuccess = {
	width: number
	height: number
	orientation: string
}

/**
 * canvasToTempFilePath 回调
 */
type CanvasToTempFileResult = {
	tempFilePath: string
}

const statusBarHeight = ref<number>(0)
const imagePath = ref<string>('')
const displayImagePath = ref<string>('')
const cropShape = ref<CropOverlayShape>(CropOverlayShape.CIRCLE)
const crop = new ImageUploaderCrop()
type CanvasSize = { width: number, height: number }

/** 打开者的 eventChannel 最小契约（仅用 emit，调用方按需传 any 数据） */
type OpenerEventChannel = {
  emit: (event: string, data: any) => void
}
const canvasSize: Ref<CanvasSize> = ref<CanvasSize>({ width: 400, height: 400 })

const cropFrameClass = computed((): UTSJSONObject => {
	return {
		'crop-frame-circle': cropShape.value == CropOverlayShape.CIRCLE,
		'crop-frame-rectangle': cropShape.value !== CropOverlayShape.CIRCLE
	}
})

const cropFrameStyle = computed((): string => {
	const cs = crop.cropSize
	return `left: ${cs.left}px; top: ${cs.top}px; width: ${cs.width}px; height: ${cs.height}px;`
})

const cropHoleStyle = computed((): string => {
	const cs = crop.cropSize
	if (cs.width == 0) return 'display: none;'
	const borderRadius = cropShape.value == CropOverlayShape.CIRCLE ? '50%' : '0'
	return `position: absolute; left: ${cs.left}px; top: ${cs.top}px; width: ${cs.width}px; height: ${cs.height}px; border-radius: ${borderRadius}; box-shadow: 0 0 0 2000px rgba(0, 0, 0, ${crop.maskOpacity}); pointer-events: none;`
})

const imageStyle = computed((): string => {
	const w = crop.imageWidth * crop.zoomScale
	const h = crop.imageHeight * crop.zoomScale
	return `width: ${w}px; height: ${h}px; position: absolute; left: ${crop.offsetX}px; top: ${crop.offsetY}px;`
})

/**
 * 加载图片信息
 */
const loadImageInfo = (): void => {
	const imgPath = imagePath.value
	uni.getImageInfo({
		src: imgPath,
		success: (res: GetImageInfoSuccess): void => {
			crop.imageWidth = res.width
			crop.imageHeight = res.height
			crop.naturalWidth = res.width
			crop.naturalHeight = res.height
			preparePreviewImage(res.width, res.height, res.orientation)
		},
		fail: (err: any): void => {
			console.error('Failed to get image info:', `${err}`)
		}
	})
}

/**
 * 准备预览图（按需压缩）
 */
const preparePreviewImage = (originalWidth: number, originalHeight: number, orientation: string): void => {
	if (!ImageUploaderCrop.needsPreviewCompression(originalWidth, originalHeight)) {
		applyInitialTransform()
		return
	}

	const previewMaxSize = ImageUploaderCrop.PREVIEW_MAX_SIZE
	const longerSide = Math.max(originalWidth, originalHeight)
	const compressRatio = previewMaxSize / longerSide
	const rotate = ImageUploaderCrop.getRotateAngle(orientation)

	const compressOptions: CompressOptions = {
		src: imagePath.value,
		quality: 90,
		rotate: rotate,
		success: (res: any): void => {
			uni.getImageInfo({
				src: res.tempFilePath,
				success: (info: GetImageInfoSuccess): void => {
					displayImagePath.value = res.tempFilePath
					crop.imageWidth = info.width
					crop.imageHeight = info.height
					applyInitialTransform()
				},
				fail: (): void => {
					displayImagePath.value = res.tempFilePath
					crop.imageWidth = Math.floor(originalWidth * compressRatio)
					crop.imageHeight = Math.floor(originalHeight * compressRatio)
					applyInitialTransform()
				}
			})
		},
		fail: (): void => {
			applyInitialTransform()
		}
	}

	if (originalWidth >= originalHeight) {
		compressOptions.compressedWidth = previewMaxSize
	} else {
		compressOptions.compressedHeight = previewMaxSize
	}

	uni.compressImage(compressOptions as any)
}

/**
 * 应用初始变换
 */
const applyInitialTransform = (): void => {
	const systemInfo = uni.getSystemInfoSync()
	crop.initializeTransform(systemInfo.screenWidth as number)
}

/**
 * 图像加载完成回调
 */
const onImageLoad = (): void => {
	if (crop.imageWidth == 0 || crop.imageHeight == 0) {
		loadImageInfo()
	}
}

/**
 * 触摸开始
 */
const onTouchStart = (e: TouchEventLike): void => {
	crop.onTouchStart(e.touches)
}

/**
 * 触摸移动
 */
const onTouchMove = (e: TouchEventLike): void => {
	crop.onTouchMove(e.touches)
}

/**
 * 触摸结束
 */
const onTouchEnd = (): void => {
	crop.onTouchEnd()
}

/**
 * 确认裁剪
 */
const onConfirm = async (): Promise<void> => {
	try {
		const region: CropRegion = crop.calculateCropRegion()
		const imgPath = imagePath.value
		const croppedPath = await cropImageWithCanvas(imgPath, region)
		deleteOriginalFile()
		const eventChannel = getOpenerEventChannel()
		const result: UTSJSONObject = { localPath: croppedPath }
		eventChannel.emit('cropResult', result)
		uni.navigateBack()
	} catch (error: any) {
		console.error('Crop failed:', `${error}`)
		uni.showToast({
			title: localizedString('crop_failed'),
			icon: 'none'
		})
	}
}

/**
 * 取消
 */
const onCancel = (): void => {
	deleteOriginalFile()
	const eventChannel = getOpenerEventChannel()
	const result: UTSJSONObject = { localPath: null }
	eventChannel.emit('cropResult', result)
	uni.navigateBack()
}

/**
 * 画布裁剪主逻辑
 */
const cropImageWithCanvas = (imgPath: string, region: CropRegion): Promise<string> => {
	return new Promise((resolve: (v: string) => void, reject: (e: any) => void) => {
		const outputSize: CanvasOutputSize = crop.calculateCanvasOutputSize(region.width, region.height)
		canvasSize.value = { width: outputSize.width, height: outputSize.height }

		setTimeout((): void => {
			const ctx = uni.createCanvasContext('cropCanvas')
			ctx.clearRect(0, 0, outputSize.width, outputSize.height)
			ctx.drawImage(imgPath, region.x, region.y, region.width, region.height, 0, 0,
				outputSize.width, outputSize.height)

			ctx.draw(false, (): void => {
				setTimeout((): void => {
					uni.canvasToTempFilePath({
						x: 0,
						y: 0,
						width: outputSize.width,
						height: outputSize.height,
						destWidth: outputSize.width,
						destHeight: outputSize.height,
						canvasId: 'cropCanvas',
						fileType: 'png',
						success: (res: CanvasToTempFileResult): void => {
							saveToCacheDir(res.tempFilePath).then(resolve).catch((): void => {
								resolve(res.tempFilePath)
							})
						},
						fail: (err: any): void => {
							console.error(
								'canvasToTempFilePath failed:',
								`${err}`
							)
							reject(err)
						}
					} as any)
				}, 100)
			})
		}, 300)
	})
}

/**
 * 保存到缓存目录
 */
const saveToCacheDir = (tempFilePath: string): Promise<string> => {
	return new Promise((resolve: (v: string) => void, reject: (e: any) => void) => {
		const cacheDir = `${plus.io.PUBLIC_DOWNLOADS}/../cache/image_uploader`
		const fileName = `crop_${Date.now()}.png`

		plus.io.resolveLocalFileSystemURL(plus.io.convertAbsoluteFileSystem(cacheDir), (dirEntry: any): void => {
			copyFileToDir(tempFilePath, dirEntry, fileName, resolve, reject)
		}, (): void => {
			// Directory doesn't exist, create it
			plus.io.requestFileSystem(plus.io.PRIVATE_DOC, (fs: any): void => {
				fs.root.getDirectory('cache/image_uploader', {
					create: true
				}, (dirEntry: any): void => {
					copyFileToDir(tempFilePath, dirEntry, fileName, resolve, reject)
				}, reject)
			}, reject)
		})
	})
}

/**
 * 复制文件到目录
 */
const copyFileToDir = (
	tempFilePath: string,
	dirEntry: any,
	fileName: string,
	resolve: (v: string) => void,
	reject: (e: any) => void
): void => {
	let srcPath: string = tempFilePath
	if (srcPath.startsWith('file://')) {
		srcPath = srcPath.substring(7)
	}
	plus.io.resolveLocalFileSystemURL(srcPath, (fileEntry: any): void => {
		fileEntry.copyTo(dirEntry, fileName, (newEntry: any): void => {
			const fullPath = plus.io.convertLocalFileSystemURL(newEntry.fullPath)
			resolve(fullPath)
		}, reject)
	}, reject)
}

/**
 * 删除原文件
 */
const deleteOriginalFile = (): void => {
	if (imagePath.value.length == 0) return
	let filePath: string = imagePath.value
	if (filePath.startsWith('file://')) {
		filePath = filePath.substring(7)
	}
	plus.io.resolveLocalFileSystemURL(filePath, (entry: any): void => {
		entry.remove((): void => {
			console.log('ImageUploaderCropView: deleted original file:', imagePath.value)
		}, (err: any): void => {
			console.error('ImageUploaderCropView: failed to delete original file:', `${err}`)
		})
	}, (err: any): void => {
		console.error('ImageUploaderCropView: failed to resolve original file:', `${err}`)
	})
}

/**
 * 获取打开者的 eventChannel（用于回传数据）
 */
const getOpenerEventChannel = (): OpenerEventChannel => {
	const inst = getCurrentInstance()
	const proxy: any = inst?.proxy ?? {}
	if (proxy.getOpenerEventChannel != null) {
		return proxy.getOpenerEventChannel()
	}
	// fallback
	return { emit: (_e: string, _d: any): void => {} }
}

onLoad((options: any) => {
	const systemInfo = uni.getSystemInfoSync()
	statusBarHeight.value = (systemInfo.statusBarHeight as number) ?? 0

	if (options != null && options.params != null && typeof options.params == 'string') {
		const params = ImageUploaderCrop.parseCropParams(options.params)
		if (params != null) {
			imagePath.value = params.imagePath
			displayImagePath.value = params.imagePath
			cropShape.value = params.cropShape
		} else {
			onCancel()
		}
	}
})

onReady((): void => {
	const systemInfo = uni.getSystemInfoSync()
	crop.calculateCropSize(
		systemInfo.screenWidth as number,
		systemInfo.screenHeight as number,
		statusBarHeight.value,
		cropShape.value
	)
	if (imagePath.value.length > 0) {
		loadImageInfo()
	}
})
</script>

<style scoped>
.crop-page {
	flex: 1;
	background-color: #000000;
	display: flex;
	flex-direction: column;
	height: 100vh;
	padding-bottom: env(safe-area-inset-bottom);
}

.status-bar {
	background-color: #000000;
}

.crop-container {
	flex: 1;
	position: relative;
	overflow: hidden;
}

.image-container {
	width: 100%;
	height: 100%;
	position: relative;
	display: flex;
	align-items: center;
	justify-content: center;
}

.source-image {
	display: block;
	pointer-events: none;
}

.crop-overlay {
	position: absolute;
	top: 0;
	left: 0;
	right: 0;
	bottom: 0;
	pointer-events: none;
}

.crop-hole {
	background-color: transparent;
	transition: box-shadow 0.3s ease;
}

.crop-frame {
	position: absolute;
	border: 1px solid #ffffff;
	pointer-events: none;
}

.crop-frame-circle {
	border-radius: 50%;
}

.crop-frame-rectangle {
	border-radius: 0;
}

.crop-frame::before {
	content: '';
	position: absolute;
	top: -1px;
	left: -1px;
	right: -1px;
	bottom: -1px;
	background: transparent;
	mix-blend-mode: screen;
}

.bottom-bar {
	position: absolute;
	left: 0;
	right: 0;
	bottom: 0;
	height: 56px;
	background-color: transparent;
	display: flex;
	align-items: center;
	justify-content: space-between;
	padding: 0 16px;
	padding-bottom: env(safe-area-inset-bottom);
	z-index: 10;
}

.cancel-btn {
	font-size: 16px;
	color: #ffffff;
	padding: 8px 0;
}

.spacer {
	flex: 1;
}

.confirm-btn {
	background-color: #007AFF;
	border-radius: 6px;
	padding: 8px 16px;
}

.confirm-text {
	font-size: 16px;
	color: #ffffff;
	font-weight: 500;
}

.crop-canvas {
	position: fixed;
	top: -9999px;
	left: -9999px;
	opacity: 0;
	pointer-events: none;
}
</style>
