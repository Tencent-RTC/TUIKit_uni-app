<template>
  <view class="search" @click="handleContainerClick">
    <component
      ref="searchBarRef"
      :is="SearchBarComponent"
      v-model="keyword"
      :placeholder="placeholder"
      :showCancel="showCancel"
      :debounceTime="debounceTime"
      :autoFocus="autoFocus"
      @search="handleSearch"
      @cancel="handleCancel"
      @focus="handleFocus"
      @clear="handleClear"
    />
    <component
      v-if="showTab"
      :is="SearchTabComponent"
      v-model="currentTab"
      :tabs="tabList"
      @change="handleTabChange"
    />
    <component
      v-if="SearchAdvancedComponent"
      :is="SearchAdvancedComponent"
      :currentTab="currentTab"
      :isCloudSearch="isCloudSearch"
      :conversationID="conversationID"
      @messageFilterChange="handleMessageFilterChange"
      @userFilterChange="handleUserFilterChange"
    />
    <component
      :is="SearchResultsComponent"
      :keyword="keyword"
      :conversationID="conversationID"
      :currentTab="currentTab"
      :isLoading="isLoading"
      :showPresearch="showPresearch"
      :userList="filteredUserList"
      :friendList="filteredFriendList"
      :groupList="filteredGroupList"
      :groupMemberList="groupMemberList"
      :messageResults="filteredMessageResults"
      :hasMoreUser="hasMoreFriends"
      :hasMoreFriend="hasMoreFriends"
      :hasMoreGroup="hasMoreGroups"
      :hasMoreGroupMember="hasMoreGroupMembers"
      :hasMoreMessage="hasMoreMessageResults"
      :searchHistory="searchHistory"
      :SearchResultItem="SearchResultItemComponent"
      :PlaceholderEmpty="PlaceholderEmpty"
      :PlaceholderLoading="PlaceholderLoading"
      :PlaceholderPresearch="PlaceholderPresearch"
      :Avatar="Avatar"
      @resultItemClick="handleResultItemClick"
      @viewMore="handleViewMore"
      @historyClick="handleHistoryClick"
      @clearHistory="handleClearHistory"
      @cloudSearchClick="handleCloudSearchClick"
    />
  </view>
</template>

<script setup lang="uts">

import { ref, computed, watch, onBeforeUnmount, onMounted, nextTick } from 'vue'
import { useSearchState } from '../../state/SearchState'
import {
	SearchResultTypeMap,
	type SearchProps,
	type SearchEmits,
	type SearchResultType,
	type SearchTabItem,
	type SearchOption,
	type FriendSearchInfo,
	type MessageSearchResultItem,
	type UserSearchFilter,
	type MessageSearchFilter
} from '../../types/search.uts'
import AvatarComponent from '../Avatar'
import DefaultSearchBar from './SearchBar.uvue'
import DefaultSearchResults from './SearchResults.uvue'
import DefaultSearchTab from './SearchTab.uvue'
import DefaultPresearch from './placeholders/SearchResultsPresearch.uvue'
import DefaultLoading from './placeholders/SearchResultsLoading.uvue'
import DefaultEmpty from './placeholders/SearchResultsEmpty.uvue'
import type { UserProfile } from '../../types/userProfile'
import type { GroupSearchInfo, GroupMember } from '../../types/group'

function getErrorMessage(error: any): string {
	if (error instanceof Error) {
		return (error as Error).message
	}
	return `${error}`
}

const props = withDefaults(defineProps<SearchProps>(), {
	conversationID: '',
	initialKeyword: '',
	initialOption: (): any => ({} as any),
	placeholder: '搜索',
	isCloud: false,
	autoFocus: true,
	showAdvanced: false,
	showCancel: true,
	debounceTime: 300,
	SearchBar: (): any => DefaultSearchBar,
	SearchResults: (): any => DefaultSearchResults,
	SearchTab: (): any => DefaultSearchTab,
	PlaceholderPresearch: (): any => DefaultPresearch,
	PlaceholderLoading: (): any => DefaultLoading,
	PlaceholderEmpty: (): any => DefaultEmpty,
	Avatar: (): any => AvatarComponent
})

const emit = defineEmits<SearchEmits>()

// 如果有 conversationID，使用它作为 storeID，否则使用默认值
const searchStoreID: string = props.conversationID.length > 0 ? props.conversationID : 'default_search_store'

const {
	friendList,
	groupList,
	groupMemberList,
	messageResults,
	hasMoreFriends,
	hasMoreGroups,
	hasMoreGroupMembers,
	hasMoreMessageResults,
	search,
	searchMore,
	clearSearchResults,
	destroyStore
} = useSearchState(searchStoreID)

const keyword = ref<string>('')
const isLoading = ref<boolean>(false)
const showPresearch = ref<boolean>(true)
const currentTab = ref<string>('all')
const searchBarRef = ref<any | null>(null)
const isCloudSearch = ref<boolean>(props.isCloud)

const userFilter: Ref<UTSJSONObject> = ref<UTSJSONObject>(new UTSJSONObject())
const messageFilter: Ref<UTSJSONObject> = ref<UTSJSONObject>(new UTSJSONObject())

// 搜索历史记录
const SEARCH_HISTORY_KEY = 'tuikit_search_history'
const MAX_HISTORY_COUNT = 20
const searchHistory = ref<string[]>([])

/**
 * 加载搜索历史
 */
const loadSearchHistory = (): void => {
	try {
		const history = uni.getStorageSync(SEARCH_HISTORY_KEY)
		if (history != null && typeof history == 'string' && history.length > 0) {
			searchHistory.value = JSON.parse(history) as string[]
		}
	} catch (e: any) {
		console.error('[Search] Load search history failed:', `${e}`)
	}
}

/**
 * 保存搜索历史
 */
const saveSearchHistory = (kw: string): void => {
	const trimmed = kw.trim()
	if (trimmed.length == 0) return

	// 移除重复项
	const index = searchHistory.value.indexOf(trimmed)
	if (index > -1) {
		searchHistory.value.splice(index, 1)
	}

	// 添加到开头
	searchHistory.value.unshift(trimmed)

	// 限制数量
	if (searchHistory.value.length > MAX_HISTORY_COUNT) {
		searchHistory.value = searchHistory.value.slice(0, MAX_HISTORY_COUNT)
	}

	// 持久化
	try {
		uni.setStorageSync(SEARCH_HISTORY_KEY, JSON.stringify(searchHistory.value))
	} catch (e: any) {
		console.error('[Search] Save search history failed:', `${e}`)
	}
}

/**
 * 清除搜索历史
 */
const clearSearchHistory = (): void => {
	searchHistory.value = []
	try {
		uni.removeStorageSync(SEARCH_HISTORY_KEY)
	} catch (e: any) {
		console.error('[Search] Clear search history failed:', `${e}`)
	}
}

/**
 * 是否显示进入全局搜索入口（非云端搜索时显示）
 */
const showCloudSearchEntry = computed((): boolean => {
	return !isCloudSearch.value && showPresearch.value
})

const tabList: SearchTabItem[] = [
	{ label: '全部', value: 'all' },
	{ label: '用户', value: 'friend' },
	{ label: '群聊', value: 'group' },
	{ label: '消息', value: 'message' },
]

const currentSearchOption = computed((): SearchOption => {
	const searchScope: number[] = [0, 1, 3]  // FRIEND, GROUP, MESSAGE
	const result: SearchOption = {
		keywordListMatchMode: 0,  // OR
		searchScope: searchScope,
		pageSize: 20
	}
	return result
})

const SearchBarComponent = computed((): any | null => props.SearchBar ?? null)
const SearchResultsComponent = computed((): any | null => props.SearchResults ?? null)
const SearchAdvancedComponent = computed((): any | null => props.SearchAdvanced ?? null)
const SearchTabComponent = computed((): any | null => props.SearchTab ?? DefaultSearchTab)
const SearchResultItemComponent = computed((): any | null => props.SearchResultItem ?? null)

const isConversationSearch = computed((): boolean => props.conversationID.length > 0)

const showTab = computed((): boolean => {
	if (isConversationSearch.value) {
		return false
	}
	return keyword.value.trim().length > 0 && !showPresearch.value
})

const filteredUserList = computed((): any[] => {
	if (isConversationSearch.value) {
		return []
	}
	// 注：底层 atomicxcore 已移除 user 搜索，这里返回空数组保留 props 接口不变；用户搜索请改为好友搜索（Friend）
	return []
})

const filteredFriendList = computed((): any[] => {
	if (isConversationSearch.value) {
		return []
	}
	if (currentTab.value == 'all' || currentTab.value == 'friend') {
		return friendList.value as any[]
	}
	return []
})

const filteredGroupList = computed((): any[] => {
	if (isConversationSearch.value) {
		return []
	}
	if (currentTab.value == 'all' || currentTab.value == 'group') {
		return groupList.value as any[]
	}
	return []
})

const filteredMessageResults = computed((): any[] => {
	if (currentTab.value == 'all' || currentTab.value == 'message') {
		return messageResults.value as any[]
	}
	return []
})

const doSearch = async (searchKeyword: string): Promise<void> => {
	if (searchKeyword.trim().length == 0) {
		showPresearch.value = true
		clearSearchResults()
		return
	}
	showPresearch.value = false
	isLoading.value = true

	// 计算本次搜索的 searchScope（数组形态，对齐 atomicxcore SearchOption.searchScope）
	let searchScope: number[] = currentSearchOption.value.searchScope ?? [0, 1, 3]

	if (isConversationSearch.value) {
		searchScope = [3]  // MESSAGE
	} else if (currentTab.value == 'message') {
		searchScope = [3]  // MESSAGE
	} else if (currentTab.value == 'friend') {
		searchScope = [0]  // FRIEND
	} else if (currentTab.value == 'group') {
		searchScope = [1]  // GROUP
	}

	const baseOption: SearchOption = {
		...currentSearchOption.value,
		searchScope: searchScope,
		userFilter: userFilter.value,
		messageFilter: messageFilter.value
	} as SearchOption

	// 三元 + 嵌套字面量（MessageSearchFilter）：拆 const 中转避免编译器不稳定识别
	let option: SearchOption
	if (isConversationSearch.value) {
		const baseMsgObj: UTSJSONObject = JSON.parse<UTSJSONObject>(JSON.stringify(baseOption.messageFilter ?? new UTSJSONObject())) ?? new UTSJSONObject()
		const newMessageFilter: MessageSearchFilter = {
			conversationID: props.conversationID,
			searchTimePosition: baseMsgObj['searchTimePosition'] as number | null,
			searchTimePeriod: baseMsgObj['searchTimePeriod'] as number | null,
			senderUserIDList: baseMsgObj['senderUserIDList'] as string[] | null,
			messageTypeList: baseMsgObj['messageTypeList'] as any[] | null
		}
		option = {
			...baseOption,
			messageFilter: newMessageFilter
		} as SearchOption
	} else {
		option = baseOption
	}

	emit('search', searchKeyword, option)

	try {
		await search([searchKeyword], option)
		// 保存搜索历史
		saveSearchHistory(searchKeyword)
	} catch (error: any) {
		const errMsg = getErrorMessage(error)
		console.error('[Search] Search failed:', errMsg)
		uni.showToast({
			title: errMsg.length > 0 ? errMsg : '搜索失败',
			icon: 'none',
			duration: 2000
		})
	} finally {
		isLoading.value = false
	}
}

const handleSearch = (searchKeyword: string): void => {
	doSearch(searchKeyword)
}

const handleCancel = (): void => {
	keyword.value = ''
	showPresearch.value = true
	currentTab.value = 'all'
	clearSearchResults()
	// ⭐ 关键修复：emit 推迟到 nextTick，让响应式清空先完成，避免 navigateBack 触发页面销毁过程中
	//   子组件 Search 还在响应式更新 + 父组件同步 emit → 框架在 beforeCreate 阶段访问 e.$nativePage.pageId 报 NPE
	nextTick(() => {
		emit('cancel')
	})
}

const handleFocus = (): void => {
	if (keyword.value.length == 0) {
		showPresearch.value = true
	}
}

const handleClear = (): void => {
	showPresearch.value = true
	currentTab.value = 'all'
	clearSearchResults()
}

const handleContainerClick = (): void => {
	uni.hideKeyboard()
}

const handleTabChange = (tab: string): void => {
	currentTab.value = tab

	if (tab == 'all' && props.conversationID.length == 0) {
		const msgFilterObj: UTSJSONObject = messageFilter.value
		const userFilterObj: UTSJSONObject = userFilter.value
		const mConvId: any | null = msgFilterObj['conversationID']
		const mSearchTime: any | null = msgFilterObj['searchTimePosition']
		const mSearchPeriod: any | null = msgFilterObj['searchTimePeriod']
		const mSenderList: any | null = msgFilterObj['senderUserIDList']
		const mTypeList: any | null = msgFilterObj['messageTypeList']
		const hasMsgFilter: boolean = (mConvId != null && (mConvId as string).length > 0) || mSearchTime != null || mSearchPeriod != null || (mSenderList != null && (mSenderList as string[]).length > 0) || (mTypeList != null && (mTypeList as any[]).length > 0)
		const uGender: any | null = userFilterObj['gender']
		const uMinBirthday: any | null = userFilterObj['minBirthday']
		const uMaxBirthday: any | null = userFilterObj['maxBirthday']
		const hasUserFilter: boolean = uGender != null || uMinBirthday != null || uMaxBirthday != null
		const hasFilter: boolean = hasMsgFilter || hasUserFilter
		if (hasFilter) {
			messageFilter.value = new UTSJSONObject()
			userFilter.value = new UTSJSONObject()
			if (keyword.value.trim().length > 0) {
				doSearch(keyword.value)
			}
		}
	}
}

const handleMessageFilterChange = (filter: any): void => {
	messageFilter.value = (filter ?? new UTSJSONObject()) as UTSJSONObject
	if (keyword.value.trim().length > 0) {
		doSearch(keyword.value)
	}
}

const handleUserFilterChange = (filter: any): void => {
	userFilter.value = (filter ?? new UTSJSONObject()) as UTSJSONObject
	if (keyword.value.trim().length > 0) {
		doSearch(keyword.value)
	}
}

const handleResultItemClick = (
	type: SearchResultType | 'conversation',
	data: FriendSearchInfo | UserProfile | GroupSearchInfo | GroupMember | MessageSearchResultItem
): void => {
	emit('resultItemClick', type, data)
}

const handleViewMore = async (type: SearchResultType): Promise<void> => {
	if (currentTab.value == 'all') {
		if (type != null) {
			currentTab.value = type as string
		}
	} else {
		const searchTypeValue = SearchResultTypeMap[type]
		if (searchTypeValue != null) {
			try {
				await searchMore(searchTypeValue)
			} catch (error: any) {
				const errMsg = getErrorMessage(error)
				console.error('[Search] View more failed:', errMsg)
				uni.showToast({
					title: errMsg.length > 0 ? errMsg : '加载更多失败',
					icon: 'none',
					duration: 2000
				})
			}
		}
	}
}

/**
 * 点击历史记录
 */
const handleHistoryClick = (historyKeyword: string): void => {
	keyword.value = historyKeyword
	doSearch(historyKeyword)
}

/**
 * 清除历史记录
 */
const handleClearHistory = (): void => {
	clearSearchHistory()
}

/**
 * 点击进入全局搜索
 */
const handleCloudSearchClick = (): void => {
	isCloudSearch.value = true
	// 如果有关键词，重新搜索
	if (keyword.value.trim().length > 0) {
		doSearch(keyword.value)
	}
}

onBeforeUnmount((): void => {
	destroyStore()
})

// onLoad 和 onMounted 执行顺序不一致导致的初始值传递问题
watch(
	(): string => props.initialKeyword,
	(newKeyword: string): void => {
		if (newKeyword.length > 0 && keyword.value.length == 0) {
			keyword.value = newKeyword
			doSearch(newKeyword)
		}
	},
	{ immediate: true }
)

onMounted((): void => {
	// 加载搜索历史
	loadSearchHistory()

	const initialOption: any | null = props.initialOption ?? null
	if (initialOption != null) {
		const optObj: UTSJSONObject = (initialOption ?? new UTSJSONObject()) as UTSJSONObject
		const userFilterRaw: any | null = optObj['userFilter']
		if (userFilterRaw != null) {
			userFilter.value = (userFilterRaw ?? new UTSJSONObject()) as UTSJSONObject
		}
		const messageFilterRaw: any | null = optObj['messageFilter']
		if (messageFilterRaw != null) {
			messageFilter.value = (messageFilterRaw ?? new UTSJSONObject()) as UTSJSONObject
		}
	}
	if (props.initialKeyword.length > 0 && keyword.value.length == 0) {
		keyword.value = props.initialKeyword
		doSearch(props.initialKeyword)
	}
})
</script>

<style>
.search {
  flex: 1;
  background-color: #ffffff;
}
</style>
