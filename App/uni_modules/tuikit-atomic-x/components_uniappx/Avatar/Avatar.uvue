<template>
  <view class="avatar-container" :class="containerClass">
    <!-- 头像图片 -->
    <image
      v-if="hasAvatarSrc"
      :src="effectiveAvatarSrc"
      :style="avatarStyle"
      class="avatar-image"
      mode="aspectFill"
      @error="handleImageError"
    />

    <!-- 默认头像（显示首字符） -->
    <view v-else class="avatar-default" :style="avatarStyle">
      <text class="avatar-text" :style="textStyle">{{ firstChar }}</text>
    </view>

    <!-- 在线状态指示器 -->
    <view v-if="showOnline" class="online-indicator"></view>

    <!-- 未读消息数量徽章 -->
    
    <view v-if="badgeCount > 0" :class="badgeClass">
      <text v-if="!showBadgeDot" class="badge-text">{{ badgeCount > 99 ? '99+' : badgeCount }}</text>
    </view>
  </view>
</template>

<script setup lang="uts">
import { ref, computed, watch, onMounted } from 'vue'

const props = withDefaults(defineProps<{
  // 头像图片地址
  src: string
  // 用户名称（用于生成默认头像）
  name: string
  // 头像大小
  size: string | number
  // 是否显示在线状态
  showOnline: boolean
  // 徽章数量
  badgeCount: number
  // 是否只显示红点，不显示数字
  showBadgeDot: boolean
  // 头像形状：circle(圆形) | square(方形)
  shape: string
  // 默认头像类型：none | user | work | public | meeting | avchatroom
  defaultAvatarType: string
  // 纯净模式，没有外层的 padding
  pureMode: string | boolean
  // 懒加载：mount 时不立即赋值 src，让出主线程后再加载远程图
  lazy: boolean
}>(), {
  src: '',
  name: '',
  size: 96,
  showOnline: false,
  badgeCount: 0,
  showBadgeDot: false,
  shape: 'square',
  defaultAvatarType: 'none',
  pureMode: false,
  lazy: false,
})

const normalizedSize = computed<number>((): number => {
  const raw = props.size
  if (typeof raw == 'number') return raw
  if (raw == '64') return 64
  if (raw == '72') return 72
  if (raw == '96') return 96
  if (raw == '120') return 120
  return 96
})

const normalizedPureMode = computed<boolean>((): boolean => {
  const raw = props.pureMode
  if (typeof raw == 'boolean') return raw
  return raw == 'true'
})

// 头像图片地址；lazy 模式下 mount 时为空，下一个事件循环再赋值
const avatarSrc = ref<string>(props.lazy ? '' : props.src)

onMounted(() => {
  if (props.lazy && props.src.length > 0) {
    setTimeout(() => {
      avatarSrc.value = props.src
    }, 0)
  }
})

watch((): string => props.src, (newVal: string) => {
  avatarSrc.value = newVal
})

/**
 * 头像样式
 */
const avatarStyle = computed<string>((): string => {
  const size = normalizedSize.value
  const radius: string = props.shape == 'circle' ? `${size / 2}rpx` : '10rpx'
  return `width: ${size}rpx; height: ${size}rpx; border-radius: ${radius};`
})

/**
 * 文字样式
 */
const textStyle = computed<string>((): string => {
  return `font-size: ${Math.floor(normalizedSize.value * 0.4)}rpx; color: rgba(0, 0, 0, 0.9);`
})

/**
 * 容器 class（pure-mode 由 props 控制）
 */
const containerClass = computed<string>((): string => {
  return normalizedPureMode.value ? 'avatar-container pure-mode' : 'avatar-container'
})

/**
 * 徽章 class
 */
const badgeClass = computed<string>((): string => {
  return props.showBadgeDot ? 'badge-dot' : 'badge'
})

/**
 * 实际加载的 URL（src 优先，否则 default URL）
 */
const effectiveAvatarSrc = computed<string>((): string => {
  const src: string = avatarSrc.value
  if (src && src.length > 0) return src
  const def: string = props.defaultAvatarType
  const defaultMap: UTSJSONObject = new UTSJSONObject()
  defaultMap['user'] = 'https://web.sdk.qcloud.com/im/assets/all-in-one/user.png'
  defaultMap['work'] = 'https://web.sdk.qcloud.com/im/assets/all-in-one/work.png'
  defaultMap['public'] = 'https://web.sdk.qcloud.com/im/assets/all-in-one/public.png'
  defaultMap['meeting'] = 'https://web.sdk.qcloud.com/im/assets/all-in-one/meeting.png'
  defaultMap['avchatroom'] = 'https://web.sdk.qcloud.com/im/assets/all-in-one/avchatroom.png'
  const urlRaw: any | null = defaultMap[def]
  return typeof urlRaw == 'string' ? (urlRaw as string) : ''
})

/**
 * 是否有可显示的头像 src（含默认 URL）
 */
const hasAvatarSrc = computed<boolean>((): boolean => {
  return effectiveAvatarSrc.value.length > 0
})

/**
 * 首字符（用于默认头像）
 */
const firstChar = computed<string>((): string => {
  if (props.name.length == 0) {
    return '?'
  }
  // 提取中文、英文或数字的第一个字符
  let code: number = 0
  for (let i = 0; i < props.name.length; i++) {
    code = props.name.charCodeAt(i) ?? 0
    // CJK 统一汉字：U+4E00 - U+9FA5
    if ((code >= 0x4E00 && code <= 0x9FA5)
        || (code >= 0x41 && code <= 0x5A) // A-Z
        || (code >= 0x61 && code <= 0x7A) // a-z
        || (code >= 0x30 && code <= 0x39)) { // 0-9
      return String.fromCharCode(code).toUpperCase()
    }
  }
  return '?'
})

/**
 * 处理图片加载错误
 */
const handleImageError = (): void => {
  avatarSrc.value = ''
}
</script>

<style>
.avatar-container {
  position: relative;
  padding: 10rpx;
}

.pure-mode {
  padding: 0rpx;
}

.avatar-image {
  background-color: #f5f5f5;
}

.avatar-default {
  background-color: #EBF3FF;
  justify-content: center;
  align-items: center;
}

.avatar-text {
  font-weight: 500;
  text-align: center;
}

.online-indicator {
  position: absolute;
  bottom: 0rpx;
  right: 0rpx;
  width: 20rpx;
  height: 20rpx;
  border-radius: 10rpx;
  background-color: #4CAF50;
  border-width: 2rpx;
  border-color: #ffffff;
}

.badge {
  position: absolute;
  top: 0rpx;
  right: 0rpx;
  background-color: #ff4444;
  min-width: 36rpx;
  height: 36rpx;
  border-radius: 36rpx;
  justify-content: center;
  align-items: center;
}

.badge-dot {
  position: absolute;
  top: 0rpx;
  right: 0rpx;
  background-color: #ff4444;
  width: 20rpx ;
  height: 20rpx;
  border-radius: 10rpx;
  justify-content: center;
  align-items: center;
}

.badge-text {
  min-width: 24rpx;
  font-weight: 500;
  font-size: 24rpx;
  line-height: 24rpx;
  text-align: center;
  color: #ffffff;
}
</style>
