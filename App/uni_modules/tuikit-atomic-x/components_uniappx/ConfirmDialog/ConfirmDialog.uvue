<template>
  <view v-if="visible" class="confirm-dialog">
    <view class="confirm-dialog__mask" @click="handleMaskClick"></view>

    <view class="confirm-dialog__content">
      <view class="confirm-dialog__header">
        <text class="confirm-dialog__title">{{ title }}</text>
        <text v-if="hasMessage" class="confirm-dialog__message">{{ message }}</text>
      </view>

      <view class="confirm-dialog__buttons">
        <view class="confirm-dialog__button" @click="handleCancel">
          <text class="confirm-dialog__button-text confirm-dialog__button-text--cancel">{{ cancelText }}</text>
        </view>
        <view class="confirm-dialog__button" @click="handleConfirm">
          <text class="confirm-dialog__button-text confirm-dialog__button-text--confirm">{{ confirmText }}</text>
        </view>
      </view>
    </view>
  </view>
</template>

<script setup lang="uts">

import { ref, watch, computed } from 'vue'

/**
 * 组件 props
 */
type Props = {
  modelValue?: boolean
  title?: string
  message?: string
  cancelText?: string
  confirmText?: string
  closeOnClickMask?: boolean
}

type Emits = {
  'update:modelValue': boolean
  confirm: void
  cancel: void
}

const props = withDefaults(defineProps<Props>(), {
  modelValue: false,
  title: '提示',
  message: '',
  cancelText: '取消',
  confirmText: '确定',
  closeOnClickMask: true
})

const emit = defineEmits<Emits>()

const visible = ref<boolean>(props.modelValue)

const hasMessage = computed<boolean>((): boolean => {
  return typeof props.message == 'string' && props.message.length > 0
})

watch((): boolean => props.modelValue, (newVal: boolean): void => {
  visible.value = newVal
})

const close = (): void => {
  visible.value = false
  emit('update:modelValue', false)
}

const handleMaskClick = (): void => {
  if (props.closeOnClickMask == true) {
    close()
    emit('cancel')
  }
}

const handleCancel = (): void => {
  close()
  emit('cancel')
}

const handleConfirm = (): void => {
  close()
  emit('confirm')
}

defineExpose({
  open: (): void => {
    visible.value = true
    emit('update:modelValue', true)
  },
  close
})
</script>

<style>
.confirm-dialog {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  justify-content: center;
  align-items: center;
}

.confirm-dialog__mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
}

.confirm-dialog__content {
  width: 654rpx;
  background-color: #FFFFFF;
  border-radius: 24rpx;
  align-items: center;
  overflow: hidden;
}

.confirm-dialog__header {
  padding: 40rpx 48rpx;
}

.confirm-dialog__title {
  font-size: 36rpx;
  font-weight: 600;
  color: rgba(0, 0, 0, 0.9);
  line-height: 52rpx;
  margin: 24rpx 0 16rpx;
  text-align: center;
}

.confirm-dialog__message {
  font-size: 32rpx;
  color: rgba(0, 0, 0, 0.9);
  line-height: 48rpx;
  text-align: center;
}

.confirm-dialog__buttons {
  flex: 1;
  width: 654rpx;
  flex-direction: row;
  border-top: 1rpx solid #E6E9F0;
}

.confirm-dialog__button {
  flex: 1;
  justify-content: center;
  align-items: center;
  padding: 32rpx;
  border-right: 1rpx solid #E6E9F0;
}

.confirm-dialog__button:last-child {
  border-right: none;
}

.confirm-dialog__button-text {
  font-size: 32rpx;
  line-height: 48rpx;
  font-weight: 500;
}

.confirm-dialog__button-text--cancel {
  color: rgba(0, 0, 0, 0.9);
}

.confirm-dialog__button-text--confirm {
  color: #E54545;
}
</style>