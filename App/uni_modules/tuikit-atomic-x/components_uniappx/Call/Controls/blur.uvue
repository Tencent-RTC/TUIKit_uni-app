<template>
  <view class="btn" @tap="handleBlur">
    <image class="btn-img" :style="{ width: size + 'px', height: size + 'px' }" src="/uni_modules/tuikit-atomic-x/static/icon/blur-off.png"></image>
    <text class="btn-text" v-if="isShowText">背景模糊</text>
  </view>
</template>

<script setup lang="uts">
  import { ref } from "vue";
  import {
    useCallState,
    type UseCallStateReturn
  } from '@/uni_modules/tuikit-atomic-x/state/CallState.uts';

  const cs: UseCallStateReturn = useCallState()
  const isBlur = ref<boolean>(false)

  const props = defineProps({
    size: {
      type: Number,
      default: 60,
    },
    isShowText: {
      type: Boolean,
      default: true,
    },
  });

  const handleBlur = (): void => {
    cs.enableVirtualBackground(!isBlur.value)
    isBlur.value = !isBlur.value
  };
</script>

<style scoped>
  .btn {
    margin: 10px 20px;
  }

  .btn-img {
    width: 60px;
    height: 60px;
    border-radius: 140px;
  }

  .btn-text {
    font-size: 12px;
    color: #d5e0f2;
    font-weight: 400;
    text-align: center;
    margin-top: 10px;
  }
</style>
