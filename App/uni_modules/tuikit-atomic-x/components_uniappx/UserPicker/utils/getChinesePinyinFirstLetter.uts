// 完整拼音首字母表（20902 字符）
const strChineseFirstPY: string = ''

export function getChinesePinyinFirstLetter(char: string): string {
  const code: number | null = char.charCodeAt(0)
  if (code == null || code > 40869 || code < 19968) {
    return char
  }
  const uni: number = code  // 收窄为非空
  const multiV = oMultiDiff.get(uni)
  const firstLetter: string = typeof multiV == "string" ? multiV : strChineseFirstPY.charAt(uni - 19968)
  return firstLetter.toUpperCase()
}
export default getChinesePinyinFirstLetter
