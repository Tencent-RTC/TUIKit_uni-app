<template>
  <view class="create-group">
    <!-- 创建群聊表单 -->
    <view class="form-container">
      <!-- 表单内容 -->
      <scroll-view class="form-content" scroll-y="true">
        <!-- 群名称 -->
        <view class="form-item form-item--first">
          <text class="form-label">群名称</text>
          <input
            ref="groupNameInput"
            class="form-input"
            v-model="groupName"
            placeholder="输入群名称"
            maxlength="20"
          ></input>
        </view>

        <!-- 群ID -->
        <view class="form-item form-item--connected">
          <text class="form-label">群ID（选填）</text>
          <input
            ref="groupIdInput"
            class="form-input"
            v-model="groupID"
            placeholder="输入群 ID"
          ></input>
        </view>

        <!-- 群类型 -->
        <view class="form-item form-item--clickable" @tap="handleGroupTypeSelect">
          <text class="form-label">群类型</text>
          <view class="form-value">
            <text class="form-text">{{ selectedGroupType.name }}</text>
            <image class="arrow-icon" src="/static/icon/arrow.png" />
          </view>
        </view>

        <!-- 群类型说明 -->
        <view class="group-type-desc">
          <text class="desc-text">{{ selectedGroupType.description }}
          </text>
        </view>

        <!-- 群头像 -->
        <view class="avatar-section">
          <text class="section-title">群头像</text>
          <view class="avatar-grid">
            <view v-for="(avatar, index) in DEFAULT_GROUP_AVATARS" :key="index" class="avatar-wrapper"
              :class="{ 'avatar-wrapper--selected': selectedAvatarIndex == index }" @tap="handleAvatarSelect(index)">
              <view class="avatar-item">
                <image
                  class="avatar-image"
                  :src="avatar"
                  mode="aspectFill"
                  @load="onAvatarLoad(index)"
                  @error="onAvatarError(index)"
                />
                  
                  <view v-if="isAvatarLoading(index)" class="avatar-loading">
                    <view class="loading-placeholder"></view>
                  </view>
              </view>
            </view>
          </view>
        </view>
      </scroll-view>

      <!-- 底部创建按钮 -->
      <view class="footer">
        <view class="create-button" :class="{ 'create-button--disabled': !canCreate }" @tap="handleCreate">
          <text class="create-button__text">创建</text>
        </view>
      </view>
    </view>
  </view>
</template>

<script setup lang="uts">

import { ref, computed, onMounted, onUnmounted } from 'vue'
import { useLoginState } from '../../state/LoginState'
import { useGroupState } from '../../state/GroupState'
import { useMessageInputState } from '../../state/MessageInputState'
import type { SendMessagePayload } from '../../types/message'
import type { GroupCreateParams } from '../../types/group'
import { GROUP_TYPES, DEFAULT_GROUP_AVATARS, type GroupType } from '../../constants/groupTypes'
import { safeJsonParse } from '../../utils/utsUtils'

const { loginUserInfo } = useLoginState()
const { createGroup } = useGroupState()

type Props = {
	selectedUsers?: any[]
}

type Emits = {
	back: void
	create: UTSJSONObject
}

const props = withDefaults(defineProps<Props>(), {
	selectedUsers: (): any[] => []
})

const emit = defineEmits<Emits>()

// 响应式数据
const groupName = ref<string>('')
const groupID = ref<string>('')
const selectedAvatarIndex = ref<number>(0)
const avatarLoadedMap = ref<Map<number, boolean>>(new Map())

// input 引用
const groupNameInput = ref<UniInputElement | null>(null)
const groupIdInput = ref<UniInputElement | null>(null)

// 使用常量中的群类型列表
const groupTypes = GROUP_TYPES
const selectedGroupType = ref<GroupType>(groupTypes[0])

/**
 * 创建中标志：防止重复点击导致并发调用 createGroup 创建出多个同名群组
 *
 * 释放策略（关键）：
 * - 失败路径：立即释放，允许用户重试
 * - 成功路径：**不释放**！跳转链路 sendCustomMessage → navigateBack → navigateTo 是异步的，
 *   navigateBack 动画期间当前页仍可见且 tap 仍能触发，释放就会被重复点击。
 *   只在 onMounted（即用户重新进入本页）时统一重置，确保跳转期间按钮始终 disabled。
 */
const isCreating = ref<boolean>(false)

// 计算属性
const canCreate = computed((): boolean => {
	return groupName.value.trim().length > 0 && !isCreating.value
})

// 页面生命周期 - 监听页面显示
onMounted(() => {
	// 重新进入本页面时重置创建态：处理"成功跳转后又退回本页继续建群"的场景
	// 这是 isCreating 在成功路径下的唯一释放点
	isCreating.value = false
	// 监听群类型选择结果
	uni.$on('groupTypeSelected', (groupType: GroupType): void => {
		selectedGroupType.value = groupType
	})
})

// 组件卸载时移除监听
onUnmounted(() => {
	uni.$off('groupTypeSelected')
})

const onAvatarLoad = (index: number): void => {
	const newMap = new Map(avatarLoadedMap.value)
	newMap.set(index, true)
	avatarLoadedMap.value = newMap
}

/**
 * 模板 helper: 判断头像是否仍在加载
 */
const isAvatarLoading = (index: number): boolean => {
	const v: boolean | null = avatarLoadedMap.value.get(index)
	return v == null || !v
}

/**
 * 头像加载失败
 */
const onAvatarError = (index: number): void => {
	const newMap = new Map(avatarLoadedMap.value)
	newMap.set(index, true)  // 即使失败也隐藏加载状态
	avatarLoadedMap.value = newMap
	console.warn(`群头像 ${index} 加载失败`)
}

/**
 * 让所有 input 失焦
 */
const blurAllInputs = (): void => {
	// 让群名称输入框失焦
	if (groupNameInput.value != null) {
		groupNameInput.value.blur()
	}
	// 让群ID输入框失焦
	if (groupIdInput.value != null) {
		groupIdInput.value.blur()
	}
}

/**
 * 选择群类型 - 跳转到群类型选择页面
 */
const handleGroupTypeSelect = (): void => {
	// 先让所有输入框失焦
	blurAllInputs()

	// 直接跳转
	uni.navigateTo({
		url: '/pages/scenes/chat/groupTypeInfo/groupTypeInfo'
	})
}

/**
 * 选择头像
 */
const handleAvatarSelect = (index: number): void => {
	selectedAvatarIndex.value = index
}

/**
 * 处理群组创建成功后的逻辑
 *
 * 跳转链路：sendCustomMessage（异步）→ navigateBack(delta=2)（异步）→ navigateTo（新会话页）
 *
 * 注意：本函数不释放 isCreating。
 * 跳转过程中本页仍处于栈中，导航动画期间按钮仍可触发 @tap，若释放就会被重复点击。
 * isCreating 由 onMounted 在用户重新进入本页时统一重置。
 */
const handleGroupCreatedSuccess = async (groupIDValue: string): Promise<void> => {
	const conversationID = `group_${groupIDValue}`

	const messageInputState = useMessageInputState({
		conversationID: conversationID
	})

	try {
		// 等待入群提示消息发送完成（含落库），避免 chat 页 loadMessages 拉不到这条消息
		const customPayload: SendMessagePayload = {
			type: 'custom',
			customData: JSON.stringify({
				version: 1,
				businessID: 'group_create',
				opUser: loginUserInfo.value?.userID ?? '',
				content: '创建群聊',
				cmd: 0,
			}),
		}
		await messageInputState?.sendMessage(customPayload, null)
	} catch (e: any) {
		console.error('[CreateGroup] sendMessage(custom) failed:', `${e}`)
	}

	uni.navigateBack({
		delta: 2,
		success: (): void => {
			uni.navigateTo({
				url: `/pages/scenes/chat/chat/index?conversationID=${conversationID}`
			})
		}
	})
}

/**
 * 创建群聊
 */
const handleCreate = async (): Promise<void> => {
	// 防重：isCreating=true 期间任何 tap 直接 return
	// 失败路径会重置；成功路径不重置，由 onMounted 在重新进入本页时重置
	if (!canCreate.value || isCreating.value) {
		return
	}
	isCreating.value = true

	try {
		const storedData = uni.getStorageSync('selectedUserData')
		const memberList = safeJsonParse<string[]>(typeof storedData == 'string' ? storedData : '', [])
		uni.removeStorageSync('selectedUserData')  // 用完即清理，避免污染下一次进入
		const avatarURL = DEFAULT_GROUP_AVATARS[selectedAvatarIndex.value] ?? ''
		const params: GroupCreateParams = {
			groupType: selectedGroupType.value.id,
			groupName: groupName.value,
			groupID: groupID.value,
			avatarURL: avatarURL,
			memberList
		}
		const createdGroupID = await createGroup(params)

		// 检查群组ID是否有效
		if (createdGroupID == null || createdGroupID.length == 0) {
			uni.showToast({
				title: '创建群组失败，请重试',
				icon: 'none'
			})
			// 失败可重试，立即释放
			isCreating.value = false
			return
		}

		// 创建成功：isCreating 不在此处释放，由 onMounted 在重新进入本页时统一重置
		handleGroupCreatedSuccess(createdGroupID)

	} catch (error: any) {
		const errObj: UTSJSONObject = error as UTSJSONObject
		const msgRaw: any | null = errObj['message']
		const errCodeRaw: any | null = errObj['errCode']
		const rawMsg: string = typeof msgRaw == 'string' ? msgRaw as string : ''
		let errMsg: string = rawMsg.length > 0 ? rawMsg : '创建群组失败，请重试'
		// 安全打击词识别：错误码 80001
		// message 形如：'group info secure check fail! beat word: xxx |requestid:...|tcloudapirequestid:...'
		// 提取 'beat word:' 后到 '|' 前的内容作为被打击词展示
		if (errCodeRaw == 80001) {
			const matchResult: RegExpMatchArray | null = rawMsg.match(/beat word:\s*([^|]+?)\s*(\||$)/i)
			const beatGroup: any | null = matchResult != null ? matchResult[1] : null
			const beatWord: string = typeof beatGroup == 'string' ? (beatGroup as string).trim() : ''
			errMsg = beatWord.length > 0
				? `创建群组失败，存在被打击词汇：${beatWord}`
				: '创建群组失败，存在被打击词汇'
		}

		uni.showToast({
			title: errMsg,
			icon: 'none'
		})
		// 失败可重试，释放
		isCreating.value = false
	}
}
</script>

<style>
.create-group {
  flex: 1;
  background-color: #f5f5f5;
}

/* 表单容器 */
.form-container {
  flex: 1;
  flex-direction: column;
}

/* 表单内容 */
.form-content {
  flex: 1;
  padding-bottom: 180rpx;
}

.form-item {
  height: 120rpx;
  background-color: #ffffff;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 32rpx;
  margin-top: 20rpx;
}

.form-item--first {

}

.form-item--connected {
  margin-top: 2rpx;
}

.form-item--clickable {
}

.form-label {
  font-family: PingFang SC;
  font-size: 32rpx;
  color: black;
  font-weight: 400;
  opacity: 0.55;
}

.form-input {
  flex: 1;
  font-size: 32rpx;
  color: #333333;
  text-align: right;
}

.form-value {
  flex: 1;
  flex-direction: row;
  align-items: center;
  justify-content: flex-end;
}

.form-text {
  font-size: 32rpx;
  color: #333333;
  margin-right: 16rpx;
}

.arrow-icon {
  width: 14rpx;
  height: 24rpx;
}

/* 群类型说明 */
.group-type-desc {
  padding: 10rpx 32rpx;
  border-radius: 16rpx;
}

.desc-text {
  font-size: 28rpx;
  color: #666666;
  line-height: 40rpx;
}

.desc-link {
  font-size: 28rpx;
  color: #1C66E5;
}

/* 头像选择 */
.avatar-section {
  margin-top: 20rpx;
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 32rpx;
}

.section-title {
  font-family: PingFang SC;
  font-size: 32rpx;
  color: black;
  font-weight: 400;
  opacity: 0.55;
  margin-bottom: 20rpx;
}

.avatar-grid {
  flex-direction: row;
  flex-wrap: wrap;
  justify-content: space-between;
}

.avatar-wrapper {
  width: 128rpx;
  height: 128rpx;
  margin-bottom: 24rpx;
  border-radius: 20rpx;
  align-items: center;
  justify-content: center;
  background-color: transparent;
}

.avatar-wrapper--selected {
  background-color: #1C66E5;
}

.avatar-item {
  width: 120rpx;
  height: 120rpx;
  border-radius: 16rpx;
  overflow: hidden;
  position: relative;
}

.avatar-image {
  width: 120rpx;
  height: 120rpx;
}

.avatar-loading {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  align-items: center;
  justify-content: center;
  background-color: #f8f9fa;
}

.loading-placeholder {
  width: 60rpx;
  height: 60rpx;
  border-radius: 30rpx;
  background-color: #e9ecef;
}

/* 底部按钮 */
.footer {
  height: 180rpx;
  background-color: #ffffff;
  align-items: center;
  justify-content: center;
  padding: 0 32rpx;
  border-top-width: 1rpx;
  border-top-color: #e5e5e5;
}

.create-button {
  position: absolute;
  top: 32rpx;
  right: 32rpx;
  width: 153rpx;
  height: 60rpx;
  border-radius: 4rpx;
  background-color: #1C66E5;
  align-items: center;
  justify-content: center;
}

.create-button--disabled {
  background-color: #CCE2FF;
}

.create-button__text {
  font-size: 32rpx;
  color: #ffffff;
  font-weight: 500;
}
</style>
