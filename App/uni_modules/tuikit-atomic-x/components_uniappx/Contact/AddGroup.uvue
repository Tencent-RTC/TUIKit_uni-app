<template>
  <view class="add-group" @touchstart="handleTouchStart">
    <!-- 搜索栏 -->
    <view class="add-group__search">
      <!-- 假输入框（初始状态，居中显示） -->
      <view
        v-if="!isInputActive"
        class="add-group__search-wrapper"
        @click="handleActivateInput"
      >
        <image
          class="add-group__search-icon"
          src="../../static/icon/search.png"
          mode="aspectFit"
        />
        <text class="add-group__search-placeholder-text">搜索群ID</text>
      </view>

      <!-- 真输入框（激活状态） -->
      <view
        v-if="isInputActive"
        class="add-group__search-wrapper"
        @touchstart="handleInputAreaTouchStart"
        @touchend="handleInputAreaTouchEnd"
      >
        <image
          class="add-group__search-icon"
          src="../../static/icon/search.png"
          mode="aspectFit"
        />
        <input
          ref="inputRef"
          class="add-group__search-input"
          type="text"
          :value="searchValue"
          :focus="shouldFocus"
          placeholder="搜索群ID"
          placeholder-class="add-group__search-placeholder"
          confirm-type="search"
          @input="handleInput"
          @confirm="handleSearch"
          @focus="handleFocus"
          @blur="handleBlur"
        ></input>
        <view
          v-if="showClear"
          class="add-group__search-clear"
          @click="handleClear"
        >
          <image
            class="add-group__search-clear-icon"
            src="../../static/icon/close.png"
            mode="aspectFit"
          />
        </view>
      </view>
    </view>

    <!-- 搜索结果 -->
    <view v-if="hasSearched" class="add-group__result">
      <!-- 加载中 -->
      <view v-if="isSearching" class="add-group__loading">
        <text class="add-group__loading-text">搜索中...</text>
      </view>

      <!-- 群不存在 -->
      <view v-else-if="showEmpty" class="add-group__empty">
        <text class="add-group__empty-text">该群聊不存在</text>
      </view>

      <!-- 搜索结果列表 -->
      <scroll-view v-else class="add-group__list" scroll-y="true">
        <view
          v-for="group in searchResultList"
          :key="(group as UTSJSONObject)['groupID'] as string"
        >
          <view
            class="add-group__group"
            @click="handleGroupClick(group)"
          >
            <component
              :is="resolvedAvatar"
              :src="(group as UTSJSONObject)['avatarURL'] as string ?? ''"
              :name="(group as UTSJSONObject)['groupName'] as string ?? (group as UTSJSONObject)['groupID'] as string"
              :size="96"
              shape="square"
              defaultAvatarType="group"
              :pureMode="true"
            />
            <view class="add-group__group-info">
              <text class="add-group__group-name">{{ (group as UTSJSONObject)['groupName'] as string ?? (group as UTSJSONObject)['groupID'] as string }}</text>
              <text class="add-group__group-id">ID: {{ (group as UTSJSONObject)['groupID'] as string }}</text>
              <text class="add-group__group-type">群类型: {{ (group as UTSJSONObject)['groupType'] as string }}</text>
            </view>
          </view>
        </view>
      </scroll-view>
    </view>
  </view>
</template>

<script setup lang="uts">

import { ref, computed, nextTick, onUnmounted } from 'vue'
import AvatarComponent from '../Avatar/Avatar.uvue'
import { useGroupState } from '../../state/GroupState'
import { showToast } from '../../utils/toast'

// onShow 生命周期
import { onShow } from '@dcloudio/uni-app'

type Props = {
  Avatar?: any
}

type Emits = {
  groupSelect: any
  search: string
}

const props = withDefaults(defineProps<Props>(), {
})

const resolvedAvatar = computed<any>((): any => props.Avatar ?? AvatarComponent)

const emit = defineEmits<Emits>()

const { getGroupInfo } = useGroupState()

// 搜索值
const searchValue = ref<string>('')
// 是否已搜索
const hasSearched = ref<boolean>(false)
// 是否搜索中
const isSearching = ref<boolean>(false)
// 搜索结果列表
const searchResultList = ref<any[]>([])
// 输入框是否激活（显示真输入框）
const isInputActive = ref<boolean>(false)
// 输入框是否聚焦
const isFocused = ref<boolean>(false)
// 是否正在触摸输入框区域
const isTouchingInput = ref<boolean>(false)
// 动态控制聚焦
const shouldFocus = ref<boolean>(false)
// 输入框 ref
const inputRef = ref<UniInputElement | null>(null)

const showEmpty = computed<boolean>((): boolean => searchResultList.value.length == 0)
const showClear = computed<boolean>((): boolean => searchValue.value.length > 0)

/**
 * 激活输入框
 */
const handleActivateInput = (): void => {
  isInputActive.value = true
  shouldFocus.value = true
  nextTick((): void => {
    setTimeout((): void => {
      inputRef.value?.focus()
    }, 100)
  })
}

/**
 * 处理聚焦
 */
const handleFocus = (): void => {
  isFocused.value = true
}

/**
 * 处理失焦
 */
const handleBlur = (): void => {
  isFocused.value = false
  // 如果没有输入值且没有搜索过，返回初始状态
  if (searchValue.value.length == 0 && !hasSearched.value) {
    isInputActive.value = false
  }
}

/**
 * 处理触摸开始 - 隐藏键盘
 */
const handleTouchStart = (): void => {
  if (!isFocused.value || isTouchingInput.value) return
  uni.hideKeyboard()
}

/**
 * 处理输入框区域触摸开始
 */
const handleInputAreaTouchStart = (): void => {
  isTouchingInput.value = true
}

/**
 * 处理输入框区域触摸结束
 */
const handleInputAreaTouchEnd = (): void => {
  setTimeout((): void => {
    isTouchingInput.value = false
  }, 100)
}

/**
 * 原生 input 事件直接使用 UniInputEvent，避免把 typed event 强转为 UTSJSONObject。
 */
const handleInput = (e: UniInputEvent): void => {
  searchValue.value = e.detail.value
}

/**
 * 清空搜索
 */
const handleClear = (): void => {
  searchValue.value = ''
  hasSearched.value = false
  searchResultList.value = []
}

/**
 * 执行搜索
 */
const handleSearch = async (): Promise<void> => {
  const groupID = searchValue.value.trim()
  if (groupID.length == 0) {
    showToast('请输入群ID')
    return
  }

  uni.hideKeyboard()
  hasSearched.value = true
  isSearching.value = true
  searchResultList.value = []

  emit('search', groupID)

  try {
    const info = await getGroupInfo(groupID)
    searchResultList.value = info != null ? [info] : []
  } catch (error: any) {
    console.error(`[AddGroup] Search failed: ${error}`)
    searchResultList.value = []
  } finally {
    isSearching.value = false
  }
}

/**
 * 点击群组
 */
const handleGroupClick = (group: any): void => {
  uni.hideKeyboard()
  emit('groupSelect', group)
}

let debounceTimer: number | null = null

/**
 * 静默刷新搜索（不显示 loading）
 */
const silentRefreshSearch = async (): Promise<void> => {
  const groupID = searchValue.value.trim()
  if (groupID.length == 0) return

  try {
    const info = await getGroupInfo(groupID)
    searchResultList.value = info != null ? [info] : []
  } catch (error: any) {
    console.error(`[AddGroup] silentRefreshSearch failed: ${error}`)
  }
}

// onShow 时刷新搜索结果（带防抖）
onShow((): void => {
  if (searchValue.value.trim().length > 0 && hasSearched.value) {
    const t: number | null = debounceTimer
    if (t != null) {
      clearTimeout(t)
    }
    debounceTimer = setTimeout((): void => {
      silentRefreshSearch()
    }, 300)
  }
})

// 清理定时器
onUnmounted((): void => {
  const t: number | null = debounceTimer
  if (t != null) {
    clearTimeout(t)
    debounceTimer = null
  }
})
</script>

<style>
.add-group {
  flex: 1;
  background-color: #F5F5F5;
}

/* 搜索栏 */
.add-group__search {
  flex-direction: row;
  align-items: center;
  padding: 20rpx 32rpx;
  background-color: #FFFFFF;
}

.add-group__search-placeholder-text {
  font-size: 28rpx;
  line-height: 46rpx;
  color: #999999;
}

.add-group__search-wrapper {
  flex: 1;
  flex-direction: row;
  align-items: center;
  background-color: #F0F2F7;
  border-radius: 8rpx;
  padding: 16rpx 24rpx;
}

.add-group__search-icon {
  width: 32rpx;
  height: 32rpx;
  margin-right: 12rpx;
}

.add-group__search-input {
  flex: 1;
  font-size: 28rpx;
  line-height: 40rpx;
  color: rgba(0, 0, 0, 0.9);
}

.add-group__search-placeholder {
  color: #999999;
}

.add-group__search-clear {
  padding: 8rpx;
  margin-left: 8rpx;
}

.add-group__search-clear-icon {
  width: 28rpx;
  height: 28rpx;
}

/* 搜索结果区域 */
.add-group__result {
  flex: 1;
}

/* 搜索结果列表 */
.add-group__list {
  flex: 1;
}

/* 加载中 */
.add-group__loading {
  padding: 60rpx;
  align-items: center;
}

.add-group__loading-text {
  font-size: 28rpx;
  color: #999999;
}

/* 群不存在 */
.add-group__empty {
  padding: 60rpx;
  align-items: center;
}

.add-group__empty-text {
  font-size: 28rpx;
  color: #999999;
}

/* 群卡片 */
.add-group__group {
  flex-direction: row;
  padding: 24rpx 32rpx;
  background-color: #FFFFFF;
}

.add-group__group-info {
  flex: 1;
  margin-left: 32rpx;
}

.add-group__group-name {
  font-size: 36rpx;
  line-height: 48rpx;
  color: #000000;
  font-weight: 400;
  lines: 1;
  text-overflow: ellipsis;
}

.add-group__group-id {
  font-size: 26rpx;
  font-weight: 400;
  line-height: 40rpx;
  color: #888888;
  margin-top: 8rpx;
}

.add-group__group-type {
  font-size: 26rpx;
  font-weight: 400;
  line-height: 40rpx;
  color: #888888;
  margin-top: 4rpx;
}
</style>
