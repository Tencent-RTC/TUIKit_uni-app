<template>
  <view class="friend-info">
    <scroll-view class="friend-info__content" scroll-y="true">

      <!-- 删除好友确认弹窗 -->
      <ConfirmDialog v-model="showDeleteDialog" title="确定删除该好友" message="删除联系人同时清空聊天记录" cancelText="取消" confirmText="确定删除" @confirm="confirmDeleteFriend" @cancel="onCancelDelete" />
      <view class="friend-info__header">
        
        <component :is="resolvedAvatar" :src="(currentFriendInfo as UTSJSONObject | null)?.['avatarURL'] ?? ''" :name="((currentFriendInfo as UTSJSONObject | null)?.['nickname'] ?? ((currentFriendInfo as UTSJSONObject | null)?.['userID'] ?? ''))" :size="96" shape="square" defaultAvatarType="user" :pureMode="true" />
        <view class="friend-info__header-info">
          <text class="friend-info__name" :numberOfLines="1">{{ (currentFriendInfo as UTSJSONObject | null)?.['nickname'] ?? ((currentFriendInfo as UTSJSONObject | null)?.['userID'] ?? '') }}</text>
          <text class="friend-info__id" :numberOfLines="1">ID: {{ (currentFriendInfo as UTSJSONObject | null)?.['userID'] ?? '' }}</text>
        </view>
      </view>

      <view v-if="isFriend" class="friend-info__section">
        <view class="friend-info__row" @click="handleRemarkEdit">
          <text class="friend-info__label">备注名</text>
          <view class="friend-info__row-value">
            <text class="friend-info__value" :numberOfLines="1">{{ (currentFriendInfo as UTSJSONObject | null)?.['friendRemark'] ?? '未设置' }}</text>
            <image class="friend-info__arrow" src="../../../static/icon/arrow-right.png" />
          </view>
        </view>
      </view>

      <view class="friend-info__section">
        <view class="friend-info__row">
          <text class="friend-info__label">消息免打扰</text>
          <switch :checked="isMuted" @change="handleMuteChange" color="#1C66E5"></switch>
        </view>
        <view class="friend-info__row">
          <text class="friend-info__label">置顶聊天</text>
          <switch :checked="isPinned" @change="handlePinChange" color="#1C66E5"></switch>
        </view>
      </view>

      <view class="friend-info__section">
        <view class="friend-info__row">
          <text class="friend-info__label">加入黑名单</text>
          <switch :checked="isBlacklisted" @change="handleBlacklistChange" color="#1C66E5"></switch>
        </view>
      </view>

      <view class="friend-info__section">
      <view v-for="action in actionList" :key="action.key" class="friend-info__row friend-info__actions" @click="handleActionClick(action)">
        <text class="friend-info__link" :style="{ color: action.color ?? '#147AFF' }">{{ action.label }}</text>
      </view>
      </view>
    </scroll-view>
  </view>
</template>

<script setup lang="uts">

import { ref, computed, watch, onMounted } from 'vue'
import AvatarComponent from '../../Avatar/Avatar.uvue'
import ConfirmDialog from '../../ConfirmDialog/ConfirmDialog.uvue'
import { useContactState } from '../../../state/ContactState'
import { useConversationListState } from '../../../state/ConversationListState'
import type { ContactInfo as ContactInfoType } from '../../../types/contact'
import { defaultFriendInfoActions, type FriendInfoAction } from '../config'
import { showToast } from '../../../utils/toast'

type Props = {
  friendInfo?: any | null
  Avatar?: any
  /** 自定义操作按钮列表 */
  actions?: FriendInfoAction[]
}

type Emits = {
  sendMessage: string
  remarkEdit: ContactInfoType
  muteChange: boolean
  pinChange: boolean
  blacklistChange: boolean
  deleteFriend: string
}

const props = defineProps<Props>()
// actions 默认空数组在 script 兜底
const effectiveActions = computed<FriendInfoAction[]>(() => props.actions ?? [])

const resolvedAvatar = computed<any>((): any => props.Avatar ?? AvatarComponent)

const emit = defineEmits<Emits>()

const { deleteFriend, addToBlacklist, removeFromBlacklist, getContactInfo, friendList } = useContactState()
const conversationListState = useConversationListState('FriendInfo')
// call 相关模块先按运行时依赖占位（编译期保持引用，便于后续补 .uts）
// import { useCallState, CallErrorCode } from '@/uni_modules/tuikit-atomic-x/state/CallState';
// import { checkCallPermissionWithDialog } from "@/uni_modules/tuikit-atomic-x/utils/callPermission";
// import { useDeviceState } from "@/uni_modules/tuikit-atomic-x/state/DeviceState";
// import { getCurrentPageFullPath, isNavigating, isCallEnding } from "../../../server/callService"
// import { reportScene } from '@/uni_modules/tuikit-atomic-x';

const showDeleteDialog = ref<boolean>(false)
// 呼叫防抖锁，防止频繁点击呼叫按钮
const isCalling = ref<boolean>(false)

const fetchedUserInfo = ref<ContactInfoType | null>(null)

const friendListUserInfo = computed<UTSJSONObject | null>(() => {
  const info = props.friendInfo
  if (info == null) return null
  const infoObj: UTSJSONObject = info as UTSJSONObject
  const targetIDRaw: any | null = infoObj['userID']
  const targetID: string = typeof targetIDRaw == 'string' ? (targetIDRaw as string) : ''
  if (targetID == null || targetID.length == 0) return null
  const rawFound: any | null = friendList.value.find((item: any, _index: number): boolean => {
    const obj = item as UTSJSONObject
    return obj['userID'] == targetID
  }) ?? null
  if (rawFound == null) return null
  return rawFound as UTSJSONObject
})

// 当前好友信息：权重优先级 friendList > fetchPeerUserInfo > props
const currentFriendInfo = computed<UTSJSONObject | null>(() => {
  const list: UTSJSONObject | null = friendListUserInfo.value
  if (list != null) return list
  const fetched: ContactInfoType | null = fetchedUserInfo.value
  if (fetched != null) return fetched as UTSJSONObject
  const prop: any | null = props.friendInfo
  if (prop != null) return prop as UTSJSONObject
  return null
})

const isFriend = computed<boolean>((): boolean => {
  const v = (currentFriendInfo.value as UTSJSONObject | null)?.['isFriend']
  return v == true
})

const isBlacklisted = computed<boolean>((): boolean => {
  const cur = currentFriendInfo.value
  if (cur == null) return false
  const curObj: UTSJSONObject = cur as UTSJSONObject
  const curUserID = (curObj['userID'] as string) ?? ''
  if (curUserID.length == 0) return false
  if (fetchedUserInfo.value != null) {
    const fu: UTSJSONObject = fetchedUserInfo.value as UTSJSONObject
    if ((fu['userID'] as string) == curUserID) {
      return fu['isInBlacklist'] == true
    }
  }
  return curObj['isInBlacklist'] == true
})

const getActionKey = (action: FriendInfoAction): string => {
  return action.key
}

const actionList = computed<FriendInfoAction[]>(() => {
  const actions: FriendInfoAction[] = effectiveActions.value.length > 0
    ? (effectiveActions.value as FriendInfoAction[])
    : defaultFriendInfoActions
  return actions.filter((action: FriendInfoAction): boolean => {
    if (getActionKey(action) == 'deleteFriend') {
      // 仅好友可显示删除好友按钮
      return isFriend.value
    }
    return true
  })
})

const conversationID = computed<string>((): string => {
  const cur: UTSJSONObject | null = currentFriendInfo.value
  if (cur == null) return ''
  const uidRaw: any | null = (cur as UTSJSONObject)['userID']
  const uid: string = typeof uidRaw == 'string' ? (uidRaw as string) : ''
  return uid.length > 0 ? `c2c_${uid}` : ''
})

const currentConversation = ref<any | null>(null)

const RECEIVE_OPT_NOT_NOTIFY = 2
const RECEIVE_OPT_RECEIVE = 0

const isMuted = computed<boolean>((): boolean => {
  const conv = currentConversation.value
  if (conv == null) return false
  const convObj: UTSJSONObject = conv as UTSJSONObject
  const optRaw: any | null = convObj['receiveOption']
  if (optRaw == null) return false
  if (typeof optRaw !== 'number') return false
  return optRaw !== RECEIVE_OPT_RECEIVE
})

const isPinned = computed<boolean>((): boolean => {
  const conv = currentConversation.value
  if (conv == null) return false
  const convObj: UTSJSONObject = conv as UTSJSONObject
  return convObj['isPinned'] == true
})

const fetchPeerUserInfo = async (): Promise<void> => {
  const info = props.friendInfo
  if (info == null) return
  const infoObj: UTSJSONObject = info as UTSJSONObject
  const targetIDRaw: any | null = infoObj['userID']
  const targetID: string = typeof targetIDRaw == 'string' ? (targetIDRaw as string) : ''
  if (targetID.length == 0) return
  try {
    const list = await getContactInfo([targetID])
    console.warn(`[FriendInfo] fetchPeerUserInfo success: ${list}`)
    if (list != null && list.length > 0) {
      fetchedUserInfo.value = list[0] as ContactInfoType | null
    }
  } catch (error: any) {
    console.error(`[FriendInfo] fetchPeerUserInfo failed: ${error}`)
  }
}

const fetchConversationInfo = async (): Promise<void> => {
  const cid: string = conversationID.value
  if (cid.length == 0) return
  try {
    const info = await conversationListState.getConversationInfo(cid)
    if (info != null) {
      currentConversation.value = info
    }
  } catch (error: any) {
    console.error(`[FriendInfo] fetchConversationInfo failed: ${error}`)
  }
}

watch((): string => {
  const info = props.friendInfo
  if (info == null) return ''
  const infoObj: UTSJSONObject = info as UTSJSONObject
  const targetIDRaw: any | null = infoObj['userID']
  return typeof targetIDRaw == 'string' ? (targetIDRaw as string) : ''
}, (): void => {
  const cid: string = conversationID.value
  if (cid.length > 0) {
    fetchPeerUserInfo()
    fetchConversationInfo()
  }
}, { immediate: true })

// 初始化
onMounted((): void => {
  fetchPeerUserInfo()
  fetchConversationInfo()
})

const handleRemarkEdit = (): void => {
  const obj = currentFriendInfo.value
  if (obj == null) return
  const objU: UTSJSONObject = obj as UTSJSONObject
  const uidRaw: any | null = objU['userID']
  const uid: string = typeof uidRaw === 'string' ? (uidRaw as string) : ''
  if (uid.length == 0) return
  const remarkRaw: any | null = objU['friendRemark']
  const rmk: string = typeof remarkRaw === 'string' ? (remarkRaw as string) : ''
  uni.navigateTo({
    url: `/pages/scenes/chat/contacts/setRemark/index?userID=${encodeURIComponent(uid)}&remark=${encodeURIComponent(rmk)}`
  })
}

const handleMuteChange = async (e: UniSwitchChangeEvent): Promise<void> => {
  const value: boolean = e.detail.value == true
  const cid = conversationID.value
  if (cid.length == 0) return

  try {
    const opt: number = value ? RECEIVE_OPT_NOT_NOTIFY : 0
    await conversationListState.setReceiveMessageOpt(cid, opt)
    await fetchConversationInfo()
    emit('muteChange', value)
  } catch (error: any) {
    showToast({ message: error.message ?? '设置失败', type: 'error' })
  }
}

const handlePinChange = async (e: UniSwitchChangeEvent): Promise<void> => {
  const value: boolean = e.detail.value == true
  const cid = conversationID.value
  if (cid.length == 0) return

  try {
    await conversationListState.pinConversation(cid, value)
    await fetchConversationInfo()
    emit('pinChange', value)
  } catch (error: any) {
    showToast({ message: error.message ?? '设置失败', type: 'error' })
  }
}

const handleBlacklistChange = async (e: UniSwitchChangeEvent): Promise<void> => {
  const value: boolean = e.detail.value == true
  const uid = (currentFriendInfo.value as UTSJSONObject | null)?.['userID'] as string
  if (uid == null || uid.length == 0) return
  try {
    if (value) {
      await addToBlacklist(uid)
      showToast({ message: '已加入黑名单', type: 'success' })
    } else {
      await removeFromBlacklist(uid)
      showToast({ message: '已移出黑名单', type: 'success' })
    }
    emit('blacklistChange', value)
  } catch (error: any) {
    showToast({ message: error.message ?? '操作失败', type: 'error' })
  }
  await fetchPeerUserInfo()
}

const handleSendMessage = (): void => {
  const uid = (currentFriendInfo.value as UTSJSONObject | null)?.['userID'] as string
  if (uid != null && uid.length > 0) {
    emit('sendMessage', uid)
  }
}

const handleDeleteFriend = (): void => {
  showDeleteDialog.value = true
}

const startCall = (_mediaType: number): void => {
  console.warn('[FriendInfo] startCall is disabled pending call state modules migration to .uts')
}

/**
 * action.key 是 string（FriendInfoAction.key: string），与字面量比较 OK。
 * switch 字符串字面量 case 合法。
 */
const handleActionClick = (action: FriendInfoAction): void => {
  const uid = (currentFriendInfo.value as UTSJSONObject | null)?.['userID'] as string
  if (uid == null || uid.length == 0) return

  const clickFn: ((userID: string) => void) | null = action.click ?? null
  if (clickFn != null) {
    clickFn(uid)
    return
  }

  const key: string = getActionKey(action)
  switch (key) {
    case 'sendMessage':
      handleSendMessage()
      break
    case 'deleteFriend':
      handleDeleteFriend()
      break
    case 'voiceCall':
      startCall(0)
      break
    case 'videoCall':
      startCall(1)
      break
    default:
      console.log(`Tool clicked: ${key}`)
  }
}

const onCancelDelete = (): void => {
  showDeleteDialog.value = false
}

const confirmDeleteFriend = async (): Promise<void> => {
  const uid = (currentFriendInfo.value as UTSJSONObject | null)?.['userID'] as string
  if (uid == null || uid.length == 0) return
  try {
    await deleteFriend(uid)
    showToast({ message: '已删除', type: 'success' })
    emit('deleteFriend', uid)
  } catch (error: any) {
    showToast({ message: error.message ?? '删除失败', type: 'error' })
  }
}
</script>

<style>
.friend-info {
  flex: 1;
  background-color: #F5F5F5;
}

.friend-info__content {
  flex: 1;
}

.friend-info__header {
  flex-direction: row;
  align-items: flex-start;
  padding: 24rpx 32rpx;
  background-color: #FFFFFF;
}

.friend-info__header-info {
  flex: 1;
  margin-left: 32rpx;
}

.friend-info__name {
  font-size: 36rpx;
  font-weight: 400;
  color: #000000;
  line-height: 48rpx;
  lines: 1;
  text-overflow: ellipsis;
}

.friend-info__id {
  font-size: 26rpx;
  color: #888888;
  line-height: 40rpx;
  margin-top: 8rpx;
  lines: 1;
  text-overflow: ellipsis;
}

.friend-info__signature {
  font-size: 26rpx;
  color: #888888;
  line-height: 40rpx;
  margin-top: 4rpx;
  lines: 2;
  text-overflow: ellipsis;
}

.friend-info__section {
  margin-top: 20rpx;
  background-color: #FFFFFF;
}

.friend-info__row {
  flex-direction: row;
  align-items: center;
  padding: 24rpx 32rpx;
  border-bottom: 1rpx solid #E6E9F0;
}

.friend-info__label {
  flex: 1;
  font-size: 32rpx;
  font-weight: 400;
  line-height: 48rpx;
  color: #444444;
}

.friend-info__row-value {
  flex-direction: row;
  align-items: center;
}

.friend-info__value {
  font-size: 30rpx;
  color: rgba(0, 0, 0, 0.5);
  max-width: 400rpx;
  lines: 1;
  text-overflow: ellipsis;
}

.friend-info__arrow {
  width: 14rpx;
  height: 24rpx;
  margin-left: 22rpx;
}

.friend-info__actions {
  padding: 30rpx 32rpx;
  justify-content: center;
  align-items: center;
}

.friend-info__link {
  font-size: 34rpx;
  line-height: 52rpx;
  font-weight: 400;
  color: #147AFF;
}

.friend-info__danger-actions {
  padding: 30rpx 32rpx;
  align-items: center;
}

.friend-info__danger-link {
  font-size: 34rpx;
  line-height: 52rpx;
  font-weight: 400;
  color: #FF584C;
}
</style>
