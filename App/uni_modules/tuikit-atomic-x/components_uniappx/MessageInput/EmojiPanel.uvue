<template>
  <view class="emoji-panel">
    <view class="emoji-list">
      <view
        v-for="(row, rowIndex) in chunkedEmojiList"
        :key="rowIndex"
        class="emoji-cell"
      >
        <view class="emoji-row">
          <view
            v-for="(emoji, colIndex) in row"
            :key="colIndex"
            class="emoji-item"
            @click="handleEmojiTap(emoji)"
          >
            <text class="emoji-text">{{ emoji }}</text>
          </view>
        </view>
      </view>

      <view style="height: 40rpx;"></view>
    </view>
  </view>
</template>

<script setup lang="uts">

import { computed } from 'vue'

type Emits = {
	select: any
}

const emit = defineEmits<Emits>()

const COLUMNS = 8

const DEFAULT_EMOJIS: string[] = [
	'😀', '😃', '😄', '😁', '😆', '😅', '🤣', '😂',
	'🙂', '🙃', '😉', '😊', '😇', '🥰', '😍', '🤩',
	'😘', '😗', '☺️', '😚', '😙', '😋', '😛',
	'😜', '🤪', '😝', '🤑', '🤗', '🤭', '🤫', '🤔',
	'🤐', '🤨', '😐', '😑', '😶', '😏', '😒', '🙄',
	'😬', '🤥', '😌', '😔', '😪', '🤤', '😴', '😷',
	'🤒', '🤕', '🤢', '🤮', '🤧', '🥵', '🥶', '🥴',
	'😵', '🤯', '🤠', '🥳', '😠', '😎', '🤓', '🧐',
	'😕', '😟', '🙁', '☹️', '😮', '😯', '😲', '😳',
	'🥺', '😦', '😧', '😨', '😰', '😥', '😢', '😭',
	'😱', '😖', '😣', '😞', '😓', '😩', '😫', '🥱',
	'😤', '😡', '🤬', '😈', '👿', '💀', '☠️',
	'🤡', '👹', '👺', '👻', '👽', '👾', '🤖',
	'😺', '😸', '😹', '😻', '😼', '😽', '🙀', '😿',
	'😾', '🙈', '🙉', '🙊', '💋', '💌', '💘', '💝',
	'💖', '💗', '💓', '💞', '💕', '💟', '❣️', '💔',
]

/**
 * 标准化数据格式
 *
 */
const normalizedList = computed((): string[] => {
	return DEFAULT_EMOJIS
})

/**
 * 将一维数组切片成二维数组
 */
const chunkedEmojiList = computed((): string[][] => {
	const result: string[][] = []
	const list: string[] = normalizedList.value
	const len: number = list.length

	for (let i = 0; i < len; i += COLUMNS) {
		result.push(list.slice(i, i + COLUMNS))
	}
	return result
})

const handleEmojiTap = (emoji: string): void => {
	emit('select', { key: emoji })
}
</script>

<style scoped>
.emoji-panel {
  flex: 1;
  background-color: #fff;
  padding-top: 23rpx;
  padding-bottom: 23rpx;
  transform: translateY(0);
}

.emoji-list {
  flex: 1;
}

.emoji-cell {
  background-color: #fff;
}

.emoji-row {
  flex-direction: row;
  padding-left: 48rpx;
  padding-right: 48rpx;
  height: 104rpx;
  align-items: center;
  justify-content: space-around;
}

.emoji-item {
  width: 60rpx;
  height: 60rpx;
  margin-right: 8rpx;
  justify-content: center;
  align-items: center;
  border-radius: 8rpx;
}

.emoji-item:active {
  background-color: #e0e0e0;
}

.emoji-text {
  font-size: 52rpx;
  font-family: sans-serif;
}
</style>
