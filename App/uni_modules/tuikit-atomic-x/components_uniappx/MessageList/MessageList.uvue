  border-radius: 40rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.1);
  align-items: center;
  justify-content: center;
  flex-direction: column;
}

.msg-list__scroll-btn-icon {
  width: 40rpx;
  height: 40rpx;
  margin-bottom: 4rpx;
}

.msg-list__scroll-btn-text {
  font-size: 20rpx;
