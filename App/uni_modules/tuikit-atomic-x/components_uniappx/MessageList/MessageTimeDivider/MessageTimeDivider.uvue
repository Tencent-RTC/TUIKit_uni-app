<template>
  <view class="msg-time-divider">
    <view class="msg-time-divider__content">
      <text class="msg-time-divider__text">{{ formattedTime }}</text>
    </view>
  </view>
</template>

<script setup lang="uts">
/**
 * MessageTimeDivider - 消息时间分隔符（uvue 版）
 */
import { computed } from 'vue'
import { formatTime } from '../../../utils/timeUtils.uts'

type Props = {
	timestamp: number
}

const props = defineProps<Props>()

const formattedTime = computed((): string => {
	return formatTime(props.timestamp, true)
})
</script>

<style>
.msg-time-divider {
  flex-direction: row;
  justify-content: center;
  align-items: center;
  padding: 10rpx 0;
  margin: 20rpx 0;
}

.msg-time-divider__content {
  margin: 0 20rpx;
}

.msg-time-divider__text {
  font-size: 24rpx;
  color: #999;
  line-height: 1.2;
  padding: 8rpx 16rpx;
  border-radius: 16rpx;
}
</style>
