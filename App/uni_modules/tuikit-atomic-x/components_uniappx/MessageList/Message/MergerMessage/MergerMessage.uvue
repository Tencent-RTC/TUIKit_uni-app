<template>
  <view
    class="merger-message"
    :class="'merger-message-' + (isSelf ? 'out' : 'in')"
    @tap="handleTap"
  >
    <view class="merger-highlight">
      <view class="merger-container">
        <text class="merger-title">{{ mergerTitle }}</text>
        
        <view class="merger-abstract-list">
          <view 
            v-for="(item, index) in abstractList" 
            :key="index"
            class="merger-abstract-item"
          >
            <text class="abstract-content">{{ item }}</text>
          </view>
        </view>
        
        <text class="merger-label">聊天记录</text>
      </view>
    </view>
  </view>
</template>

<script setup lang="uts">
import { computed } from 'vue'

type Props = {
  message: any | null}

const props = defineProps<Props>()

const emit = defineEmits<{
  tap: [message: UTSJSONObject]
}>()

const mergedMessage = computed((): any | null => {
  const messageObj: UTSJSONObject = props.message as UTSJSONObject
  return messageObj['messagePayload']
})

const isSelf = computed((): boolean => {
  const messageObj: UTSJSONObject = props.message as UTSJSONObject
  const v: any | null = messageObj['isSentBySelf']
  return v == true
})

const mergerTitle = computed((): string => {
  const v: any | null = mergedMessage.value
  if (v == null) return '聊天记录'
  const vObj: UTSJSONObject = v as UTSJSONObject
  const t: any | null = vObj['title']
  return typeof t == 'string' && (t as string).length > 0 ? (t as string) : '聊天记录'
})

const abstractList = computed((): string[] => {
  const v: any | null = mergedMessage.value
  if (v == null) return []
  const vObj: UTSJSONObject = v as UTSJSONObject
  const arr: any | null = vObj['abstractList']
  if (!Array.isArray(arr)) return []
  const result: string[] = []
  const max = Math.min(arr.length, 4)
  for (let i = 0; i < max; i++) {
    const item: any | null = arr[i]
    if (typeof item == 'string') result.push(item as string)
  }
  return result
})

const handleTap = () => {
  emit('tap', props.message)
}
</script>

<style scoped>
.merger-message {
  flex-direction: row;
}

.merger-message-in {
  justify-content: flex-start;
}

.merger-message-out {
  justify-content: flex-end;
}

.merger-highlight {
  background-color: transparent;
  border-radius: 20rpx;
}

.merger-container {
  max-width: 500rpx;
  background-color: #FFFFFF;
  border-radius: 20rpx;
  padding: 20rpx 24rpx;
  flex-direction: column;
}

.merger-title {
  font-size: 32rpx;
  line-height: 42rpx;
  font-weight: 400;
  color: rgba(0, 0, 0, 0.9);
  margin-bottom: 10rpx;
}

.merger-abstract-list {
  flex-direction: column;
  margin-bottom: 18rpx;
}

.merger-abstract-item {
  flex-direction: row;
  margin-bottom: 8rpx;
}

.merger-abstract-item:last-child {
  margin-bottom: 0;
}

.abstract-sender {
  font-weight: 400;
  font-size: 24rpx;
  line-height: 36rpx;
  color: rgba(0, 0, 0, 0.4);
  flex-shrink: 0;
}

.abstract-content {
  font-weight: 400;
  font-size: 24rpx;
  line-height: 36rpx;
  color: rgba(0, 0, 0, 0.4);
  flex: 1;
  lines: 1;
  text-overflow: ellipsis;
}

.merger-label {
  font-weight: 400;
  font-size: 18rpx;
  line-height: 28rpx;
  color: rgba(0, 0, 0, 0.4);
  border-top: 1rpx solid #E6E9F0;
  padding-top: 12rpx;
}
</style>
