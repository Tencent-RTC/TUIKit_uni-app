<template>
	<view class="custom-message" :class="{ 'custom-message--center': isCustomCenter, 'custom-message--plain': plain == true }">
		<CallMessage v-if="isCallMsg" :message="message" :isGroupCall="isCustomCenter" />
		<view v-else class="custom-highlight">
			<view class="default-custom">
				<text class="custom-text">{{ customText }}</text>
			</view>
		</view>
	</view>
</template>

<script setup lang="uts">
	import { computed } from 'vue'
	import {
		isCallMessage,
		isGroupCallMessage,
		parseCustomDataObject,
		getCustomMessageDescription
	} from '../../../../utils/callMessageUtils'
	import CallMessage from './CallMessage.uvue'

	type Props = {
		message: any | null
		conversationID?: string
		// 无气泡模式（合并转发详情）：去掉半透明白底与圆角
		plain?: boolean
	}
	const props = withDefaults(defineProps<Props>(), {
		conversationID: '',
		plain: false
	})

	// 是否通话消息（customData.businessID === 1）
	const isCallMsg = computed((): boolean => isCallMessage(props.message))

	// 是否需要居中显示（群聊内的通话消息）
	const isCustomCenter = computed((): boolean => isGroupCallMessage(props.message, props.conversationID ?? ''))

	const customText = computed((): string => {
		// 1. 业务侧 customData.content（如 group_create 的"创建群聊"）
		const customData: UTSJSONObject | null = parseCustomDataObject(props.message)
		if (customData != null) {
			const content: any | null = customData['content']
			if (typeof content == 'string' && (content as string).length > 0) return content as string
			if (typeof content == 'number') return `${content}`
		}
		// 2. payload.description 兜底
		const description: string = getCustomMessageDescription(props.message)
		if (description.length > 0) return description
		return '自定义消息'
	})
</script>
