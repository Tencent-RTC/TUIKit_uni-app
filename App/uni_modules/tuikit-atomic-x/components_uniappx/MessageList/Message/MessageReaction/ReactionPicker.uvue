<template>
  <view class="rp">
    <view class="rp__header">
      <text class="rp__title">贴表情</text>
      <view class="rp__collapse" @tap="handleCollapseTap">
        <image class="rp__collapse-icon" :src="collapseIcon" mode="aspectFit" />
      </view>
    </view>
    <view v-for="(row, rowIndex) in panelRows" :key="rowIndex" class="rp__grid">
      <view class="rp__row">
        <view v-for="(cell, cellIndex) in row" :key="cellIndex" class="rp__cell">
          <image
            v-if="cell.src.length > 0"
            class="rp__emoji"
            :src="cell.src"
            mode="aspectFit"
            @tap="handleEmojiTap(cell.key)"
          />
          <view v-else-if="cell.isMore" class="rp__more" @tap="handleMoreTap">
            <image class="rp__more-icon" :src="moreIcon" mode="aspectFit" />
          </view>
        </view>
      </view>
      <view v-if="rowIndex < panelRows.length - 1" class="rp__divider"></view>
    </view>
  </view>
</template>

<script setup lang="uts">
import { computed } from 'vue'
import collapseIcon from '../../../../static/assets/message-list/msg_reaction_collapse.png'
import moreIcon from '../../../../static/assets/message-list/msg_more.png'
import { listQuickReactionEmojis, type ReactionEmoji } from '../../../../utils/reactionEmoji'
import { getReactionList, toggleMessageReaction } from '../../../../utils/messageReaction'

// 与 native LongPressEmojiPanelBuilder / MessageReactionPanelPolicy 一致：6 列 2 行，末格为「更多」入口
const PANEL_COLUMNS = 6
const PANEL_ROWS = 2
const QUICK_MAX = PANEL_COLUMNS * PANEL_ROWS - 1

type Props = {
  message: any | null
}

type PanelCell = {
  key: string
  src: string
  isMore: boolean
}

const props = defineProps<Props>()

const emit = defineEmits<{
  collapse: []
  showAll: []
  close: []
}>()

const panelRows = computed((): PanelCell[][] => {
  const reactedIDs: string[] = []
  // 快捷列表把「我已回应」的表情排最前
  const briefs = getReactionList(props.message)
  briefs.forEach((item) => {
    if (item.reactedByMyself && item.reactionID.length > 0) {
      reactedIDs.push(item.reactionID)
    }
  })
  const quickEmojis: ReactionEmoji[] = listQuickReactionEmojis(QUICK_MAX, reactedIDs)
  const cells: PanelCell[] = []
  quickEmojis.forEach((emoji: ReactionEmoji) => {
    cells.push({ key: emoji.key, src: emoji.src, isMore: false } as PanelCell)
  })
  while (cells.length < QUICK_MAX) {
    cells.push({ key: '', src: '', isMore: false } as PanelCell)
  }
  cells.push({ key: '', src: '', isMore: true } as PanelCell)
  const rows: PanelCell[][] = []
  for (let r: number = 0; r < PANEL_ROWS; r++) {
    rows.push(cells.slice(r * PANEL_COLUMNS, (r + 1) * PANEL_COLUMNS))
  }
  return rows
})

// 回应的执行与失败提示统一在 utils/messageReaction；store 由 MessageActions 持有，故 keepStore=true。
const handleEmojiTap = (reactionID: string): void => {
  ;(async (): Promise<void> => {
    await toggleMessageReaction(props.message, reactionID, true)
    emit('close')
  })()
}

const handleCollapseTap = (): void => {
  emit('collapse')
}

const handleMoreTap = (): void => {
  emit('showAll')
}
</script>

<style>
.rp {
  flex-direction: column;
  width: 456rpx;
  margin: 0 12rpx;
}

.rp__header {
  flex-direction: row;
  align-items: center;
  height: 28rpx;
  margin: 12rpx 24rpx 16rpx;
}

.rp__title {
  flex: 1;
  font-size: 20rpx;
  color: rgba(0, 0, 0, 0.9);
}

.rp__collapse {
  width: 28rpx;
  height: 28rpx;
  align-items: center;
  justify-content: center;
}

.rp__collapse:active {
  opacity: 0.6;
}

.rp__collapse-icon {
  width: 28rpx;
  height: 28rpx;
}

.rp__grid {
  flex-direction: column;
  padding: 0 24rpx;
}

.rp__row {
  flex-direction: row;
}

.rp__cell {
  width: 68rpx;
  height: 68rpx;
  align-items: center;
  justify-content: center;
}

.rp__cell:active {
  opacity: 0.6;
}

.rp__emoji {
  width: 48rpx;
  height: 48rpx;
  padding: 10rpx;
}

.rp__more {
  width: 48rpx;
  height: 48rpx;
  border-radius: 24rpx;
  background-color: #F0F2F7;
  align-items: center;
  justify-content: center;
}

.rp__more-icon {
  width: 32rpx;
  height: 32rpx;
}

.rp__divider {
  height: 2rpx;
  margin: 6rpx 0;
  background-color: rgba(0, 0, 0, 0.08);
}
</style>
