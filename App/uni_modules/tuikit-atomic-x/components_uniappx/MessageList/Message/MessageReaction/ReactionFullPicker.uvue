<template>
  <Drawer :visible="visible" @close="handleClose">
    <scroll-view class="rfp__list" :style="listStyle" direction="vertical" :show-scrollbar="false">
      <view v-for="(item, itemIndex) in gridItems" :key="itemIndex">
        <view v-if="item.title.length > 0" class="rfp__header">
          <text class="rfp__header-text">{{ item.title }}</text>
        </view>
        <view v-else class="rfp__row">
          <view
            v-for="emoji in item.emojis"
            :key="emoji.key"
            class="rfp__cell"
            @tap.stop="handleEmojiTap(emoji.key)"
          >
            <image class="rfp__emoji" :src="emoji.src" mode="aspectFit" />
          </view>
        </view>
      </view>
    </scroll-view>
  </Drawer>
</template>

<script setup lang="uts">
import { computed, ref, watch } from 'vue'
import Drawer from '../../../Drawer/index.uvue'
import {
  listAllReactionEmojis,
  listRecentReactionEmojis,
  type ReactionEmoji
} from '../../../../utils/reactionEmoji'
import { toggleMessageReaction } from '../../../../utils/messageReaction'

// 与 native ReactionEmojiPickerDialog 一致：8 列网格，「最近使用」+「全部」两个分组
const GRID_COLUMNS = 8

type Props = {
  visible: boolean
  message: any | null
}

type GridItem = {
  title: string
  emojis: ReactionEmoji[]
}

const props = defineProps<Props>()

const emit = defineEmits<{
  close: []
}>()

// 面板高度 = 屏高 60%，限制在 800-1040rpx（native 400-520dp）
const listStyle = computed((): UTSJSONObject => {
  const style: UTSJSONObject = new UTSJSONObject()
  const si = uni.getSystemInfoSync()
  const sw: number = si.windowWidth > 0 ? si.windowWidth : 375
  const sh: number = si.windowHeight > 0 ? si.windowHeight : 667
  const heightRpx: number = sh / sw * 750
  const h: number = Math.min(Math.max(heightRpx * 0.6, 800), 1040)
  style['height'] = `${Math.round(h)}rpx`
  return style
})

// 「最近使用」每次打开弹层时重新获取（listRecentReactionEmojis 非响应式，computed 会缓存旧值）
const gridItems = ref<GridItem[]>([])

const refreshGridItems = (): void => {
  const items: GridItem[] = []
  const appendSection = (title: string, emojis: ReactionEmoji[]): void => {
    if (emojis.length == 0) return
    items.push({ title: title, emojis: [] as ReactionEmoji[] } as GridItem)
    for (let i: number = 0; i < emojis.length; i += GRID_COLUMNS) {
      const end: number = Math.min(i + GRID_COLUMNS, emojis.length)
      items.push({ title: '', emojis: emojis.slice(i, end) } as GridItem)
    }
  }
  appendSection('最近使用', listRecentReactionEmojis())
  appendSection('全部', listAllReactionEmojis())
  gridItems.value = items
}

watch((): boolean => props.visible, (v: boolean): void => {
  if (v) refreshGridItems()
}, { immediate: true })

const handleClose = (): void => {
  emit('close')
}

const handleEmojiTap = (reactionID: string): void => {
  ;(async (): Promise<void> => {
    await toggleMessageReaction(props.message, reactionID, false)
    handleClose()
  })()
}
</script>

<style>
.rfp__list {
  padding: 0 32rpx;
}

.rfp__header {
  padding: 16rpx 0;
}

.rfp__header-text {
  font-size: 24rpx;
  color: rgba(0, 0, 0, 0.55);
}

.rfp__row {
  flex-direction: row;
}

.rfp__cell {
  width: 85rpx;
  height: 88rpx;
  align-items: center;
  justify-content: center;
}

.rfp__cell:active {
  opacity: 0.6;
}

.rfp__emoji {
  width: 64rpx;
  height: 64rpx;
}
</style>
