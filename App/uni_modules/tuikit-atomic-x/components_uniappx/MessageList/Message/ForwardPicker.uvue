<template>
  <view class="fwd-picker">
    <CustomNavbar
      title="选择"
      :showBack="false"
      :showMenu="true"
      :showShadow="false"
      @back="handleClose"
      @menuSelect="noop"
    >
      <template #left>
        <view class="fwd-picker__cancel" @tap.stop="handleClose">
          <text class="fwd-picker__cancel-text">取消</text>
        </view>
      </template>
      <template #right>
        <view class="fwd-picker__nav-right" @tap.stop="noop"></view>
      </template>
    </CustomNavbar>

    <view class="fwd-picker__search">
      <view class="fwd-picker__search-wrapper">
        <view class="fwd-picker__search-inner" :class="keyword.length > 0 ? 'fwd-picker__search-inner--left' : ''">
          <image class="fwd-picker__search-icon" src="/uni_modules/tuikit-atomic-x/static/icon/search.png" mode="aspectFit" />
          <input
            class="fwd-picker__search-input"
            type="text"
            :value="keyword"
            placeholder="搜索"
            placeholder-class="fwd-picker__search-placeholder"
            @input="handleSearchInput"
          />
        </view>
      </view>
    </view>

    <scroll-view
      class="fwd-picker__list"
      :scroll-y="true"
      :show-scrollbar="false"
    >
      <view class="fwd-picker__section">
        <text class="fwd-picker__section-title">最近聊天</text>
      </view>

      <view v-if="targetList.length == 0" class="fwd-picker__empty">
        <text class="fwd-picker__empty-text">{{ keyword.length > 0 ? '没有匹配的聊天' : '暂无可转发的会话' }}</text>
      </view>

      <view
        v-for="(item, index) in targetList"
        :key="item.conversationID"
        class="fwd-picker__item"
        @tap.stop="handleSelect(item)"
      >
        <Avatar
          :src="item.avatarURL"
          :name="item.title"
          :size="80"
          :defaultAvatarType="item.defaultAvatarType"
          class="fwd-picker__avatar"
        />
        <view class="fwd-picker__info">
          <text class="fwd-picker__name" :lines="1">{{ item.title }}</text>
        </view>
      </view>

      <!-- 底部留白，避免最后一项贴边 -->
      <view class="fwd-picker__list-footer" />
    </scroll-view>
  </view>
</template>

<script setup lang="uts">
import { ref, computed, onMounted } from 'vue'
import Avatar from '../../Avatar/Avatar.uvue'
import CustomNavbar from '../../CustomNavbar/CustomNavbar.uvue'
import { useConversationListState } from '../../../state/ConversationListState'

// 会话对象来自原生，type 是原始 Number，与 enum 实例比较恒不相等 → 用数值
// （ConversationType: C2C = 1 / GROUP = 2）
const CONVERSATION_TYPE_GROUP = 2

type Props = {
  excludeConversationID?: string
}

const props = withDefaults(defineProps<Props>(), {
  excludeConversationID: ''
})

const emit = defineEmits<{
  select: [conversationID: string]
  close: []
}>()

/** 转发目标（组件内部视图模型，避免模板里直接读 UTSJSONObject） */
type ForwardTarget = {
  conversationID: string
  title: string
  avatarURL: string
  defaultAvatarType: string
}

const conversationListState = useConversationListState('ForwardPicker')

onMounted(() => {
  const list: any[] = conversationListState.conversationList.value
  if (list.length == 0) {
    conversationListState.loadConversations(JSON.stringify({ count: 100 })).catch((e: any | null): void => {
      console.warn('[ForwardPicker] loadConversations failed:', `${e}`)
    })
  }
})

const keyword = ref('')

function objString(obj: any | null, key: string, fallback: string): string {
  if (obj == null) return fallback
  const o: UTSJSONObject = obj as UTSJSONObject
  const v: any | null = o[key]
  return typeof v == 'string' ? (v as string) : fallback
}

const targetList = computed((): ForwardTarget[] => {
  const list: any[] = conversationListState.conversationList.value
  const result: ForwardTarget[] = []
  const kw: string = keyword.value.trim().toLowerCase()

  list.forEach((conv: any) => {
    if (conv == null) return
    const convObj: UTSJSONObject = conv as UTSJSONObject
    const conversationID: string = objString(convObj, 'conversationID', '')
    if (conversationID.length == 0) return
    if (props.excludeConversationID.length > 0 && conversationID == props.excludeConversationID) return

    const typeRaw: any | null = convObj['type']
    const isGroup: boolean = typeRaw == CONVERSATION_TYPE_GROUP || conversationID.startsWith('group_')
    const fallbackID: string = isGroup
      ? conversationID.replace('group_', '')
      : conversationID.replace('c2c_', '')
    const rawTitle: string = objString(convObj, 'title', '')
    const title: string = rawTitle.length > 0 ? rawTitle : fallbackID

    if (kw.length > 0 && title.toLowerCase().indexOf(kw) == -1) return

    const groupType: string = objString(convObj, 'groupType', '')
    result.push({
      conversationID: conversationID,
      title: title,
      avatarURL: objString(convObj, 'avatarURL', ''),
      defaultAvatarType: isGroup ? (groupType.length > 0 ? groupType : 'work') : 'user'
    } as ForwardTarget)
  })

  return result
})

const handleSearchInput = (e: UniInputEvent): void => {
  keyword.value = e.detail.value
}

const handleSelect = (item: ForwardTarget): void => {
  emit('select', item.conversationID)
}

const handleClose = (): void => {
  emit('close')
}

const noop = (): void => {}
</script>

<style>
.fwd-picker {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: #ffffff;
  flex-direction: column;
  z-index: 9990;
}

.fwd-picker__cancel {
  padding-left: 0;
  justify-content: flex-start;
}

.fwd-picker__cancel-text {
  font-size: 32rpx;
  color: rgba(0, 0, 0, 0.9);
}

.fwd-picker__nav-right {
  width: 100rpx;
  height: 88rpx;
}

.fwd-picker__search {
  padding: 8rpx 32rpx 24rpx;
}

.fwd-picker__search-wrapper {
  background-color: #F0F2F7;
  border-radius: 8rpx;
  padding: 16rpx 24rpx;
}

.fwd-picker__search-inner {
  flex-direction: row;
  align-items: center;
  justify-content: center;
}

.fwd-picker__search-inner--left {
  justify-content: flex-start;
}

.fwd-picker__search-icon {
  width: 32rpx;
  height: 32rpx;
  margin-right: 8rpx;
  opacity: 0.4;
}

.fwd-picker__search-input {
  font-size: 28rpx;
  line-height: 40rpx;
  color: rgba(0, 0, 0, 0.9);
  width: 500rpx;
}

.fwd-picker__search-placeholder {
  font-size: 28rpx;
  color: rgba(0, 0, 0, 0.4);
}

.fwd-picker__list {
  flex: 1;
}

.fwd-picker__section {
  background-color: #F5F7FA;
  padding: 10rpx 32rpx;
}

.fwd-picker__section-title {
  font-size: 24rpx;
  line-height: 34rpx;
  color: rgba(0, 0, 0, 0.4);
}

.fwd-picker__item {
  flex-direction: row;
  align-items: center;
  padding: 20rpx 32rpx;
  border-bottom-width: 1rpx;
  border-bottom-style: solid;
  border-bottom-color: #F0F2F7;
}

.fwd-picker__avatar {
  margin-right: 24rpx;
}

.fwd-picker__info {
  flex: 1;
  flex-direction: column;
  justify-content: center;
}

.fwd-picker__name {
  font-size: 32rpx;
  line-height: 44rpx;
  color: rgba(0, 0, 0, 0.9);
  text-overflow: ellipsis;
}

.fwd-picker__empty {
  align-items: center;
  justify-content: center;
  padding: 80rpx 0;
}

.fwd-picker__empty-text {
  font-size: 28rpx;
  color: rgba(0, 0, 0, 0.4);
}

.fwd-picker__list-footer {
  height: 40rpx;
}
</style>
