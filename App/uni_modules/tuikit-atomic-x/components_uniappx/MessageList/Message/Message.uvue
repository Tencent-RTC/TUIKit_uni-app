<template>
  <view v-if="isCenterMessage" class="msg msg--center" @tap.stop="handleMessageContentTap">
    <RecalledMessage v-if="isRevokedMessage" :message="message" :conversationID="conversationID" />
    <GroupTipMessage v-else-if="isSystemMessage || isGroupCreateMessage" :message="message" />
    <component v-else-if="isCustomCenterMessage" :is="centerCustomComponent" :message="message" :conversationID="conversationID" />
  </view>
    <view v-else class="msg msg--no-select" :class="messageClasses" :data-message-id="messageMsgID" @touchstart="handleTouchStart" @touchend="handleTouchEnd" @tap.stop="handleTap" @touchmove="handleTouchMove">
    <Avatar v-if="showAvatar" :src="fromAvatarURL" :name="displayName" :size="80" defaultAvatarType="user" lazy class="msg__avatar" />
    <view class="msg__main msg__main--no-select" :class="'msg__main--'+ (isSelf ? 'out' : 'in')">
      <view v-if="showNickname" class="msg__nickname">
        <text class="msg__nickname-text msg__text--no-select">{{ displayName }}</text>
      </view>

      <view class="msg__bubble msg__bubble--no-select" :class="bubbleClasses" @longpress="handleLongPress" @tap.stop="handleMessageContentTap" @touchstart.stop="handleBubbleTouchStart">
        <component ref="messageContentRef" :is="currentMessageComponent" :message="message" :conversationID="conversationID" :id="messageMsgID" />
        <view ref="flashOverlayRef" class="msg__flash-overlay" :class="bubbleClasses" />
        <view v-if="showStatus" :class="['msg__status', 'msg__status--'+ (isSelf ? 'out' : 'in')]">
          <image v-if="isSendingMessage" ref="loadingIconRef" src="../../../static/icon/loading.png" class="msg__status-icon" mode="aspectFill" />
          <image v-else-if="isSendFailMessage" src="../../../static/icon/error.png" class="msg__status-icon" mode="aspectFill" @tap="handleResend" />
        </view>
        <view v-if="showReadStatus" class="msg__read-status">
          <text class="msg__read-text msg__text--no-select">{{ readStatusText }}</text>
        </view>
      </view>
      <view v-if="showTime" class="msg__time" @tap.stop="handleMessageContentTap" style="background-color: black;">
        <text class="msg__time-text msg__text--no-select">{{ formatMessageTime(messageTimestamp) }}</text>
      </view>
    </view>
    <MessageActions v-if="showActions" :message="message" :actions="messageActionList" :triggerPosition="longPressPosition" @close="handleActionsClose" />
  </view>
</template>

<script setup lang="uts">
  import { computed, ref, nextTick, getCurrentInstance, watch, onMounted, onUnmounted } from 'vue'
  import Avatar from '../../Avatar/Avatar.uvue'
  import RecalledMessage from './RecalledMessage/RecalledMessage.uvue'
  import GroupTipMessage from './GroupTipMessage/GroupTipMessage.uvue'
  import TextMessage from './TextMessage/TextMessage.uvue'
  import ImageMessage from './ImageMessage/ImageMessage.uvue'
  import VideoMessage from './VideoMessage/VideoMessage.uvue'
  import AudioMessage from './AudioMessage/AudioMessage.uvue'
  import FileMessage from './FileMessage/FileMessage.uvue'
  import FaceMessage from './FaceMessage/FaceMessage.uvue'
  import CustomMessage from './CustomMessage/CustomMessage.uvue'
  import MergerMessage from './MergerMessage/MergerMessage.uvue'
  import MessageActions from './MessageActions.uvue'
  import { formatTime } from '../../../utils/timeUtils'
  import { isGroupCallMessage, isCallMessage, isVideoCall, parseCallMessageData } from '../../../utils/callMessageUtils'
  import {
    useCallState,
    CallErrorCode
  } from '@/uni_modules/tuikit-atomic-x/state/CallState';
  import {
    useDeviceState
  } from "@/uni_modules/tuikit-atomic-x/state/DeviceState";
  import { getCurrentPageFullPath, isNavigating, isCallEnding } from "../../../server/callService"
  import { checkCallPermissionWithDialog } from "@/uni_modules/tuikit-atomic-x/utils/callPermission"
  import { setCallSource, setCallLastPage } from '@/uni_modules/tuikit-atomic-x/utils/callContextStore.uts'
  import { useLoginState } from '@/uni_modules/tuikit-atomic-x/state/LoginState'

  type AnimationStub = {
    transition: (el: any, options: any, callback: (() => void) | null) => void
  }
  const animation: AnimationStub = {
    transition: (_el: any, _options: any, _callback: (() => void) | null): void => {
    }
  }

type Props = {
  message: any
  conversationID: string
  showAvatar?: boolean
  showNickname?: boolean
  showTime?: boolean
  messageActionList?: any[]
  highlight?: number
  customCenterChecker?: (message: any, conversationID: string) => boolean
  customMessageRender?: any
  inputPanelHeight?: number
  inputToolbarHeight?: number
}

  type AnyReadableObject = {
    getAny: (key: string) => any | null
  }

  type StringReadableObject = {
    getString: (key: string) => string | null
  }

const props = withDefaults(defineProps<Props>(), {
  conversationID: '',
  showAvatar: true,
  showNickname: true,
  showTime: false,
  messageActionList: () => [],
  highlight: 0,
  customCenterChecker: null,
  customMessageRender: null,
  inputPanelHeight: 0,
  inputToolbarHeight: 0
})

  function getObjectAny(obj: any | null, key: string): any | null {
    if (obj == null) return null
    try {
      const readable = obj as AnyReadableObject
      return readable.getAny(key)
    } catch (_e: any) {
      return null
    }
  }

  function getObjectString(obj: any | null, key: string, fallback: string = ''): string {
    if (obj == null) return fallback
    try {
      const readable = obj as StringReadableObject
      const v = readable.getString(key)
      return typeof v == 'string' ? (v as string) : fallback
    } catch (_e: any) {
      const v = getObjectAny(obj, key)
      return typeof v == 'string' ? (v as string) : fallback
    }
  }

  function getObjectNumber(obj: any | null, key: string, fallback: number = 0): number {
    const v = getObjectAny(obj, key)
    return typeof v == 'number' ? (v as number) : fallback
  }

  function toUTSJSONObject(value: any | null): UTSJSONObject {
    return JSON.parse<UTSJSONObject>(JSON.stringify(value ?? new UTSJSONObject())) ?? new UTSJSONObject()
  }

  function toUTSJSONObjectOrNull(value: any | null): UTSJSONObject | null {
    if (value == null) return null
    return JSON.parse<UTSJSONObject>(JSON.stringify(value)) ?? new UTSJSONObject()
  }

  const currentMessage = computed((): UTSJSONObject | null => {
    const raw: any | null = props.message
    if (raw == null) return null
    return toUTSJSONObject(raw)
  })

  function getCurrentMessage(): UTSJSONObject | null {
    return currentMessage.value
  }

  const emit = defineEmits<{
    onMessageListTap: []
    onMessageTap: [message: any]
  }>()

  const showActions = ref(false)
  const messageContentRef = ref(null)
  const loadingIconRef = ref(null)
  const flashOverlayRef = ref<UniElement | null>(null)  // 独立 DOM 覆盖在 messageContentRef 上做 backgroundColor 渐变
  const loadingAnimationTimer = ref<number | null>(null)
  const loadingStartTimer = ref<number | null>(null)
  const longPressPosition = ref({ x: 0, y: 0 })
  const lastTouchPosition = ref({ x: 0, y: 0 })
  const avatarRef = ref(null)

  const isLongPressing = ref(false)
  const longPressTimer = ref<number | null>(null)
  const touchStartTime = ref(0)
  const {
    calls,
    setCallFramework
  } = useCallState()
  const {
    openLocalCamera,
    openLocalMicrophone,
  } = useDeviceState();
  // 呼叫防抖锁，防止频繁点击通话消息
  const isCalling = ref(false);
  const instance = getCurrentInstance();

  type MessageRect = {
    top: number
    left: number
    width: number
    height: number
  }

  const getMessagePosition = (messageId: string): Promise<MessageRect> => {
    return new Promise<MessageRect>((resolve, reject) => {
      // Promise 泛型已是 MessageRect，reject 分支也必须放在同一个 Promise 构造里。
      if (instance == null) {
        reject(new Error('instance is null'))
        return
      }
      const query = uni.createSelectorQuery().in(instance.proxy);
      query
        .select("#" + messageId)
        .boundingClientRect((data: any) => {
          if (data != null) {
            const node = data as NodeInfo
            const top: number = node.top != null ? node.top : 0
            const left: number = node.left != null ? node.left : 0
            const width: number = node.width != null ? node.width : 0
            const height: number = node.height != null ? node.height : 0
            const rect: MessageRect = {
              top: top,
              left: left,
              width: width,
              height: height,
            }
            resolve(rect)
          } else {
            reject(new Error('无法获取Avatar位置信息'))
          }
        })
        .exec();
    })
  }

  defineExpose({
    getMessagePosition,
  })

  // 兼容 SDK 端历史消息 isSentBySelf 字段可能缺失的场景：
  //   1) 主路径读 isSentBySelf
  //   2) 兜底：message.from.userID === currentUserID
  const loginUserInfo = useLoginState().loginUserInfo
  const isSelf = computed((): boolean => {
    const message = getCurrentMessage()
    if (message == null) return false
    let v: any | null = message['isSentBySelf']
    if (v == null) v = message['isSelf']  // 旧版字段名 fallback
    if (v === true || v === 'true' || v === 1) return true
    // 字段缺失时用 from.userID 对比当前用户
    if (v == null) {
      const fromRaw: any | null = message['from']
      if (fromRaw != null) {
        const fromObj: UTSJSONObject = fromRaw as UTSJSONObject
        const fromUserIDRaw: any | null = fromObj['userID']
        if (typeof fromUserIDRaw == 'string' && (fromUserIDRaw as string).length > 0) {
          const currentUser = loginUserInfo.value
          if (currentUser != null) {
            // UserProfileParam 是 type alias（construction type），
            // userID 字段编译为 string | null，typed field 点访问合法
            const currentUserID: string | null = currentUser.userID
            if (currentUserID != null && currentUserID.length > 0 && currentUserID == fromUserIDRaw) {
              return true
            }
          }
        }
      }
    }
    return false
  })
  const fromAvatarURL = computed((): string => {
    const message = getCurrentMessage()
    if (message == null) return ''
    const fromRaw: any | null = message['from']
    if (fromRaw == null) return ''
    const fromObj: UTSJSONObject = fromRaw as UTSJSONObject
    const avatarRaw: any | null = fromObj['avatarURL']
    return typeof avatarRaw == 'string' ? (avatarRaw as string) : ''
  })

  const messageType = computed((): any | null => {
    const message = getCurrentMessage()
    return message != null ? message['messageType'] : null
  })
  const messageTimestamp = computed((): number => {
    const message = getCurrentMessage()
    const v: any | null = message != null ? message['timestamp'] : null
    return typeof v == 'number' ? (v as number) : 0
  })
  const messageMsgID = computed((): string => {
    const message = getCurrentMessage()
    const v: any | null = message != null ? message['msgID'] : null
    return typeof v == 'string' ? (v as string) : ''
  })
  const messageStatus = computed((): any | null => {
    const message = getCurrentMessage()
    return message != null ? message['status'] : null
  })
  const isRevokedMessage = computed((): boolean => messageStatus.value == 4)
  const isSendingMessage = computed((): boolean => messageStatus.value == 1)
  const isSendFailMessage = computed((): boolean => messageStatus.value == 3)
  const messageNeedReadReceipt = computed((): boolean => {
    const message = getCurrentMessage()
    const v: any | null = message != null ? message['needReadReceipt'] : null
    return v == true
  })

  const isSystemMessage = computed((): boolean => {
    return messageType.value == 7
  });

  const isGroupCreateMessage = computed((): boolean => {
    if (messageType.value == 8) {
      const message = getCurrentMessage()
      const payload: any | null = message != null ? message['messagePayload'] : null
      const cd = getObjectString(payload, 'customData', '')
      const dataRaw: any | null = JSON.parse(cd.length > 0 ? cd : '{}')
      const dataObj: UTSJSONObject = (dataRaw ?? new UTSJSONObject()) as UTSJSONObject
      const businessID: any | null = dataObj['businessID']
      if (businessID == 'group_create') {
        return true;
      }
    }
    return false;
  })

  const isCustomCenterMessage = computed((): boolean => {
    if (props.customCenterChecker != null) {
      return props.customCenterChecker(props.message, props.conversationID)
    }
    return isGroupCallMessage(props.message, props.conversationID ?? '')
  })

  const isCenterMessage = computed((): boolean => {
    if (
      messageStatus.value == 4
      || isSystemMessage.value
      || isGroupCreateMessage.value
      || isCustomCenterMessage.value
    ) {
      return true;
    }
    return false;
  });

const messageClasses = computed((): string[] => {
  return [
    `msg--${isSelf.value ? 'out' : 'in'}`,
    `msg--type-${messageType.value}`
  ]
})

const bubbleClasses = computed((): string => {
  return `msg__bubble--${isSelf.value ? 'out' : 'in'}`
})

let _lastFlashTriggerTime: number = 0
let _flashClearTimer: number | null = null
let activeFlashAnim: UniAnimation | null = null
// playFlashAnimation 必须定义在 triggerFlash 之前：UTS const 箭头函数不 hoisted（规则 55B/130）
const playFlashAnimation = (): void => {
  const el: UniElement | null = flashOverlayRef.value
  if (el == null) return
  // 取消上一次未完成的 animation（防止堆叠）
  if (activeFlashAnim != null) {
    try {
      // 模块级 let 在 capturing closure 内被 mutate（activeFlashAnim = null/= animate(...)），
      // Kotlin 拒绝 smart cast（规则 75/102 v6 推广）；用 as UniAnimation 显式强转跳过 smart cast
      ;(activeFlashAnim as UniAnimation).cancel()
    } catch (e: any) {
      // 静默：Animation 可能已结束
    }
    activeFlashAnim = null
  }
  activeFlashAnim = el.animate(
    [
      { backgroundColor: 'rgba(255, 213, 79, 0)', offset: 0 },
      { backgroundColor: 'rgba(255, 213, 79, 0.85)', offset: 0.2 },
      { backgroundColor: 'rgba(255, 213, 79, 0.4)', offset: 0.4 },
      { backgroundColor: 'rgba(255, 213, 79, 0.85)', offset: 0.6 },
      { backgroundColor: 'rgba(255, 213, 79, 0.4)', offset: 0.8 },
      { backgroundColor: 'rgba(255, 213, 79, 0)', offset: 1 }
    ],
    {
      duration: 1500,
      iterations: 1,
      easing: 'ease-in-out',
      fill: 'forwards'       // 动画结束后保持透明终态
    }
  )
}

const isFlashing = ref(false)
const triggerFlash = (): void => {
  const now: number = Date.now()
  if (now - _lastFlashTriggerTime < 1500) {
    return
  }
  _lastFlashTriggerTime = now
  const t: number | null = _flashClearTimer
  if (t != null) {
    clearTimeout(t)
    _flashClearTimer = null
  }
  // 直接显示高亮层（v-if="isFlashing" 触发 .msg__flash-bg 渲染 + 动画）
  isFlashing.value = true
  playFlashAnimation()
  // 1600ms 后隐藏（确保 keyframe 1.5s 跑完）
  _flashClearTimer = setTimeout((): void => {
    isFlashing.value = false
    _flashClearTimer = null
  }, 1600) as number
}

  const showStatus = computed((): boolean => {
    return isSelf.value &&
      (messageStatus.value == 1 ||
        messageStatus.value == 3)
  })

  const showReadStatus = computed((): boolean => {
    return isSelf.value &&
      messageStatus.value == 2 &&
      messageNeedReadReceipt.value
  })

  // 已读状态文本
  const readStatusText = computed((): string => {
    const message = getCurrentMessage()
    const receipt: any | null = message != null ? message['readReceiptInfo'] : null
    if (receipt == null) {
      return '未读'
    }
    const readCount: number = getObjectNumber(receipt, 'readCount', 0)
    const unreadCount: number = getObjectNumber(receipt, 'unreadCount', 0)
    if (unreadCount == 0) {
      return '已读'
    }
    return `${readCount}人已读`
  })

  const displayName = computed((): string => {
    const message = getCurrentMessage()
    const senderRaw: any | null = message != null ? message['from'] : null
    if (senderRaw == null) return ''
    const sender: UTSJSONObject = senderRaw as UTSJSONObject
    const nameCardRaw: any | null = sender['nameCard']
    const nameCard: string = typeof nameCardRaw == 'string' ? (nameCardRaw as string) : ''
    if (nameCard.length > 0) return nameCard
    const friendRemarkRaw: any | null = sender['friendRemark']
    const friendRemark: string = typeof friendRemarkRaw == 'string' ? (friendRemarkRaw as string) : ''
    if (friendRemark.length > 0) return friendRemark
    const nicknameRaw: any | null = sender['nickname']
    const nickname: string = typeof nicknameRaw == 'string' ? (nicknameRaw as string) : ''
    if (nickname.length > 0) return nickname
    const userIDRaw: any | null = sender['userID']
    return typeof userIDRaw == 'string' ? (userIDRaw as string) : ''
  })

  // 调用业务方传入的 customMessageRender 解析 CUSTOM 消息对应的渲染组件
  // 仅在 messageType == CUSTOM 时生效；render 抛错或返回空值时降级走默认渲染
  const customComponent = computed((): any | null => {
    if (messageType.value !== 8) return null
    if (props.customMessageRender == null) return null
    try {
      const renderFn = props.customMessageRender as ((m: any, cid: string) => any) | null
      if (renderFn != null) {
        const comp: any = renderFn(props.message, props.conversationID ?? '')
        return comp ?? null
      }
      return null
    } catch (e: any) {
      console.error('[Message] customMessageRender failed:', e)
      return null
    }
  })

  // 居中分支自定义消息渲染：业务组件优先，否则走内置 CustomMessage
  const centerCustomComponent = computed(() => {
    return customComponent.value ?? CustomMessage
  })

const componentMap: UTSJSONObject = new UTSJSONObject()
componentMap['1'] = TextMessage
componentMap['2'] = ImageMessage
componentMap['3'] = VideoMessage
componentMap['4'] = AudioMessage
componentMap['5'] = FileMessage
componentMap['6'] = FaceMessage
componentMap['8'] = CustomMessage
componentMap['9'] = MergerMessage

const currentMessageComponent = computed((): any | null => {
  if (customComponent.value != null) return customComponent.value
  if (messageType.value == null) return TextMessage
  const key: string = '' + (messageType.value as number)
  const comp: any | null = componentMap[key]
  return comp != null ? comp : TextMessage
})

  const formatMessageTime = (timestamp?: number) => {
    if (timestamp == null) return ''
    return formatTime(timestamp * 1000)
  }

  const playHighlightAnimation = () => {
    const refVal: any | null = messageContentRef.value
    if (refVal == null) return
    const refObj: UTSJSONObject = toUTSJSONObject(refVal)
    const elVal: any | null = refObj['$el']
    const contentEl: any | null = elVal != null ? elVal : refVal
    if (contentEl == null) return
    const contentObj: UTSJSONObject = toUTSJSONObject(contentEl)
    const children: any | null = contentObj['children']
    if (children == null) return
    const childrenArr: any = children
    const first: any | null = Array.isArray(childrenArr) && childrenArr.length > 0 ? childrenArr[0] : null
    if (first == null) return

    const highlightEl: any = first
    let count = 0
    const maxCount = 6

    function flash(): void {
      if (count >= maxCount) {
        animation.transition(highlightEl, {
          styles: { backgroundColor: 'transparent' },
          duration: 150,
          timingFunction: 'ease-out'
        }, null)
        return
      }

      const isHighlight = count % 2 == 0

      animation.transition(highlightEl, {
        styles: { backgroundColor: isHighlight ? '#FFD54F' : 'transparent' },
        duration: 200,
        timingFunction: 'ease-in-out'
      }, () => {
        count++
        flash()
      })
    }

    flash()
  }

watch(
  (): number => props.highlight as number,
  (newVal: number): void => {
    if (newVal > 0) {
      nextTick((): void => {
        triggerFlash()
      })
    }
  }
)

  const handleTouchMove = (e: any) => {
    // e.stopPropagation();
  }

  const startLoadingAnimation = () => {
    const t: number | null = loadingStartTimer.value
    if (t != null) {
      clearTimeout(t)
    }

    loadingStartTimer.value = setTimeout(() => {
      loadingStartTimer.value = null
      if (loadingIconRef.value == null) return

      const el: any = loadingIconRef.value as any
      if (el == null) return

      const elForClosure: any = el

      let rotation = 0

      function rotate(): void {
        if (loadingAnimationTimer.value == null) return

        rotation += 360
        animation.transition(elForClosure, {
          styles: { transform: `rotateZ(${rotation}deg)` },
          duration: 800,
          timingFunction: 'linear'
        }, () => {
          if (loadingAnimationTimer.value !== null) {
            rotate()
          }
        })
      }

      loadingAnimationTimer.value = 1
      rotate()
    }, 100) as number
  }

  const stopLoadingAnimation = () => {
    const t: number | null = loadingStartTimer.value
    if (t != null) {
      clearTimeout(t)
      loadingStartTimer.value = null
    }
    loadingAnimationTimer.value = null
  }

  watch(
    (): any | null => messageStatus.value,
    (newStatus: any | null): void => {
      if (newStatus == 1) {
        nextTick((): void => {
          startLoadingAnimation()
        })
      } else {
        stopLoadingAnimation()
      }
    },
    { immediate: true }
  )

  onMounted(() => {
    if (messageStatus.value == 1) {
      nextTick(() => {
        startLoadingAnimation()
      })
    }
  })

  onUnmounted(() => {
    stopLoadingAnimation()
  })

  const handleTouchStart = (e: UniTouchEvent) => {
    touchStartTime.value = Date.now()
    isLongPressing.value = false

    const touches = e.touches
    if (touches.length > 0) {
      const touch = touches[0]
      const cx = touch.clientX
      const cy = touch.clientY
      const systemInfo = uni.getSystemInfoSync()
      const ww = systemInfo.windowWidth
      const wh = systemInfo.windowHeight
      if (ww > 0 && wh > 0) {
        lastTouchPosition.value = {
          x: (cx / ww) * 750,
          y: (cy / wh) * (wh / ww * 750)
        }
      }
    }

    const lt: number | null = longPressTimer.value
    if (lt != null) {
      clearTimeout(lt)
    }
    longPressTimer.value = setTimeout((): void => {
      isLongPressing.value = true
    }, 350) as number
  }

  const handleTouchEnd = (_e: UniTouchEvent) => {
    const lt: number | null = longPressTimer.value
    if (lt != null) {
      clearTimeout(lt)
      longPressTimer.value = null
    }
  }

  // 新增：处理气泡的 touchstart 事件，阻止冒泡到外层 view
  const handleBubbleTouchStart = (e: UniTouchEvent) => {
    e.stopPropagation()
  }

  const recomputeLongPressPosition = async (): Promise<void> => {
    try {
      const msgID: string = messageMsgID.value
      const messagePosition: MessageRect = await getMessagePosition(msgID)
      const top: number = messagePosition.top
      const left: number = messagePosition.left
      const width: number = messagePosition.width
      const height: number = messagePosition.height
      // 将像素坐标转换为rpx单位（uni-app中使用）
      const systemInfo = uni.getSystemInfoSync()
      const winWRaw: any = systemInfo.windowWidth
      const winW: number = typeof winWRaw == 'number' ? (winWRaw as number) : 375
      const leftRpx: number = winW > 0 ? (left / winW) * 750 : 0
      const widthRpx: number = winW > 0 ? (width / winW) * 750 : 0
      const rightRpx: number = 750 - leftRpx - widthRpx
      const adjustedPosition = {
        x: isSelf.value ? rightRpx : leftRpx,
        y: winW > 0 ? (top / winW) * 750 : 0,
        // 统一 rpx 单位：messageX/messageWidth/messageHeight 都转 rpx
        // 避免 MessageActions.uvue 内部再做 px→rpx 转换（之前是字段单位不一致的 bug）
        messageX: winW > 0 ? (left / winW) * 750 : 0,
        messageWidth: widthRpx,
        messageHeight: winW > 0 ? (height / winW) * 750 : 0,
        isSentBySelf: isSelf.value,
      }
      longPressPosition.value = adjustedPosition
    } catch (error: any) {
      console.warn('获取Avatar位置失败:', error)
    }
  }

  const handleLongPress = async (e: UniTouchEvent) => {
    // 阻止默认行为，防止 iOS 系统菜单弹出
    e.preventDefault()
    e.stopPropagation()
    isLongPressing.value = true

    if (isCenterMessage.value) {
      return
    }

    longPressPosition.value = { ...lastTouchPosition.value }
    await recomputeLongPressPosition()
    showActions.value = true
  }

  watch(
    (): number => (props.inputPanelHeight ?? 0) + (props.inputToolbarHeight ?? 0),
    (newTotal: number, oldTotal: number): void => {
      if (!showActions.value) return
      if (newTotal === oldTotal) return
      recomputeLongPressPosition()
    }
  )

  const handleTap = () => {
    if (isLongPressing.value) {
      setTimeout(() => {
        isLongPressing.value = false
      }, 100)
      return
    }

    const lt: number | null = longPressTimer.value
    if (lt != null) {
      clearTimeout(lt)
      longPressTimer.value = null
    }

    emit('onMessageListTap')
  }

  // 处理 C2C 会话中的通话消息点击
  const handleC2CCallMessageTap = async (): Promise<boolean> => {
    if (!isCallMessage(props.message) || !props.conversationID.startsWith('c2c_')) {
      return false
    }

    // 防抖：上一次呼叫流程尚未完成时，不允许再次呼叫
    if (isCalling.value) {
      console.log('[Message] call skipped: isCalling is true');
      return true;
    }
    if (isNavigating()) {
      console.log('[Message] call skipped: navigation in progress');
      return true;
    }
    if (isCallEnding()) {
      console.log('[Message] call skipped: previous call end still processing');
      return true;
    }

    const callData = parseCallMessageData(props.message)
    const mediaType: number = isVideoCall(callData) ? 1 : 2
    const peerUserID: string = props.conversationID.replace('c2c_', '')

    if (peerUserID.length > 0) {
      isCalling.value = true;

      if (mediaType == 1) {
        openLocalCamera({
          isFront: true
        })
      }
      openLocalMicrophone({
        fail: (error) => {
          if (error == -1104) {
            setTimeout(() => {
              openLocalMicrophone(null);
            }, 200);
          }
        }
      })
      const hasPermission = await checkCallPermissionWithDialog(mediaType);
      if (!hasPermission) {
        isCalling.value = false;
        return true;
      }
      setCallFramework(15)
      calls({
        participantIds: [peerUserID],
        mediaType,
        success: () => {
          setCallSource('caller')
          setCallLastPage(getCurrentPageFullPath())
          uni.navigateTo({
            url: '/uni_modules/tuikit-atomic-x/pages/call?layoutTemplate=Float',
            complete: () => { isCalling.value = false; }
          })
        },
        fail: (error) => {
          if (error == CallErrorCode.PACKAGE_NOT_PURCHASED) {
            uni.showToast({
              icon: 'none',
              title: '您的应用还未开通音视频通话（TUICallKit）能力，您可以去控制台申请免费体验'
            })
            console.error('控制台申请免费体验,https://console.cloud.tencent.com/trtc')
          }
          isCalling.value = false;
        }
      })
    }
    return true
  }

  const handleMessageContentTap = () => {
    emit('onMessageListTap')
    handleC2CCallMessageTap()
    emit('onMessageTap', props.message);
  }

  const handleResend = () => {
  }

  const handleActionsClose = () => {
    showActions.value = false
    setTimeout(() => {
      isLongPressing.value = false
    }, 100)
  }
</script>

<style>
  .msg {
    flex-direction: row;
    padding: 20rpx 22rpx;
    align-items: flex-start;
    flex: 1;
  }

  /* 禁用整个消息容器的选择 */
  .msg--no-select {
    user-select: none;
    -webkit-user-select: none;
    -webkit-touch-callout: none;
  }

  .msg--center {
    justify-content: center;
    align-items: center;
    flex: 1;
    width: 750rpx;
  }

  .msg--in {
    flex-direction: row;
  }

  .msg--out {
    flex-direction: row-reverse;
  }

  .msg__avatar {
    margin-right: 8rpx;
  }

  .msg--out .msg__avatar {
    margin-right: 0;
    margin-left: 8rpx;
  }

  .msg__main {
    flex: 1;
    flex-direction: column;
    align-items: flex-start;
  }

  .msg__main--out {
    align-items: flex-end;
    padding: 10rpx 8rpx 0 14rpx;
  }

  .msg__main--in {
    padding: 10rpx 14rpx 0 8rpx;
  }

  /* 禁用主内容区域的选择 */
  .msg__main--no-select {
    user-select: none;
    -webkit-user-select: none;
    -webkit-touch-callout: none;
  }

  .msg--out .msg__main {
    align-items: flex-end;
  }

  .msg__nickname {
    margin-bottom: 8rpx;
  }

  .msg__nickname-text {
    font-size: 24rpx;
    line-height: 34rpx;
    color: rgba(0, 0, 0, 0.4);
  }

.msg__bubble {
  position: relative;
  justify-content: center;
  align-items: flex-end;
  overflow: hidden;
}

.msg__flash-overlay {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 1;
  pointer-events: none;
  background-color: transparent;
  border-radius: 4rpx 20rpx 20rpx 20rpx;  /* 默认 in 方向圆角 */
}

.msg__flash-overlay.msg__bubble--out {
  border-radius: 20rpx 4rpx 20rpx 20rpx;
}

  /* 禁用 iOS 长按默认菜单 */
  .msg__bubble--no-select {
    user-select: none;
    -webkit-user-select: none;
    -webkit-touch-callout: none;
  }

  .msg__bubble--in {
    flex-direction: row;
  }

  .msg__bubble--out {
    flex-direction: row-reverse;
  }

  /* 禁用所有文本的选择 */
  .msg__text--no-select {
    user-select: none;
    -webkit-user-select: none;
    -webkit-touch-callout: none;
  }

  .msg__status {
    height: 80rpx;
    align-items: center;
    justify-content: center;
  }

  .msg__status--in {
    margin-left: 16rpx;
  }

  .msg__status--out {
    margin-right: 16rpx;
  }

  .msg__status-icon {
    width: 32rpx;
    height: 32rpx;
  }

  .msg__time {
    flex-direction: row;
    align-items: center;
    margin-top: 8rpx;
  }

  .msg--out .msg__time {
    flex-direction: row-reverse;
  }

  .msg__time-text {
    font-size: 24rpx;
    line-height: 34rpx;
    font-weight: 400;
    color: rgba(0, 0, 0, 0.4);
  }

  .msg__read-status {
    margin-left: 16rpx;
  }

  .msg--out .msg__read-status {
    margin-left: 0;
    margin-right: 16rpx;
  }

  .msg__read-text {
    font-size: 24rpx;
    line-height: 34rpx;
    font-weight: 400;
    color: rgba(0, 0, 0, 0.4);
  }
</style>
