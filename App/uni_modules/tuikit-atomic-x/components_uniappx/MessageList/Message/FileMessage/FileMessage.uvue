<template>
  <view
    class="file-message"
    :class="['content-'+ (isSelf ? 'out' : 'in')]"
    @touchstart="handleTouchStart"
    @touchend="handleTouchEnd"
    @tap="handleFileTap"
  >
    <view class="file-highlight">
      <image :src="fileIconSrc" class="file-icon" mode="aspectFit" />
      <view class="file-info">
        <view class="file-name">
          <text class="file-name-text" :lines="2">{{ fileName }}</text>
        </view>
        <view class="file-footer">
          <text class="file-size-text">{{ formatFileSize(fileSize) }}</text>
          <view class="file-download" v-if="!isDownloaded">
            <text v-if="isDownloading" class="download-percent">{{ downloadProgress }}%</text>
            <image
              v-else
              src="../../../../static/icon/download.png"
              class="icon-image"
              mode="aspectFill"
            />
          </view>
        </view>
      </view>
    </view>
    <view
      v-if="isDownloading"
      class="downloading"
      :class="['content-'+ (isSelf ? 'out' : 'in')]"
    >
    </view>
  </view>
</template>

<script setup lang="uts">
import { ref, computed } from 'vue'
import { MediaQuality } from '../../../../types/message'
import { useMessageActionState } from '../../../../state/MessageActionState'
import { useMessageListState } from '../../../../state/MessageListState'

import wordIcon from '../../../../static/icon/file-types/word_icon.png'
import excelIcon from '../../../../static/icon/file-types/excel_icon.png'
import pptIcon from '../../../../static/icon/file-types/ppt_icon.png'
import pdfIcon from '../../../../static/icon/file-types/pdf_icon.png'
import txtIcon from '../../../../static/icon/file-types/txt_icon.png'
import imageIcon from '../../../../static/icon/file-types/image_icon.png'
import compressIcon from '../../../../static/icon/file-types/compress_icon.png'
import unknownIcon from '../../../../static/icon/file-types/unknown_icon.png'

type Props = {
  message: any | null
  conversationID: string}

const props = defineProps<Props>()

// downloadMessageResource 已迁到 MessageActionState.downloadMedia
const isDownloading = ref(false)

// 长按判定阈值，与 Message.nvue 中保持一致
const LONG_PRESS_THRESHOLD = 350
const touchStartTime = ref(0)

const fileName = computed((): string => {
  const messageObj: UTSJSONObject = props.message as UTSJSONObject
  const body: UTSJSONObject = messageObj['messagePayload'] as UTSJSONObject
  if (body == null) return '未知文件'
  const v: any | null = body['fileName']
  return typeof v == 'string' ? (v as string) : '未知文件'
})

const fileSize = computed((): number => {
  const messageObj: UTSJSONObject = props.message as UTSJSONObject
  const body: UTSJSONObject = messageObj['messagePayload'] as UTSJSONObject
  if (body == null) return 0
  const v: any | null = body['fileSize']
  return typeof v == 'number' ? (v as number) : 0
})

const filePath = computed((): string => {
  const messageObj: UTSJSONObject = props.message as UTSJSONObject
  const body: UTSJSONObject = messageObj['messagePayload'] as UTSJSONObject
  if (body == null) return ''
  const v: any | null = body['filePath']
  return typeof v == 'string' ? (v as string) : ''
})

const isSelf = computed((): boolean => {
  const messageObj: UTSJSONObject = props.message as UTSJSONObject
  const v: any | null = messageObj['isSentBySelf']
  return v == true
})

const isDownloaded = computed((): boolean => filePath.value.length > 0)

// 下载进度（0-100），与 VideoMessage 一致：SDK 下载时通过 message.progress 推送
const downloadProgress = computed((): number => {
  const messageObj: UTSJSONObject = props.message as UTSJSONObject
  const v: any | null = messageObj['progress']
  return typeof v == 'number' ? (v as number) : 0
})

const fileExtension = computed(() => {
  const name = fileName.value
  const ext = name.split('.').pop()?.toLowerCase()
  return ext ?? ''
})

// 文件类型 → 图标资源映射
function getFileTypeIcon(ext: string): string {
  if (ext.length == 0) return unknownIcon
  // Word
  if (ext == 'doc' || ext == 'docx') return wordIcon
  // Excel
  if (ext == 'xls' || ext == 'xlsx' || ext == 'csv') return excelIcon
  // PPT
  if (ext == 'ppt' || ext == 'pptx') return pptIcon
  // PDF
  if (ext == 'pdf') return pdfIcon
  // 文本
  if (ext == 'txt' || ext == 'log' || ext == 'json' || ext == 'xml' || ext == 'md') return txtIcon
  // 图片
  if (ext == 'jpg' || ext == 'jpeg' || ext == 'png' || ext == 'gif' ||
      ext == 'bmp' || ext == 'webp' || ext == 'svg') return imageIcon
  // 压缩包
  if (ext == 'zip' || ext == 'rar' || ext == '7z' || ext == 'tar' ||
      ext == 'gz' || ext == 'bz2') return compressIcon
  return unknownIcon
}

const fileIconSrc = computed((): string => {
  return getFileTypeIcon(fileExtension.value)
})

const formatFileSize = (size: number) => {
  if (size == 0) return '0 B'
  const units = ['B', 'KB', 'MB', 'GB', 'TB']
  let value = size
  let unitIndex = 0
  while (value >= 1024 && unitIndex < units.length - 1) {
    value /= 1024
    unitIndex++
  }
  return `${value.toFixed(unitIndex == 0 ? 0 : 1)} ${units[unitIndex]}`
}

// uni.openDocument 官方支持的文档类型
const DOCUMENT_TYPES = ['doc', 'docx', 'xls', 'xlsx', 'ppt', 'pptx', 'pdf']

const openFile = (path: string) => {
  if (path.length == 0) return
  const ext = fileExtension.value

  // 路径标准化：uni.openDocument 接受不带 file:// 的本地绝对路径
  const localPath = path.startsWith('file://') ? path.substring(7) : path

  uni.openDocument({
    filePath: localPath,
    fileType: ext,
    fail: (err: any): void => {
      console.error('[FileMessage] openDocument failed:', err)
      uni.showToast({ title: '无法打开此文件', icon: 'none' })
    }
  })
}

const handleTouchStart = (e: any) => {
  touchStartTime.value = Date.now()
}

const handleTouchEnd = (e: any) => {
  // 此处不消费事件，仅用于配合 handleFileTap 的长按判定
}

const handleFileTap = async (e: any) => {
  // 长按判定：触摸持续时间超过阈值视为长按，交由父级 Message.nvue 处理消息操作菜单
  // 注意：判定后必须复位 touchStartTime，否则下一次"未收到 touchstart 直接 tap"
  // （nvue 部分场景事件丢失）会用旧时间戳算出极大 duration，导致正常点击被误判为长按
  const startTime = touchStartTime.value
  touchStartTime.value = 0
  if (startTime > 0 && Date.now() - startTime >= LONG_PRESS_THRESHOLD) {
    return
  }

  if (isDownloading.value) return

  if (isDownloaded.value) {
    openFile(filePath.value)
    return
  }

  isDownloading.value = true
  try {
    const msgForAction: UTSJSONObject = props.message as UTSJSONObject
    const state = useMessageActionState({ message: msgForAction })
    await state.downloadMedia(MediaQuality.ORIGINAL)
    uni.showToast({ title: '下载完成', icon: 'success', duration: 1500 })
  } catch (error: any) {
    console.error('[FileMessage] download failed:', error)
    const errObj: UTSJSONObject = (error as UTSJSONObject) ?? new UTSJSONObject()
    const errMsgRaw: any | null = errObj['message']
    const errMsg: string = typeof errMsgRaw == 'string' ? (errMsgRaw as string) : ''
    uni.showToast({
      title: errMsg.length > 0 ? errMsg : '下载失败',
      icon: 'none',
      duration: 2000
    })
  } finally {
    isDownloading.value = false
  }
}
</script>

<style>
.file-message {
  position: relative;
  background-color: #FFFFFF;
  border: 2rpx solid #E6E9F0;
  min-width: 300rpx;
  max-width: 500rpx;
}

.content-in {
  border-radius: 4rpx 20rpx 20rpx 20rpx;
}

.content-out {
  border-radius: 20rpx 4rpx 20rpx 20rpx;
}

.file-highlight {
  flex: 1;
  flex-direction: row;
  align-items: center;
  padding: 24rpx;
  background-color: transparent;
}

.file-icon {
  margin-right: 20rpx;
  width: 64rpx;
  height: 64rpx;
}

.file-info, .file-name, .file-footer {
  flex: 1;
}

.file-name-text {
  flex: 1;
  font-weight: 400;
  font-size: 32rpx;
  line-height: 42rpx;
  color: rgba(0, 0, 0, 0.9);
  margin-bottom: 4rpx;
  lines: 2;
  text-overflow: ellipsis;
}

.file-size-text {
  font-weight: 400;
  font-size: 28rpx;
  line-height: 39rpx;
  color: rgba(0, 0, 0, 0.4);
}

.file-footer {
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}

.file-download {
  justify-content: flex-end;
}

.icon-image {
  width: 28rpx;
  height: 28rpx;
}

.download-percent {
  font-size: 24rpx;
  line-height: 28rpx;
  color: rgba(0, 0, 0, 0.55);
  font-weight: 500;
}

.file-status {
  margin-left: 16rpx;
  align-items: center;
  justify-content: center;
}

.downloading {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 0;
  background-color: rgba(204, 226, 255, 0.5);
  border-radius: 20rpx;
}
</style>
