<template>
  <!-- 送礼入场条：固定 2 个常驻槽位 + v-show 显隐，全程零节点增删。
       连击只改槽位内 count，同发送者+同礼物 2s 内累加，最多 2 条并排。 -->
  <view
    class="gift-entry-layer"
    :style="{ bottom: bottomPx + 'px', zIndex: elevated ? 3000 : 2400 }"
    v-if="anyActive && !hidden"
    userInteractionEnabled="false"
  >
    <!-- 槽位 0 -->
    <view
      class="gift-entry-item"
      v-if="slot0.active"
      :ref="(el: any) => { itemRefs[0].value = el; }"
    >
      <view class="gift-entry-capsule">
        <view class="gift-entry-avatar">
          <image v-if="slot0.avatar" class="gift-entry-avatar-img" :src="slot0.avatar" mode="aspectFill" />
          <text v-else class="gift-entry-avatar-text">{{ slot0.nameFirst }}</text>
        </view>
        <view class="gift-entry-copy">
          <text class="gift-entry-name" :numberOfLines="1">{{ slot0.name }}</text>
          <text class="gift-entry-detail" :numberOfLines="1">{{ slot0.detailText }}</text>
        </view>
        <view class="gift-entry-image-wrap">
          <image
            v-if="slot0.giftIcon && !slot0.giftIconFailed"
            class="gift-entry-image"
            :src="slot0.giftIcon"
            mode="aspectFit"
            @error="onGiftIconError(slot0)"
          />
          <text v-else class="gift-entry-image-fallback">{{ t('gift.giftFallback') }}</text>
        </view>
      </view>
      <view class="gift-entry-count" :ref="(el: any) => { countRefs[0].value = el; }">
        <text class="gift-entry-count-x" :class="{ 'gift-entry-count-bump': slot0.bumping }">×</text>
        <text class="gift-entry-count-num" :class="{ 'gift-entry-count-bump': slot0.bumping }">{{ slot0.count }}</text>
      </view>
    </view>

    <!-- 槽位 1 -->
    <view
      class="gift-entry-item"
      v-if="slot1.active"
      :ref="(el: any) => { itemRefs[1].value = el; }"
    >
      <view class="gift-entry-capsule">
        <view class="gift-entry-avatar">
          <image v-if="slot1.avatar" class="gift-entry-avatar-img" :src="slot1.avatar" mode="aspectFill" />
          <text v-else class="gift-entry-avatar-text">{{ slot1.nameFirst }}</text>
        </view>
        <view class="gift-entry-copy">
          <text class="gift-entry-name" :numberOfLines="1">{{ slot1.name }}</text>
          <text class="gift-entry-detail" :numberOfLines="1">{{ slot1.detailText }}</text>
        </view>
        <view class="gift-entry-image-wrap">
          <image
            v-if="slot1.giftIcon && !slot1.giftIconFailed"
            class="gift-entry-image"
            :src="slot1.giftIcon"
            mode="aspectFit"
            @error="onGiftIconError(slot1)"
          />
          <text v-else class="gift-entry-image-fallback">{{ t('gift.giftFallback') }}</text>
        </view>
      </view>
      <view class="gift-entry-count" :ref="(el: any) => { countRefs[1].value = el; }">
        <text class="gift-entry-count-x" :class="{ 'gift-entry-count-bump': slot1.bumping }">×</text>
        <text class="gift-entry-count-num" :class="{ 'gift-entry-count-bump': slot1.bumping }">{{ slot1.count }}</text>
      </view>
    </view>
  </view>
</template>

<script setup>
  import { reactive, computed, onUnmounted, ref } from 'vue';
  import { t } from '../locales';

  defineProps({
    bottomPx: {
      type: Number,
      default: 240
    },
    elevated: {
      type: Boolean,
      default: false
    },
    hidden: {
      type: Boolean,
      default: false
    }
  });

  const animation = uni.requireNativePlugin('animation');

  const HOLD_DURATION = 2000;
  const DEFAULT_AVATAR_URL = '/uni_modules/tuikit-atomic-x/static/assets/live/default-avatar.png';
  const EXIT_DURATION = 320;
  const BUMP_UP_DURATION = 120;

  const itemRefs = { 0: ref(null), 1: ref(null) };
  const countRefs = { 0: ref(null), 1: ref(null) };

  const ENTER_ANIM_DURATION = 320;
  const ENTER_ANIM_TIMING = 'cubic-bezier(0.16, 0.82, 0.22, 1)';
  const EXIT_ANIM_DURATION = 320;
  const EXIT_ANIM_TIMING = 'cubic-bezier(0.16, 0.82, 0.22, 1)';
  const BUMP_ANIM_DURATION = 120;
  const BUMP_ANIM_TIMING = 'cubic-bezier(0.34, 1.56, 0.64, 1)';

  function createSlot(index) {
    return reactive({
      index,
      active: false,
      visible: false,
      leaving: false,
      bumping: false,
      giftId: '',
      senderId: '',
      recipientId: '',
      name: '',
      nameFirst: '',
      avatar: '',
      giftName: '',
      giftIcon: '',
      giftIconFailed: false,
      detailText: '',
      count: 0,
      expireTimer: null,
      hideTimer: null,
      bumpTimer: null
    });
  }

  const slot0 = createSlot(0);
  const slot1 = createSlot(1);
  const slots = [slot0, slot1];

  const queue = [];
  const anyActive = computed(() => slot0.active || slot1.active);

  function onGiftIconError(slot) {
    if (slot) slot.giftIconFailed = true;
  }

  function push(giftData) {
    if (!giftData) return;
    const gift = giftData.gift || {};
    const sender = giftData.sender || {};
    const recipient = giftData.recipient || null;
    const senderId = sender.userID || '';
    const recipientId = recipient && recipient.userID ? recipient.userID : '';
    const giftId = gift.giftID || gift.name || '';
    const name = sender.userName || sender.userID || t('gift.senderFallback');
    const giftName = gift.name || t('gift.giftNameFallback');
    const detailText = t('gift.sent', { name: giftName });
    const count = Math.max(1, Math.round(Number(giftData.count) || 1));

    const active = slots.find(s =>
      s.active && !s.leaving &&
      s.giftId === giftId && s.senderId === senderId && s.recipientId === recipientId
    );
    if (active) {
      active.count += count;
      restartTimer(active);
      triggerBump(active);
      return;
    }

    const queued = queue.find(e =>
      e.giftId === giftId && e.senderId === senderId && e.recipientId === recipientId
    );
    if (queued) {
      queued.count += count;
      return;
    }

    const data = {
      giftId,
      senderId,
      recipientId,
      name,
      nameFirst: (name || t('gift.senderCharFallback')).slice(0, 1),
      avatar: sender.avatarURL || DEFAULT_AVATAR_URL,
      giftName,
      giftIcon: gift.iconURL || '',
      detailText,
      count
    };

    // 找空闲槽位填充；都满则排队
    const free = slots.find(s => !s.active);
    if (free) {
      fillSlot(free, data);
    } else {
      queue.push(data);
    }
  }

  function fillSlot(slot, data) {
    slot.giftId = data.giftId;
    slot.senderId = data.senderId;
    slot.recipientId = data.recipientId;
    slot.name = data.name;
    slot.nameFirst = data.nameFirst;
    slot.avatar = data.avatar;
    slot.giftName = data.giftName;
    slot.giftIcon = data.giftIcon;
    slot.giftIconFailed = false;
    slot.detailText = data.detailText;
    slot.count = data.count;
    slot.leaving = false;
    slot.active = true;
    slot.visible = false;
    const idx = slot.index;
    setTimeout(() => {
      if (!slot.active || slot.leaving) return;
      slot.visible = true;
      const el = itemRefs[idx].value;
      if (el) {
        animation.transition(el, {
          styles: { opacity: 1, transform: 'translateX(0)' },
          duration: ENTER_ANIM_DURATION,
          timingFunction: ENTER_ANIM_TIMING
        });
      }
    }, 16);
    restartTimer(slot);
  }

  function restartTimer(slot) {
    clearTimeout(slot.expireTimer);
    clearTimeout(slot.hideTimer);
    slot.expireTimer = setTimeout(() => leave(slot), HOLD_DURATION);
  }

  function triggerBump(slot) {
    clearTimeout(slot.bumpTimer);
    if (!slot.active) return;
    const idx = slot.index;
    const el = countRefs[idx].value;
    if (el) {
      animation.transition(el, {
        styles: { transform: 'scale(1.24)' },
        duration: BUMP_ANIM_DURATION,
        timingFunction: BUMP_ANIM_TIMING
      });
    }
    slot.bumping = true;
    slot.bumpTimer = setTimeout(() => {
      if (!slot.active) return;
      slot.bumping = false;
      const el2 = countRefs[idx].value;
      if (el2) {
        animation.transition(el2, {
          styles: { transform: 'scale(1)' },
          duration: BUMP_ANIM_DURATION,
          timingFunction: 'ease-out'
        });
      }
    }, BUMP_UP_DURATION);
  }

  function leave(slot) {
    if (!slot.active || slot.leaving) return;
    slot.leaving = true;
    slot.visible = false;
    const idx = slot.index;
    const el = itemRefs[idx].value;
    if (el) {
      animation.transition(el, {
        styles: { opacity: 0, transform: 'translateX(-48rpx)' },
        duration: EXIT_ANIM_DURATION,
        timingFunction: EXIT_ANIM_TIMING
      });
    }
    slot.hideTimer = setTimeout(() => release(slot), EXIT_DURATION);
  }

  function release(slot) {
    clearTimeout(slot.expireTimer);
    clearTimeout(slot.hideTimer);
    clearTimeout(slot.bumpTimer);
    slot.expireTimer = null;
    slot.hideTimer = null;
    slot.bumpTimer = null;
    slot.active = false;
    slot.visible = false;
    slot.leaving = false;
    slot.bumping = false;
    slot.count = 0;
    slot.giftId = '';
    slot.senderId = '';
    slot.recipientId = '';
    slot.detailText = '';
    if (queue.length > 0) {
      fillSlot(slot, queue.shift());
    }
  }

  function reset() {
    slots.forEach(s => {
      clearTimeout(s.expireTimer);
      clearTimeout(s.hideTimer);
      clearTimeout(s.bumpTimer);
      s.expireTimer = null;
      s.hideTimer = null;
      s.bumpTimer = null;
      s.active = false;
      s.visible = false;
      s.leaving = false;
      s.bumping = false;
      s.count = 0;
      s.giftId = '';
      s.senderId = '';
      s.recipientId = '';
      s.detailText = '';
    });
    queue.length = 0;
  }

  onUnmounted(reset);

  defineExpose({ push, reset });
</script>

<style>
  .gift-entry-layer {
    position: fixed;
    left: 24rpx;
    z-index: 2400;
    flex-direction: column-reverse;
    align-items: flex-start;
  }

  .gift-entry-item {
    flex-direction: row;
    align-items: center;
    height: 88rpx;
    margin-top: 8rpx;
    opacity: 0;
    transform: translateX(-600rpx);
  }

  .gift-entry-capsule {
    flex-direction: row;
    align-items: center;
    height: 88rpx;
    padding: 6rpx;
    border-radius: 44rpx;
    background-color: rgba(8, 10, 15, 0.28);
    max-width: 560rpx;
  }

  .gift-entry-avatar {
    width: 76rpx;
    height: 76rpx;
    border-radius: 38rpx;
    border-width: 2rpx;
    border-color: rgba(255, 255, 255, 0.72);
    background-color: rgba(74, 158, 255, 0.36);
    justify-content: center;
    align-items: center;
    overflow: hidden;
    flex-shrink: 0;
  }

  .gift-entry-avatar-img {
    width: 76rpx;
    height: 76rpx;
    border-radius: 38rpx;
  }

  .gift-entry-avatar-text {
    color: rgba(255, 255, 255, 0.9);
    font-size: 24rpx;
    font-weight: 700;
    line-height: 76rpx;
  }

  .gift-entry-copy {
    flex-direction: column;
    justify-content: center;
    margin-left: 14rpx;
    /* 文本列必须有宽度上限:单行截断依赖它。否则超长用户名/礼物名会把
       text 撑开 => 整条礼物条被拉得很长。
       胶囊上限 560 - 固定部分(头像 76 + 礼物图 90 + padding 12) - ×数量约 70
       => 文本列 320rpx。 */
    max-width: 320rpx;
    min-width: 0;
  }

  .gift-entry-name {
    color: #ffffff;
    font-size: 24rpx;
    font-weight: 600;
    line-height: 30rpx;
    text-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.5);
    lines: 1;
    white-space: nowrap;
    text-overflow: ellipsis;
    overflow: hidden;
    max-width: 320rpx;
  }

  .gift-entry-detail {
    color: rgba(255, 255, 255, 0.72);
    font-size: 18rpx;
    line-height: 24rpx;
    lines: 1;
    white-space: nowrap;
    text-overflow: ellipsis;
    overflow: hidden;
    max-width: 320rpx;
  }

  .gift-entry-image-wrap {
    width: 82rpx;
    height: 82rpx;
    justify-content: center;
    align-items: center;
    margin-left: 8rpx;
    flex-shrink: 0;
  }

  .gift-entry-image {
    width: 74rpx;
    height: 74rpx;
  }

  .gift-entry-count {
    flex-direction: row;
    align-items: flex-end;
    min-width: 104rpx;
    margin-left: 8rpx;
    padding-right: 56rpx;
    transform: scale(1);
    transform-origin: left center;
  }

  .gift-entry-count-x {
    color: #ffffff;
    font-size: 34rpx;
    line-height: 44rpx;
    font-weight: 800;
    text-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.55);
  }

  .gift-entry-count-num {
    color: #ffffff;
    font-size: 52rpx;
    line-height: 56rpx;
    font-weight: 800;
    margin-left: 4rpx;
    letter-spacing: -3rpx;
    text-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.55);
  }

  .gift-entry-image-fallback {
    width: 68rpx;
    height: 52rpx;
    border-radius: 24rpx;
    color: #ffffff;
    background-color: #f30b82;
    font-size: 34rpx;
    font-weight: 800;
    text-align: center;
    line-height: 52rpx;
  }

  .gift-entry-count-bump {
    color: #78d8ff;
  }
</style>
