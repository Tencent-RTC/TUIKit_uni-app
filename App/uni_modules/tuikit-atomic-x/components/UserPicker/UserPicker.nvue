<template>
  <view class="user-picker-page">
    <UserPickerList
      :maxCount="maxCount"
      :dataSource="userList"
      :lockedItems="lockedItems"
      :title="title"
      :singleSelect="singleSelect"
      :pinnedTopItems="pinnedTopItems"
      :remoteSearch="remoteSearch"
      :enableSearch="enableSearch"
      @confirm="handleConfirm"
      @searchChange="handleSearchChange"
    />
  </view>
</template>

<script setup lang="ts">
import { onBeforeUnmount, computed } from 'vue'
import UserPickerList from './components/UserPickerList.nvue'
import { useUserPicker, type User } from './service/index'

interface UserPickerProps {
  businessType: number
  routeParams?: Record<string, any>
}

const props = withDefaults(defineProps<UserPickerProps>(), {
  businessType: -1,
  routeParams: () => ({})
})

const emit = defineEmits<{
  (e: 'confirm', selectedUsers: User[]): void
}>()

// 调用 Hook
const pickerResult = useUserPicker(props.businessType, props.routeParams)

const {
  userList,
  lockedItems,
  maxCount,
  title,
  hasMore,
  handleConfirm: confirmHandler,
  handleCancel: cancelHandler,
  onReachEnd,
} = pickerResult

const singleSelect = computed<boolean>(() => !!pickerResult.singleSelect)
const pinnedTopItems = computed<User[]>(() => pickerResult.pinnedTopItems?.value || [])
const remoteSearch = computed<boolean>(() => typeof pickerResult.onSearchChange === 'function')
// enableSearch 优先取 hook 返回值；其次回退到 routeParams.enableSearch；默认 true
const enableSearch = computed<boolean>(() => {
  if (pickerResult.enableSearch != null) return !!pickerResult.enableSearch
  if (props.routeParams && props.routeParams.enableSearch != null) {
    // routeParams 来自 query string 时是字符串，需做容错
    const v = props.routeParams.enableSearch
    return !(v === false || v === 'false' || v === 0 || v === '0')
  }
  return true
})

const handleConfirm = async (selectedUsers: User[]) => {
  emit('confirm', selectedUsers)
  await confirmHandler(selectedUsers)
}

const handleSearchChange = (keyword: string) => {
  if (pickerResult.onSearchChange) {
    pickerResult.onSearchChange(keyword)
  }
}

const handleReachEnd = async () => {
  if (onReachEnd) {
    await onReachEnd()
  }
}

onBeforeUnmount(async () => {
  if (cancelHandler) {
    await cancelHandler()
  }
})
</script>

<style>
.user-picker-page {
  flex: 1;
  background-color: #f5f5f5;
}
</style>
