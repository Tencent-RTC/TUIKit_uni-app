<template>
  <BaseDrawer
    v-model="innerVisible"
    :height="990"
    :overlayOpacity="0.5"
    bgImage="/uni_modules/tuikit-atomic-x/static/assets/live/drawer-bg.png"
    :bgImageHeight="1200"
    padding="20rpx 36rpx 48rpx"
    :useSafeBottom="true"
  >
    <view class="ae-heading">
      <text class="ae-title">{{ t('ae.title') }}</text>
    </view>

    <view class="ae-card">
      <view class="ae-row">
        <text class="ae-row-label">{{ t('ae.earback') }}</text>
        <SwitchButton :modelValue="isEarMonitorOpened" @change="handleEarMonitorChange" />
      </view>
      <view class="ae-divider"></view>
      <view class="ae-row">
        <text class="ae-row-label">{{ t('ae.earbackVolume') }}</text>
        <view class="ae-row-slider">
          <Slider
            :modelValue="earMonitorVolume"
            :min="0"
            :max="100"
            :trackWidth="340"
            @input="onEarVolumeInput"
            @change="onEarVolumeChange"
          />
          <text class="ae-row-value">{{ earMonitorVolume }}</text>
        </view>
      </view>
    </view>

    <view class="ae-section">
      <text class="ae-section-title">{{ t('ae.audioSettings') }}</text>
      <view class="ae-card">
        <view class="ae-row">
          <text class="ae-row-label">{{ t('ae.voiceVolume') }}</text>
          <view class="ae-row-slider">
            <Slider
              :modelValue="voiceVolume"
              :min="0"
              :max="100"
              :trackWidth="340"
              @input="onVoiceVolumeInput"
              @change="onVoiceVolumeChange"
            />
            <text class="ae-row-value">{{ voiceVolume }}</text>
          </view>
        </view>
      </view>
    </view>

    <view class="ae-section">
      <text class="ae-section-title">{{ t('ae.voiceChange') }}</text>
      <view class="ae-option-grid">
        <view
          v-for="option in voiceOptions"
          :key="option.key"
          class="ae-option"
          @tap="handleVoiceChange(option.key)"
        >
          <view class="ae-option-icon-wrap" :class="{ 'ae-option-icon-on': audioChangerType === option.key }">
            <image class="ae-option-icon" :class="{ 'ae-option-icon-img-on': audioChangerType === option.key }" :src="option.icon" mode="aspectFit" />
          </view>
          <text class="ae-option-label" :class="{ 'ae-option-label-on': audioChangerType === option.key }">{{ option.label }}</text>
        </view>
      </view>
    </view>

    <view class="ae-section">
      <text class="ae-section-title">{{ t('ae.reverb') }}</text>
      <view class="ae-option-grid">
        <view
          v-for="option in reverbOptions"
          :key="option.key"
          class="ae-option"
          @tap="handleReverbChange(option.key)"
        >
          <view class="ae-option-icon-wrap" :class="{ 'ae-option-icon-on': audioReverbType === option.key }">
            <image class="ae-option-icon" :class="{ 'ae-option-icon-img-on': audioReverbType === option.key }" :src="option.icon" mode="aspectFit" />
          </view>
          <text class="ae-option-label" :class="{ 'ae-option-label-on': audioReverbType === option.key }">{{ option.label }}</text>
        </view>
      </view>
    </view>
  </BaseDrawer>
</template>

<script setup>
  import { ref, computed } from 'vue';
  import { t } from '../locales';
  import BaseDrawer from '@/components/live/BaseDrawer/index.nvue';
  import SwitchButton from '@/components/live/SwitchButton/index.nvue';
  import Slider from '@/uni_modules/tuikit-atomic-x/components/Slider.nvue';
  import {
    AudioChangerType,
    AudioReverbType,
    useAudioEffectState
  } from '@/uni_modules/tuikit-atomic-x/state/AudioEffectState';
  import { useDeviceState } from '@/uni_modules/tuikit-atomic-x/state/DeviceState';

  const props = defineProps({
    modelValue: {
      type: Boolean,
      default: false
    }
  });

  const emit = defineEmits(['update:modelValue']);

  const innerVisible = computed({
    get: () => props.modelValue,
    set: (v) => emit('update:modelValue', v)
  });

  const {
    isEarMonitorOpened,
    earMonitorVolume,
    audioChangerType,
    audioReverbType,
    setVoiceEarMonitorEnable,
    setVoiceEarMonitorVolume,
    setAudioChangerType,
    setAudioReverbType,
  } = useAudioEffectState();

  const { setCaptureVolume } = useDeviceState();

  const voiceVolume = ref(100);

  const voiceOptions = [
    { key: AudioChangerType.NONE, label: t('ae.original'), icon: '/uni_modules/tuikit-atomic-x/static/assets/live/sound-voice-original.png' },
    { key: AudioChangerType.CHILD, label: t('ae.child'), icon: '/uni_modules/tuikit-atomic-x/static/assets/live/sound-voice-child.png' },
    { key: AudioChangerType.LITTLE_GIRL, label: t('ae.loli'), icon: '/uni_modules/tuikit-atomic-x/static/assets/live/sound-voice-loli.png' },
    { key: AudioChangerType.MAN, label: t('ae.uncle'), icon: '/uni_modules/tuikit-atomic-x/static/assets/live/sound-voice-uncle.png' },
    { key: AudioChangerType.ETHEREAL, label: t('ae.ethereal'), icon: '/uni_modules/tuikit-atomic-x/static/assets/live/sound-voice-spirit.png' },
  ];

  const reverbOptions = [
    { key: AudioReverbType.NONE, label: t('ae.none'), icon: '/uni_modules/tuikit-atomic-x/static/assets/live/sound-reverb-none.png' },
    { key: AudioReverbType.KTV, label: t('ae.ktv'), icon: '/uni_modules/tuikit-atomic-x/static/assets/live/sound-reverb-ktv.png' },
    { key: AudioReverbType.METALLIC, label: t('ae.metal'), icon: '/uni_modules/tuikit-atomic-x/static/assets/live/sound-reverb-metal.png' },
    { key: AudioReverbType.DEEP, label: t('ae.deep'), icon: '/uni_modules/tuikit-atomic-x/static/assets/live/sound-reverb-deep.png' },
    { key: AudioReverbType.LOUD, label: t('ae.loud'), icon: '/uni_modules/tuikit-atomic-x/static/assets/live/sound-reverb-bright.png' },
  ];

  const handleEarMonitorChange = (next) => {
    setVoiceEarMonitorEnable({ enable: next });
  };

  const onEarVolumeInput = (v) => {
    earMonitorVolume.value = v;
    setVoiceEarMonitorVolume({ volume: v });
  };
  const onEarVolumeChange = (v) => {
    earMonitorVolume.value = v;
    setVoiceEarMonitorVolume({ volume: v });
  };

  const onVoiceVolumeInput = (v) => {
    voiceVolume.value = v;
    setCaptureVolume({ volume: v });
  };
  const onVoiceVolumeChange = (v) => {
    voiceVolume.value = v;
    setCaptureVolume({ volume: v });
  };

  const handleVoiceChange = (key) => {
    audioChangerType.value = key;
    setAudioChangerType({ changerType: key });
  };

  const handleReverbChange = (key) => {
    audioReverbType.value = key;
    setAudioReverbType({ reverbType: key });
  };
</script>

<style lang="scss">
  @import './AudioEffectPanel.scss';
</style>
