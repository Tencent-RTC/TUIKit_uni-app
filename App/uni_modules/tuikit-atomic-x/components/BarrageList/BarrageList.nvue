<template>
  <view class="barrage-container">
    <canvas canvas-id="barrageRuler" id="barrageRuler" class="barrage-ruler"></canvas>

    <list class="chat-list" scroll-y :show-scrollbar="false" :style="{ top: topPx + 'px', opacity: listReady ? 1 : 0, width: barWidthRpx, visibility: hidden ? 'hidden' : 'visible' }" @scroll="onListScroll" @touchstart="onUserTouchList" ref="chatListRef">
      <cell class="top-spacer-cell" :style="{ height: topSpacerPx + 'px' }"></cell>
      <cell class="welcome-cell" ref="welcomeCellRef">
        <view class="welcome-content-wrapper" :style="{ maxWidth: barWidthRpx }">
          <text class="welcome-text">{{ welcomeText }}</text>
        </view>
      </cell>
      <cell class="chat-item" :style="{ maxWidth: barWidthRpx }" v-if="mixMessageList.length > 0" v-for="(message) in mixMessageList" :key="msgKey(message)" @tap="onItemTap(message)">
        <view class="message-content-wrapper" :style="{ opacity: enteringSeqs.includes(msgKey(message)) ? 0 : 1, maxWidth: barWidthRpx }" :ref="(el: any) => collectCellRef(el, msgKey(message))">
          <view class="nickname-content-gift" :style="{ maxWidth: barWidthRpx }" v-if="message?.gift">
            <view class="live-level-badge">
              <image class="live-level-bg" :src="msgLevelBadge(message)" mode="scaleToFill" />
              <text class="live-level-num">{{ msgLevel(message) }}</text>
            </view>
            <text class="chat-nickname" :style="{ maxWidth: nickMaxWidthRpx + 'rpx' }" numberOfLines="1">{{ nickTextOf(message) }}</text>
            <view class="gift-row">
              <text class="gift-prefix">{{ t('bl.giftPrefix') }}</text>
              <text class="gift-name" :style="{ maxWidth: giftNameWidthPx(message) + 'px' }">{{ giftNameText(message) }}</text>
              <image class="gift-icon" :src="message?.gift?.iconURL || ''" alt="" />
              <text class="gift-count">×{{ message?.count || '1' }}</text>
            </view>
          </view>
          <view class="nickname-content-wrapper" v-else>
            <view class="msg-line" v-for="(line, lidx) in msgLines(message)" :key="lidx">
              <template v-if="lidx === 0">
                <view class="live-level-badge">
                  <image class="live-level-bg" :src="msgLevelBadge(message)" mode="scaleToFill" />
                  <text class="live-level-num">{{ msgLevel(message) }}</text>
                </view>
                <view class="message-right" v-if="isOwner(message)">
                  <view class="message-role">
                    <view class="message-role-inner">
                      <text class="message-role-text">{{ t('bl.anchor') }}</text>
                    </view>
                  </view>
                </view>
                <text class="chat-nickname" :style="{ maxWidth: nickMaxWidthRpx + 'rpx' }" numberOfLines="1">{{ nickTextOf(message) }}：</text>
              </template>
              <template v-for="(run, ridx) in line" :key="'r' + ridx">
                <text v-if="run.type === 'text'" class="chat-content-char">{{ run.text }}</text>
                <image v-else class="chat-content-emoji" :src="run.src" mode="aspectFit" />
              </template>
            </view>
          </view>
        </view>
      </cell>
      <cell ref="ListBottom" style="height: 10rpx;"></cell>
    </list>

    <view class="new-message-pill" :style="{ top: pillTopPx + 'px', opacity: unreadCount > 0 ? 1 : 0, visibility: hidden ? 'hidden' : 'visible' }" :userInteractionEnabled="unreadCount > 0" @tap="onNewMessagePillTap">
      <text class="new-message-pill-count">{{ unreadCount }}</text>
      <text class="new-message-pill-text">{{ t('bl.newMessages') }}</text>
    </view>
  </view>
</template>

<script setup lang="ts">
  import { ref, watch, computed, onMounted, onUnmounted, nextTick, getCurrentInstance } from 'vue';
  import { useBarrageState, BarrageType } from "@/uni_modules/tuikit-atomic-x/state/BarrageState";
  import { useGiftState } from "@/uni_modules/tuikit-atomic-x/state/GiftState";
  import { useLiveListState } from "@/uni_modules/tuikit-atomic-x/state/LiveListState";
  import { useLoginState } from "@/uni_modules/tuikit-atomic-x/state/LoginState";
  import { parseTextToSegments } from "@/uni_modules/tuikit-atomic-x/utils/emojiUtils";
  import { resolveMsgLevel, levelBadgeUrl } from './levelBadge';
  import { createCharRuler } from './textMeasurer';
  import { wrapSegmentsIntoLines } from './lineBreaker';
  import { t } from '../locales';

  const props = defineProps<{
    mode?: 'anchor' | 'audience',
    bottomPx?: number,
    topPx?: number,
    liveID?: string,
    width?: number,
    hidden?: boolean,
  }>();

  const emit = defineEmits(['itemTap', 'receiveGift']);

  const mode = computed(() => props.mode || 'audience');
  const welcomeText = computed(() => t(mode.value === 'anchor' ? 'bl.welcomeHost' : 'bl.welcome'));
  const bottomPx = computed(() => props.bottomPx ?? 0);
  const topPx = computed(() => props.topPx ?? 0);
  const LIST_H_PX = uni.upx2px(380);
  const PILL_H_PX = uni.upx2px(52);
  const pillTopPx = computed(() => Math.max(0, topPx.value + LIST_H_PX - PILL_H_PX));

  const barWidth = computed(() => props.width ?? 500);
  const barWidthRpx = computed(() => barWidth.value + 'rpx');

  const { loginUserInfo } = useLoginState();
  const msgLevel = (message: any): number => resolveMsgLevel(message);
  const msgLevelBadge = (message: any): string => levelBadgeUrl(msgLevel(message));

  const { currentLive } = useLiveListState();
  const liveID = computed(() => props.liveID || String(currentLive.value?.liveID || ''));

  const { messageList } = useBarrageState(liveID.value);
  const { addGiftListener, removeGiftListener } = useGiftState(liveID.value);

  const isOwner = (message: any): boolean => !!message?.__owner;

  const isRenderableBarrage = (m: any): boolean => m?.messageType !== BarrageType.CUSTOM;

  const snapshotMessage = (m: any) => {
    const snap: any = {
      ...m,
      sender: m?.sender ? { ...m.sender } : m?.sender,
      gift: m?.gift ? { ...m.gift } : m?.gift,
      recipient: m?.recipient ? { ...m.recipient } : m?.recipient,
    };
    if (!(Number(snap?.sender?.level) > 0) && snap?.sender?.userID
      && snap.sender.userID === uni.$userID) {
      snap.sender = { ...(snap.sender || {}), level: Number(loginUserInfo.value?.level) || 0 };
    }
    snap.__owner = !!(snap?.sender?.userID && currentLive.value?.liveOwner?.userID
      && snap.sender.userID === currentLive.value.liveOwner.userID);
    return snap;
  };

  const mixMessageList = ref<any[]>((messageList.value || []).filter(isRenderableBarrage).map(snapshotMessage));

  const FONT_PX = uni.upx2px(26);
  const EMOJI_PX = uni.upx2px(34);
  const NICK_MAX_CHARS = 20;
  const NICK_MAX_RATIO = 0.45;
  const nickMaxWidthRpx = computed(() =>
    Math.max(160, Math.round((barWidth.value - 24) * NICK_MAX_RATIO))
  );
  const nickMaxWidthPx = computed(() => uni.upx2px(nickMaxWidthRpx.value));
  const NICK_MARGIN_PX = uni.upx2px(8);
  const BADGE_PX = uni.upx2px(68 + 8);
  const ANCHOR_PX = uni.upx2px(66);
  const contentWidthPx = computed(() => uni.upx2px(barWidth.value - 24));

  let rulerCtx: any = null;
  const rulerReady = ref(false);
  const rulerVersion = ref(0);

  const rawMeasure = (ch: string): number | null => {
    if (!rulerReady.value || !rulerCtx) return null;
    try {
      const m: any = rulerCtx.measureText(ch);
      return (m && m.width > 0) ? m.width : null;
    } catch (e) { return null; }
  };
  const ruler = createCharRuler({ fontPx: FONT_PX, safety: 1.05, measureRaw: rawMeasure });

  const initRuler = () => {
    try {
      const inst: any = getCurrentInstance();
      let ctx: any = null;
      try { ctx = uni.createCanvasContext('barrageRuler', inst && (inst.proxy || inst)); } catch (e) { ctx = null; }
      if (!ctx) { try { ctx = uni.createCanvasContext('barrageRuler'); } catch (e) { ctx = null; } }
      if (!ctx) return;
      try { ctx.setFontSize(FONT_PX); } catch (e) { /* ignore */ }
      let ok = false;
      try { const m: any = ctx.measureText('测'); ok = !!(m && m.width > 0); } catch (e) { ok = false; }
      rulerCtx = ctx;
      if (ok) {
        rulerReady.value = true;
        ruler.reset();
        rulerVersion.value++;
      }
    } catch (e) { /* ignore: 尺子不可用时全程走估算,CJK 仍精确 */ }
  };

  const layoutCache = new Map<string, any>();
  const msgLines = (message: any): any[] => {
    const key = msgKey(message) + '|' + contentWidthPx.value + '|' + rulerVersion.value + '|' + (isOwner(message) ? '1' : '0');
    const cached = layoutCache.get(key);
    if (cached) return cached;
    const segs = parseTextToSegments(message?.textContent || '');
    const nickText = nickTextOf(message) + '：';
    const nickPx = Math.min(ruler.measureStrPx(nickText), nickMaxWidthPx.value) + NICK_MARGIN_PX;
    const headerPx = BADGE_PX + (isOwner(message) ? ANCHOR_PX : 0) + nickPx;
    const line0AvailPx = Math.max(0, contentWidthPx.value - headerPx);
    const lines = wrapSegmentsIntoLines(segs, {
      line0AvailPx,
      lineNAvailPx: contentWidthPx.value,
      emojiPx: EMOJI_PX,
      measureCharPx: ruler.measureCharPx,
    });
    if (layoutCache.size > 600) layoutCache.clear();
    layoutCache.set(key, lines);
    return lines;
  };

  const GIFT_NAME_MARGIN_PX = uni.upx2px(6);
  const GIFT_ICON_PX = uni.upx2px(24);
  const GIFT_COUNT_MAX_PX = uni.upx2px(110);

  const giftNameWidthPx = (message: any): number => {
    if (rulerVersion.value < 0) return 0;
    const nickText = nickTextOf(message);
    const nickPx = Math.min(ruler.measureStrPx(nickText), nickMaxWidthPx.value) + NICK_MARGIN_PX;
    const prefixPx = ruler.measureStrPx(t('bl.giftPrefix')) + GIFT_NAME_MARGIN_PX;
    const countStr = '×' + String(message?.count || '1');
    const countPx = Math.min(ruler.measureStrPx(countStr), GIFT_COUNT_MAX_PX) + GIFT_NAME_MARGIN_PX;
    const reservedPx = BADGE_PX + nickPx + prefixPx + GIFT_NAME_MARGIN_PX + GIFT_ICON_PX + countPx;
    const avail = contentWidthPx.value - reservedPx;
    return Math.max(0, Math.round(avail));
  };

  const nickTextOf = (message: any): string => {
    const raw = String(message?.sender?.userName || message?.sender?.userID || '');
    return raw.length > NICK_MAX_CHARS ? `${raw.slice(0, NICK_MAX_CHARS)}…` : raw;
  };

  const giftNameText = (message: any): string => {
    const name = String(message?.textContent || '');
    const avail = giftNameWidthPx(message);
    if (avail <= 0 || ruler.measureStrPx(name) <= avail) return name;
    const chars = Array.from(name);
    const ellipsisPx = ruler.measureStrPx('…');
    let acc = 0;
    let kept = '';
    for (let i = 0; i < chars.length; i++) {
      const w = ruler.measureCharPx(chars[i]);
      if (acc + w + ellipsisPx > avail) break;
      acc += w;
      kept += chars[i];
    }
    return kept + '…';
  };

  const dom = uni.requireNativePlugin('dom');
  const ListBottom = ref('ListBottom');

  const pendingTimers = new Set<any>();
  let isDestroyed = false;
  const later = (fn: () => void, ms: number): any => {
    if (isDestroyed) return null;
    const id = setTimeout(() => {
      pendingTimers.delete(id);
      if (isDestroyed) return;
      fn();
    }, ms);
    pendingTimers.add(id);
    return id;
  };
  const clearPendingTimers = () => {
    pendingTimers.forEach((id) => clearTimeout(id));
    pendingTimers.clear();
  };

  const scrollToBottom = () => {
    programmaticScrollUntil = Date.now() + 600;
    nextTick(() => {
      later(() => {
        if (isDestroyed) return;
        try {
          dom.scrollToElement(ListBottom.value, {
            offset: 0,
            animated: true
          });
        } catch (e) { /* ignore */ }
      }, 100);
    });
  };

  const NEAR_BOTTOM_THRESHOLD = 16;
  const following = ref(true);
  let hasUserTouchedList = false;
  let programmaticScrollUntil = 0;
  const topSpacerPx = ref(0);
  const listReady = ref(false);
  const WELCOME_EST_PX = 95;
  const welcomeHeightPx = ref(0);
  let listContentHeight = 0;
  let listViewportPx = uni.upx2px(380);
  let spacerFrozen = false;
  const welcomeCellRef = ref<any>(null);
  const SINGLE_MSG_HEIGHT_PX = 54 * 0.88;
  const recomputeTopSpacer = () => {
    if (spacerFrozen) return;
    if (listViewportPx <= 0) return;
    const welcomeH = welcomeHeightPx.value > 0 ? welcomeHeightPx.value : WELCOME_EST_PX;
    const contentH = listContentHeight > 0 ? listContentHeight : welcomeH;
    const remain = Math.round(listViewportPx - contentH);
    if (remain > 2) topSpacerPx.value = remain;
    else {
      topSpacerPx.value = 0;
      spacerFrozen = true;
    }
  };
  const unreadCount = ref(0);
  const chatListRef = ref<any>(null);
  let listViewportHeight = 0;

  const measureListHeight = () => {
    try {
      if (chatListRef.value) {
        dom.getComponentRect(chatListRef.value, (res: any) => {
          const h = res?.size?.height || 0;
          if (h > 0) {
            listViewportHeight = h;
            listViewportPx = h;
            recomputeTopSpacer();
          }
        });
      }
    } catch (e) { /* ignore */ }
  };

  const measureWelcomeHeight = () => {
    try {
      const el = welcomeCellRef.value;
      if (!el) return;
      dom.getComponentRect(el, (r: any) => {
        const h = r?.size?.height || 0;
        if (h > 0) {
          welcomeHeightPx.value = h;
          listContentHeight = welcomeHeightPx.value + mixMessageList.value.length * SINGLE_MSG_HEIGHT_PX;
          recomputeTopSpacer();
        }
      });
    } catch (e) { /* ignore */ }
  };

  const onUserTouchList = () => {
    hasUserTouchedList = true;
  };

  const onListScroll = (e: any) => {
    const rawY = (e?.contentOffset?.y ?? e?.detail?.scrollTop ?? e?.scrollY ?? 0) as number;
    const offsetY = Math.abs(rawY);
    const contentH = (e?.contentSize?.height ?? e?.detail?.scrollHeight ?? e?.contentHeight ?? 0) as number;
    if (!(contentH > 0) || !(listViewportHeight > 0)) return;
    const bottomCellPx = 10 * 0.88;
    const trueNetH = Math.max(0, contentH - topSpacerPx.value - bottomCellPx);
    if (Math.abs(trueNetH - listContentHeight) > 4) {
        listContentHeight = trueNetH;
      recomputeTopSpacer();
    }
    if (!hasUserTouchedList) {
      following.value = true;
      if (unreadCount.value > 0) {
        unreadCount.value = 0;
      }
      return;
    }
    const bottomGap = contentH - offsetY - listViewportHeight;
    const nearBottom = bottomGap <= NEAR_BOTTOM_THRESHOLD;
    if (!nearBottom && Date.now() < programmaticScrollUntil) {
      return;
    }
    following.value = nearBottom;
    if (nearBottom && unreadCount.value > 0) {
      unreadCount.value = 0;
    }
  };

  const onNewMessagePillTap = () => {
    following.value = true;
    unreadCount.value = 0;
    scrollToBottom();
    later(() => {
      try {
        if (following.value) {
          dom.scrollToElement(ListBottom.value, { offset: 0, animated: false });
        }
      } catch (e) { /* ignore */ }
    }, 600);
  };

  const scrollOrCountUnread = (added: number) => {
    if (following.value) {
      scrollToBottom();
    } else {
      unreadCount.value += Math.max(1, added);
    }
  };

  const animation = uni.requireNativePlugin('animation');

  const cellRefs = new Map<any, any>();
  const collectCellRef = (el: any, seq: any) => {
    if (el) cellRefs.set(seq, el);
    else cellRefs.delete(seq);
  };

  let firstAppendDone = false;
  const enteringSeqs = ref<any[]>([]);

  const dismissEntering = (seqs: any[]) => {
    enteringSeqs.value = enteringSeqs.value.filter((s: any) => !seqs.includes(s));
  };

  const appendMessages = (msgs: any[]) => {
    if (!msgs || msgs.length === 0) return;
    const snaps = msgs.map(snapshotMessage);
    const animate = firstAppendDone && snaps.length === 1 && enteringSeqs.value.length === 0;
    const newSeqs = snaps.map((m: any) => msgKey(m));
    if (animate) {
      enteringSeqs.value = [...enteringSeqs.value, ...newSeqs];
    }
    mixMessageList.value = [...mixMessageList.value, ...snaps];
    firstAppendDone = true;
    if (animate) {
      nextTick(() => {
        later(() => {
          snaps.forEach((m: any) => {
            const seq = msgKey(m);
            const el = cellRefs.get(seq);
            if (el) {
              try {
                animation.transition(el, {
                  styles: { opacity: 1 },
                  duration: 300,
                  timingFunction: 'ease-out'
                }, () => {
                  dismissEntering([seq]);
                });
              } catch (e) {
                dismissEntering([seq]);
              }
            } else {
              dismissEntering([seq]);
            }
          });
          later(() => {
            dismissEntering(newSeqs);
          }, 600);
        }, 50);
      });
    }
  };

  watch(messageList, (newVal, oldVal) => {
    if (!newVal) return;
    const delta = newVal.slice((oldVal || []).length, (newVal || []).length);
    const value = delta.filter(isRenderableBarrage);
    if (value.length > 0) {
      appendMessages(value);
      scrollOrCountUnread(value.length);
      listContentHeight = welcomeHeightPx.value + mixMessageList.value.length * SINGLE_MSG_HEIGHT_PX;
      recomputeTopSpacer();
    }
  }, {
    deep: true,
    immediate: true
  });

  const msgKey = (m: any) => m?.sequence ?? m?.__localKey;
  const onItemTap = (message: any) => {
    emit('itemTap', message);
  };

  const GIFT_COMBO_MS = 2000;
  const pendingGiftMessages = new Map();
  const addGiftMessage = (value: any) => {
    const giftId = value?.gift?.giftID || value?.gift?.name || '';
    const senderId = value?.sender?.userID || '';
    const recipientId = (value?.recipient && value.recipient.userID) || '';
    const comboKey = `${senderId}:${giftId}:${recipientId}`;
    const pending = pendingGiftMessages.get(comboKey);
    if (pending) {
      pending.count += Math.max(1, Math.round(Number(value.count) || 1));
      clearTimeout(pending.timer);
    }
    const count = pending ? pending.count : Math.max(1, Math.round(Number(value.count) || 1));
    pendingGiftMessages.set(comboKey, {
      value,
      count,
      timer: setTimeout(() => {
        pendingGiftMessages.delete(comboKey);
        const merged = { ...value, count };
        appendMessages([merged]);
        scrollOrCountUnread(1);
        listContentHeight = welcomeHeightPx.value + mixMessageList.value.length * SINGLE_MSG_HEIGHT_PX;
        recomputeTopSpacer();
      }, GIFT_COMBO_MS),
    });
  };

  const handleReceiveGift =
    (event) => {
      const res = JSON.parse(event)
      const gift = typeof res.gift === 'string' ? JSON.parse(res.gift) : res.gift;
      const sender = typeof res.sender === 'string' ? JSON.parse(res.sender) : res.sender;
      const giftData = { ...res, gift, sender };

      const value = {
        ...giftData,
        textContent: `${gift?.name || ''}`,
        __localKey: `gift_${Date.now()}_${Math.random().toString(36).slice(2, 8)}`,
      };
      addGiftMessage(value);

      emit('receiveGift', giftData);
    }

  onMounted(() => {
    watch(liveID, (id, _, onCleanup) => {
      if (!id) return;
      addGiftListener(id, 'onReceiveGift', handleReceiveGift);
      onCleanup(() => removeGiftListener(id, 'onReceiveGift', handleReceiveGift));
    }, { immediate: true });
    initRuler();
    measureListHeight();
    measureWelcomeHeight();
    listContentHeight = (welcomeHeightPx.value > 0 ? welcomeHeightPx.value : WELCOME_EST_PX)
      + mixMessageList.value.length * SINGLE_MSG_HEIGHT_PX;
    recomputeTopSpacer();
    nextTick(() => {
      measureWelcomeHeight();
      recomputeTopSpacer();
      later(() => {
        measureWelcomeHeight();
        recomputeTopSpacer();
        listReady.value = true;
      }, 60);
    });
    later(() => {
      measureListHeight();
    }, 300);
    later(() => { listReady.value = true; }, 600);
  });
  onUnmounted(() => {
    isDestroyed = true;
    clearPendingTimers();
    pendingGiftMessages.forEach(p => clearTimeout(p.timer));
    pendingGiftMessages.clear();
  });
</script>

<style>
  .barrage-container {
    position: relative;
  }

  .barrage-ruler {
    position: fixed;
    left: -1000px;
    top: -1000px;
    width: 200px;
    height: 40px;
  }

  .chat-list {
    position: fixed;
    left: 32rpx;
    top: 0;
    height: 380rpx;
    width: 500rpx;
  }

  .new-message-pill {
    position: fixed;
    left: 32rpx;
    height: 52rpx;
    padding-left: 20rpx;
    padding-right: 20rpx;
    border-radius: 26rpx;
    border-width: 2rpx;
    border-style: solid;
    border-color: rgba(74, 158, 255, 0.34);
    background-color: rgba(10, 12, 18, 0.96);
    box-shadow: 0 10rpx 32rpx rgba(0, 0, 0, 0.38);
    flex-direction: row;
    align-items: center;
    justify-content: center;
    z-index: 998;
  }

  .new-message-pill-text {
    color: #ffffff;
    font-size: 22rpx;
    font-weight: 600;
  }

  .new-message-pill-count {
    color: #78D8FF;
    font-size: 22rpx;
    font-weight: 600;
    margin-right: 6rpx;
  }

  .welcome-content-wrapper {
    background-color: rgba(0, 0, 0, 0.25);
    border-top-left-radius: 24rpx;
    border-top-right-radius: 24rpx;
    border-bottom-left-radius: 24rpx;
    border-bottom-right-radius: 24rpx;
    padding: 12rpx 16rpx;
    max-width: 500rpx;
    margin-bottom: 10rpx;
  }

  .welcome-text {
    color: #78d8ff;
    font-size: 26rpx;
    font-weight: 600;
  }

  .chat-item {
    flex-direction: row;
    align-items: flex-start;
    border-top-left-radius: 24rpx;
    border-top-right-radius: 24rpx;
    border-bottom-left-radius: 24rpx;
    border-bottom-right-radius: 24rpx;
    padding: 6rpx 6rpx 6rpx 0;
    max-width: 500rpx;
  }

  .welcome-cell {
    flex-direction: row;
    align-items: flex-start;
  }

  .top-spacer-cell {
    width: 1rpx;
  }

  .message-content-wrapper {
    flex-direction: row;
    align-items: flex-start;
    min-width: 0;
    max-width: 500rpx;
    background-color: rgba(0, 0, 0, 0.25);
    border-top-left-radius: 24rpx;
    border-top-right-radius: 24rpx;
    border-bottom-left-radius: 24rpx;
    border-bottom-right-radius: 24rpx;
    padding: 8rpx 12rpx;
    position: relative;
  }

  .nickname-content-wrapper {
    flex: 1;
    flex-direction: column;
    align-items: flex-start;
