<template>
  <view class="like-container">
    <view
      class="like-btn-bg"
      :ref="(el: any) => { if (el) likeBtnRef = el; }"
      @touchstart="onPressStart"
      @touchend="onPressEnd"
      @touchcancel="onPressEnd"
      @click="handleLikeTap"
      v-if="role !== 'anchor'"
    >
      <image class="like-btn-icon" src="/uni_modules/tuikit-atomic-x/static/assets/live/live-like.png" mode="aspectFit" />
    </view>

    <view class="like-float-layer" v-if="floats.length > 0">
      <view
        v-for="f in floats"
        :key="f.id"
        class="like-float"
        :style="{
          left: (f.startX - 40) + 'rpx',
          transform: 'translate(' + f.tx + 'rpx, ' + f.ty + 'rpx) scale(' + f.scale + ')',
          opacity: f.opacity
        }"
      >
        <image class="like-float-icon" :src="f.iconSrc" mode="aspectFit" />
      </view>
    </view>
  </view>
</template>

<script setup lang="ts">
  import { ref, onMounted, onUnmounted } from 'vue';
  import { useLikeState } from "@/uni_modules/tuikit-atomic-x/state/LikeState";

  const props = defineProps({
    role: {
      type: String,
      default: 'audience',
      validator: (value: string) => ['anchor', 'audience'].includes(value)
    },
    // 同屏最大漂浮数量：过多会拖累 nvue 逐帧 style patch 通信
    maxConcurrent: {
      type: Number,
      default: 8,
    },
    enableHaptics: {
      type: Boolean,
      default: true,
    },
  });

  const { sendLike, addLikeListener, removeLikeListener } = useLikeState(uni.$liveID);

  // nvue 原生 animation 模块：直接对按钮元素 ref 执行 transform/opacity 动画（与底部操作按钮统一），
  // 不依赖 CSS transition（nvue Weex 上 class/style 切 transform 不稳定）。
  const animation = uni.requireNativePlugin('animation');

  // ============ 按钮按压反馈 ============
  // 按压态仅缩放不改透明度：transform: scale(0.92)。
  //
  // 注意：nvue 的 animation.transition 打断进行中的动画时，起点不像浏览器 CSS :active 那样从
  // 「当前真实插值」平滑接续，导致轻点（touchstart 后立刻 touchend）时收缩还没起来就被回弹覆盖、
  // 几乎看不到缩放。为此加「最小可见按压时长」：按下即播收缩，抬起若过快则延迟回弹补足到
  // MIN_PRESS_VISIBLE_MS，保证轻点也能看到「缩到 0.92 再回弹」。长按行为不变（与底部操作按钮统一）。
  let likeBtnRef: any = null;
  const BTN_ANIM_DURATION = 120;
  const BTN_ANIM_TIMING = 'ease';
  const BTN_PRESSED_SCALE = 0.92;
  const MIN_PRESS_VISIBLE_MS = 120;
  let likeBtnPressAt = 0;
  let likeBtnReleaseTimer: any = null;

  function transitionBtn(pressed: boolean) {
    if (!likeBtnRef) return;
    animation.transition(likeBtnRef, {
      styles: {
        transform: pressed ? `scale(${BTN_PRESSED_SCALE})` : 'scale(1)',
      },
      duration: BTN_ANIM_DURATION,
      timingFunction: BTN_ANIM_TIMING,
    });
  }

  function onPressStart() {
    if (likeBtnReleaseTimer != null) { clearTimeout(likeBtnReleaseTimer); likeBtnReleaseTimer = null; }
    likeBtnPressAt = Date.now();
    transitionBtn(true);
  }
  function onPressEnd() {
    const elapsed = Date.now() - likeBtnPressAt;
    const delay = Math.max(0, MIN_PRESS_VISIBLE_MS - elapsed);
    if (likeBtnReleaseTimer != null) { clearTimeout(likeBtnReleaseTimer); likeBtnReleaseTimer = null; }
    if (delay === 0) {
      transitionBtn(false);
      return;
    }
    likeBtnReleaseTimer = setTimeout(() => {
      transitionBtn(false);
      likeBtnReleaseTimer = null;
    }, delay);
  }

  // ============ 飘心动画 ============
  const REACTION_ICONS = [
    '/uni_modules/tuikit-atomic-x/static/assets/live/reaction-thumb.png',
    '/uni_modules/tuikit-atomic-x/static/assets/live/reaction-heart.png',
    '/uni_modules/tuikit-atomic-x/static/assets/live/reaction-double-heart.png',
    '/uni_modules/tuikit-atomic-x/static/assets/live/reaction-fire.png',
    '/uni_modules/tuikit-atomic-x/static/assets/live/reaction-sparkle.png',
  ];

  interface Float {
    id: number;
    iconSrc: string;
    startX: number;
    tx: number;
    ty: number;
    scale: number;
    opacity: number;
    bornAt: number;
    duration: number;
    p1x: number; p1y: number;
    p2x: number; p2y: number;
    p3x: number; p3y: number;
    p4x: number; p4y: number;
  }

  const floats = ref<Float[]>([]);
  let floatSeq = 0;
  let rafTimer: any = null;

  // 关键帧节点：0% / 12.5% / 42.25% / 70.25% / 80.75% / 100%
  const STAGE_1 = 0.125;
  const STAGE_2 = 0.4225;
  const STAGE_3 = 0.7025;
  const STAGE_4 = 0.8075;
  const RISE_Y = -100;
  // layer 宽度需与 CSS 保持一致；按钮位于 layer 右侧
  const LAYER_W = 380;
  const BTN_CENTER_FROM_RIGHT = 156;

  // 点击节流：SPAWN_THROTTLE 内的重复调用直接丢弃，避免同屏飘心堆积拖累帧率
  const SPAWN_THROTTLE = 80;
  let lastSpawnAt = 0;

  function lerp(a: number, b: number, t: number): number {
    return a + (b - a) * t;
  }

  function easeOutCubic(t: number): number {
    const inv = 1 - t;
    return 1 - inv * inv * inv;
  }

  function tick() {
    if (floats.value.length === 0) {
      rafTimer = null;
      return;
    }
    const now = Date.now();
    // 倒序遍历：finished 时 splice 精准剔除；其余只改 reactive 属性触发精准 patch，
    // 不做整体数组替换（否则 nvue 会重建 native view，视觉卡顿）
    for (let i = floats.value.length - 1; i >= 0; i--) {
      const f = floats.value[i];
      const p = (now - f.bornAt) / f.duration;
      if (p >= 1) {
        floats.value.splice(i, 1);
        continue;
      }
      if (p < STAGE_1) {
        const k = easeOutCubic(p / STAGE_1);
        f.tx = 0;
        f.ty = lerp(0, RISE_Y, k);
        f.scale = lerp(0.2, 1, k);
        f.opacity = 1;
      } else if (p < STAGE_2) {
        const k = (p - STAGE_1) / (STAGE_2 - STAGE_1);
        f.tx = lerp(0, f.p1x, k);
        f.ty = lerp(RISE_Y, f.p1y, k);
        f.scale = 1;
        f.opacity = lerp(1, 0.66, k);
      } else if (p < STAGE_3) {
        const k = (p - STAGE_2) / (STAGE_3 - STAGE_2);
        f.tx = lerp(f.p1x, f.p2x, k);
        f.ty = lerp(f.p1y, f.p2y, k);
        f.scale = 1;
        f.opacity = lerp(0.66, 0.34, k);
      } else if (p < STAGE_4) {
        const k = (p - STAGE_3) / (STAGE_4 - STAGE_3);
        f.tx = lerp(f.p2x, f.p3x, k);
        f.ty = lerp(f.p2y, f.p3y, k);
        f.scale = 1;
        f.opacity = lerp(0.34, 0.22, k);
      } else {
        const k = (p - STAGE_4) / (1 - STAGE_4);
        f.tx = lerp(f.p3x, f.p4x, k);
        f.ty = lerp(f.p3y, f.p4y, k);
        f.scale = 1;
        f.opacity = lerp(0.22, 0, k);
      }
    }
    rafTimer = setTimeout(tick, 16);
  }

  function ensureTicking() {
    if (rafTimer == null) rafTimer = setTimeout(tick, 16);
  }

  // 生成一条飘心：从按钮中心蹿出，四段近乎垂直上升的漂移路径。
  // X 方向只在 -2~-14rpx 微摆，飘心几乎垂直上升，避免侧向漂出容器被裁切。
  function spawnFloat() {
    const now = Date.now();
    if (now - lastSpawnAt < SPAWN_THROTTLE) return;
    lastSpawnAt = now;

    const startX = LAYER_W - BTN_CENTER_FROM_RIGHT + (Math.random() * 20 - 10);
    // rise2：整体总上升量。配合 RISE_Y=-100，最高 Y 约 -260rpx
    const rise2 = 100 + Math.random() * 60;
    const p1x = -(8 + Math.random() * 4);
    const p1y = RISE_Y - rise2 * 0.34;
    const p2x = -(2 + Math.random() * 4);
    const p2y = RISE_Y - rise2 * 0.66;
    const p3x = -(10 + Math.random() * 4);
    const p3y = RISE_Y - rise2 * 0.78;
    const p4x = -(6 + Math.random() * 4);
    const p4y = RISE_Y - rise2;
    const duration = 1500 + Math.round(Math.random() * 200);
    const iconSrc = REACTION_ICONS[Math.floor(Math.random() * REACTION_ICONS.length)];

    const item: Float = {
      id: ++floatSeq,
      iconSrc,
      startX,
      tx: 0, ty: 0, scale: 0.2, opacity: 1,
      bornAt: Date.now(),
      duration,
      p1x, p1y, p2x, p2y, p3x, p3y, p4x, p4y,
    };

    // 超上限则丢最旧
    if (floats.value.length >= props.maxConcurrent) {
      floats.value.splice(0, 1);
    }
    floats.value.push(item);
    ensureTicking();
  }

  // ============ 后端发送策略：6s 内累积批量发送，动画每次点击立即出 ============
  const pendingCount = ref(0);
  let batchTimer: any = null;
  let lastSendAt = 0;
  const BATCH_DELAY = 6000;

  function flushBatch() {
    if (pendingCount.value <= 0) return;
    const count = pendingCount.value;
    pendingCount.value = 0;
    lastSendAt = Date.now();
    sendLike({
      liveID: uni.$liveID,
      count,
      success: () => { /* noop */ },
      fail: (code: any, msg: any) => {
        console.error(`sendLike failed, code: ${code}, msg: ${msg}`);
      },
    });
    if (batchTimer != null) { clearTimeout(batchTimer); batchTimer = null; }
  }

  function handleLikeTap() {
    if (props.enableHaptics) {
      const info = uni.getSystemInfoSync();
      if (info && info.platform === 'android') {
        uni.vibrateShort({ type: 'light' });
      }
    }
    spawnFloat();

    pendingCount.value += 1;
    const now = Date.now();
    if (lastSendAt === 0 || now - lastSendAt >= BATCH_DELAY) {
      flushBatch();
      return;
    }
    if (batchTimer == null) {
      const remain = Math.max(0, BATCH_DELAY - (now - lastSendAt));
      batchTimer = setTimeout(flushBatch, remain);
    }
  }

  function handleReceiveLikesMessage(event: any) {
    const res = typeof event === 'string' ? JSON.parse(event) : event;
    const sender = typeof res?.sender === 'string' ? JSON.parse(res.sender) : res?.sender;
    if (sender && sender.userID === uni.$userID) return;
    spawnFloat();
  }

  function triggerLike() {
    spawnFloat();
  }

  onMounted(() => {
    addLikeListener(uni.$liveID, 'onReceiveLikesMessage', handleReceiveLikesMessage);
  });

  onUnmounted(() => {
    removeLikeListener(uni.$liveID, 'onReceiveLikesMessage', handleReceiveLikesMessage);
    if (rafTimer != null) { clearTimeout(rafTimer); rafTimer = null; }
    if (batchTimer != null) { clearTimeout(batchTimer); batchTimer = null; }
    if (likeBtnReleaseTimer != null) { clearTimeout(likeBtnReleaseTimer); likeBtnReleaseTimer = null; }
    // 组件卸载前 flush 未发送量，避免吞点赞
    if (pendingCount.value > 0) flushBatch();
  });

  defineExpose({ triggerLike });
</script>

<style>
  /* 明确宽高：避免 nvue Weex 里 relative + 无尺寸 view 被 flex 父级压到 0×0 */
  .like-container {
    position: relative;
    width: 88rpx;
    height: 72rpx;
    flex-direction: row;
    align-items: center;
  }

  .like-btn-bg {
    width: 72rpx;
    height: 72rpx;
    background-color: rgba(20, 20, 22, 0.54);
    border-radius: 50%;
    border-width: 2rpx;
    border-color: rgba(255, 255, 255, 0.055);
    margin-left: 16rpx;
    justify-content: center;
    align-items: center;
  }

  .like-btn-icon {
    width: 72rpx;
    height: 72rpx;
  }

  /* fixed 定位脱离 flex 相对定位链；right -80rpx 让右边界超出屏幕，
     为飘心右侧起点抖动留出 padding，避免右侧被裁 */
  .like-float-layer {
    position: fixed;
    right: -80rpx;
    bottom: 116rpx;
    width: 380rpx;
    height: 520rpx;
    z-index: 100;
  }

  /* bottom: -40rpx 让元素中心贴 layer 底线（= 按钮中心线） */
  .like-float {
    position: absolute;
    bottom: -40rpx;
    width: 80rpx;
    height: 80rpx;
    transform-origin: center center;
  }

  .like-float-icon {
    width: 80rpx;
    height: 80rpx;
  }
</style>
