<template>
  <view class="tools-panel">
    <scroll-view class="tools-scroll" scroll-y="true">
      <view class="tools-grid">
        <view v-for="(tool, index) in displayToolList" :key="tool.id" class="tool-item" :class="{ 'last-in-row': (index + 1) % 4 === 0 }">
          <view class="tool-icon-wrapper" @tap="handleToolClick(tool)">
            <image class="tool-icon" :src="tool.icon" mode="aspectFit"></image>
          </view>
          <text class="tool-name">{{ tool.name }}</text>
        </view>
      </view>
    </scroll-view>
  </view>
</template>

<script setup lang="ts">
  import { computed, ref } from 'vue';
  import { UserPickerType } from '../../types/userpicker';
  import { useMessageInputState } from '../../state/MessageInputState';
  import { MessageType } from '../../types/message';
  import type { OfflinePushInfoResolver } from '../../types/message';
  import { buildOfflinePushInfo } from '../../utils/buildOfflinePushInfo';
  import { chooseFile } from '../../hooks/useFilePicker';
  import { DEFAULT_TOOLS } from './types';
  import type { ToolItem } from './types';
  import { AlbumPickerMediaFilter } from '../AlbumPicker/AlbumPicker';
  import { openAlbumPicker } from './AlbumPickerMediaSendManager';
  import {
    useCallState,
    CallErrorCode
  } from '@/uni_modules/tuikit-atomic-x/state/CallState';
  import {
    useDeviceState
  } from "@/uni_modules/tuikit-atomic-x/state/DeviceState";
  import { getCurrentPageFullPath, isNavigating, isCallEnding } from "../../server/callService"
  import { checkCallPermissionWithDialog } from "@/uni_modules/tuikit-atomic-x/utils/callPermission";
  import { reportScene } from '@/uni_modules/tuikit-atomic-x';

  interface ToolsPanelProps {
    conversationID: string;
    toolList?: ToolItem[];
    /**
     * 业务方注入：在每次发送消息前回调本函数计算 offlinePushInfo（透传自 MessageInput）
     * 同步函数；返回 null/undefined 表示不附带；异常时兜底为不附带
     */
    setOfflinePushInfo?: OfflinePushInfoResolver;
  }

  const {
    calls,
    selfInfo,
    setCallFramework
  } = useCallState()
  const {
    openLocalCamera,
    openLocalMicrophone,
  } = useDeviceState();
  const props = withDefaults(defineProps<ToolsPanelProps>(), {
    conversationID: '',
  });

  const messageInputState = useMessageInputState({
    conversationID: props.conversationID,
  });

  // 计算属性
  const displayToolList = computed(() => {
    if (props.toolList && props.toolList.length > 0) {
      return props.toolList;
    }
    return DEFAULT_TOOLS;
  });

  const isC2CConversation = computed(() => props.conversationID.startsWith('c2c_'))

  // 移除无用的资源路径前缀
  const removeUnusedResourcePrefix = (path: string) => {
    return path.startsWith('file:///') ? path.substring(7) : path;
  };

  const handleToolClick = (tool: ToolItem) => {
    // 如果有自定义 callback，优先执行 callback
    if (tool.callback) {
      tool.callback();
      return;
    }

    // 内置工具处理
    switch (tool.id) {
      case 'image':
        openAlbumPicker(props.conversationID, {
          mediaFilter: AlbumPickerMediaFilter.IMAGE_ONLY,
          maxSelectionCount: 9,
          itemsPerRow: 3,
          showsCameraItem: true,
        });
        break;
      case 'video':
        openAlbumPicker(props.conversationID, {
          mediaFilter: AlbumPickerMediaFilter.IMAGE_AND_VIDEO,
          maxSelectionCount: 9,
          itemsPerRow: 3,
          showsCameraItem: true,
        });
        break;
      case 'file':
        chooseAndSendFile();
        break;
      case 'voiceCall':
        startCall(0);
        break;
      case 'videoCall':
        startCall(1);
        break;
      default:
        console.log('Tool clicked:', tool);
    }
  };

  /**
   * 调起系统文件选择器并发送文件消息
   */
  const chooseAndSendFile = () => {
    chooseFile({
      success: ({ filePath, fileName, fileSize }) => {
        if (!messageInputState) return;
        const messageBody = { filePath, fileName, fileSize };
        const offlinePushInfo = buildOfflinePushInfo(props.setOfflinePushInfo, {
          messageType: MessageType.FILE,
          messageBody,
          conversationID: props.conversationID,
        });
        const messageObj: any = {
          messageType: MessageType.FILE,
          messageBody,
        };
        if (offlinePushInfo) {
          messageObj.offlinePushInfo = offlinePushInfo;
        }
        const message: any = JSON.stringify(messageObj);
        messageInputState.sendMessage(message).catch((err: any) => {
          console.error('[ToolsPanel] sendFileMessage failed:', err);
          uni.showToast({ title: '文件发送失败', icon: 'none' });
        });
      },
      fail: (err: any) => {
        console.error('[ToolsPanel] chooseFile failed:', err);
        uni.showToast({ title: '文件选择失败', icon: 'none' });
      },
    });
  };

  // 呼叫防抖锁，防止频繁点击呼叫按钮
  const isCalling = ref(false);

  const startCall = async (mediaType: number) => {
    setCallFramework(15)
    // 防抖：上一次呼叫流程尚未完成时，不允许再次呼叫
    if (isCalling.value) {
      console.log('[ToolsPanel] call skipped: isCalling is true');
      return;
    }
    if (isNavigating()) {
      console.log('[ToolsPanel] call skipped: navigation in progress');
      return;
    }
    if (isCallEnding()) {
      console.log('[ToolsPanel] call skipped: previous call end still processing');
      return;
    }

    const getPeerUserID = () => {
      return isC2CConversation.value ? props.conversationID.replace('c2c_', '') : ''
    }
    if (isC2CConversation.value) {
      if (selfInfo.value.status === 1 || selfInfo.value.status === 2) {
        plus.nativeUI.toast('您正在通话中，无法再次发起通话', {
          align: 'center',
          verticalAlign: 'center'
        });
        return
      }

      isCalling.value = true;

      if (mediaType === 1) {
        openLocalCamera({
          isFront: true
        })
      }
      openLocalMicrophone({
        fail: (error) => {
          if (error === -1104) {
            setTimeout(() => {
              openLocalMicrophone();
            }, 200);
          }
        }
      })
      const hasPermission = await checkCallPermissionWithDialog(mediaType);
      if (!hasPermission) {
        isCalling.value = false;
        return;
      }
      reportScene('CHAT_INVOKE_CALL');
      calls({
        participantIds: [getPeerUserID()],
        mediaType,
        success: () => {
          uni.$callSource = 'caller'
          uni.$lastPage = getCurrentPageFullPath()
          uni.navigateTo({
            url: '/uni_modules/tuikit-atomic-x/pages/call?layoutTemplate=Float',
            complete: () => { isCalling.value = false; }
          })
        },
        fail: (error) => {
          if (error === CallErrorCode.PACKAGE_NOT_PURCHASED) {
            uni.showToast({
              icon: 'none',
              title: '您的应用还未开通音视频通话（TUICallKit）能力，您可以去控制台申请免费体验'
            })
            console.error('控制台申请免费体验,https://console.cloud.tencent.com/trtc')
          }
          isCalling.value = false;
        }
      })
    } else {
      // 监听承载页 uni.$emit('onSelectGroupMember') 回传（Vue2/Vue3 nvue 统一方案）
      uni.$off('onSelectGroupMember')
      uni.$once('onSelectGroupMember', async (data) => {
        if (isCalling.value) return;
        if (isNavigating()) return;
        if (isCallEnding()) return;

        if (selfInfo.value.status === 1 || selfInfo.value.status === 2) {
          plus.nativeUI.toast('您正在通话中，无法再次发起通话', {
            align: 'center',
            verticalAlign: 'center'
          });
          return
        }

        isCalling.value = true;

        if (mediaType === 1) {
          openLocalCamera({
            isFront: true
          })
        }
        openLocalMicrophone({
          fail: (error) => {
            if (error === -1104) {
              setTimeout(() => {
                openLocalMicrophone();
              }, 200);
            }
          }
        })
        const hasPermission = await checkCallPermissionWithDialog(mediaType);
        if (!hasPermission) {
          isCalling.value = false;
          return;
        }
        reportScene('CHAT_INVOKE_CALL');
        const userIDList = data.selectedUsers.map(user => user.userID);
        if (userIDList.length > 8) {
          uni.showToast({
            icon: "none",
            title: "当前通话最多支持 9 人同时在线",
          });
          isCalling.value = false;
          return;
        }
        calls({
          participantIds: userIDList,
          mediaType,
          params: {
            chatGroupId: props.conversationID.replace('group_', ''),
          },
          success: () => {
            uni.$callSource = 'caller'
            uni.$lastPage = getCurrentPageFullPath()
            uni.navigateTo({
              url: '/uni_modules/tuikit-atomic-x/pages/call?layoutTemplate=Grid',
              complete: () => { isCalling.value = false; }
            })
          },
          fail: (error) => {
            if (error === CallErrorCode.PACKAGE_NOT_PURCHASED) {
              uni.showToast({
                icon: 'none',
                title: '您的应用还未开通音视频通话（TUICallKit）能力，您可以去控制台申请免费体验'
              })
              console.error('控制台申请免费体验,https://console.cloud.tencent.com/trtc')
            }
            isCalling.value = false;
          }
        })
      })
      uni.navigateTo({
        url: `/pages/scenes/chat/userPicker/userPicker?businessType=${UserPickerType.SELECT_GROUP_MEMBER}&conversationID=${props.conversationID}`,
        fail: () => {
          uni.$off('onSelectGroupMember')
        }
      })
    }
  }
</script>

<style scoped>
  .tools-panel {
    flex: 1;
    background-color: #FFF;
    border-top-width: 1rpx;
    border-top-style: solid;
    border-top-color: #F0F2F7;
  }

  .tools-scroll {
    flex: 1;
    padding: 20rpx 48rpx;
  }

  .tools-grid {
    flex-direction: row;
    flex-wrap: wrap;
  }

  .tool-item {
    align-items: center;
    margin-bottom: 8rpx;
    margin-right: 45rpx;
    margin-bottom: 38rpx;
  }

  .tool-item.last-in-row {
    margin-right: 0;
  }

  .tool-icon-wrapper {
    width: 128rpx;
    height: 128rpx;
    background-color: #F9FAFC;
    border-radius: 28rpx;
    justify-content: center;
    align-items: center;
    margin-bottom: 8rpx;
  }

  .tool-icon-wrapper:active {
    background-color: #F0F2F7;
  }

  .tool-icon {
    width: 52rpx;
    height: 42rpx;
  }

  .tool-name {
    font-size: 24rpx;
    color: rgba(0, 0, 0, 0.40);
    text-align: center;
  }
</style>
