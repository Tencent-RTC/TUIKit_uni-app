<template>
  <view class="emoji-panel">
    <list class="emoji-list" :show-scrollbar="false">
      
      <cell
        v-for="(row, rowIndex) in chunkedEmojiList"
        :key="rowIndex"
        class="emoji-cell"
      >
        <view class="emoji-row">
          <view 
            v-for="(emoji, colIndex) in row" 
            :key="colIndex"
            class="emoji-item"
            @click="handleEmojiTap(emoji)"
          >
            <text class="emoji-text">{{ emoji.key || emoji }}</text>
          </view>
        </view>
      </cell>
      
      <cell>
        <view style="height: 40rpx;"></view>
      </cell>
    </list>
  </view>
</template>

<script setup>
import { computed } from 'vue';

const emit = defineEmits(['select']);

const COLUMNS = 8; // 每一行显示的个数

// 默认数据
const DEFAULT_EMOJIS = [
  '😀', '😃', '😄', '😁', '😆', '😅', '🤣', '😂',
  '🙂', '🙃', '😉', '😊', '😇', '🥰', '😍', '🤩',
  '😘', '😗', '☺️', '😚', '😙', '😋', '😛',
  '😜', '🤪', '😝', '🤑', '🤗', '🤭', '🤫', '🤔',
  '🤐', '🤨', '😐', '😑', '😶', '😏', '😒', '🙄',
  '😬', '🤥', '😌', '😔', '😪', '🤤', '😴', '😷',
  '🤒', '🤕', '🤢', '🤮', '🤧', '🥵', '🥶', '🥴',
  '😵', '🤯', '🤠', '🥳', '😠', '😎', '🤓', '🧐',
  '😕', '😟', '🙁', '☹️', '😮', '😯', '😲', '😳',
  '🥺', '😦', '😧', '😨', '😰', '😥', '😢', '😭',
  '😱', '😖', '😣', '😞', '😓', '😩', '😫', '🥱',
  '😤', '😡', '🤬', '😈', '👿', '💀', '☠️',
  '🤡', '👹', '👺', '👻', '👽', '👾', '🤖',
  '😺', '😸', '😹', '😻', '😼', '😽', '🙀', '😿',
  '😾', '🙈', '🙉', '🙊', '💋', '💌', '💘', '💝',
  '💖', '💗', '💓', '💞', '💕', '💟', '❣️', '💔',
];

// 1. 先标准化数据格式
const normalizedList = computed(() => {
  return DEFAULT_EMOJIS.map(e => ({ key: e })); // 统一转对象，方便扩展
});

// 2. 核心算法：将一维数组切片成二维数组
// [a,b,c...] -> [[a,b,c,d,e,f,g,h], [i...]]
const chunkedEmojiList = computed(() => {
  const result = [];
  const list = normalizedList.value;
  const len = list.length;
  
  for (let i = 0; i < len; i += COLUMNS) {
    // 截取一行的据
    result.push(list.slice(i, i + COLUMNS));
  }
  return result;
});

const handleEmojiTap = (emoji) => {
  emit('select', emoji);
};
</script>

<style scoped>
.emoji-panel {
  flex: 1;
  background-color: #fff;
  padding-top: 23rpx;
  padding-bottom: 23rpx;
  /* 防止挂载时的隐式动画 */
  transform: translateY(0);
}

.emoji-list {
  flex: 1;
}

/* Cell 样式 
  注意：nvue 中 cell 不支持 margin，只能用内部 view 的 padding/margin 来控制间距
*/
.emoji-cell {
  background-color: #fff;
}

/* 每一行的容器 */
.emoji-row {
  flex-direction: row;       /* 必须显式声明横向排列 */
  padding-left: 51rpx;       /* 整体左边距 */
  padding-right: 51rpx;      /* 整体右边距 */
  height: 104rpx;            /* 给每一行定高，性能最好 */
  align-items: center;       /* 垂直居中 */
}

/* 单个表情容器 */
.emoji-item {
  width: 60rpx;             /* 固定宽度 */
  height: 60rpx;
  margin-right: 24rpx;       /* item 之间的间距 */
  justify-content: center;
  align-items: center;
  border-radius: 8rpx;
}

/* 点击态 (Active State) */
.emoji-item:active {
  background-color: #e0e0e0;
}

.emoji-text {
  font-size: 52rpx;
  font-family: sans-serif; /* 确保 Emoji 渲染正常 */
}
</style>