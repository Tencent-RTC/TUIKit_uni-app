<template>
  <view class="msg-actions" @tap="handleMaskTap">
    <view 
      ref="panelRef"
      class="msg-actions__panel"
      :style="panelStyle"
      @tap.stop
    >
      <ReactionPicker
        v-if="reactionMode"
        :message="message"
        @collapse="handleReactionCollapse"
        @show-all="handleReactionShowAll"
        @close="safeClose"
      />
      <view v-else class="msg-actions__rows">
        <view
          v-for="(row, rowIndex) in actionRows"
          :key="rowIndex"
          class="msg-actions__row-wrap"
        >
          <view class="msg-actions__row">
            <view
              v-for="item in row"
              :key="item.key"
              class="msg-actions__item"
              @tap="handleActionTap(item)"
            >
              <image class="msg-actions__icon" :src="item.icon" mode="aspectFit"></image>
              <text class="msg-actions__text">{{ item.label }}</text>
            </view>
          </view>
          <view v-if="rowIndex < actionRows.length - 1" class="msg-actions__divider"></view>
        </view>
      </view>
    </view>
    
    <view class="msg-actions__arrow" :style="arrowStyle"></view>
  </view>
</template>

<script setup lang="ts">
import { computed, ref, onMounted, onUnmounted, nextTick } from 'vue'
import { MessageStatus, MessageType } from '../../../types/message'
import { useMessageActionState } from '../../../state/MessageActionState'
import { throttle } from '../../../utils/lodash'
import { isCallMessage } from '../../../utils/callMessageUtils'
import { emitPremiumRequired } from '../../../utils/premiumRequired'
import { listAllReactionEmojis } from '../../../utils/reactionEmoji'
import ReactionPicker from './MessageReaction/ReactionPicker.nvue'

import copyIcon from '../assets/msg_copy.png'
import deleteIcon from '../assets/msg_delete.png'
import forwardIcon from '../assets/msg_forward.png'
import hideIcon from '../assets/msg_hide.png'
import multiSelectIcon from '../../../static/assets/message-list/msg_multi_select.png'
import quoteIcon from '../assets/msg_quote.png'
import reactionIcon from '../../../static/assets/message-list/msg_reaction.png'
import recallIcon from '../assets/msg_recall.png'
import translateIcon from '../assets/msg_translate.png'
import voiceToTextIcon from '../assets/msg_voice_to_text.png'

const ARROW_SIZE = 24
const GAP = 20
const ARROW_INSET = 16

let deleteAction;
let revokeAction;
let convertVoiceToText;
let translateText;
let destroyStore;

const props = defineProps({
  message: {
    type: Object,
    required: true
  },
  actions: {
    type: Array,
    default: () => []
  }
})

const emit = defineEmits(['close', 'action', 'reaction-show-all'])

const panelRef = ref(null)
const triggerPosition = ref({ x: 0, y: 0 })
const phase = ref('measure')
const showBelow = ref(false)
const isCentered = ref(false)
const panelWidthRpx = ref(0)
const panelHeightRpx = ref(0)
const reactionMode = ref(false)

onMounted(() => {
  const obj = useMessageActionState({ message: props.message })
  deleteAction = obj.delete
  revokeAction = obj.revoke
  convertVoiceToText = obj.convertVoiceToText
  translateText = obj.translateText
  destroyStore = obj.destroyStore
})

onUnmounted(() => {
  destroyStore && destroyStore()
})

const safeClose = () => {
  // #ifdef APP-IOS
  setTimeout(() => {
    emit('close')
  }, 300)
  // #endif
  
  // #ifndef APP-IOS
  emit('close')
  // #endif
}

const canCopy = computed(() => {
  return props.message.messageType === MessageType.TEXT && 
         props.message.messagePayload?.text
})

const canRecall = computed(() => {
  if (!props.message.isSentBySelf) {
    return false
  }
  
  if (props.message.status === MessageStatus.REVOKED || 
      props.message.status === MessageStatus.DELETED) {
    return false
  }
  
  if (props.message.timestamp) {
    const now = Math.floor(Date.now() / 1000)
    const messageTime = props.message.timestamp
    const timeDiff = now - messageTime
    return timeDiff <= 120
  }
  
  return false
})

const canConvertVoice = computed(() => {
  return props.message.messageType === MessageType.AUDIO
})

const canForward = computed(() => {
  if (!props.message) return false
  if (props.message.status === MessageStatus.REVOKED || props.message.status === MessageStatus.DELETED) {
    return false
  }
  if (props.message.messageType === MessageType.TIPS) {
    return false
  }
  if (props.message.messageType === MessageType.CUSTOM && isCallMessage(props.message)) {
    return false
  }
  return true
})

// 多选入口：已撤回 / 已删除的消息本身不会走到长按菜单，这里只兜底过滤
const canMultiSelect = computed(() => {
  if (!props.message) return false
  return props.message.status !== MessageStatus.REVOKED && props.message.status !== MessageStatus.DELETED
})

const canQuote = computed(() => {
  if (!props.message) return false
  if (props.message.status === MessageStatus.REVOKED || props.message.status === MessageStatus.DELETED) {
    return false
  }
  if (props.message.messageType === MessageType.TIPS) {
    return false
  }
  return true
})

// 与 native 一致：仅发送成功的消息且存在可用表情时才提供「贴表情」入口
const showReactionPicker = computed(() => {
  return props.message.status === MessageStatus.SEND_SUCCESS &&
    !!props.message.msgID &&
    listAllReactionEmojis().length > 0
})

const STORAGE_KEY = 'tuikit_audio_convert_visible_v1'

const voiceTextHasContent = computed(() => {
  const text = props.message && props.message.messagePayload && props.message.messagePayload.asrText
  return !!text
})

const voiceTextVisible = computed(() => {
  if (!voiceTextHasContent.value) return false
  const msgID = props.message.msgID

  const map = uni.__audioConvertVisibleMap__
  if (map && map.has(msgID)) {
    return map.get(msgID) === true
  }

  try {
    const raw = uni.getStorageSync(STORAGE_KEY)
    let store = null
    if (raw && typeof raw === 'object') {
      store = raw
    } else if (typeof raw === 'string' && raw) {
      store = JSON.parse(raw)
    }
    if (store && store[msgID] === false) {
      return false
    }
  } catch (e) {}

  return true
})

const voiceActionLabel = computed(() => {
  return voiceTextVisible.value ? '隐藏文字' : '转文字'
})

const TRANSLATE_TARGET_LANGUAGE = 'zh'

const TRANSLATE_STORAGE_KEY = 'tuikit_message_translate_visible_v1'

const canTranslate = computed(() => {
  if (!props.message) return false
  if (props.message.messageType !== MessageType.TEXT) return false
  if (props.message.status === MessageStatus.REVOKED || props.message.status === MessageStatus.DELETED) {
    return false
  }
  return !!props.message.messagePayload?.text
})

const translateHasContent = computed(() => {
  const payload = props.message?.messagePayload
  const sourceText = payload?.text || ''
  const map = payload?.translatedText
  if (!map || !sourceText) return false
  return !!map[sourceText]
})

const translateVisible = computed(() => {
  if (!translateHasContent.value) return false
  const msgID = props.message.msgID

  const map = uni.__messageTranslateVisibleMap__
  if (map && map.has(msgID)) {
    return map.get(msgID) === true
  }

  try {
    const raw = uni.getStorageSync(TRANSLATE_STORAGE_KEY)
    let store = null
    if (raw && typeof raw === 'object') {
      store = raw
    } else if (typeof raw === 'string' && raw) {
      store = JSON.parse(raw)
    }
    if (store && store[msgID] === false) {
      return false
    }
  } catch (e) {}

  return true
})

const translateActionLabel = computed(() => {
  return translateVisible.value ? '隐藏' : '翻译'
})

const viewportRpx = () => {
  const si = uni.getSystemInfoSync()
  const sw = si.windowWidth || 375
  const sh = si.windowHeight || 667
  const navH = si.platform === 'android' ? 48 : 44
  const safeTop = si.safeArea?.top || 0
  const safeBottom = (sh - (si.safeArea?.bottom || sh)) || 0
  return {
    minTop: (safeTop + navH + 8) / sw * 750,
    maxBottom: (sh - safeBottom - 8) / sw * 750,
  }
}

const panelTopRpx = computed(() => {
  const tp = triggerPosition.value
  const ph = panelHeightRpx.value
  const want = showBelow.value ? tp.y + tp.messageHeight + GAP : tp.y - ph - GAP
  if (ph <= 0) return want
  const { minTop, maxBottom } = viewportRpx()
  if (isCentered.value) return Math.round((minTop + maxBottom - ph) / 2)
  return Math.max(minTop, Math.min(want, maxBottom - ph))
})

const panelStyle = computed(() => {
  const tp = triggerPosition.value
  if (phase.value === 'measure') {
    return { top: '-9999rpx', left: '0rpx', opacity: 0 }
  }
  if (!tp.x || !tp.y) return { visibility: 'hidden' }
  const pos = { top: `${panelTopRpx.value}rpx` }
  if (isCentered.value && panelWidthRpx.value > 0) {
    pos.left = `${Math.round((750 - panelWidthRpx.value) / 2)}rpx`
  } else if (tp.isSentBySelf) {
    pos.right = `${tp.x}rpx`
  } else {
    pos.left = `${tp.x}rpx`
  }
  return pos
})

const arrowStyle = computed(() => {
  if (phase.value !== 'ready') return { visibility: 'hidden' }
  if (isCentered.value) return { visibility: 'hidden' }
  const tp = triggerPosition.value
  if (!tp.x || !tp.y) return { visibility: 'hidden' }

  const si = uni.getSystemInfoSync()
  const sw = si.windowWidth || 375

  let arrowLeft = (tp.messageX + tp.messageWidth / 2) / sw * 750 - ARROW_SIZE / 2

  const pw = panelWidthRpx.value
  if (pw > 0) {
    let panelFinalLeft
    if (tp.isSentBySelf) {
      panelFinalLeft = 750 - tp.x - pw
    } else {
      panelFinalLeft = tp.x
    }
    const panelFinalRight = panelFinalLeft + pw
    const minLeft = panelFinalLeft + ARROW_INSET
    const maxLeft = panelFinalRight - ARROW_SIZE - ARROW_INSET
    if (arrowLeft < minLeft) arrowLeft = minLeft
    if (arrowLeft > maxLeft) arrowLeft = maxLeft
  }

  const style = { left: `${arrowLeft}rpx`, visibility: 'visible' }
  if (showBelow.value) {
    style.top = `${panelTopRpx.value - ARROW_SIZE / 2}rpx`
  } else {
    style.top = `${panelTopRpx.value + panelHeightRpx.value - ARROW_SIZE / 2}rpx`
  }
  return style
})

const handleMaskTap = () => {
  safeClose()
}

const ACTION_THROTTLE_WAIT = 1000

const handleCopy = throttle(() => {
  if (props.message.messagePayload?.text) {
    uni.setClipboardData({
      data: props.message.messagePayload.text,
      success: () => {
        uni.showToast({
          title: '已复制',
          icon: 'none'
        })
      }
    })
  }
  emit('action', { key: 'copy', text: '复制' })
  safeClose()
}, ACTION_THROTTLE_WAIT, { leading: true, trailing: false })

const handleDelete = throttle(async () => {
  try {
    await deleteAction()
    safeClose()
  } catch (error) {
    uni.showToast({
      title: '删除失败',
      icon: 'none',
      duration: 2000
    })
    safeClose()
  }
}, ACTION_THROTTLE_WAIT, { leading: true, trailing: false })

const handleRecall = throttle(async () => {
  try {
    await revokeAction()
    safeClose()
  } catch (error) {
    console.warn('revoke failed: ', error)
    uni.showToast({
      title: '撤回失败',
      icon: 'none',
      duration: 2000
    })
    safeClose()
  }
}, ACTION_THROTTLE_WAIT, { leading: true, trailing: false })

const handleForward = throttle(() => {
  emit('action', { key: 'forward', text: '转发' })
  safeClose()
}, ACTION_THROTTLE_WAIT, { leading: true, trailing: false })

const handleMultiSelect = throttle(() => {
  emit('action', { key: 'multiSelect', text: '多选' })
  safeClose()
}, ACTION_THROTTLE_WAIT, { leading: true, trailing: false })

const handleQuote = throttle(() => {
  emit('action', { key: 'quote', text: '引用' })
  safeClose()
}, ACTION_THROTTLE_WAIT, { leading: true, trailing: false })

// 点「贴表情」→ 切换到表情面板（panel 高度变化，需重新测量定位）
const handleReactionEntry = throttle(() => {
  reactionMode.value = true
  phase.value = 'measure'
  nextTick(() => {
    setTimeout(() => {
      measureAndPosition()
    }, 30)
  })
}, ACTION_THROTTLE_WAIT, { leading: true, trailing: false })

// 收起表情面板 → 返回操作菜单（重新测量定位）
const handleReactionCollapse = () => {
  reactionMode.value = false
  phase.value = 'measure'
  nextTick(() => {
    setTimeout(() => {
      measureAndPosition()
    }, 30)
  })
}

// 点「更多」→ 关闭菜单，唤起全量表情选择器（底部弹层）
const handleReactionShowAll = () => {
  emit('reaction-show-all')
  safeClose()
}

const handleVoiceToText = throttle(() => {
  const msgID = props.message.msgID
  emit('action', { key: voiceTextVisible.value ? 'voiceTextHide' : 'voiceToText', text: voiceActionLabel.value })
  safeClose()

  if (voiceTextVisible.value) {
    uni.$emit('audioConvertHide', { msgID })
    return
  }

  uni.$emit('audioConvertingStart', { msgID })

  const language = 'zh'
  if (!convertVoiceToText) {
    uni.$emit('audioConvertingError', { msgID })
    uni.showToast({ title: '转换失败', icon: 'none' })
    return
  }
  convertVoiceToText(language).catch((err) => {
    console.error('[MessageActions] convertVoiceToText failed:', err)
    uni.$emit('audioConvertingError', { msgID })
    let toastTitle = '转换失败'
    if (err && err.code === 140008) {
      toastTitle = '当前 SDKAppID 尚未开通语音转文字（ASR）服务'
    } else if (err && err.message) {
      toastTitle = err.message
    }
    uni.showToast({ title: toastTitle, icon: 'none' })
  })
}, ACTION_THROTTLE_WAIT, { leading: true, trailing: false })

const handleTranslate = throttle(() => {
  const msgID = props.message.msgID
  emit('action', { key: translateVisible.value ? 'translateHide' : 'translate', text: translateActionLabel.value })
  safeClose()

  if (translateVisible.value) {
    uni.$emit('messageTranslateHide', { msgID })
    return
  }

  uni.$emit('messageTranslateStart', { msgID })

  if (translateHasContent.value) {
    return
  }

  const sourceText = props.message.messagePayload?.text || ''
  if (!translateText || !sourceText) {
    uni.$emit('messageTranslateError', { msgID })
    uni.showToast({ title: '翻译失败', icon: 'none' })
    return
  }

  translateText([sourceText], undefined, TRANSLATE_TARGET_LANGUAGE).catch((err) => {
    console.error('[MessageActions] translateText failed:', err)
    uni.$emit('messageTranslateError', { msgID })
    if (err && /require.*payment|purchase/i.test(err.message || '')) {
      emitPremiumRequired('文本翻译能力需要单独购买，请购买后再使用')
      return
    }
    uni.showToast({ title: (err && err.message) ? err.message : '翻译失败', icon: 'none' })
  })
}, ACTION_THROTTLE_WAIT, { leading: true, trailing: false })

// ==================== 操作项配置 ====================
const ACTIONS_PER_ROW = 4

interface ActionItem {
  key: string
  label: string
  icon: any
  visible: boolean
  handler: (...args: any[]) => void
}


const actionConfig = computed<ActionItem[]>(() => [
  { key: 'copy', label: '复制', icon: copyIcon, visible: canCopy.value, handler: handleCopy },
  { key: 'delete', label: '删除', icon: deleteIcon, visible: true, handler: handleDelete },
  { key: 'voiceToText', label: voiceActionLabel.value, icon: voiceToTextIcon, visible: canConvertVoice.value, handler: handleVoiceToText },
  { key: 'recall', label: '撤回', icon: recallIcon, visible: canRecall.value, handler: handleRecall },
  { key: 'forward', label: '转发', icon: forwardIcon, visible: canForward.value, handler: handleForward },
  { key: 'multiSelect', label: '多选', icon: multiSelectIcon, visible: canMultiSelect.value, handler: handleMultiSelect },
  { key: 'reaction', label: '贴表情', icon: reactionIcon, visible: showReactionPicker.value, handler: handleReactionEntry },
  { key: 'quote', label: '引用', icon: quoteIcon, visible: canQuote.value, handler: handleQuote },
  { key: 'translate', label: translateActionLabel.value, icon: translateVisible.value ? hideIcon : translateIcon, visible: canTranslate.value, handler: handleTranslate },
])

const visibleActions = computed<ActionItem[]>(() => {
  const available = actionConfig.value.filter((item: ActionItem) => item.visible)
  const configured = props.actions as string[]
  if (!configured || configured.length === 0) {
    return available
  }
  const result: ActionItem[] = []
  configured.forEach((key: string) => {
    const found = available.find((item: ActionItem) => item.key === key)
    if (found) {
      result.push(found)
    }
  })
  return result
})

const actionRows = computed<ActionItem[][]>(() => {
  const rows: ActionItem[][] = []
  const list = visibleActions.value
  for (let i = 0; i < list.length; i += ACTIONS_PER_ROW) {
    rows.push(list.slice(i, i + ACTIONS_PER_ROW))
  }
  return rows
})

const handleActionTap = (item: ActionItem) => {
  item.handler && item.handler()
}

const measureAndPosition = () => {
  const panelEl = panelRef.value
  if (!panelEl) {
    phase.value = 'ready'
    return
  }
  // #ifdef APP-PLUS
  try {
    const dom = uni.requireNativePlugin('dom')
    dom.getComponentRect(panelEl, (result) => {
      if (result && result.size) {
        const si = uni.getSystemInfoSync()
        const sw = si.windowWidth || 375
        panelWidthRpx.value = Math.round(result.size.width / sw * 750)
        panelHeightRpx.value = Math.round(result.size.height / sw * 750)
      }
      if (panelHeightRpx.value <= 0) {
        phase.value = 'ready'
        return
      }
      const tp = triggerPosition.value
      const { minTop, maxBottom } = viewportRpx()
      const inSafeArea = (top) =>
        top >= minTop && top + panelHeightRpx.value <= maxBottom
      const canBelow = inSafeArea(tp.y + tp.messageHeight + GAP)
      const canAbove = inSafeArea(tp.y - GAP - panelHeightRpx.value)
      if (canBelow) {
        showBelow.value = true
        isCentered.value = false
      } else if (canAbove) {
        showBelow.value = false
        isCentered.value = false
      } else {
        isCentered.value = true
      }
      phase.value = 'ready'
    })
    return
  } catch (e) {
    console.error('[MessageActions] measureAndPosition failed:', e)
  }
  // #endif
  phase.value = 'ready'
}

const setTriggerPosition = (position) => {
  triggerPosition.value = {
    x: position.x,
    y: position.y,
    messageX: position.messageX,
    messageWidth: position.messageWidth,
    messageHeight: position.messageHeight,
    isSentBySelf: position.isSentBySelf,
  }
  phase.value = 'measure'
  nextTick(() => {
    setTimeout(() => {
      measureAndPosition()
    }, 30)
  })
}

defineExpose({
  setTriggerPosition
})
</script>

<style>
.msg-actions {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(255, 255, 255, 0.01);
  z-index: 999;
}

.msg-actions__panel {
  position: absolute;
  flex-direction: column;
  background-color: #FFFFFF;
  border-radius: 12rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.25);
  padding-top: 11rpx;
  max-width: 560rpx;
  z-index: 1000;
  justify-content: center;
  align-items: flex-start;
  left: auto;
  right: auto;
}

.msg-actions__rows {
  padding: 22rpx 0 22rpx;
  flex-direction: column;
  align-items: flex-start;
}

.msg-actions__row-wrap {
  flex-direction: column;
  align-items: flex-start;
}

.msg-actions__row {
  flex-direction: row;
  justify-content: flex-start;
  align-items: center;
}

/* 多行之间的隔断线 */
.msg-actions__divider {
  width: 420rpx;
  height: 2rpx;
  background-color: #F0F2F7;
  margin: 20rpx 40rpx;
}

.msg-actions__item {
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 125rpx;
  margin: 0rpx;
}

.msg-actions__item:active {
  opacity: 0.6;
}

.msg-actions__icon {
  width: 36rpx;
  height: 36rpx;
  margin-bottom: 10rpx;
}

.msg-actions__text {
  font-size: 20rpx;
  color: rgba(0, 0, 0, 0.55);
  text-align: center;
}

.msg-actions__arrow {
  position: absolute;
  width: 24rpx;
  height: 24rpx;
  background-color: #FFFFFF;
  transform: rotate(45deg);
  z-index: 1001;
}
</style>
