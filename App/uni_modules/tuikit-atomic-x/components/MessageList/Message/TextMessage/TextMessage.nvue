<template>
  <view
    class="text-msg text-msg--no-select"
    :class="['text-msg__content', 'text-msg__content--'+ (message.isSentBySelf ? 'out' : 'in')]"
  >
    <view class="text-msg__highlight">
      <view
        v-if="quoteMessage"
        class="text-msg__quote text-msg__quote--no-select"
        :class="'text-msg__quote--' + (message.isSentBySelf ? 'out' : 'in')"
        @tap="handleReferenceTap"
      >
        <view class="text-msg__quote-header">
          <text class="text-msg__quote-sender text-msg__text--no-select">{{ quoteSenderName }}</text>
        </view>
        <view class="text-msg__quote-body">
          <text class="text-msg__quote-text text-msg__text--no-select" :numberOfLines="1">{{ quoteAbstract }}</text>
        </view>
      </view>

      <view class="text-msg__body text-msg__body--no-select">
        <text v-if="!hasEmojiInText" class="text-msg__plain text-msg__text--no-select">{{ messageText }}</text>
        <view v-else class="text-msg__line">
          <template v-for="(seg, idx) in segments" :key="idx">
            <text v-if="seg.type === 'char'" class="text-msg__char text-msg__text--no-select">{{ seg.text }}</text>
            <image v-else class="text-msg__emoji" :src="seg.src" mode="aspectFit" resize="contain" />
          </template>
        </view>
      </view>

      <view
        v-if="translateBoxVisible"
        ref="translateBoxRef"
        class="text-msg__translate"
        :style="translateBoxInitStyle"
      >
        <view class="text-msg__translate-divider" />
        <text v-if="isTranslating" class="text-msg__translate-text text-msg__text--no-select">...</text>
        <view v-else ref="translateTextRef" :style="translateTextInitStyle">
          <text class="text-msg__translate-text text-msg__text--no-select">{{ translatedText }}</text>
          <view class="text-msg__translate-footer">
            <image class="text-msg__translate-footer-icon" :src="translateFooterIcon" mode="aspectFit" />
            <text class="text-msg__translate-footer-text text-msg__text--no-select">由 IM 提供翻译支持</text>
          </view>
        </view>
      </view>
    </view>
  </view>
</template>

<script setup lang="ts">
import { ref, computed, onMounted, onUnmounted, watch, nextTick } from 'vue'
import type { MessageInfo } from '../../../../types/message'
import { MessageStatus } from '../../../../types/message'
import { getMessageAbstract } from '../../../ConversationList/utils'
import { parseTextToSegments, hasEmoji, transformEmojiKeyToName } from '../../../../utils/emojiUtils'
import translateFooterIcon from '../../assets/msg_translate.png'

const animation = uni.requireNativePlugin('animation')

interface Props {
  message: MessageInfo
}

const props = defineProps<Props>()

const messageText = computed(() => {
  return props.message.messagePayload?.text || ''
})

// 仅在含 emoji 时才走字符级切分，纯文本场景零开销
const hasEmojiInText = computed(() => hasEmoji(messageText.value))
const segments = computed(() => hasEmojiInText.value ? parseTextToSegments(messageText.value) : [])

const quoteMessage = computed(() => {
  return (props.message as any)?.quoteInfo || null
})

const quoteSenderName = computed<string>(() => {
  const sender = quoteMessage.value?.sender
  if (!sender) return ''
  return sender.nameCard || sender.friendRemark || sender.nickname || sender.userID || ''
})

const quoteAbstract = computed<string>(() => {
  const quote = quoteMessage.value
  if (!quote) return ''
  if (quote.status === MessageStatus.DELETED) return '原消息已删除'
  if (quote.status === MessageStatus.REVOKED) return '原消息已撤回'
  return transformEmojiKeyToName(getMessageAbstract(quote as any, false))
})

const handleReferenceTap = () => {
  const quote = quoteMessage.value
  if (!quote?.msgID) return
  if (quote.status === MessageStatus.DELETED || quote.status === MessageStatus.REVOKED) return
  uni.$emit('scrollToMessage', quote.msgID, quote)
}

const TRANSLATE_STORAGE_KEY = 'tuikit_message_translate_visible_v1'

const translatedText = computed<string>(() => {
  const payload: any = (props.message as any)?.messagePayload
  const sourceText = payload?.text || ''
  const map = payload?.translatedText
  if (!map || !sourceText) return ''
  return map[sourceText] || ''
})

const isTranslating = ref(false)
const translateBoxRef = ref<any>(null)
const translateTextRef = ref<any>(null)
const curtainPhase = ref<'idle' | 'pending' | 'done'>('idle')

const curtainOrigin = computed(() => {
  return (props.message as any)?.isSentBySelf ? '100% 0' : '0 0'
})

const translateBoxInitStyle = computed(() => {
  if (isTranslating.value) return {}
  if (curtainPhase.value === 'pending') {
    return { opacity: 0, transform: 'scale(0, 0)', transformOrigin: curtainOrigin.value }
  }
  if (curtainPhase.value === 'done') {
    return { opacity: 1, transform: 'scale(1, 1)', transformOrigin: curtainOrigin.value }
  }
  return {}
})

const translateTextInitStyle = computed(() => {
  if (isTranslating.value) return {}
  if (curtainPhase.value === 'pending') return { opacity: 0 }
  if (curtainPhase.value === 'done') return { opacity: 1 }
  return {}
})

const CURTAIN_BOX_DURATION = 360
const CURTAIN_TEXT_DELAY = 120
const CURTAIN_TEXT_DURATION = 240
const playCurtainAnimation = () => {
  let attempt = 0
  const tryAnimate = () => {
    attempt += 1
    const boxEl = translateBoxRef.value
    const textEl = translateTextRef.value
    if (boxEl) {
      animation.transition(boxEl, {
        styles: { opacity: 1, transform: 'scale(1, 1)', transformOrigin: curtainOrigin.value },
        duration: CURTAIN_BOX_DURATION,
        timingFunction: 'cubic-bezier(0.16, 1, 0.3, 1)',
        delay: 0
      })
      if (textEl) {
        animation.transition(textEl, {
          styles: { opacity: 1 },
          duration: CURTAIN_TEXT_DURATION,
          timingFunction: 'ease-out',
          delay: CURTAIN_TEXT_DELAY
        })
      }
      const totalDuration = Math.max(CURTAIN_BOX_DURATION, CURTAIN_TEXT_DELAY + CURTAIN_TEXT_DURATION)
      setTimeout(() => { curtainPhase.value = 'done' }, totalDuration + 50)
      return
    }
    if (attempt < 3) {
      setTimeout(tryAnimate, 32)
    } else {
      console.error('[TextMessage] curtain anim: ref unavailable, fallback to done state')
      curtainPhase.value = 'done'
    }
  }
  nextTick(() => { setTimeout(tryAnimate, 16) })
}

const readVisibleStore = (): Record<string, boolean> => {
  try {
    const raw = uni.getStorageSync(TRANSLATE_STORAGE_KEY)
    if (raw && typeof raw === 'object') return raw as Record<string, boolean>
    if (typeof raw === 'string' && raw) {
      return JSON.parse(raw) as Record<string, boolean>
    }
  } catch (e) {}
  return {}
}

const writeVisibleStore = (store: Record<string, boolean>) => {
  try {
    uni.setStorageSync(TRANSLATE_STORAGE_KEY, store)
  } catch (e) {
    console.error('[TextMessage] writeVisibleStore failed:', e)
  }
}

const showTranslation = ref<boolean>((() => {
  const store = readVisibleStore()
  return store[props.message.msgID] === false ? false : true
})())


const translateBoxVisible = computed(() => {
  return isTranslating.value || (!!translatedText.value && showTranslation.value)
})

const getVisibleMap = (): Map<string, boolean> => {
  const u: any = uni as any
  if (!u.__messageTranslateVisibleMap__) {
    u.__messageTranslateVisibleMap__ = new Map<string, boolean>()
  }
  return u.__messageTranslateVisibleMap__
}

const syncVisibleMap = () => {
  getVisibleMap().set(props.message.msgID, !!translatedText.value && showTranslation.value)
}

// 仅写 false（true 即默认值，不写以节省空间）
const persistShowTranslation = (visible: boolean) => {
  const store = readVisibleStore()
  if (visible) {
    if (props.message.msgID in store) {
      delete store[props.message.msgID]
      writeVisibleStore(store)
    }
  } else if (store[props.message.msgID] !== false) {
    store[props.message.msgID] = false
    writeVisibleStore(store)
  }
}

/** 通知 MessageList：气泡长高了，必要时滚动让译文完整可见（避免被输入框遮挡） */
const notifyBoxGrow = () => {
  nextTick(() => {
    uni.$emit('messageBoxGrow', {
      msgID: props.message.msgID,
      boxRef: translateBoxRef.value
    })
  })
}

watch(translatedText, (newText) => {
  if (isTranslating.value && newText) {
    curtainPhase.value = 'pending'
    isTranslating.value = false
    playCurtainAnimation()
  }
  if (newText) notifyBoxGrow()
  syncVisibleMap()
})

watch(showTranslation, (visible) => {
  syncVisibleMap()
  persistShowTranslation(visible)
})

const handleTranslateStart = (data: { msgID: string }) => {
  if (data?.msgID !== props.message.msgID) return
  showTranslation.value = true
  if (translatedText.value) {
    curtainPhase.value = 'pending'
    isTranslating.value = false
    playCurtainAnimation()
    notifyBoxGrow()
  } else {
    isTranslating.value = true
  }
}

const handleTranslateError = (data: { msgID: string }) => {
  if (data?.msgID === props.message.msgID) {
    isTranslating.value = false
  }
}

const handleTranslateHide = (data: { msgID: string }) => {
  if (data?.msgID === props.message.msgID) {
    isTranslating.value = false
    showTranslation.value = false
    curtainPhase.value = 'idle'
  }
}

onMounted(() => {
  uni.$on('messageTranslateStart', handleTranslateStart)
  uni.$on('messageTranslateError', handleTranslateError)
  uni.$on('messageTranslateHide', handleTranslateHide)
  syncVisibleMap()
})

onUnmounted(() => {
  uni.$off('messageTranslateStart', handleTranslateStart)
  uni.$off('messageTranslateError', handleTranslateError)
  uni.$off('messageTranslateHide', handleTranslateHide)
  try { getVisibleMap().delete(props.message.msgID) } catch (e) {}
})
</script>

<style>
.text-msg {
  flex-direction: column;
  max-width: 500rpx;
}

/* 禁用整个文本消息的选择 */
.text-msg--no-select {
  user-select: none;
  -webkit-user-select: none;
  -webkit-touch-callout: none;
}

.text-msg__content {
  flex: 1;
}

.text-msg__content--in {
  background-color: #F0F2F7;
  border-radius: 4rpx 20rpx 20rpx 20rpx;
}

.text-msg__content--out {
  background-color: #CCE2FF;
  border-radius: 20rpx 4rpx 20rpx 20rpx;
}

.text-msg__highlight {
  flex: 1;
  padding: 20rpx 24rpx;
  background-color: transparent;
}

/* 气泡内引用块：左侧竖条 + 发送者 + 单行内容摘要 */
.text-msg__quote {
  border-radius: 0 8rpx 8rpx 0;
  padding: 6rpx 12rpx;
  margin-bottom: 16rpx;
  border-left: 4rpx solid #D5D5D5;
}

/* 引用块背景按发送方区分（nvue 不支持后代选择器，必须用修饰类） */
.text-msg__quote--in {
  background-color: #E4E4E4;
}

.text-msg__quote--out {
  background-color: #D5E2F5;
}

.text-msg__quote--no-select {
  user-select: none;
  -webkit-user-select: none;
  -webkit-touch-callout: none;
}

.text-msg__quote-header {
  margin-bottom: 8rpx;
}

.text-msg__quote-sender {
  font-size: 24rpx;
  font-weight: 500;
  color: #888888;
}

.text-msg__quote-body {
  max-width: 100%;
}

.text-msg__quote-text {
  font-size: 24rpx;
  color: #888888;
  lines: 1;
  text-overflow: ellipsis;
}

.text-msg__text--no-select {
  user-select: none;
  -webkit-user-select: none;
  -webkit-touch-callout: none;
}

.text-msg__body {
  flex-direction: column;
}

.text-msg__body--no-select {
  user-select: none;
  -webkit-user-select: none;
  -webkit-touch-callout: none;
}

/* 纯文本路径：单个 text 节点，原生 lines / 自动换行，最优性能
   word-break/word-wrap 让超长英文单词、URL 等到达边界时强制断字换行（避免溢出气泡） */
.text-msg__plain {
  font-size: 32rpx;
  line-height: 44rpx;
  color: #1A1A1A;
  word-wrap: break-word;
  word-break: break-all;
  white-space: normal;
}

/* 字符级 flex-wrap 容器：图文混排 + 自动换行 + 垂直居中 */
.text-msg__line {
  flex-direction: row;
  flex-wrap: wrap;
  align-items: center;
}

.text-msg__char {
  font-size: 32rpx;
  line-height: 44rpx;
  color: #1A1A1A;
}

.text-msg__emoji {
  width: 40rpx;
  height: 40rpx;
}

/* 译文区：与原文之间用细分隔线区隔，整体在气泡内自然延展 */
.text-msg__translate {
  flex-direction: column;
  margin-top: 16rpx;
}

.text-msg__translate-divider {
  height: 1rpx;
  background-color: rgba(0, 0, 0, 0.08);
  margin-bottom: 16rpx;
}

.text-msg__translate-text {
  font-size: 32rpx;
  line-height: 44rpx;
  color: #1A1A1A;
  word-wrap: break-word;
  word-break: break-all;
  white-space: normal;
  /* nvue text 需父容器有宽度约束才换行，显式声明保证多行展示 */
  lines: 0;
}

/* "由 IM 提供翻译支持" 来源说明 */
.text-msg__translate-footer {
  flex-direction: row;
  align-items: center;
  margin-top: 12rpx;
}

.text-msg__translate-footer-icon {
  width: 24rpx;
  height: 24rpx;
  margin-right: 8rpx;
  opacity: 0.4;
}

.text-msg__translate-footer-text {
  font-size: 22rpx;
  line-height: 30rpx;
  color: rgba(0, 0, 0, 0.4);
}
</style>
