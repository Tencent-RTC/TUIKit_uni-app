<template>
  <view
    class="text-msg text-msg--no-select"
    :class="['text-msg__content', 'text-msg__content--'+ (message.isSentBySelf ? 'out' : 'in')]"
  >
    <view class="text-msg__highlight">
      <view
        v-if="quoteMessage"
        class="text-msg__quote text-msg__quote--no-select"
        @tap="handleReferenceTap"
      >
        <view class="text-msg__quote-header">
          <text class="text-msg__quote-sender text-msg__text--no-select">{{ quoteMessage.msgSender || '' }}</text>
        </view>
        <view class="text-msg__quote-body">
          <text class="text-msg__quote-text text-msg__text--no-select">{{ quoteMessage.msgAbstract || '' }}</text>
        </view>
      </view>

      <!-- 渲染策略：
           - 纯文本（不含 [TUIEmoji_*]）：单个 <text> 节点，性能最优 + 自动换行 + 原生字号控制
           - 含 emoji：字符级 view + flex-wrap，每个字符 / emoji 独立节点，align-items:center 强制居中
             代价是节点数增加，仅在 ~20% 含 emoji 消息中付出 -->
      <view class="text-msg__body text-msg__body--no-select">
        <text v-if="!hasEmojiInText" class="text-msg__plain text-msg__text--no-select">{{ messageText }}</text>
        <view v-else class="text-msg__line">
          <template v-for="(seg, idx) in segments" :key="idx">
            <text v-if="seg.type === 'char'" class="text-msg__char text-msg__text--no-select">{{ seg.text }}</text>
            <image v-else class="text-msg__emoji" :src="seg.src" mode="aspectFit" resize="contain" />
          </template>
        </view>
      </view>
    </view>
  </view>
</template>

<script setup lang="ts">
import { computed } from 'vue'
import type { MessageInfo } from '../../../../types/message'
import { parseTextToSegments, hasEmoji } from '../../../../utils/emojiUtils'

interface Props {
  message: MessageInfo
}

const props = defineProps<Props>()

const messageText = computed(() => {
  return props.message.messagePayload?.text || ''
})

// 仅在含 emoji 时才走字符级切分，纯文本场景零开销
const hasEmojiInText = computed(() => hasEmoji(messageText.value))
const segments = computed(() => hasEmojiInText.value ? parseTextToSegments(messageText.value) : [])

const quoteMessage = computed(() => {
  return props.message.quoteMessageInfo
})

const handleReferenceTap = () => {
  if (quoteMessage.value?.msgID) {
    uni.$emit('scrollToMessage', quoteMessage.value.msgID)
  }
}
</script>

<style>
.text-msg {
  flex-direction: column;
  max-width: 500rpx;
}

/* 禁用整个文本消息的选择 */
.text-msg--no-select {
  user-select: none;
  -webkit-user-select: none;
  -webkit-touch-callout: none;
}

.text-msg__content {
  flex: 1;
}

.text-msg__content--in {
  background-color: #F0F2F7;
  border-radius: 4rpx 20rpx 20rpx 20rpx;
}

.text-msg__content--out {
  background-color: #CCE2FF;
  border-radius: 20rpx 4rpx 20rpx 20rpx;
}

.text-msg__highlight {
  flex: 1;
  padding: 20rpx 24rpx;
  background-color: transparent;
}

.text-msg__quote {
  background-color: rgba(0, 0, 0, 0.05);
  border-left-width: 4rpx;
  border-left-color: #999;
  border-radius: 8rpx;
  padding: 16rpx;
  margin-bottom: 12rpx;
}

.text-msg__quote--no-select {
  user-select: none;
  -webkit-user-select: none;
  -webkit-touch-callout: none;
}

.text-msg__quote-header {
  margin-bottom: 8rpx;
}

.text-msg__quote-sender {
  font-size: 24rpx;
  color: #333;
  font-weight: 500;
}

.text-msg__quote-body {
  max-width: 100%;
}

.text-msg__quote-text {
  font-size: 26rpx;
  color: #666;
}

.text-msg__text--no-select {
  user-select: none;
  -webkit-user-select: none;
  -webkit-touch-callout: none;
}

.text-msg__body {
  flex-direction: column;
}

.text-msg__body--no-select {
  user-select: none;
  -webkit-user-select: none;
  -webkit-touch-callout: none;
}

/* 纯文本路径：单个 text 节点，原生 lines / 自动换行，最优性能
   word-break/word-wrap 让超长英文单词、URL 等到达边界时强制断字换行（避免溢出气泡） */
.text-msg__plain {
  font-size: 32rpx;
  line-height: 44rpx;
  color: #1A1A1A;
  word-wrap: break-word;
  word-break: break-all;
  white-space: normal;
}

/* 字符级 flex-wrap 容器：图文混排 + 自动换行 + 垂直居中 */
.text-msg__line {
  flex-direction: row;
  flex-wrap: wrap;
  align-items: center;
}

.text-msg__char {
  font-size: 32rpx;
  line-height: 44rpx;
  color: #1A1A1A;
}

.text-msg__emoji {
  width: 40rpx;
  height: 40rpx;
}
</style>
