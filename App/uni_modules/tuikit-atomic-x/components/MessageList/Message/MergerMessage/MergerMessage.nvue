<template>
  <view 
    class="merger-message"
    :class="plain ? 'merger-container--plain' : 'merger-message-' + (message.isSentBySelf ? 'out' : 'in')"
    @tap="handleTap"
  >
    <view class="merger-highlight">
      <view class="merger-container">
        <text class="merger-title">{{ mergerTitle }}</text>
        
        <view class="merger-abstract-list">
          <view 
            v-for="(item, index) in abstractList" 
            :key="index"
            class="merger-abstract-item"
          >
            <text class="abstract-content">{{ item }}</text>
          </view>
        </view>
        
        <text class="merger-label">聊天记录</text>
      </view>
    </view>

    <!-- 点击查看完整聊天记录：整页覆盖，内部消息点击「合并转发消息」可继续向下钻取 -->
    <MergedMessageDetail
      v-if="showDetail"
      :visible="showDetail"
      :message="message"
      :conversationID="conversationID"
      @update:visible="(v) => (showDetail = v)"
      @close="handleDetailClose"
    />
  </view>
</template>

<script setup lang="ts">
import { computed, ref, inject } from 'vue'
import MergedMessageDetail from './MergedMessageDetail.nvue'
import type { MessageInfo } from '../../../../types/message'
import { MESSAGE_LONG_PRESSED_INJECTION_KEY } from '../../../../constants/messageInjectionKeys'

interface Props {
  message: MessageInfo
  conversationID?: string
  // 无气泡模式（详情页内再套一层合并转发时）：透明底、直角、不按 isSentBySelf 靠右
  plain?: boolean
}

const props = withDefaults(defineProps<Props>(), {
  conversationID: '',
  plain: false
})

const emit = defineEmits<{
  tap: [message: MessageInfo]
}>()

// 详情页可见性：组件内部自洽，是否放开查看由业务方通过长按菜单等入口控制
const showDetail = ref(false)

// 外层 Message 提供的“本次触摸是否已长按”；不在 Message 内使用（如详情页递归渲染的只读场景）时恒为 false
const isLongPressed = inject<() => boolean>(MESSAGE_LONG_PRESSED_INJECTION_KEY, () => false)

const mergedMessage = computed(() => {
  return props.message.messagePayload
})

const mergerTitle = computed(() => {
  return mergedMessage.value?.title || '聊天记录'
})

const abstractList = computed(() => {
  const abstracts = mergedMessage.value?.abstractList || []
  return abstracts.slice(0, 4)
})

// iOS 暂时禁用点击打开聊天记录详情；恢复时把该值改为 false 即可
const isDetailDisabled = (() => {
  try { return uni.getSystemInfoSync().platform === 'ios' } catch (e) { return false }
})()

const handleTap = () => {
  if (isDetailDisabled) return
  // 长按（弹出操作菜单）松手后会补发 tap，此时不应进入详情
  if (isLongPressed()) return
  showDetail.value = true
  emit('tap', props.message)
}

const handleDetailClose = () => {
  showDetail.value = false
}
</script>

<style scoped>
.merger-message {
  flex-direction: row;
}

.merger-message-in {
  justify-content: flex-start;
}

.merger-message-out {
  justify-content: flex-end;
}

.merger-highlight {
  background-color: transparent;
  border-radius: 20rpx;
}

.merger-container {
  max-width: 500rpx;
  background-color: #FFFFFF;
  border-radius: 20rpx;
  padding: 20rpx 24rpx;
  flex-direction: column;
}

/* 无气泡模式（合并转发详情）：透明底，用细边框圈出卡片，避免内容裸露显得突兀 */
.merger-container--plain {
  max-width: 602rpx;
  background-color: transparent;
  border: 1rpx solid #E6E9F0;
  border-radius: 12rpx;
}

.merger-title {
  font-size: 32rpx;
  line-height: 42rpx;
  font-weight: 400;
  color: rgba(0, 0, 0, 0.9);
  margin-bottom: 10rpx;
}

.merger-abstract-list {
  flex-direction: column;
  margin-bottom: 18rpx;
}

.merger-abstract-item {
  flex-direction: row;
  margin-bottom: 8rpx;
}

.merger-abstract-item:last-child {
  margin-bottom: 0;
}

.abstract-sender {
  font-weight: 400;
  font-size: 24rpx;
  line-height: 36rpx;
  color: rgba(0, 0, 0, 0.4);
  flex-shrink: 0;
}

.abstract-content {
  font-weight: 400;
  font-size: 24rpx;
  line-height: 36rpx;
  color: rgba(0, 0, 0, 0.4);
  flex: 1;
  lines: 1;
  text-overflow: ellipsis;
}

.merger-label {
  font-weight: 400;
  font-size: 18rpx;
  line-height: 28rpx;
  color: rgba(0, 0, 0, 0.4);
  border-top: 1rpx solid #E6E9F0;
  padding-top: 12rpx;
}
</style>
