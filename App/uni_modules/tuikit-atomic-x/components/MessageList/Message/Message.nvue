<template>
  <view v-if="isCenterMessage" class="msg msg--center" @tap.stop="handleMessageContentTap">
    <RecalledMessage v-if="message.status === MessageStatus.REVOKED" :message="message" :conversationID="conversationID" />
    <GroupTipMessage v-else-if="isSystemMessage || isGroupCreateMessage" :message="message" />
    <component v-else-if="isCustomCenterMessage" :is="centerCustomComponent" :message="message" :conversationID="conversationID" />
    <view v-if="highlight" class="msg__highlight-overlay" :style="{ backgroundColor: highlightFlashOn ? '#FFE082' : 'transparent' }"></view>
  </view>
  <!-- 只读模式（合并转发详情）：固定左对齐版式，不依赖 isSentBySelf，也不带气泡底色 -->
  <view v-else-if="readonly" class="msg--readonly">
    <Avatar :src="message.from.avatarURL" :name="displayName" :size="64" defaultAvatarType="user" class="msg-ro__avatar" />
    <view class="msg-ro__main">
      <view class="msg-ro__header">
        <text class="msg-ro__name msg__text--no-select" :numberOfLines="1">{{ displayName }}</text>
        <text class="msg-ro__time msg__text--no-select">{{ formatMessageTime(message.timestamp) }}</text>
      </view>
      <view class="msg-ro__content">
        <component ref="messageContentRef" :is="currentMessageComponent" :message="message" :conversationID="conversationID" :id="message.msgID" v-bind="plainContentProps" />
      </view>
    </view>
  </view>
  <view v-else class="msg-select-row">
    <!-- 多选模式：行首勾选圈（对方 / 自己的消息都显示） -->
    <view
      v-if="multiSelectMode"
      class="msg-select"
      @tap.stop="handleSelectToggle"
    >
      <view
        class="msg-select__circle"
        :class="{
          'msg-select__circle--checked': selectable && selected,
          'msg-select__circle--disabled': !selectable,
        }"
      >
        <image v-if="selectable && selected" class="msg-select__tick" :src="checkedIcon" mode="aspectFit" />
      </view>
    </view>

    <view class="msg msg--no-select" :class="messageClasses" :data-message-id="message.msgID" @touchstart="handleTouchStart" @touchend="handleTouchEnd" @tap.stop="handleTap" @touchmove.stop.prevent="handleTouchMove">
      <Avatar v-if="showAvatar" :src="message.from.avatarURL" :name="displayName" :size="80" defaultAvatarType="user" class="msg__avatar" />
      <view class="msg__main msg__main--no-select" :class="'msg__main--'+ (message.isSentBySelf ? 'out' : 'in')">
        <!-- 只读模式（合并转发详情）：昵称在左、时间在同一行右侧 -->
        <view v-if="showNickname || (readonly && showTime)" class="msg__nickname" :class="{ 'msg__nickname--readonly': readonly }">
          <text v-if="showNickname" class="msg__nickname-text msg__text--no-select" :class="{ 'msg__nickname-text--readonly': readonly }" :numberOfLines="1">{{ displayName }}</text>
          <text v-if="readonly && showTime" class="msg__time-text msg__time-text--inline msg__text--no-select">{{ formatMessageTime(message.timestamp) }}</text>
        </view>

        <view class="msg__bubble msg__bubble--no-select" :class="'msg__bubble--'+ (message.isSentBySelf ? 'out' : 'in')" @longpress="handleLongPress" @tap.stop="handleBubbleTap" @touchstart.stop="handleBubbleTouchStart" @touchmove.stop="">
          <component ref="messageContentRef" :is="currentMessageComponent" :message="message" :conversationID="conversationID" :id="message.msgID" />

          <view v-if="showStatus" :class="['msg__status', 'msg__status--'+ (message.isSentBySelf ? 'out' : 'in')]">
            <image v-if="message.status === MessageStatus.SENDING" ref="loadingIconRef" src="../../../static/icon/loading.png" class="msg__status-icon" mode="aspectFill" />
            <image v-else-if="message.status === MessageStatus.SEND_FAIL" src="../../../static/icon/error.png" class="msg__status-icon" mode="aspectFill" @tap="handleResend" />
          </view>
          <view v-if="showReadStatus" class="msg__read-status">
            <text class="msg__read-text msg__text--no-select">{{ readStatusText }}</text>
          </view>
          <view v-if="highlight" class="msg__highlight-overlay" :style="{ backgroundColor: highlightFlashOn ? '#FFE082' : 'transparent' }"></view>
        </view>
        <MessageReactionBar v-if="showStandaloneReaction" :message="message" @show-detail="handleShowReactionDetail" />
        <view v-if="showTime && !readonly" class="msg__time" @tap.stop="handleMessageContentTap">
          <text class="msg__time-text msg__text--no-select">{{ formatMessageTime(message.timestamp) }}</text>
        </view>
      </view>
      <!-- 多选模式：透明遮罩吞掉气泡内部点击（图片预览 / 语音播放 / 通话回拨等），整行点击统一切换选中 -->
      <view v-if="multiSelectMode" class="msg__select-mask" @tap.stop="handleSelectToggle"></view>
    </view>

    <MessageActions v-if="showActions" ref="messageActionsRef" :message="message" :actions="messageActionList" @close="handleActionsClose" @action="handleAction" @reaction-show-all="handleReactionShowAll" />

    <!-- 转发目标选择器：组件内部自洽，选中后直接调 forwardMessages，不抛给业务层 -->
    <ForwardPicker
      v-if="showForwardPicker"
      :excludeConversationID="conversationID"
      @select="handleForwardSelect"
      @close="handleForwardPickerClose"
    />

    <!-- 表情回应详情选择器：底部弹出，展示当前 reaction 的用户列表，支持点击移除 -->
    <ReactionDetailPicker
      v-if="showReactionDetail"
      :visible="showReactionDetail"
      :message="message"
      :selectedReactionID="reactionDetailReactionID"
      @update:visible="(v) => (showReactionDetail = v)"
      @close="handleReactionDetailClose"
    />
    <ReactionFullPicker
      :visible="showReactionFullPicker"
      :message="message"
      @close="showReactionFullPicker = false"
    />
  </view>
</template>

<script setup lang="ts">
  import { computed, ref, nextTick, getCurrentInstance, provide, watch, onMounted, onUnmounted } from 'vue'
  import Avatar from '../../Avatar/Avatar.nvue'
  import RecalledMessage from './RecalledMessage/RecalledMessage.nvue'
  import GroupTipMessage from './GroupTipMessage/GroupTipMessage.nvue'
  import TextMessage from './TextMessage/TextMessage.nvue'
  import ImageMessage from './ImageMessage/ImageMessage.nvue'
  import VideoMessage from './VideoMessage/VideoMessage.nvue'
  import AudioMessage from './AudioMessage/AudioMessage.nvue'
  import FileMessage from './FileMessage/FileMessage.nvue'
  import FaceMessage from './FaceMessage/FaceMessage.nvue'
  import CustomMessage from './CustomMessage/CustomMessage.nvue'
  import MergerMessage from './MergerMessage/MergerMessage.nvue'
  import MessageActions from './MessageActions.nvue'
  import MessageReactionBar from './MessageReaction/MessageReactionBar.nvue'
  import ReactionDetailPicker from './MessageReaction/ReactionDetailPicker.nvue'
  import ReactionFullPicker from './MessageReaction/ReactionFullPicker.nvue'
  import ForwardPicker from './ForwardPicker.nvue'
  import checkedIcon from '../../../static/icon/checked.png'
  import { MESSAGE_COMPONENT_INJECTION_KEY, MESSAGE_LONG_PRESSED_INJECTION_KEY } from '../../../constants/messageInjectionKeys'
  import type { MessageInfo } from '../../../types/message'
  import { MessageType, MessageStatus, MessageForwardType } from '../../../types/message'
  import { useMessageListState } from '../../../state/MessageListState'
  import { formatTime } from '../../../utils/timeUtils'
  import { isCallMessage, isVideoCall, parseCallMessageData, CallType } from '../../../utils/callMessageUtils'
  import { isSystemTipMessage, isGroupCreateMessage as checkGroupCreateMessage, isCustomCenterMessage as checkCustomCenterMessage, isCenterLayoutMessage } from '../../../utils/messageLayout'
  import { isMessageMultiSelectable } from '../../../utils/multiSelect'
  import {
    useCallState,
    CallErrorCode
  } from '@/uni_modules/tuikit-atomic-x/state/CallState';
  import {
    useDeviceState
  } from "@/uni_modules/tuikit-atomic-x/state/DeviceState";
  import { getCurrentPageFullPath, isNavigating, isCallEnding } from "../../../server/callService"
  import { checkCallPermissionWithDialog } from "@/uni_modules/tuikit-atomic-x/utils/callPermission"

  const animation = uni.requireNativePlugin('animation')

  interface Props {
    message: MessageInfo
    conversationID: string
    showAvatar?: boolean
    showNickname?: boolean
    showTime?: boolean
    messageActionList?: any[]
    highlight?: boolean
    customCenterChecker?: (message: MessageInfo, conversationID: string) => boolean
    customMessageRender?: any
    // >0 表示键盘/EMOJI/TOOLS 面板正展开（MessageInput.updateSpacer：NONE/VOICE 时为 0）
    inputPanelHeight?: number
    // 多选模式：由 MessageList 持有并下发；开启后显示勾选圈、屏蔽长按菜单与气泡内点击
    multiSelectMode?: boolean
    // 当前消息是否已被勾选（仅 multiSelectMode 下有意义）
    selected?: boolean
    // 只读展示（合并转发详情页）：禁用长按菜单、通话回拨、状态与回应条
    readonly?: boolean
  }

  const props = withDefaults(defineProps<Props>(), {
    conversationID: '',
    showAvatar: true,
    showNickname: true,
    showTime: false,
    messageActionList: () => [],
    highlight: false,
    customCenterChecker: null,
    customMessageRender: null,
    inputPanelHeight: 0,
    multiSelectMode: false,
    selected: false,
    readonly: false
  })

  const emit = defineEmits<{
    onMessageListTap: []
    onMessageTap: [message: MessageInfo]
    // 长按菜单点「多选」：请求列表进入多选模式，并默认勾选当前消息
    onEnterMultiSelect: [message: MessageInfo]
    // 多选模式下点击整行 / 勾选圈：请求列表切换该消息的选中状态
    onToggleSelect: [message: MessageInfo]
  }>()

  const showActions = ref(false)
  // 转发目标选择器可见性（组件内部状态，不外泄）
  const showForwardPicker = ref(false)
  const showReactionDetail = ref(false)
  const showReactionFullPicker = ref(false)
  const reactionDetailReactionID = ref<string>('')
  const messageActionsRef = ref(null)
  const messageContentRef = ref(null)
  const highlightFlashOn = ref(false)
  const loadingIconRef = ref(null)
  const loadingAnimationTimer = ref<number | null>(null)
  const loadingStartTimer = ref<number | null>(null)
  const longPressPosition = ref({ x: 0, y: 0 })
  const lastTouchPosition = ref({ x: 0, y: 0 })
  const avatarRef = ref(null)

  const isLongPressing = ref(false)
  const COLLAPSE_SETTLE_MS = 450
  const longPressTimer = ref<number | null>(null)
  const touchStartTime = ref(0)
  const {
    calls,
    setCallFramework
  } = useCallState()
  const {
    openLocalCamera,
    openLocalMicrophone,
  } = useDeviceState();
  // 呼叫防抖锁，防止频繁点击通话消息
  const isCalling = ref(false);
  const instance = getCurrentInstance();

  // 把自身组件定义暴露给后代（合并转发详情页 inject 后递归渲染消息）
  provide(MESSAGE_COMPONENT_INJECTION_KEY, instance ? (instance as any).type : null);

  // 气泡本次触摸是否已触发长按：气泡 touchstart 时复位，长按触发时置位。
  // nvue 长按松手后仍会补发 tap，用它屏蔽气泡自身及内容子组件的点击
  let bubbleLongPressed = false
  provide(MESSAGE_LONG_PRESSED_INJECTION_KEY, () => bubbleLongPressed);

  const getMessagePosition = (messageId: string) => {
    const query = uni.createSelectorQuery().in(instance.proxy);

    return new Promise((resolve, reject) => {
      query
        .select("#" + messageId)
        .boundingClientRect((data) => {
          if (data) {
            resolve(data)
          } else {
            reject(new Error('无法获取Avatar位置信息'))
          }
        })
        .exec();
    })
  }

  defineExpose({
    getMessagePosition,
  })

  // 居中判断的规则只在 utils/messageLayout.ts 一处维护，这里只做响应式封装，供模板选择渲染分支
  const isSystemMessage = computed(() => isSystemTipMessage(props.message));

  const isGroupCreateMessage = computed(() => checkGroupCreateMessage(props.message))

  const isCustomCenterMessage = computed(() =>
    checkCustomCenterMessage(props.message, props.conversationID, props.customCenterChecker)
  )

  const isCenterMessage = computed(() =>
    isCenterLayoutMessage(props.message, props.conversationID, props.customCenterChecker)
  );

  const messageClasses = computed(() => {
    return [
      `msg--${props.message.isSentBySelf ? 'out' : 'in'}`,
      `msg--type-${props.message.messageType}`
    ]
  })

  // 只读模式（合并转发详情页）：不展示发送 / 已读状态，也不展示表情回应条
  const showStatus = computed(() => {
    return !props.readonly &&
      props.message.isSentBySelf &&
      (props.message.status === MessageStatus.SENDING ||
        props.message.status === MessageStatus.SEND_FAIL)
  })

  const showReadStatus = computed(() => {
    return !props.readonly &&
      props.message.isSentBySelf &&
      props.message.status === MessageStatus.SEND_SUCCESS &&
      props.message.needReadReceipt
  })

  const showStandaloneReaction = computed(() => {
    return !props.readonly && (props.message.reactionList || []).length > 0
  })

  // 已读状态文本
  const readStatusText = computed(() => {
    if (!props.message.receipt) {
      return '未读'
    }
    const { readCount = 0, unreadCount = 0 } = props.message.receipt
    if (unreadCount === 0) {
      return '已读'
    }
    return `${readCount}人已读`
  })

  const displayName = computed(() => {
    const sender = props.message.from
    return sender.nameCard || sender.friendRemark || sender.nickname || sender.userID
  })

  // 调用业务方传入的 customMessageRender 解析 CUSTOM 消息对应的渲染组件
  // 仅在 messageType === CUSTOM 时生效；render 抛错或返回空值时降级走默认渲染
  const customComponent = computed(() => {
    if (props.message.messageType !== MessageType.CUSTOM) return null
    if (!props.customMessageRender) return null
    try {
      const comp = props.customMessageRender(props.message, props.conversationID)
      return comp || null
    } catch (e) {
      console.error('[Message] customMessageRender failed:', e)
      return null
    }
  })

  // 居中分支自定义消息渲染：业务组件优先，否则走内置 CustomMessage
  const centerCustomComponent = computed(() => {
    return customComponent.value || CustomMessage
  })

  const currentMessageComponent = computed(() => {
    if (customComponent.value) return customComponent.value

    const componentMap = {
      [MessageType.TEXT]: TextMessage,
      [MessageType.IMAGE]: ImageMessage,
      [MessageType.VIDEO]: VideoMessage,
      [MessageType.AUDIO]: AudioMessage,
      [MessageType.FILE]: FileMessage,
      [MessageType.FACE]: FaceMessage,
      [MessageType.CUSTOM]: CustomMessage,
      [MessageType.MERGED]: MergerMessage
    }

    return componentMap[props.message.messageType] || TextMessage
  })

  // 只读模式（合并转发详情）下下发给内容组件的 plain：去气泡底色。
  // 仅这几类内容组件声明了 plain prop；业务自定义渲染组件不注入，避免污染其 attrs
  const PLAIN_SUPPORTED_TYPES = [
    MessageType.TEXT,
    MessageType.AUDIO,
    MessageType.FILE,
    MessageType.CUSTOM,
    MessageType.MERGED
  ]
  const plainContentProps = computed(() => {
    if (customComponent.value) return {}
    return PLAIN_SUPPORTED_TYPES.includes(props.message.messageType) ? { plain: true } : {}
  })

  const formatMessageTime = (timestamp?: number) => {
    if (!timestamp) return ''
    return formatTime(timestamp, true)
  }

  // 高亮闪烁用响应式样式驱动，不用 animation.transition：
  // iOS 的 list 只给视口内 cell 创建原生 view，二次跳转时目标 cell 还在屏外，
  // 对尚未创建的原生节点调 transition 会静默失败；响应式样式在节点创建时会按当前值渲染。
  // 每次启动递增 runId，旧闪烁链发现 runId 变了就终止。
  let highlightRunId = 0
  const HIGHLIGHT_FLASH_COUNT = 4
  const HIGHLIGHT_FLASH_INTERVAL = 300
  // 滚动落位的等待由 MessageList 在置位 highlight 前处理，这里立即开始
  const HIGHLIGHT_START_DELAY = 0

  const startHighlight = () => {
    const runId = ++highlightRunId
    highlightFlashOn.value = false
    let count = 0
    const tick = () => {
      if (runId !== highlightRunId) return
      if (count >= HIGHLIGHT_FLASH_COUNT) {
        highlightFlashOn.value = false
        return
      }
      highlightFlashOn.value = count % 2 === 0
      count++
      setTimeout(tick, HIGHLIGHT_FLASH_INTERVAL)
    }
    setTimeout(tick, HIGHLIGHT_START_DELAY)
  }

  watch(() => props.highlight, (newVal) => {
    if (newVal) {
      startHighlight()
    } else {
      highlightRunId++
      highlightFlashOn.value = false
    }
  })

  const handleTouchMove = (e: any) => {
    // e.stopPropagation();
  }

  const startLoadingAnimation = () => {
    if (loadingStartTimer.value !== null) {
      clearTimeout(loadingStartTimer.value)
    }

    loadingStartTimer.value = setTimeout(() => {
      loadingStartTimer.value = null
      if (!loadingIconRef.value) return

      const el = loadingIconRef.value.$el || loadingIconRef.value
      if (!el) return

      let rotation = 0

      const rotate = () => {
        if (loadingAnimationTimer.value === null) return

        rotation += 360
        animation.transition(el, {
          styles: { transform: `rotateZ(${rotation}deg)` },
          duration: 800,
          timingFunction: 'linear'
        }, () => {
          if (loadingAnimationTimer.value !== null) {
            rotate()
          }
        })
      }

      loadingAnimationTimer.value = 1
      rotate()
    }, 100) as unknown as number
  }

  const stopLoadingAnimation = () => {
    if (loadingStartTimer.value !== null) {
      clearTimeout(loadingStartTimer.value)
      loadingStartTimer.value = null
    }
    loadingAnimationTimer.value = null
  }

  watch(() => props.message.status, (newStatus) => {
    if (newStatus === MessageStatus.SENDING) {
      nextTick(() => {
        startLoadingAnimation()
      })
    } else {
      stopLoadingAnimation()
    }
  }, { immediate: true })

  onMounted(() => {
    // 跳转到历史消息时目标 cell 是新挂载的，highlight 一开始就是 true，watch 不会触发，需主动启动
    if (props.highlight) startHighlight()
    if (props.message.status === MessageStatus.SENDING) {
      nextTick(() => {
        startLoadingAnimation()
      })
    }
  })

  onUnmounted(() => {
    highlightRunId++
    stopLoadingAnimation()
  })


  const handleTouchStart = (e: any) => {
    touchStartTime.value = Date.now()
    isLongPressing.value = false

    if (e && e.touches && e.touches.length > 0) {
      const touch = e.touches[0]
      const systemInfo = uni.getSystemInfoSync()
      lastTouchPosition.value = {
        x: (touch.clientX / systemInfo.windowWidth) * 750,
        y: (touch.clientY / systemInfo.windowHeight) * (systemInfo.windowHeight / systemInfo.windowWidth * 750)
      }
    }

    if (longPressTimer.value) {
      clearTimeout(longPressTimer.value)
    }
    longPressTimer.value = setTimeout(() => {
      isLongPressing.value = true
    }, 350) as unknown as number
  }

  const handleTouchEnd = (e: any) => {
    if (longPressTimer.value) {
      clearTimeout(longPressTimer.value)
      longPressTimer.value = null
    }
  }

  // 新增：处理气泡的 touchstart 事件，阻止文本选择
  const handleBubbleTouchStart = (e: any) => {
    bubbleLongPressed = false
    // 阻止事件冒泡和默认行为
    if (e && e.preventDefault) {
      e.preventDefault()
    }
    if (e && e.stopPropagation) {
      e.stopPropagation()
    }
  }

  const handleLongPress = async (e: any) => {
    // 阻止默认行为，防止 iOS 系统菜单弹出
    if (e && e.preventDefault) {
      e.preventDefault()
    }
    if (e && e.stopPropagation) {
      e.stopPropagation()
    }
    isLongPressing.value = true
    bubbleLongPressed = true

    if (isCenterMessage.value || props.multiSelectMode || props.readonly) {
      return
    }

    longPressPosition.value = { ...lastTouchPosition.value }

    if (props.inputPanelHeight > 0) {
      emit('onMessageListTap')
      await new Promise(resolve => setTimeout(resolve, COLLAPSE_SETTLE_MS))
    }

    try {
      const messagePosition = await getMessagePosition(props.message.msgID) //
      // 将像素坐标转换为rpx单位（uni-app中使用）
      const systemInfo = uni.getSystemInfoSync()
      const adjustedPosition = {
        x: 132,
        y: messagePosition.top / systemInfo.windowWidth * 750,
        messageX: messagePosition.left,
        messageWidth: messagePosition.width,
        messageHeight: messagePosition.height / systemInfo.windowWidth * 750,
        isSentBySelf: props.message.isSentBySelf,
      }

      longPressPosition.value = adjustedPosition
    } catch (error) {
      console.warn('获取Avatar位置失败:', error)
    }

    showActions.value = true

    nextTick(() => {
      if (messageActionsRef.value && typeof messageActionsRef.value.setTriggerPosition === 'function') {
        messageActionsRef.value.setTriggerPosition(longPressPosition.value)
      }
    })
  }

  const handleTap = () => {
    if (props.multiSelectMode) {
      handleSelectToggle()
      return
    }

    if (isLongPressing.value) {
      setTimeout(() => {
        isLongPressing.value = false
      }, 100)
      return
    }

    if (longPressTimer.value) {
      clearTimeout(longPressTimer.value)
      longPressTimer.value = null
    }

    emit('onMessageListTap')
  }

  // 处理 C2C 会话中的通话消息点击
  const handleC2CCallMessageTap = async (): Promise<boolean> => {
    if (!isCallMessage(props.message) || !props.conversationID.startsWith('c2c_')) {
      return false
    }

    // 防抖：上一次呼叫流程尚未完成时，不允许再次呼叫
    if (isCalling.value) {
      console.log('[Message] call skipped: isCalling is true');
      return true;
    }
    if (isNavigating()) {
      console.log('[Message] call skipped: navigation in progress');
      return true;
    }
    if (isCallEnding()) {
      console.log('[Message] call skipped: previous call end still processing');
      return true;
    }

    const callData = parseCallMessageData(props.message)
    const mediaType = isVideoCall(callData) ? CallType.VIDEO : CallType.AUDIO
    const peerUserID = props.conversationID.replace('c2c_', '')

    if (peerUserID) {
      isCalling.value = true;

      if (mediaType === 1) {
        openLocalCamera({
          isFront: true
        })
      }
      openLocalMicrophone({
        fail: (error) => {
          if (error === -1104) {
            setTimeout(() => {
              openLocalMicrophone();
            }, 200);
          }
        }
      })
      const hasPermission = await checkCallPermissionWithDialog(mediaType);
      if (!hasPermission) {
        isCalling.value = false;
        return true;
      }
      setCallFramework(15)
      calls({
        participantIds: [peerUserID],
        mediaType,
        success: () => {
          uni.$callSource = 'caller'
          uni.$lastPage = getCurrentPageFullPath()
          uni.navigateTo({
            url: '/uni_modules/tuikit-atomic-x/pages/call?layoutTemplate=Float',
            complete: () => { isCalling.value = false; }
          })
        },
        fail: (error) => {
          if (error === CallErrorCode.PACKAGE_NOT_PURCHASED) {
            uni.showToast({
              icon: 'none',
              title: '您的应用还未开通音视频通话（TUICallKit）能力，您可以去控制台申请免费体验'
            })
            console.error('控制台申请免费体验,https://console.cloud.tencent.com/trtc')
          }
          isCalling.value = false;
        }
      })
    }
    return true
  }

  // 气泡点击：长按松手补发的 tap 直接忽略
  const handleBubbleTap = () => {
    if (bubbleLongPressed) return
    handleMessageContentTap()
  }

  const handleMessageContentTap = () => {
    emit('onMessageListTap')
    // 只读模式（合并转发详情）里的通话消息只是历史记录，点击不应回拨
    if (!props.readonly) {
      handleC2CCallMessageTap()
    }
    emit('onMessageTap', props.message);
  }

  const handleResend = () => {
  }

  const handleActionsClose = () => {
    showActions.value = false
    setTimeout(() => {
      isLongPressing.value = false
    }, 100)
  }

  // 通话消息、发送失败的消息不支持多选，勾选圈置灰（规则见 utils/multiSelect.ts）
  const selectable = computed(() => isMessageMultiSelectable(props.message))

  const handleSelectToggle = () => {
    // 不可选的消息只置灰，不弹提示
    if (!selectable.value) return
    emit('onToggleSelect', props.message)
  }

  const handleAction = (action: { key: string; text: string }) => {
    if (!action || !action.key) return

    if (action.key === 'multiSelect') {
      emit('onEnterMultiSelect', props.message)
      return
    }

    if (action.key === 'forward') {
      setTimeout(() => {
        showForwardPicker.value = true
      }, 320)
      return
    }

    if (action.key === 'quote') {
      setTimeout(() => {
        uni.$emit('atomicx-quote', {
          conversationID: props.conversationID,
          message: props.message,
        })
      }, 320)
      return
    }
  }

  const handleForwardPickerClose = () => {
    showForwardPicker.value = false
  }

  const handleReactionShowAll = () => {
    showReactionFullPicker.value = true
  }

  const handleShowReactionDetail = (reactionID: string) => {
    if (!reactionID) return
    reactionDetailReactionID.value = reactionID
    showReactionDetail.value = true
  }

  const handleReactionDetailClose = () => {
    showReactionDetail.value = false
    reactionDetailReactionID.value = ''
  }

  const handleForwardSelect = async (targetConversationID: string) => {
    showForwardPicker.value = false

    if (!targetConversationID) return

    try {
      const { forwardMessages } = useMessageListState({ conversationID: props.conversationID })
      await forwardMessages(
        [props.message],
        { forwardType: MessageForwardType.SEPARATE },
        targetConversationID
      )
      uni.showToast({ title: '已转发', icon: 'none' })
    } catch (error) {
      console.error('[Message] forwardMessages failed:', error)
      uni.showToast({ title: '转发失败', icon: 'none', duration: 2000 })
    }
  }
</script>

<style>
  /* 多选包装行：勾选列 + 消息本体并排；非多选模式下勾选列不渲染，布局与原先一致 */
  .msg-select-row {
    flex-direction: row;
    align-items: flex-start;
    width: 750rpx;
  }

  .msg-select {
    width: 88rpx;
    height: 120rpx;
    padding-top: 36rpx;
    padding-left: 32rpx;
  }

  .msg-select__circle {
    width: 40rpx;
    height: 40rpx;
    border-radius: 20rpx;
    border-width: 2rpx;
    border-style: solid;
    border-color: #C9CDD4;
    background-color: #FFFFFF;
    justify-content: center;
    align-items: center;
  }

  /* 不可选（通话 / 发送失败）：勾选圈置灰 */
  .msg-select__circle--disabled {
    border-color: #E6E9F0;
    background-color: #F0F2F7;
  }

  .msg-select__circle--checked {
    border-color: #1C66E5;
    background-color: #1C66E5;
  }

  .msg-select__tick {
    width: 24rpx;
    height: 24rpx;
  }

  /* 多选模式下盖住整个消息本体，吞掉气泡内部点击 */
  .msg__select-mask {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: transparent;
    z-index: 20;
  }

  .msg {
    position: relative;
    flex-direction: row;
    padding: 20rpx 22rpx;
    align-items: flex-start;
    flex: 1;
  }

  .msg__highlight-overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: transparent;
    z-index: 10;
    /* 颜色渐变交给原生 transition，开关切换时淡入淡出，避免硬切 */
    transition-property: background-color;
    transition-duration: 0.2s;
    transition-timing-function: ease-in-out;
  }

  /* 禁用整个消息容器的选择 */
  .msg--no-select {
    user-select: none;
    -webkit-user-select: none;
    -webkit-touch-callout: none;
  }

  .msg--center {
    justify-content: center;
    align-items: center;
    flex: 1;
    width: 750rpx;
  }

  .msg--in {
    flex-direction: row;
  }

  .msg--out {
    flex-direction: row-reverse;
  }

  .msg__avatar {
    margin-right: 24rpx;
  }

  .msg--out .msg__avatar {
    margin-right: 0;
    margin-left: 24rpx;
  }

  .msg__main {
    flex: 1;
    flex-direction: column;
    align-items: flex-start;
  }

  .msg__main--out {
    padding: 10rpx 14rpx 0 24rpx;
  }

  .msg__main--in {
    padding: 10rpx 24rpx 0 14rpx;
  }

  /* 禁用主内容区域的选择 */
  .msg__main--no-select {
    user-select: none;
    -webkit-user-select: none;
    -webkit-touch-callout: none;
  }

  .msg--out .msg__main {
    align-items: flex-end;
  }

  .msg__nickname {
    margin-bottom: 8rpx;
  }

  .msg__nickname-text {
    max-width: 500rpx;
    font-size: 24rpx;
    line-height: 34rpx;
    color: rgba(0, 0, 0, 0.4);
    lines: 1;
    text-overflow: ellipsis;
  }

  /* ==================== 只读版式（合并转发详情） ====================
     固定左对齐：头像 64rpx + 间距 20rpx，左右各 32rpx，正文区 602rpx。
     不使用 msg--in / msg--out，避免受 message.isSentBySelf 影响。 */
  .msg--readonly {
    flex-direction: row;
    align-items: flex-start;
    width: 750rpx;
    padding: 24rpx 32rpx 0;
  }

  .msg-ro__avatar {
    margin-right: 20rpx;
  }

  .msg-ro__main {
    width: 602rpx;
    flex-direction: column;
    align-items: flex-start;
  }

  .msg-ro__header {
    width: 602rpx;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
  }

  .msg-ro__name {
    max-width: 430rpx;
    font-size: 24rpx;
    line-height: 34rpx;
    color: rgba(0, 0, 0, 0.5);
    lines: 1;
    text-overflow: ellipsis;
  }

  .msg-ro__time {
    margin-left: 16rpx;
    font-size: 22rpx;
    line-height: 34rpx;
    color: rgba(0, 0, 0, 0.35);
  }

  .msg-ro__content {
    width: 602rpx;
    margin-top: 8rpx;
    align-items: flex-start;
  }

  .msg__bubble {
    position: relative;
    justify-content: center;
    align-items: flex-end;
  }

  /* 禁用 iOS 长按默认菜单 */
  .msg__bubble--no-select {
    user-select: none;
    -webkit-user-select: none;
    -webkit-touch-callout: none;
  }

  .msg__bubble--in {
    flex-direction: row;
  }

  .msg__bubble--out {
    flex-direction: row-reverse;
  }

  /* 禁用所有文本的选择 */
  .msg__text--no-select {
    user-select: none;
    -webkit-user-select: none;
    -webkit-touch-callout: none;
  }

  .msg__status {
    height: 80rpx;
    align-items: center;
    justify-content: center;
  }

  .msg__status--in {
    margin-left: 16rpx;
  }

  .msg__status--out {
    margin-right: 16rpx;
  }

  .msg__status-icon {
    width: 32rpx;
    height: 32rpx;
  }

  .msg__time {
    flex-direction: row;
    align-items: center;
    margin-top: 8rpx;
  }

  .msg--out .msg__time {
    flex-direction: row-reverse;
  }

  .msg__time-text {
    font-size: 24rpx;
    line-height: 34rpx;
    font-weight: 400;
    color: rgba(0, 0, 0, 0.4);
  }

  .msg__read-status {
    margin-left: 16rpx;
  }

  .msg--out .msg__read-status {
    margin-left: 0;
    margin-right: 16rpx;
  }

  .msg__read-text {
    font-size: 24rpx;
    line-height: 34rpx;
    font-weight: 400;
    color: rgba(0, 0, 0, 0.4);
  }
</style>