<template>
  <view class="custom-message" :class="{ 'custom-message--center': isCustomCenter }">
    <CallMessage v-if="isCallMsg" :message="message" :isGroupCall="isCustomCenter" />
    <view v-else class="custom-highlight">
      <view class="default-custom">
        <text class="custom-text">{{ customText }}</text>
      </view>
    </view>
  </view>
</template>

<script setup lang="ts">
import { computed } from 'vue'
import type { MessageInfo, CustomMessagePayload } from '../../../../types/message'
import { safeJsonParse } from '../../../../utils/utsUtils'
import { isCallMessage, isGroupCallMessage } from '../../../../utils/callMessageUtils'
import CallMessage from './CallMessage.nvue'

interface Props {
  message: MessageInfo
  conversationID?: string
}

const props = withDefaults(defineProps<Props>(), {
  conversationID: ''
})

const customMessage = computed(() => {
  return props.message.messagePayload as CustomMessagePayload | undefined
})

// 解析 customData（业务方序列化的 JSON 字符串）
const customDataContent = computed<any>(() => {
  const raw = customMessage.value?.customData
  if (!raw) return null
  return safeJsonParse<any>(raw as string, null)
})

// 判断是否是通话消息（callMessageUtils.isCallMessage 已对齐 customData）
const isCallMsg = computed(() => isCallMessage(props.message))

// 判断是否是需要居中显示的自定义消息
const isCustomCenter = computed(() => {
  return isGroupCallMessage(props.message, props.conversationID)
})

const customText = computed(() => {
  // 1. 业务侧 customData.content（如 group_create 的"创建群聊"）
  const content = customDataContent.value?.content
  if (content) return String(content)
  // 2. payload.description 兜底
  const desc = customMessage.value?.description
  if (desc) return desc
  return '自定义消息'
})
</script>

<style>
.custom-message {
  background-color: rgba(255, 255, 255, 0.8);
  border-radius: 12rpx;
  min-width: 160rpx;
  max-width: 480rpx;
}

/* 居中消息样式（如群组通话消息） */
.custom-message--center {
  background-color: transparent;
  max-width: 750rpx;
  min-width: auto;
}

.custom-highlight {
  flex: 1;
  padding: 20rpx;
  background-color: transparent;
  border-radius: 12rpx;
}

.default-custom {
  flex-direction: row;
  align-items: flex-start;
}

.custom-text {
  font-size: 28rpx;
  color: #333;
  flex: 1;
  lines: 0;
  word-wrap: break-word;
  white-space: pre-wrap;
}
</style>