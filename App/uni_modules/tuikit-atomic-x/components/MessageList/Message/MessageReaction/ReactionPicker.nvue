.rp {
  flex-direction: column;
  width: 456rpx;
  margin: 0 12rpx;
  padding-bottom: 10rpx;
}

.rp__header {
  flex-direction: row;
  align-items: center;
  height: 28rpx;
  margin: 12rpx 24rpx 0;
}

.rp__title {
  flex: 1;
  font-size: 20rpx;
  color: rgba(0, 0, 0, 0.9);
}

.rp__collapse {
  width: 28rpx;
  height: 28rpx;
  align-items: center;
  justify-content: center;
}

.rp__collapse:active {
  opacity: 0.6;
}

.rp__collapse-icon {
  width: 28rpx;
  height: 28rpx;
}

.rp__grid {
  flex-direction: column;
  padding: 0 24rpx;
}

.rp__row {
  flex-direction: row;
}

.rp__cell {
  width: 68rpx;
  height: 68rpx;
  align-items: center;
  justify-content: center;
}

.rp__emoji {
  width: 68rpx;
  height: 68rpx;
  padding: 10rpx;
}

.rp__cell:active {
  opacity: 0.6;
}

.rp__more {
  align-items: center;
  justify-content: center;
}

.rp__more-icon {
  width: 32rpx;
  height: 32rpx;
}

.rp__divider {
  height: 2rpx;
  margin: 6rpx 0;
  background-color: rgba(0, 0, 0, 0.08);
}
</style>
