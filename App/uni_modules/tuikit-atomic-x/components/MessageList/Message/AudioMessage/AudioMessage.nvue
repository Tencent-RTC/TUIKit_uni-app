<template>
  <view class="audio-message-wrapper" :class="{ 'audio-message-wrapper--self': message.isSentBySelf }">
    <view 
      class="audio-message" 
      :class="'content-'+ (message.isSentBySelf ? 'out' : 'in')" 
      :style="{ width: audioWidth + 'rpx' }"
      @touchstart="handleTouchStart"
      @tap="handlePlayTap"
    >
      <view class="audio-highlight">
        <view class="audio-wave-container" :class="'wave-'+ (message.isSentBySelf ? 'out' : 'in')">
          <view class="audio-wave-clip" :style="{ width: '12rpx', opacity: waveOpacity[0] }">
            <image
              src="../../../../static/icon/audio.png"
              class="audio-wave-icon"
              mode="aspectFit"
            />
          </view>
          <view class="audio-wave-clip" :style="{ width: '26rpx', opacity: waveOpacity[1] }">
            <image
              src="../../../../static/icon/audio.png"
              class="audio-wave-icon"
              mode="aspectFit"
            />
          </view>
          <view class="audio-wave-clip" :style="{ width: '40rpx', opacity: waveOpacity[2] }">
            <image
              src="../../../../static/icon/audio.png"
              class="audio-wave-icon"
              mode="aspectFit"
            />
          </view>
        </view>
        <view class="audio-duration">
          <text class="duration-text">{{ formatDuration(soundDuration) }}</text>
        </view>
      </view>
    </view>

    <view
      v-if="convertBoxVisible"
      ref="convertBoxRef"
      class="audio-convert-box"
      :style="convertBoxInitStyle"
    >
      <text v-if="isConverting" class="audio-convert-text">...</text>
      <text v-else ref="convertTextRef" class="audio-convert-text" :style="convertTextInitStyle">{{ asrText }}</text>
    </view>
  </view>
</template>

<script setup lang="ts">
import { ref, computed, onMounted, onUnmounted, watch, nextTick } from 'vue'
import type { MessageInfo } from '../../../../types/message'
import { MediaQuality } from '../../../../types/message'
import { useMessageActionState } from '../../../../state/MessageActionState'
import { useMessageListState } from '../../../../state/MessageListState'
import { useAudioPlayer, stopGlobalAudioPlayer } from '../../../../hooks/useAudioPlayer'
import { useCallState } from '../../../../state/CallState'

// nvue 原生动画模块：transition 在合成线程执行；nvue 对 css @keyframes 支持不稳定，必须用此模块
const animation = uni.requireNativePlugin('animation')

interface Props {
  message: MessageInfo
  conversationID: string
}

const props = defineProps<Props>()

// 获取消息列表状态，用于下载资源
// downloadMessageResource 已迁到 MessageActionState.downloadMedia
// 下载状态
const isDownloading = ref(false)
// 等待播放标记（下载完成后自动播放）
const pendingPlay = ref(false)
// 本次播放是否已尝试过远端 URL 回退（避免死循环重试）
let hasTriedRemoteFallback = false

// 通话状态（用于拦截播放）
// status === 1（呼叫中/待接听）或 2（通话中）时阻止播放，避免抢占音频焦点
const { selfInfo: callSelfInfo } = useCallState()
const isInCallNow = (): boolean => {
  const status = callSelfInfo?.value?.status
  return status === 1 || status === 2
}

// 长按判定阈值，与 Message.nvue 中保持一致
const LONG_PRESS_THRESHOLD = 350
const touchStartTime = ref(0)

// 语音转文字状态
// - asrText：直接读 message.messagePayload.asrText（SDK 转换完成后会更新整条 message，由 MessageList 响应式驱动）
// - isConverting：本地 loading，由 MessageActions 广播 audioConvertingStart 事件触发，asrText 出现或 audioConvertingError 释放
// - showConvertedText：当前是否展示文本；初值从本地存储恢复，"隐藏文字"会置 false 并持久化
// 文本直接全量渲染 asrText，配合 css "幕布拉开" 入场动画完成视觉过渡（不再用打字机效果）
const asrText = computed<string>(() => {
  return ((props.message as any)?.messagePayload?.asrText) || ''
})
const isConverting = ref(false)
// 转写文本框（loading 与 result 共用一个 view，由 isConverting 切换内层 text）
// - convertBoxRef：外层 view，幕布动画 + MessageList 滚动测量都用它
// - convertTextRef：result 态内层 text（loading 态不用），用于幕布文字 opacity 动画
const convertBoxRef = ref<any>(null)
const convertTextRef = ref<any>(null)
/**
 * 幕布动画三态机
 * - 'pending'：v-if 渲染瞬间，元素以 (opacity:0, scale(0,0)) 初始态挂载，等待 animation.transition 启动
 * - 'done'：动画已完成，inline style 改为终态 (opacity:1, scale(1,1))
 *   关键：iOS 下 animation.transition 不会持久化样式，动画结束后若 :style 清空，元素会"飞"回初始
 *   显式输出终态 inline style，让 vue 维护"已动画完成"的样式状态，与 transition 的最终值一致
 * - 'idle'：无动画需求（历史消息/重新进入会话），inline style 不输出任何 transform/opacity
 */
const curtainPhase = ref<'idle' | 'pending' | 'done'>('idle')
// 转写容器是否显示：loading 中 或 已有结果且未被用户隐藏
// 合并 loading/result 为同一个 view，仅切换内层 text，避免 v-if/v-else-if 切换时
// 外层 view 重建导致 ref 失效、滚动位置抖动
const convertBoxVisible = computed(() => {
  return isConverting.value || (!!asrText.value && showConvertedText.value)
})

// origin 区分发送方：
// - 接收（isSentBySelf=false）：从语音条左下角对应的左上角拉开
// - 发送（isSentBySelf=true）：从语音条右下角对应的右上角拉开
//   语义上文本框总是从"贴气泡尾部的角"出现，符合用户视觉惯性
const curtainOrigin = computed(() => {
  return (props.message as any)?.isSentBySelf ? '100% 0' : '0 0'
})
// inline style 仅在 result 态（非 loading）输出 transform/opacity
// loading 态不参与幕布动画，避免 "正在转换..." 也被 scale 缩放
const convertBoxInitStyle = computed(() => {
  if (isConverting.value) return {}
  if (curtainPhase.value === 'pending') {
    return { opacity: 0, transform: 'scale(0, 0)', transformOrigin: curtainOrigin.value }
  }
  if (curtainPhase.value === 'done') {
    // 显式声明终态，防止 iOS 下 animation.transition 完成后样式被清空
    return { opacity: 1, transform: 'scale(1, 1)', transformOrigin: curtainOrigin.value }
  }
  return {}
})
const convertTextInitStyle = computed(() => {
  if (isConverting.value) return {}
  if (curtainPhase.value === 'pending') return { opacity: 0 }
  if (curtainPhase.value === 'done') return { opacity: 1 }
  return {}
})

// 本地存储 key：仅持久化用户主动\"隐藏\"的 msgID（值固定为 false）
// 默认未存储 → 视为可见 true，节省空间；切会话/重启 App 后保持用户上次的隐藏选择
// logout 时由 LoginState 清空
const STORAGE_KEY = 'tuikit_audio_convert_visible_v1'

const readVisibleStore = (): Record<string, boolean> => {
  try {
    const raw = uni.getStorageSync(STORAGE_KEY)
    if (raw && typeof raw === 'object') return raw as Record<string, boolean>
    if (typeof raw === 'string' && raw) {
      return JSON.parse(raw) as Record<string, boolean>
    }
  } catch (e) {}
  return {}
}

const writeVisibleStore = (store: Record<string, boolean>) => {
  try {
    uni.setStorageSync(STORAGE_KEY, store)
  } catch (e) {
    console.error('[AudioMessage] writeVisibleStore failed:', e)
  }
}

// showConvertedText 初值：默认 true，仅当本地存储里显式标记为 false 时才隐藏
const showConvertedText = ref<boolean>((() => {
  const store = readVisibleStore()
  const v = store[props.message.msgID]
  return v === false ? false : true
})())

/**
 * 模块级 Map：msgID → 当前文本是否可见
 * 供 MessageActions 在长按弹出时同步判断"转文字 / 隐藏文字"按钮文案
 * 写入入口：showConvertedText 变化时同步；卸载时清理
 *
 * nvue 没有 globalThis，统一挂在 uni 上做跨组件共享
 */
const getVisibleMap = (): Map<string, boolean> => {
  const u: any = uni as any
  if (!u.__audioConvertVisibleMap__) {
    u.__audioConvertVisibleMap__ = new Map<string, boolean>()
  }
  return u.__audioConvertVisibleMap__
}
const syncVisibleMap = () => {
  const visible = !!asrText.value && showConvertedText.value
  getVisibleMap().set(props.message.msgID, visible)
}

// showConvertedText 变化时持久化到本地存储（仅写 false，true 即默认值不写）
const persistShowConvertedText = (visible: boolean) => {
  const store = readVisibleStore()
  if (visible) {
    if (props.message.msgID in store) {
      delete store[props.message.msgID]
      writeVisibleStore(store)
    }
  } else {
    if (store[props.message.msgID] !== false) {
      store[props.message.msgID] = false
      writeVisibleStore(store)
    }
  }
}

/**
 * 播放"幕布从角拉开"入场动画
 *
 * 设计：
 * 1. 容器 scale(0,0) → scale(1,1)，origin 设在左上/右上角，cubic-bezier(0.16, 1, 0.3, 1)
 * 2. 内层文字 opacity 0 → 1，延迟 120ms 启动
 *
 * 关键：动画结束后切到 'done' 阶段，inline style 显式输出终态，
 * 防止 iOS 下 animation.transition 完成后样式被 vue 清空导致"飞回初始"的视觉问题
 *
 * 健壮性：
 * - ref 时序兜底：v-if 切换瞬间 ref 可能还是 null，nextTick + setTimeout(16ms) 重试 3 次
 * - 取不到时直接切到 'done'：让元素以终态显示，杜绝"动画失败 → 永久不可见"
 */
const CURTAIN_BOX_DURATION = 360
const CURTAIN_TEXT_DELAY = 120
const CURTAIN_TEXT_DURATION = 240
const playCurtainAnimation = () => {
  let attempt = 0
  const tryAnimate = () => {
    attempt += 1
    const boxEl = convertBoxRef.value
    const textEl = convertTextRef.value
    if (boxEl) {
      animation.transition(boxEl, {
        styles: { opacity: 1, transform: 'scale(1, 1)', transformOrigin: curtainOrigin.value },
        duration: CURTAIN_BOX_DURATION,
        timingFunction: 'cubic-bezier(0.16, 1, 0.3, 1)',
        delay: 0
      })
      if (textEl) {
        animation.transition(textEl, {
          styles: { opacity: 1 },
          duration: CURTAIN_TEXT_DURATION,
          timingFunction: 'ease-out',
          delay: CURTAIN_TEXT_DELAY
        })
      }
      // 动画完成后切到 'done'：inline style 输出 (opacity:1, scale(1,1)) 终态，
      // 与 animation.transition 的最终值一致，iOS 下不会出现样式回退/丢失
      const totalDuration = Math.max(CURTAIN_BOX_DURATION, CURTAIN_TEXT_DELAY + CURTAIN_TEXT_DURATION)
      // 多 50ms 缓冲，确保 iOS 动画线程已完全收敛
      setTimeout(() => { curtainPhase.value = 'done' }, totalDuration + 50)
      return
    }
    if (attempt < 3) {
      setTimeout(tryAnimate, 32)
    } else {
      // 兜底：ref 始终拿不到，强制切到终态让元素显示
      console.error('[AudioMessage] curtain anim: ref unavailable, fallback to done state')
      curtainPhase.value = 'done'
    }
  }
  nextTick(() => { setTimeout(tryAnimate, 16) })
}

// asrText 变化策略：
// - 由 isConverting=true → 出现新文本：转换完成，关闭 loading；置 curtainPhase='pending' 后 v-else-if
//   渲染容器为 (opacity:0, scale(0,0)) 初始态，再由 animation.transition 拉开幕布
// - 通知 MessageList 跟随滚动：避免幕布展开后底部被输入框遮挡
watch(asrText, (newText) => {
  if (isConverting.value && newText) {
    // 真正"刚转换完成"才播幕布动画；其它静默更新（如外部刷新）不重播
    curtainPhase.value = 'pending'
    isConverting.value = false
    playCurtainAnimation()
  }
  if (newText) {
    // 通知 MessageList：转写文本框出现，可能被输入框遮挡需要滚动让它可视
    // 附带 boxRef：MessageList 直接 getComponentRect(boxRef) 测可视性，避免猜测高度
    // nextTick 等渲染完成后再 emit，确保 boxRef 已绑定真实元素
    nextTick(() => {
      uni.$emit('audioConvertStreamGrow', {
        msgID: props.message.msgID,
        boxRef: convertBoxRef.value
      })
    })
  }
  syncVisibleMap()
})

watch(showConvertedText, (visible) => {
  syncVisibleMap()
  persistShowConvertedText(visible)
})

// 声波动画状态
const waveStep = ref(0) // 0, 1, 2 循环
let waveTimer: ReturnType<typeof setInterval> | null = null

/**
 * 获取远端语音下载 URL
 * 路径: rawMessage.message.messageBaseElements[0].soundDownloadUrl
 * 任一层级缺失时返回空串
 */
const getRemoteSoundUrl = (): string => {
  try {
    const rawMsg: any = (props.message as any)?.rawMessage
    const elements: any[] = rawMsg?.message?.messageBaseElements
    if (Array.isArray(elements) && elements.length > 0) {
      return elements[0]?.soundDownloadUrl || ''
    }
  } catch (e) {
    console.error('[AudioMessage] getRemoteSoundUrl error:', e)
  }
  return ''
}

// 使用音频播放器 Hook
const { isPlaying, play, stop } = useAudioPlayer({
  messageId: props.message.msgID,
  onComplete: () => {
    hasTriedRemoteFallback = false
    stopWaveAnimation()
  },
  onError: (error) => {
    console.error('[AudioMessage] onError:', error)
    
    // 本地播放失败时，尝试远端 URL 回退（仅回退一次）
    if (!hasTriedRemoteFallback) {
      const remoteUrl = getRemoteSoundUrl()
      if (remoteUrl) {
        hasTriedRemoteFallback = true
        // 不 toast、不停止动画，直接用远端 URL 重新播放
        play(remoteUrl)
        return
      }
    }
    
    // 远端也无可用 URL 或远端也失败 → 最终报错
    hasTriedRemoteFallback = false
    stopWaveAnimation()
    // -99 通常表示音频格式不受系统支持（如 SILK），提示用户
    const errCode = error?.errCode
    const tip = errCode === -99 ? '音频格式暂不支持' : '播放失败'
    uni.showToast({ title: tip, icon: 'none' })
  }
})

// 监听播放状态变化，控制动画
watch(isPlaying, (playing) => {
  if (playing) {
    startWaveAnimation()
  } else {
    stopWaveAnimation()
  }
})

/**
 * 监听全局 audioPlayerStart 事件
 * 当其他语音消息开始播放时，如果不是自己，主动重置播放状态并停止动画。
 * 作为 useAudioPlayer 内部 isPlaying 响应式更新的兜底，防止 nvue 下 watch 延迟导致动画未停。
 */
const handleGlobalAudioStart = (data: { messageId: string }) => {
  if (data?.messageId && data.messageId !== props.message.msgID && isPlaying.value) {
    stopWaveAnimation()
    // 调用 stop() 会同时重置 useAudioPlayer 内部状态
    stop()
  }
}

/**
 * 应用切换到后台时，停止播放，避免后台继续消耗资源并释放音频焦点
 */
const handleAppHide = () => {
  if (isPlaying.value) {
    stopWaveAnimation()
    stop()
  }
}

/**
 * 监听 MessageActions 广播的"开始转文字"事件
 * - 已有 asrText（之前转过 / 用户曾隐藏后再次点"转文字"）：直接展示文本，css 自动播幕布动画
 * - 没有 asrText：进入 loading 态等待 SDK 推送，asrText 到达后由 watch 关闭 loading 并展示文本
 */
const handleConvertingStart = (data: { msgID: string }) => {
  if (data?.msgID !== props.message.msgID) return
  showConvertedText.value = true
  if (asrText.value) {
    // 已有缓存文本：直接展示并播幕布动画（asrText 未变化，watch 不触发，需手动驱动）
    curtainPhase.value = 'pending'
    isConverting.value = false
    playCurtainAnimation()
    // 主动通知 MessageList 跟随滚动；ref 此刻未必就绪，nextTick 后再 emit 拿到真实元素
    nextTick(() => {
      uni.$emit('audioConvertStreamGrow', {
        msgID: props.message.msgID,
        boxRef: convertBoxRef.value
      })
    })
  } else {
    // 等待 SDK 推送：进 loading
    isConverting.value = true
    // loading 容器也可能被输入框遮挡，通知 MessageList 测量并滚动让它可视
    // nextTick 等 v-if 渲染容器后 ref 才就绪
    nextTick(() => {
      uni.$emit('audioConvertStreamGrow', {
        msgID: props.message.msgID,
        boxRef: convertBoxRef.value
      })
    })
  }
}

/**
 * 监听 MessageActions 广播的"转文字失败"事件，释放 loading
 */
const handleConvertingError = (data: { msgID: string }) => {
  if (data?.msgID === props.message.msgID) {
    isConverting.value = false
  }
}

/**
 * 监听 MessageActions 广播的"隐藏文字"事件
 */
const handleConvertHide = (data: { msgID: string }) => {
  if (data?.msgID === props.message.msgID) {
    showConvertedText.value = false
  }
}

// 三层声波的透明度
const waveOpacity = computed(() => {
  if (!isPlaying.value) {
    // 未播放时显示完整图标
    return [0, 0, 1]
  }
  // 播放时根据 waveStep 依次显示（从小到大循环）
  switch (waveStep.value) {
    case 0:
      return [1, 0, 0]  // 只显示圆点
    case 1:
      return [0, 1, 0]  // 显示圆点+第一条弧线
    case 2:
      return [0, 0, 1]  // 显示完整图标
    default:
      return [0, 0, 1]
  }
})

const startWaveAnimation = () => {
  stopWaveAnimation()
  waveStep.value = 0
  waveTimer = setInterval(() => {
    waveStep.value = (waveStep.value + 1) % 3
  }, 300) // 每 300ms 切换一次
}

const stopWaveAnimation = () => {
  if (waveTimer) {
    clearInterval(waveTimer)
    waveTimer = null
  }
  waveStep.value = 0
}

const soundUrl = computed(() => {
  // 直接返回原始路径，play 时会自动处理私有目录文件的复制和 URL 转换
  return props.message.messagePayload?.audioPath || ''
})

const soundDuration = computed(() => {
  return props.message.messagePayload?.audioDuration || 0
})

const audioWidth = computed(() => {
  const duration = soundDuration.value
  const minWidth = 220 // 最小宽度
  const maxWidth = 474 // 最大宽度
  const minDuration = 20 // 20秒以内保持最小宽度
  const maxDuration = 60 // 60秒对应最大宽度
  
  if (duration <= minDuration) return minWidth
  if (duration >= maxDuration) return maxWidth
  
  // 线性插值计算宽度（20秒到60秒之间）
  return minWidth + (maxWidth - minWidth) * ((duration - minDuration) / (maxDuration - minDuration))
})

const formatDuration = (duration: number) => {
  if (!duration) return `0''`
  
  const seconds = Math.floor(duration)
  
  return `${seconds}''`
}

const handleTouchStart = (e: any) => {
  touchStartTime.value = Date.now()
}

const handlePlayTap = () => {
  // 长按判定：触摸持续时间超过阈值视为长按，交由父级 Message.nvue 处理消息操作菜单
  // 注意：判定后必须复位 touchStartTime，否则下一次"未收到 touchstart 直接 tap"
  // （nvue 部分场景事件丢失）会用旧时间戳算出极大 duration，导致正常点击被误判为长按
  const startTime = touchStartTime.value
  touchStartTime.value = 0
  if (startTime > 0 && Date.now() - startTime >= LONG_PRESS_THRESHOLD) {
    return
  }

  // 通话中（呼叫中 / 通话中）禁止播放语音消息，避免抢占通话音频焦点
  if (isInCallNow()) {
    uni.showToast({ title: '您正在通话中，无法播放语音消息', icon: 'none', duration: 2000 })
    return
  }

  if (isPlaying.value) {
    // 停止播放
    stop()
  } else {
    // 检查是否需要先下载
    if (!soundUrl.value) {
      // 标记等待播放
      pendingPlay.value = true
      // 如果还没开始下载，触发下载
      if (!isDownloading.value) {
        preDownloadSound()
      }
    } else {
      // 开始播放
      handlePlay()
    }
  }
}

/**
 * 预下载语音资源
 */
const preDownloadSound = async () => {
  if (!props.message?.msgID) {
    return
  }
  
  // 已有本地路径，无需下载
  if (soundUrl.value) {
    // 如果有等待播放的标记，直接播放
    if (pendingPlay.value) {
      pendingPlay.value = false
      handlePlay()
    }
    return
  }
  
  if (isDownloading.value) {
    return
  }
  
  isDownloading.value = true
  try {
    await useMessageActionState({ message: props.message }).downloadMedia(MediaQuality.ORIGINAL)
    // 下载完成后，如果有等待播放的标记，自动播放
    if (pendingPlay.value && soundUrl.value) {
      pendingPlay.value = false
      handlePlay()
    }
  } catch (error) {
    console.error('[AudioMessage] preDownloadSound failed:', error)
    // 下载失败，尝试用远端 URL 直接播放作为兜底
    if (pendingPlay.value) {
      pendingPlay.value = false
      const remoteUrl = getRemoteSoundUrl()
      if (remoteUrl) {
        // 标记为已尝试远端回退，避免 onError 再次重试
        hasTriedRemoteFallback = true
        stopGlobalAudioPlayer()
        play(remoteUrl)
      } else {
        uni.showToast({ title: '语音下载失败', icon: 'none' })
      }
    }
  } finally {
    isDownloading.value = false
  }
}

/**
 * 开始播放
 * 策略：
 * 1. 优先用本地路径（soundPath）播放
 * 2. 若本地路径不存在，直接降级用远端 URL 播放
 * 3. onError 里做一次远端 URL 回退兜底（防止本地文件损坏 / 格式不被系统支持）
 */
const handlePlay = async () => {
  // 通话中（呼叫中 / 通话中）禁止播放——拦截所有路径（用户主动 tap、下载完成自动播）
  // 静默 return：tap 入口已弹过 toast，下载完成的自动播放属内部流程，无需再扰民
  if (isInCallNow()) {
    pendingPlay.value = false
    return
  }
  // 进入新一轮播放，重置远端回退标志
  hasTriedRemoteFallback = false
  
  const localUrl = soundUrl.value
  const remoteUrl = getRemoteSoundUrl()
  
  // 本地路径 + 远端 URL 都没有 → 直接报错
  if (!localUrl && !remoteUrl) {
    uni.showToast({ title: '语音资源不可用', icon: 'none' })
    return
  }
  
  // 停止全局音频播放器（如铃声）
  stopGlobalAudioPlayer()
  
  // 没本地路径，直接走远端（标记为已尝试过回退，避免 onError 再次回退造成双 toast）
  if (!localUrl && remoteUrl) {
    hasTriedRemoteFallback = true
    await play(remoteUrl)
    return
  }
  
  // 播放本地资源（失败时 onError 内会自动回退到远端）
  await play(localUrl)
}

onMounted(() => {
  // 订阅事件（放在生命周期内，避免 SSR/预渲染时 uni 未就绪）
  uni.$on('audioPlayerStart', handleGlobalAudioStart)
  // 转文字事件订阅（开始/失败/隐藏；成功结果通过 SDK 更新 message.messagePayload.asrText）
  uni.$on('audioConvertingStart', handleConvertingStart)
  uni.$on('audioConvertingError', handleConvertingError)
  uni.$on('audioConvertHide', handleConvertHide)
  // 初始化时同步一次可见态到模块级 Map
  syncVisibleMap()
  // 切后台暂停：使用 plus.globalEvent 'pause' 代替不可靠的 uni.onAppHide
  // （uni.onAppHide 在 nvue 下有版本兼容问题，plus.globalEvent 在 iOS/Android 上更稳定）
  // #ifdef APP-PLUS
  if (typeof plus !== 'undefined' && plus.globalEvent) {
    plus.globalEvent.addEventListener('pause', handleAppHide)
  }
  // #endif
  
  // 初始化时预下载语音资源
  if (!soundUrl.value) {
    preDownloadSound()
  }
})

onUnmounted(() => {
  stopWaveAnimation()
  uni.$off('audioPlayerStart', handleGlobalAudioStart)
  uni.$off('audioConvertingStart', handleConvertingStart)
  uni.$off('audioConvertingError', handleConvertingError)
  uni.$off('audioConvertHide', handleConvertHide)
  // 清理模块级可见态缓存，避免 msgID 复用 / 内存泄漏
  try { getVisibleMap().delete(props.message.msgID) } catch (e) {}
  // #ifdef APP-PLUS
  if (typeof plus !== 'undefined' && plus.globalEvent) {
    try { plus.globalEvent.removeEventListener('pause', handleAppHide) } catch (e) {}
  }
  // #endif
})
</script>

<style>
.audio-message-wrapper {
  flex-direction: column;
  align-items: flex-start;
}

/* 自己发送的消息整体右对齐 */
.audio-message-wrapper--self {
  align-items: flex-end;
}

.audio-message {
  min-width: 200rpx;
}

.content-in {
  background-color: #F0F2F7;
  border-radius: 4rpx 20rpx 20rpx 20rpx;
}

.content-out {
  background-color: #CCE2FF;
  border-radius: 20rpx 4rpx 20rpx 20rpx;
}

.audio-highlight {
  flex: 1;
  flex-direction: row;
  align-items: center;
  padding: 20rpx;
  background-color: transparent;
}

.content-out .audio-highlight {
  flex-direction: row-reverse;
}

/* 声波动画容器 */
.audio-wave-container {
  position: relative;
  width: 40rpx;
  height: 40rpx;
}

/* 接收消息的声波方向（镜像翻转） */
.wave-in {
  transform: scaleX(-1);
}

/* 声波裁剪容器 - 从右侧开始显示（原点在右边） */
.audio-wave-clip {
  position: absolute;
  right: 0;
  top: 0;
  height: 40rpx;
  overflow: hidden;
}

/* 声波图标 - 固定在右侧 */
.audio-wave-icon {
  position: absolute;
  right: 0;
  top: 0;
  width: 40rpx;
  height: 40rpx;
}

.audio-duration {
  margin-left: 8rpx;
  margin-right: 8rpx;
}

.duration-text {
  padding: 0 4rpx;
  font-size: 28rpx;
  line-height: 32rpx;
  font-weight: 500;
  color: rgba(0, 0, 0, 0.9);
}

/* 语音转文字结果展示
 * 入场动画使用 nvue 原生 animation.transition 驱动（见 playCurtainAnimation），
 * 而非 css @keyframes—— nvue 对 @keyframes 支持不稳定 */
.audio-convert-box {
  /* 最大宽度与 audioWidth 最大值（474rpx）保持一致，视觉宽度不超过气泡 */
  max-width: 474rpx;
  margin-top: 12rpx;
  padding: 16rpx 20rpx;
  background-color: rgba(255, 255, 255, 0.95);
  border-radius: 12rpx;
  border: 1rpx solid rgba(0, 0, 0, 0.08);
}

.audio-convert-text {
  font-size: 28rpx;
  line-height: 40rpx;
  color: rgba(0, 0, 0, 0.85);
  /* nvue text 默认会换行，但需父容器有宽度约束才生效；此处显式声明保证多行展示 */
  lines: 0;
}
</style>
