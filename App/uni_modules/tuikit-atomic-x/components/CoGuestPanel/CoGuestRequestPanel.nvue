<template>
  <view>
  <!-- 连麦接通后从控制条"画面调整"进入（initialDetailOpen=true）：跳过选择面板层，只渲染 detail drawer，直达调整视频连麦画面。 -->
  <BaseDrawer
    ref="baseDrawerRef"
    :model-value="requestPanelVisible"
    @update:model-value="onRequestPanelVisibleChange"
    :height="430"
    :overlayOpacity="0.4"
    bgImage="/uni_modules/tuikit-atomic-x/static/assets/live/drawer-bg.png"
    :bgImageHeight="710"
    padding="0 40rpx 60rpx 40rpx"
  >
    <!-- 主播资料（.audience-co-mic-profile） -->
    <view class="anchor-profile">
      <!-- 外层 ring（浅色扩散圈）包裹内层头像 image（含 brand 边框）。
           nvue image 的 box-shadow spread 会渲染成菱形，
           故用外层 view 背景色实现 ring，内层 image 做边框，均用 border-radius:50%。 -->
      <view class="anchor-avatar-ring">
        <image
          class="anchor-avatar"
          :src="anchorAvatarDisplay"
          mode="aspectFill"
          @error="onAnchorAvatarError"
          @load="onAnchorAvatarLoad"
        />
      </view>
      <text class="anchor-name">{{ anchorName }}</text>
    </view>

    <!-- 连麦方式按钮。状态机：
         IDLE -> 语音/视频双块（中间圆滑斜边无缝分隔，斜边+双渐变由 PNG 背景实现，
                 nvue 不支持内联 SVG，按钮透明叠在图上）；
         USER_APPLYING -> 合并为单个全宽"取消申请"按钮（灰色样式）。 -->
    <!-- IDLE：语音/视频双块 -->
    <view class="co-mic-actions" v-if="!isApplying && !isConnected">
      <image class="co-mic-split-bg" src="/uni_modules/tuikit-atomic-x/static/assets/live/co-mic-split-bg.png" mode="scaleToFill" />
      <!-- 左半：语音连麦 -->
      <view class="co-mic-apply is-voice" @tap="handleSendCoGuest('mic')">
        <text class="co-mic-apply-text">{{ t('voice_co_guest') }}</text>
      </view>
      <!-- 右半：视频连麦（对齐 iOS：先进入"调整视频连麦画面"，点申请按钮才发起申请） -->
      <view class="co-mic-apply is-video" @tap="handleSendCoGuest('video')">
        <text class="co-mic-apply-text">{{ t('video_co_guest') }}</text>
      </view>
    </view>
    <!-- USER_APPLYING：单个"取消申请"按钮 -->
    <view class="co-mic-actions is-single" v-else-if="isApplying">
      <view class="co-mic-apply is-cancel" @tap="handleCancelApplication">
        <text class="co-mic-apply-text is-cancel-text">{{ t('cancel_apply') }}</text>
      </view>
    </view>
  </BaseDrawer>

  <!-- 调整视频连麦画面：底部抽屉，内部布局对齐 iOS SettingsPanel
       （返回/标题+副标题/本地摄像头预览/三能力项/申请按钮）。
       连麦接通后从控制条进入(initialDetailOpen)为 connected 模式：无预览、无申请按钮，仅三能力项。 -->
  <BaseDrawer
    v-model="detailVisible"
    :height="detailDrawerHeight"
    :zIndex="3200"
    :showHandle="true"
    bgImage="/uni_modules/tuikit-atomic-x/static/assets/live/drawer-bg.png"
    :bgImageHeight="detailDrawerHeight + 80"
    padding="0 40rpx 48rpx 40rpx"
    @overlayTap="handleOverlayTap"
  >
    <view class="detail-back" @tap="handleDetailBack">
      <image class="detail-back-icon" src="/uni_modules/tuikit-atomic-x/static/assets/live/co-mic-back.png" mode="aspectFit" />
    </view>
    <view class="detail-heading">
      <text class="detail-title">{{ t('adjust_title') }}</text>
      <text class="detail-subtitle">{{ t('adjust_subtitle') }}</text>
    </view>
    <view class="local-preview" v-if="detailPreviewShown">
      <camera-test-view
        v-if="cameraTestViewReady"
        class="local-preview-camera"
        :viewID="cameraTestViewID"
        :cornerRadius="20"
      />
    </view>
    <view class="detail-actions">
      <view class="detail-action" @tap="handleBeauty">
        <view class="cap-icon">
          <image class="cap-icon-img" src="/uni_modules/tuikit-atomic-x/static/assets/live/co-mic-beauty.png" mode="aspectFit" />
        </view>
        <text class="cap-label">{{ t('beautify') }}</text>
      </view>
      <view class="detail-action" @tap="handleToggleMirror">
        <view class="cap-icon">
          <image
            class="cap-icon-img"
            :style="{ transform: mirrorEnabled ? 'scaleX(1)' : 'scaleX(-1)' }"
            :src="mirrorOnIcon"
            mode="aspectFit"
          />
        </view>
        <text class="cap-label">{{ t('mirror') }}</text>
      </view>
      <view class="detail-action" @tap="handleFlipCamera">
        <view class="cap-icon">
          <image class="cap-icon-img" src="/uni_modules/tuikit-atomic-x/static/assets/live/co-mic-flip.png" mode="aspectFit" />
        </view>
        <text class="cap-label">{{ t('flip_camera') }}</text>
      </view>
    </view>
    <view class="detail-apply" v-if="detailPreviewShown" @tap="handleApply">
      <text class="detail-apply-text">{{ t('apply_co_guest') }}</text>
    </view>
    <BeautyPanel
      :modelValue="isShowBeautyPanel"
      :zIndex="3200"
      @update:modelValue="onBeautyVisibleChange"
    />
  </BaseDrawer>
  </view>
</template>

<script setup lang="ts">
  import { onMounted, ref, onUnmounted, computed, watch, nextTick } from 'vue';
  import BaseDrawer from '@/uni_modules/tuikit-atomic-x/components/Common/BaseDrawer/index.nvue';
  import { BeautyPanel } from '@/uni_modules/tuikit-atomic-x/components/Beauty';
  import { showLiveToast } from '@/uni_modules/tuikit-atomic-x/components/Common/LiveToast/index.ts';

  import { useDeviceState } from "@/uni_modules/tuikit-atomic-x/state/DeviceState";
  import { MirrorType } from "@/uni_modules/tuikit-atomic-x/state/DeviceState";
  import { useCoGuestState, NoResponseReason } from "@/uni_modules/tuikit-atomic-x/state/CoGuestState";
  import { useLiveSeatState } from "@/uni_modules/tuikit-atomic-x/state/LiveSeatState";
  import { t } from '../locales';
  import { useLoginState } from "@/uni_modules/tuikit-atomic-x/state/LoginState";
  import { useLiveListState } from "@/uni_modules/tuikit-atomic-x/state/LiveListState";
  import permission from "@/uni_modules/tuikit-atomic-x/utils/permission";
  const { loginUserInfo } = useLoginState()
  const { currentLive } = useLiveListState()
  const liveID = computed(() => String(currentLive.value?.liveID || ''))
  const currentCoGuestType = ref('')

  const ensureCameraPermission = async (): Promise<boolean> => {
    const result = await permission.ensureMediaPermission('camera');
    if (result === 1) return true;
    if (result === -1) showTip(t('camera_permission_denied'));
    return false;
  };

  const showTip = (title) => showLiveToast(title);

  // iOS SDK 的 requestPermissions(openCamera: true) 会同时申请麦克风权限,麦克风被拒时
  // startCameraTest / openLocalCamera / openLocalMicrophone 都会返回 -1105,视频也开不了。
  // 这三条失败可能在同一轮上麦里接连发生,3s 内只提示一次,指向真正需要开启的权限。
  let lastPermissionTipAt = 0;
  const showPermissionTipOnce = (errCode: any, errMsg: any) => {
    if (Number(errCode) !== -1105 && !String(errMsg || '').includes('Microphone')) return;
    const now = Date.now();
    if (now - lastPermissionTipAt < 3000) return;
    lastPermissionTipAt = now;
    showTip(t('micPermissionDenied'));
  };

  const {
    microphoneStatus, microphoneStatusReason, microphoneLastError, captureVolume,
    cameraStatus, cameraStatusReason, cameraLastError,
    currentAudioRoute, isScreenSharing, isFrontCamera, localMirrorType, screenStatus, screenStatusReason,
    openLocalMicrophone, closeLocalMicrophone, muteLocalAudio, unmuteLocalAudio, setAudioRoute,
    openLocalCamera, closeLocalCamera, switchCamera, switchMirror, updateVideoQuality,
    startCameraTest, stopCameraTest,
    startScreenShare, stopScreenShare,
  } = useDeviceState(liveID.value);
  const {
    invitees, applicants, connected,
    applyForSeat, cancelApplication,
    addCoGuestHostListener, removeCoGuestHostListener,
    addCoGuestGuestListener, removeCoGuestGuestListener
  } = useCoGuestState(liveID.value);
  const { seatList, muteMicrophone } = useLiveSeatState(liveID.value);


  const defaultAvatarURL = '/uni_modules/tuikit-atomic-x/static/assets/live/default-avatar.png';
  const props = defineProps({
    modelValue: {
      type: Boolean,
      default: false
    },
    liveID: {
      type: String,
    },
    userID: {
      type: String,
      default: '',
    },
    seatIndex: {
      type: Number,
      default: -1,
    },
    initialDetailOpen: {
      type: Boolean,
      default: false,
    },
  });
  const emit = defineEmits(['update:modelValue', 'accepted', 'statusChange', 'back']);

  const requestPanelVisible = computed(() => innerVisible.value && !props.initialDetailOpen);

  const onRequestPanelVisibleChange = (val) => {
    if (val) return;
    innerVisible.value = false;
  };

  const innerVisible = computed({
    get: () => props.modelValue,
    set: (val) => emit('update:modelValue', val)
  });

  const guestStatus = ref(uni.$localGuestStatus || 'IDLE');

  watch(innerVisible, (val) => {
    if (val) {
      guestStatus.value = uni.$localGuestStatus || 'IDLE';
      if (props.initialDetailOpen) {
        setTimeout(() => { detailVisible.value = true; }, 0);
      }
    }
  });
  const isApplying = computed(() => guestStatus.value === 'USER_APPLYING');
  const isConnected = computed(() => guestStatus.value === 'CONNECTED');

  const detailVisible = ref(false);
  const baseDrawerRef = ref(null);
  let cameraRelayoutTimer: any = null;
  let cameraStartTimer: any = null;
  let detailMode = 'preview';
  const detailPreviewShown = ref(true);
  let cameraTeardownTimer: any = null;

  const cameraTestViewID = 'co-guest-camera-test';
  const mirrorEnabled = computed(() =>
    localMirrorType.value === MirrorType.AUTO || localMirrorType.value === MirrorType.ENABLE
  );
  const mirrorOnIcon = '/uni_modules/tuikit-atomic-x/static/assets/live/co-mic-mirror.png';
  const cameraTestViewReady = ref(true);
  const isShowBeautyPanel = ref(false);
  const BEAUTY_CLOSE_GUARD_MS = 400;
  let beautyClosedAt = 0;
  const onBeautyVisibleChange = (val: boolean) => {
    const next = !!val;
    if (!next) beautyClosedAt = Date.now();
    isShowBeautyPanel.value = next;
  };

  const showDetailPreview = computed(() => !props.initialDetailOpen);
  const detailDrawerHeight = computed(() => (detailPreviewShown.value ? 1054 : 380));

  const handleDetailBack = () => {
    detailVisible.value = false;
    if (props.initialDetailOpen) {
      emit('back');
    }
  };

  const handleOverlayTap = () => {
    if (isShowBeautyPanel.value) return;
    if (Date.now() - beautyClosedAt < BEAUTY_CLOSE_GUARD_MS) return;
    detailVisible.value = false;
    if (props.initialDetailOpen) {
      emit('back');
      return;
    }
    emit('update:modelValue', false);
  };

  let cameraTestRetryTimer: any = null;
  let cameraTestRetryCount = 0;
  const CAMERA_TEST_MAX_RETRY = 10;
  let cameraFollowTimer: any = null;
  let cameraFollowPending = false;
  const tryStartCameraTest = async () => {
    const wantFront = isFrontCamera.value;
    const cameraPermitted = await ensureCameraPermission();
    if (!cameraPermitted) return;
    startCameraTest({
      cameraView: cameraTestViewID,
      success: () => {
        cameraTestRetryCount = 0;
        console.log('startCameraTest success.');
        if (!wantFront) {
          cameraFollowPending = true;
          clearTimeout(cameraFollowTimer);
          cameraFollowTimer = setTimeout(() => {
            cameraFollowPending = false;
            if (detailVisible.value) {
              switchCamera({ isFront: false });
              isFrontCamera.value = false;
            }
          }, 200);
        }
      },
      fail: (errCode, errMsg) => {
        if (errCode === -1 && cameraTestRetryCount < CAMERA_TEST_MAX_RETRY && detailVisible.value) {
          cameraTestRetryCount += 1;
          clearTimeout(cameraTestRetryTimer);
          cameraTestRetryTimer = setTimeout(() => { tryStartCameraTest(); }, 100);
        } else {
          console.error(`startCameraTest fail errCode: ${errCode}, errMsg: ${errMsg}`);
          showPermissionTipOnce(errCode, errMsg);
        }
      },
    });
  };
  const openCoMicDetail = () => {
    clearTimeout(cameraTestRetryTimer);
    clearTimeout(cameraFollowTimer);
    clearTimeout(cameraStartTimer);
    clearTimeout(cameraTeardownTimer);
    cameraTestRetryCount = 0;
    detailMode = showDetailPreview.value ? 'preview' : 'connected';
    detailPreviewShown.value = showDetailPreview.value;
    if (detailMode === 'connected') return;
    switchCamera({ isFront: true });
    switchMirror({ mirrorType: MirrorType.ENABLE });
    cameraStartTimer = setTimeout(() => {
      cameraStartTimer = null;
      if (detailVisible.value) tryStartCameraTest();
    }, 350);
  };

  // 关闭 detail（iOS: sheetWillDismiss -> stopPreview）。
  // 两种场景处理差异：
  //   - 未连麦（initialDetailOpen=false）：正常 stopCameraTest 关闭测试预览即可
  //   - 连麦中（initialDetailOpen=true）：先 stopCameraTest 关摄像头（会中断连麦画面），
  //     紧接着 openLocalCamera 重开摄像头。cameraStatus 由 OFF→ON 触发 LiveCoreView 内部
  //     updateVideoView → 重新 setLocalVideoView(liveView) → 画面自动回到连麦画面。
  //     期间连麦画面有几百 ms 短暂黑屏（可接受）。
  const closeCoMicDetail = () => {
    clearTimeout(cameraTestRetryTimer);
    clearTimeout(cameraFollowTimer);
    // 布局变化重建 view 的延迟 timer 一并清除,防止关面板后迟到触发又拉起摄像头测试。
    clearTimeout(cameraRelayoutTimer);
    // 复位挂载开关:若上次布局变化中断在"卸载重挂"的等待期(cameraTestViewReady=false),
    // 不复位会导致下次打开面板时 camera-test-view 不渲染、预览黑屏。
    cameraTestViewReady.value = true;
    // 跟随切换排队中面板即被关闭：跳过切换，直接按后置恢复连麦摄像头
    // （此时 SDK 可能把 isFrontCamera 刷成了前置，若不校正会错误地恢复前置）。
    if (cameraFollowPending) {
      cameraFollowPending = false;
      isFrontCamera.value = false;
    }
    cameraTestRetryCount = 0;
    isShowBeautyPanel.value = false;
    // connected 模式从未启动预览采集（iOS 也不 startPreview），无需收尾、不会关掉连麦摄像头。
    // 用打开时快照的 detailMode：此时 props.initialDetailOpen 可能已被父层复位成 false。
    if (detailMode === 'connected') return;
    stopCameraTest();
  };

  watch(detailVisible, (val) => {
    if (val) {
      openCoMicDetail();
    } else {
      closeCoMicDetail();
    }
  });

  watch(() => currentLive.value?.seatLayoutTemplateID, (newVal, oldVal) => {
    if (oldVal === undefined || newVal === oldVal) return;
    if (!detailVisible.value) return;
    if (uni.$localGuestStatus !== 'CONNECTED') return;
    console.log(`[CoGuest] layout changed: ${oldVal} -> ${newVal}, recover camera then restart test.`);
    showTip(t('layout_adjusted'));
    stopCameraTest();
    clearTimeout(cameraTestRetryTimer);
    clearTimeout(cameraFollowTimer);
    cameraFollowPending = false;
    cameraTestRetryCount = 0;
    cameraTestViewReady.value = false;
    if (props.initialDetailOpen) {
      openLocalCamera({
        isFront: isFrontCamera.value,
        fail: (errCode: number, errMsg: string) => {
          console.error(`[CoGuest] relayout recover openLocalCamera fail: ${errCode}, ${errMsg}`);
        },
      });
    }
    clearTimeout(cameraRelayoutTimer);
    cameraRelayoutTimer = setTimeout(() => {
      cameraRelayoutTimer = null;
      if (!detailVisible.value) return;
      console.log('[CoGuest] relayout settle, remount camera test view & restart capture.');
      cameraTestViewReady.value = true;
      nextTick(() => { tryStartCameraTest(); });
    }, 1000);
  });

  const handleToggleMirror = () => {
    switchMirror({ mirrorType: mirrorEnabled.value ? MirrorType.DISABLE : MirrorType.ENABLE });
  };

  const handleFlipCamera = () => {
    switchCamera({ isFront: !isFrontCamera.value });
  };

  const handleBeauty = () => {
    isShowBeautyPanel.value = true;
  };

  // 「申请连麦」按钮（iOS SettingsPanel.applyButton -> onApply）：关闭调整画面并发起视频连麦申请。
  const handleApply = () => {
    doApplyCoGuest('video');
  };

  // SDK 偶发返回字符串 "null"/"undefined",需过滤,否则会被当成有效 URL 加载失败后卡在兜底图。
  const anchorAvatarURL = computed(() => {
    const raw = String(currentLive.value?.liveOwner?.avatarURL ?? '').trim();
    if (!raw || raw === 'null' || raw === 'undefined') return '';
    return raw;
  });
  // 对齐 iOS RequestingPanel.bind：超 15 字符截断并加省略号
  const anchorName = computed(() => {
    const raw = currentLive.value?.liveOwner?.userName || currentLive.value?.liveOwner?.userID || '';
    return raw.length > 15 ? `${raw.slice(0, 15)}…` : raw;
  });

  // 对齐 iOS RequestingPanel.bind:kf.setImage(with:owner.avatarURL, placeholder:默认头像)。
  // 默认图只作初始占位,真实 URL 直接赋给 image;不做"清空 src + setTimeout" —— iOS nvue
  // 对空 src 会派发 @error,迟到的旧 error 会把刚赋值的真实头像覆盖成兜底图且无法自愈。
  const LOCAL_FALLBACK_AVATAR = defaultAvatarURL;
  const anchorAvatarDisplay = ref(LOCAL_FALLBACK_AVATAR);
  let appliedAvatarURL = '';
  const applyAnchorAvatar = () => {
    const url = anchorAvatarURL.value;
    if (!url || url === appliedAvatarURL) return;
    appliedAvatarURL = url;
    anchorAvatarDisplay.value = url;
  };
  const onAnchorAvatarError = () => {
    if (anchorAvatarDisplay.value !== LOCAL_FALLBACK_AVATAR) {
      anchorAvatarDisplay.value = LOCAL_FALLBACK_AVATAR;
    }
  };
  const onAnchorAvatarLoad = () => {
    // 加载成功回调（保留 hook，方便后续扩展，比如埋点/淡入动画）。
  };
  // 数据到达即绑定(对齐 iOS bind(liveInfo)),不等面板打开。
  watch(anchorAvatarURL, () => { applyAnchorAvatar(); }, { immediate: true });
  // 每次打开面板重新绑定一次:若上次加载失败停在兜底图,重新打开可重试。
  watch(innerVisible, (val) => {
    if (val) {
      appliedAvatarURL = '';
      applyAnchorAvatar();
    }
  });

  const close = () => {
    emit('update:modelValue', false);
  };

  onMounted(() => {
    bindGuestEventListeners(liveID.value)
  })

  onUnmounted(() => {
    currentCoGuestType.value = ''
    uni.$localCoGuestType = ''
    clearTimeout(cameraTestRetryTimer)
    clearTimeout(cameraFollowTimer)
    clearTimeout(cameraRelayoutTimer)
    clearTimeout(cameraStartTimer)
    clearTimeout(cameraTeardownTimer)
    if (detailVisible.value) {
      stopCameraTest()
    }
    if (boundGuestEventLiveID) {
      removeCoGuestGuestListener(boundGuestEventLiveID, 'onGuestApplicationResponded', handleGuestApplicationResponded)
      removeCoGuestGuestListener(boundGuestEventLiveID, 'onGuestApplicationNoResponse', handleGuestApplicationNoResponse)
      boundGuestEventLiveID = ''
    }
  })


  const finalizeAccepted = () => {
    if (uni.$localGuestStatus === 'CONNECTED') return;
    pendingSeatIndex = -1;
    uni.$localGuestStatus = 'CONNECTED'
    guestStatus.value = 'CONNECTED'
    emit('statusChange', 'CONNECTED')
    // 相机 / 麦克风各自向系统确认自己的权限(Android 主动 requestPermissions 取权威结果,
    // iOS 读原生授权状态),互不牵连;被拒时【不发起】设备打开请求,避免留下挂起请求 ——
    // 否则用户后续在系统设置里开启权限后设备会自动开始采集(别人能听到,但 UI 仍显示关闭)。
    const coGuestType = currentCoGuestType.value;
    permission.ensureMediaPermission('camera').then((result: number) => {
      if (result !== 1 || coGuestType !== 'video') return;
      openLocalCamera({
        isFront: isFrontCamera.value !== false,
        success: () => {
          // 对齐 iOS CoGuestIcon:开启期间已进后台则立刻关掉摄像头。
          // 例外:系统权限弹框造成的"假后台"不能关,否则上麦后刚开的摄像头会被误关。
          if (uni.$appIsActive === false && !permission.isPermissionPrompting()) {
            closeLocalCamera();
            return;
          }
          console.log('openLocalCamera success.');
        },
        fail: (errCode, errMsg) => {
          console.error(`openLocalCamera fail errCode: ${errCode}, errMsg: ${errMsg}`);
          showPermissionTipOnce(errCode, errMsg);
          closeLocalCamera();
        },
      });
    });
    permission.ensureMediaPermission('microphone').then((result: number) => {
      if (result !== 1) {
        muteMicrophone({ liveID: liveID.value });
        return;
      }
      openLocalMicrophone({
        success: () => {
          console.log('openLocalMicrophone success.');
        },
        fail: (errCode, errMsg) => {
          console.error(`openLocalMicrophone fail errCode: ${errCode}, errMsg: ${errMsg}`);
          showPermissionTipOnce(errCode, errMsg);
          closeLocalMicrophone();
          muteMicrophone({ liveID: liveID.value });
        },
      });
    });
    if (detailVisible.value) {
      detailVisible.value = false;
    }
    emit('update:modelValue', false);
    emit('accepted');
  };

  const handleGuestApplicationResponded = (event) => {
    const res = JSON.parse(event)
    if (res.isAccept) {
      finalizeAccepted();
    } else {
      uni.$localGuestStatus = 'IDLE'
      guestStatus.value = 'IDLE'
      emit('statusChange', 'IDLE')
      showTip(t('request_rejected'));
    }
  }

  watch(connected, (newList) => {
    const list = Array.isArray(newList) ? newList : [];
    const hasSelf = list.some((item: any) => item?.userID && item?.userID === props.userID);
    if (hasSelf && uni.$localGuestStatus === 'USER_APPLYING') {
      finalizeAccepted();
    }
  }, { deep: true });
  const handleGuestApplicationNoResponse = (event) => {
    const res = JSON.parse(event)
    if (res.reason === NoResponseReason.TIMEOUT) {
      uni.$localGuestStatus = 'IDLE'
      guestStatus.value = 'IDLE'
      emit('statusChange', 'IDLE')
      showTip(t('request_timeout'));
    }
  }

  let boundGuestEventLiveID = '';
  const bindGuestEventListeners = (roomID: string) => {
    if (!roomID || roomID === boundGuestEventLiveID) return;
    if (boundGuestEventLiveID) {
      removeCoGuestGuestListener(boundGuestEventLiveID, 'onGuestApplicationResponded', handleGuestApplicationResponded)
      removeCoGuestGuestListener(boundGuestEventLiveID, 'onGuestApplicationNoResponse', handleGuestApplicationNoResponse)
    }
    boundGuestEventLiveID = roomID;
    addCoGuestGuestListener(roomID, 'onGuestApplicationResponded', handleGuestApplicationResponded)
    addCoGuestGuestListener(roomID, 'onGuestApplicationNoResponse', handleGuestApplicationNoResponse)
  };
  watch(liveID, (val) => { bindGuestEventListeners(val); });

  let pendingSeatIndex = -1;
  watch(seatList, (newList) => {
    if (uni.$localGuestStatus !== 'USER_APPLYING' || pendingSeatIndex < 0) return;
    const list: any[] = Array.isArray(newList) ? newList : [];
    const seat = list.find((s: any) => Number(s?.index) === pendingSeatIndex);
    const occupiedUserID = seat?.userInfo?.userID;
    if (occupiedUserID && occupiedUserID !== props.userID) {
      cancelApplication({ liveID: liveID.value });
      pendingSeatIndex = -1;
      uni.$localGuestStatus = 'IDLE'
      guestStatus.value = 'IDLE'
      emit('statusChange', 'IDLE')
      showTip(t('seat_occupied'));
    }
  }, { deep: true });

  let lastSelfAllowOpenMic: boolean | null = null;
  watch(seatList, (newList) => {
    const list: any[] = Array.isArray(newList) ? newList : [];
    const selfSeat = list.find((s: any) => s?.userInfo?.userID === props.userID);
    if (!selfSeat) {
      lastSelfAllowOpenMic = null;
      return;
    }
    const allowOpenMic = selfSeat?.userInfo?.allowOpenMicrophone !== false;
    if (lastSelfAllowOpenMic !== null && lastSelfAllowOpenMic !== allowOpenMic) {
      showTip(t(allowOpenMic ? 'micUnlocked' : 'micLocked'));
    }
    lastSelfAllowOpenMic = allowOpenMic;
  }, { deep: true });

  const APPLY_ERROR_KEYS: Record<number, string> = {
    100004: 'room_not_exist',
    100005: 'not_room_member',
    100006: 'cannot_do_now',
    100200: 'seat_locked',
    100202: 'already_requesting',
    100203: 'already_on_seat',
    100205: 'seat_full',
    100210: 'seat_occupied',
    100211: 'not_supported',
  };

  const doApplyCoGuest = (type: string) => {
    console.log(`goGuest localStatus: ${uni.$localGuestStatus}`);
    if (uni.$localGuestStatus !== 'IDLE') {
      return
    }
    currentCoGuestType.value = type
    uni.$localCoGuestType = type
    // 从调整画面发起：先关闭预览采集，再申请（预览摄像头与连麦推流互斥）。
    if (detailVisible.value) {
      detailVisible.value = false;
    }
    pendingSeatIndex = props.seatIndex >= 0 ? props.seatIndex : -1
    applyForSeat({
      liveID: props.liveID,
      seatIndex: props.seatIndex,
      timeout: 0,
      success: () => {
      },
      fail: (errorCode) => {
        showTip(t(APPLY_ERROR_KEYS[errorCode] || 'apply_failed'))
        uni.$localGuestStatus = 'IDLE'
        guestStatus.value = 'IDLE'
        emit('statusChange', 'IDLE')
      },
    });
    uni.$localGuestStatus = 'USER_APPLYING'
    // 申请后不关闭面板，按钮就地切换为"取消申请"单按钮。
    guestStatus.value = 'USER_APPLYING'
    emit('statusChange', 'USER_APPLYING')
  }

  // 语音连麦：直接发起申请；视频连麦：先进入"调整视频连麦画面"，由其中的申请按钮发起。
  const handleSendCoGuest = (type: string) => {
    if (type === 'video') {
      currentCoGuestType.value = 'video';
      detailVisible.value = true;
      return;
    }
    doApplyCoGuest(type);
  }

  const handleCancelApplication = () => {
    cancelApplication({
      liveID: props.liveID,
    })
    pendingSeatIndex = -1;
    uni.$localGuestStatus = 'IDLE'
    guestStatus.value = 'IDLE'
    emit('statusChange', 'IDLE')
  }
</script>

<style>
  /* 主播资料 .audience-co-mic-profile：竖向居中 */
  .anchor-profile {
    flex-direction: column;
    align-items: center;
  }

  /* .audience-co-mic-avatar 外圈 ring：box-shadow 0 0 0 4px rgba(brand-2,0.1) -> 8rpx 浅蓝环。
     ring view尺寸 = 头像116 + 边框4*2 + ring8*2 = 140rpx，圆形，浅蓝背景，居中放头像。 */
  .anchor-avatar-ring {
    width: 140rpx;
    height: 140rpx;
    border-radius: 50%;
    background-color: rgba(74, 158, 255, 0.1);
    align-items: center;
    justify-content: center;
  }

  /* 主播头像：116rpx 圆形，边框 4rpx（brand 渐变边框 nvue 不支持，用 brand-2 单色近似）。 */
  .anchor-avatar {
    width: 116rpx;
    height: 116rpx;
    border-radius: 50%;
    border-width: 4rpx;
    border-style: solid;
    border-color: #4A9EFF;
  }

  /* .audience-co-mic-name：margin-top:10px→20rpx，16px→32rpx，600 */
  .anchor-name {
    margin-top: 20rpx;
    color: #ffffff;
    font-size: 32rpx;
    font-weight: 600;
  }

  .co-mic-actions {
    position: relative;
    flex-direction: row;
    width: 670rpx;
    height: 80rpx;
    margin-top: 44rpx;
    border-radius: 22rpx;
    overflow: hidden;
  }

  /* 斜边背景：铺满 actions 区，含双渐变与中间圆滑斜边。
     nvue 中父容器 overflow:hidden 无法裁剪绝对定位子 image 的圆角，
     故圆角直接加在 image 自身（22rpx）。 */
  .co-mic-split-bg {
    position: absolute;
    top: 0;
    left: 0;
    width: 670rpx;
    height: 80rpx;
    border-radius: 22rpx;
  }

  /* 连麦方式按钮：透明按钮叠在斜边背景上，只承载文字与点击。
     background:transparent、border:0；voice padding-right:40rpx、video padding-left:40rpx。 */
  .co-mic-apply {
    position: relative;
    flex: 1;
    height: 80rpx;
    align-items: center;
    justify-content: center;
    background-color: transparent;
  }

  .co-mic-apply.is-voice {
    padding-right: 40rpx;
  }

  .co-mic-apply.is-video {
    padding-left: 40rpx;
  }

  /* 取消申请按钮（.primary-action-button.is-cancel）：单列全宽，灰色描边 + 半透明底。
     border rgba(255,255,255,0.1)，background rgba(255,255,255,0.07)，圆角 22rpx。
     .audience-co-mic-actions.is-single 时 .audience-co-mic-apply border-radius:11px。 */
  .co-mic-apply.is-cancel {
    flex: 1;
    border-width: 2rpx;
    border-style: solid;
    border-color: rgba(255, 255, 255, 0.1);
    border-radius: 22rpx;
    background-color: rgba(255, 255, 255, 0.07);
  }

  /* .primary-action-button 文字：13px→26rpx，600 */
  .co-mic-apply-text {
    color: #ffffff;
    font-size: 26rpx;
    font-weight: 600;
  }

  /* is-cancel 文字：color rgba(255,255,255,0.72) */
  .co-mic-apply-text.is-cancel-text {
    color: rgba(255, 255, 255, 0.72);
  }

  /* ===== 调整视频连麦画面（从右往左滑入的面板；内部度量对齐 iOS SettingsPanel） ===== */
  /* 全屏层容器 */

  /* 遮罩：背景色由 animation 模块驱动（滑入渐显 / 滑出渐隐） */

  /* 内容层：整屏，transform 由 animation 模块驱动。
     背景给极低非零不透明度：nvue Android 上完全透明的 view 不接收 touch，会导致关闭点击失效。
     注意：不能用 align-items/justify-content 把面板压到底部——weex 默认 column，
     align-items 管的是水平方向；面板改为自身绝对定位贴底（见 .detail-panel）。 */

  /* 面板：全宽、贴底，高度 = 各区实际高度之和 1022rpx（handle 48 + 标题区 64 + 预览 534
     + 能力项 192 + 申请按钮 136 + 底部内边距 48），从右滑入。 */


  /* 顶部 thumb 短横线：margin-top 20rpx + 自身 8rpx + 下间距 20rpx（收紧，避免标题离横条太远） */

  /* 返回按钮：36pt→72rpx 圆形，圆角 36rpx，白 9% 底，left 16pt→32rpx，top 20pt→40rpx */
  .detail-back {
    position: absolute;
    left: 32rpx;
    top: 40rpx;
    width: 72rpx;
    height: 72rpx;
    border-radius: 36rpx;
    background-color: rgba(255, 255, 255, 0.09);
    align-items: center;
    justify-content: center;
    z-index: 3;
  }

  .detail-back-icon {
    width: 36rpx;
    height: 36rpx;
  }

  /* 标题区：紧贴上方横条（不再额外拉开间距）；title 16pt→32rpx 600 居中，
     subtitle 12pt→24rpx 白 60%，上间距 4pt→8rpx */
  .detail-heading {
    flex-direction: column;
    align-items: center;
  }

  .detail-title {
    color: #ffffff;
    font-size: 32rpx;
    font-weight: 600;
  }

  .detail-subtitle {
    margin-top: 8rpx;
    color: rgba(255, 255, 255, 0.6);
    font-size: 24rpx;
  }

  /* 本地摄像头预览：左右各内缩 64pt→128rpx（宽 494rpx），正方形，圆角 20pt→40rpx，
     底色 RGB(0.055,0.098,0.196)→#0E1932，与标题区间距 20pt→40rpx */
  .local-preview {
    width: 494rpx;
    height: 494rpx;
    margin-top: 40rpx;
    border-radius: 40rpx;
    overflow: hidden;
    background-color: #0e1932;
    align-items: center;
    justify-content: center;
  }

  .local-preview-camera {
    width: 494rpx;
    height: 494rpx;
  }

  /* 三个能力项：左右内缩 56pt→112rpx（宽 526rpx），等间距，高 76pt→152rpx */
  .detail-actions {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    width: 526rpx;
    height: 152rpx;
    margin-top: 40rpx;
  }

  .detail-action {
    flex-direction: column;
    align-items: center;
  }

  .cap-icon {
    width: 96rpx;
    height: 96rpx;
    border-radius: 48rpx;
    background-color: rgba(255, 255, 255, 0.08);
    align-items: center;
    justify-content: center;
    margin-bottom: 16rpx;
  }

  .cap-icon-img {
    width: 48rpx;
    height: 48rpx;
  }

  .cap-label {
    color: rgba(255, 255, 255, 0.75);
    font-size: 22rpx;
    white-space: nowrap;
  }

  /* 申请按钮：左右内缩 20pt→40rpx（宽 670rpx），高 44pt→88rpx，圆角 22pt→44rpx，#3B7BFF */
  .detail-apply {
    width: 670rpx;
    height: 88rpx;
    margin-top: 48rpx;
    border-radius: 44rpx;
    background-color: #3b7bff;
    align-items: center;
    justify-content: center;
  }

  .detail-apply-text {
    color: #ffffff;
    font-size: 30rpx;
    font-weight: 600;
  }
</style>