<template>
  <BaseDrawer
    v-model="innerVisible"
    :height="drawerHeight"
    :overlayOpacity="0.4"
    bgImage="/uni_modules/tuikit-atomic-x/static/assets/live/drawer-bg.png"
    :bgImageHeight="drawerHeight"
    padding="0 32rpx 32rpx 32rpx"
    :preload="false"
  >
    <view class="panel-header">
      <text class="panel-title">{{ t('settings_title') }}</text>
      <view
        v-if="connectedCount > 0"
        class="end-all"
        :class="{ 'is-disabled': endAllDisabled }"
        @tap="handleEndAll"
      >
        <text class="end-all-text" :class="{ 'disabled-text': endAllDisabled }">{{ t('end_all') }}</text>
      </view>
    </view>

    <view class="card">
      <text class="section-title">{{ t('layout_title') }}</text>
      <view class="layout-grid">
        <view class="layout-row" v-for="(row, rowIndex) in layoutRows" :key="rowIndex">
          <view
            v-for="opt in row"
            :key="opt.id"
            class="layout-option"
            :class="{ 'is-active': selectedTemplateID === opt.id }"
            @tap="selectLayout(opt.id)"
          >
            <image class="layout-icon" :src="selectedTemplateID === opt.id ? opt.iconActive : opt.icon" mode="aspectFit" />
            <text class="layout-label" :class="{ 'is-active-label': selectedTemplateID === opt.id }">{{ t(opt.key) }}</text>
          </view>
        </view>
      </view>
    </view>

    <view class="card">
      <text class="section-title">
        {{ connectedCount > 0 ? t('connected_viewers_count', { count: connectedCount }) : t('connected_viewers') }}
      </text>
      <scroll-view
        v-if="connectedCount > 0"
        class="list-scroll"
        :style="{ height: listContentH(connectedCount) + 'rpx' }"
        scroll-y
        :show-scrollbar="false"
      >
        <view
          v-for="(audience, index) in connectedGuests"
          :key="audience?.userID"
          class="audience-row"
          :class="{ 'row-divider': index > 0 }"
        >
          <image class="audience-avatar" :src="audience?.avatarURL || defaultAvatarURL" mode="aspectFill" />
          <text class="audience-name" :numberOfLines="1">{{ audience?.userName || audience?.userID }}</text>
          <view class="row-btn danger" :class="{ 'is-disabled': isPending(audience) }" @tap="handleEndConnection(audience)">
            <text class="row-btn-text danger-text">{{ isPending(audience) ? t('processing') : t('end') }}</text>
          </view>
        </view>
      </scroll-view>
      <view v-else class="list-empty">
        <text class="list-empty-text">{{ t('no_participants') }}</text>
      </view>
    </view>

    <view class="card" v-if="applicantCount > 0">
      <text class="section-title">{{ t('applicants_count', { count: applicantCount }) }}</text>
      <scroll-view
        class="list-scroll"
        :style="{ height: listContentH(applicantCount) + 'rpx' }"
        scroll-y
        :show-scrollbar="false"
      >
        <view
          v-for="(audience, index) in applicants || []"
          :key="audience?.userID"
          class="audience-row"
          :class="{ 'row-divider': index > 0 }"
        >
          <image class="audience-avatar" :src="audience?.avatarURL || defaultAvatarURL" mode="aspectFill" />
          <text class="audience-name" :numberOfLines="1">{{ audience?.userName || audience?.userID }}</text>
          <view
            class="row-btn"
            :class="{ 'is-disabled': isPending(audience) || isLayoutFull }"
            @tap="handleAccept(audience)"
          >
            <text class="row-btn-text">{{ isPending(audience) ? t('processing') : t('accept_label') }}</text>
          </view>
        </view>
      </scroll-view>
    </view>

    <view class="card" v-if="candidateRows.length > 0">
      <text class="section-title">{{ t('available_count', { count: candidateRows.length }) }}</text>
      <scroll-view
        class="list-scroll"
        :style="{ height: listContentH(candidateRows.length) + 'rpx' }"
        scroll-y
        :show-scrollbar="false"
      >
        <view
          v-for="(item, index) in candidateRows"
          :key="item.userID"
          class="audience-row"
          :class="{ 'row-divider': index > 0 }"
        >
          <image class="audience-avatar" :src="item.avatarURL || defaultAvatarURL" mode="aspectFill" />
          <text class="audience-name" :numberOfLines="1">{{ item.userName || item.userID }}</text>
          <view
            class="row-btn"
            :class="{ 'danger': item.isInvitee, 'is-disabled': isPending(item) || (!item.isInvitee && isLayoutFull) }"
            @tap="handleCandidateAction(item)"
          >
            <text
              class="row-btn-text"
              :class="{ 'danger-text': item.isInvitee }"
            >{{ isPending(item) ? t('processing') : (item.isInvitee ? t('cancel_invitation') : t('invite')) }}</text>
          </view>
        </view>
      </scroll-view>
    </view>
  </BaseDrawer>
</template>

<script setup>
  import { ref, computed, watch, nextTick } from 'vue'
  import BaseDrawer from '@/uni_modules/tuikit-atomic-x/components/Common/BaseDrawer/index.nvue';
  import { useCoGuestState } from '@/uni_modules/tuikit-atomic-x/state/CoGuestState';
  import { useLiveSeatState } from '@/uni_modules/tuikit-atomic-x/state/LiveSeatState';
  import { useLiveListState } from '@/uni_modules/tuikit-atomic-x/state/LiveListState';
  import { t } from '../locales';
  import { showLiveToast } from '@/uni_modules/tuikit-atomic-x/components/Common/LiveToast/index.ts';

  const props = defineProps({
    modelValue: {
      type: Boolean,
      default: false
    },
    activeTab: {
      type: String,
      default: 'requests',
    },
  })

  const emit = defineEmits(['update:modelValue'])

  const showTip = (title) => showLiveToast(title);

  const innerVisible = computed({
    get: () => props.modelValue,
    set: (val) => emit('update:modelValue', val)
  })

  const { currentLive, updateLiveInfo } = useLiveListState();
  const liveID = computed(() => String(currentLive.value?.liveID || ''));
  const {
    connected,
    invitees,
    applicants,
    candidates,
    acceptApplication,
    inviteToSeat,
    cancelInvitation,
  } = useCoGuestState(liveID.value);
  const { kickUserOutOfSeat } = useLiveSeatState();

  const defaultAvatarURL = '/uni_modules/tuikit-atomic-x/static/assets/live/default-avatar.png';

  const HANDLE_H = 76;
  const HEADER_H = 40;
  const BOTTOM_BASE_H = 32;
  const CARD_GAP = 24;
  const SECTION_PAD_H = 64;
  const SECTION_TITLE_H = 54;
  const LAYOUT_GRID_H = 208;
  const ROW_H = 104;
  const EMPTY_H = 304;
  const MAX_ROWS = 3;

  const LAYOUTS = [
    { id: 601, key: 'layout_floating', guestCapacity: 6, icon: '/uni_modules/tuikit-atomic-x/static/assets/live/co-mic-layout-floating.png', iconActive: '/uni_modules/tuikit-atomic-x/static/assets/live/co-mic-layout-floating-active.png' },
    { id: 600, key: 'layout_grid2', guestCapacity: 8, icon: '/uni_modules/tuikit-atomic-x/static/assets/live/co-mic-layout-grid2.png', iconActive: '/uni_modules/tuikit-atomic-x/static/assets/live/co-mic-layout-grid2-active.png' },
    { id: 801, key: 'layout_fixed', guestCapacity: 6, icon: '/uni_modules/tuikit-atomic-x/static/assets/live/co-mic-layout-fixed.png', iconActive: '/uni_modules/tuikit-atomic-x/static/assets/live/co-mic-layout-fixed-active.png' },
    { id: 800, key: 'layout_grid9', guestCapacity: 8, icon: '/uni_modules/tuikit-atomic-x/static/assets/live/co-mic-layout-grid9.png', iconActive: '/uni_modules/tuikit-atomic-x/static/assets/live/co-mic-layout-grid9-active.png' },
  ];

  const selectedTemplateID = ref(600);
  const layoutUpdating = ref(false);
  const pendingUserIDs = ref(new Set());

  const layoutRows = computed(() => [LAYOUTS.slice(0, 2), LAYOUTS.slice(2, 4)]);

  const anchorUserID = computed(() => currentLive.value?.liveOwner?.userID || uni.$userID || '');
  const connectedGuests = computed(() =>
    (connected.value || []).filter(user => user?.userID !== anchorUserID.value)
  );
  const connectedCount = computed(() => connectedGuests.value.length);
  const guestCapacity = computed(() => {
    const layout = LAYOUTS.find(opt => opt.id === selectedTemplateID.value);
    return layout ? layout.guestCapacity : 8;
  });
  const isLayoutFull = computed(() => connectedCount.value >= guestCapacity.value);
  const applicantCount = computed(() => (applicants.value || []).length);

  const candidateRows = computed(() => {
    const invitedRows = (invitees.value || []).map(user => ({
      ...user,
      isInvitee: true,
    }));
    const candidateList = (candidates.value || []).map(user => ({
      ...user,
      isInvitee: false,
    }));
    return [...invitedRows, ...candidateList];
  });

  const isPending = (audience) => !!audience?.userID && pendingUserIDs.value.has(audience.userID);
  const endAllDisabled = computed(() =>
    connectedCount.value > 0 && connectedGuests.value.every(user => isPending(user))
  );

  const listContentH = (count) => (count > 0 ? Math.min(count, MAX_ROWS) * ROW_H : EMPTY_H);

  const drawerHeight = computed(() => {
    const layoutCardH = SECTION_PAD_H + SECTION_TITLE_H + LAYOUT_GRID_H;
    const connectedCardH = SECTION_PAD_H + SECTION_TITLE_H + listContentH(connectedCount.value);
    const applicantsCardH = applicantCount.value > 0
      ? SECTION_PAD_H + SECTION_TITLE_H + listContentH(applicantCount.value)
      : 0;
    const availableCardH = candidateRows.value.length > 0
      ? SECTION_PAD_H + SECTION_TITLE_H + listContentH(candidateRows.value.length)
      : 0;
    const cardCount = 2 + (applicantCount.value > 0 ? 1 : 0) + (candidateRows.value.length > 0 ? 1 : 0);
    return HANDLE_H + HEADER_H + BOTTOM_BASE_H
      + layoutCardH + connectedCardH + applicantsCardH + availableCardH
      + CARD_GAP * cardCount;
  });

  watch(() => props.modelValue, (val) => {
    if (val) {
      selectedTemplateID.value = Number(currentLive.value?.seatLayoutTemplateID) || 600;
    }
  });

  // UI 层限频:5s 内只允许切换一次布局,避免高频调用 updateLiveInfo 触发服务端反复重混流。【背景：麦上用户布局切换时拉其他麦上用户容易黑屏，老 engine 问题】
  const LAYOUT_SWITCH_COOLDOWN_MS = 5000;
  let lastLayoutSwitchAt = 0;

  const selectLayout = (templateID) => {
    if (templateID === selectedTemplateID.value || layoutUpdating.value) return;
    const now = Date.now();
    if (now - lastLayoutSwitchAt < LAYOUT_SWITCH_COOLDOWN_MS) {
      showTip(t('layout_switch_limit'));
      return;
    }
    const prev = selectedTemplateID.value;
    lastLayoutSwitchAt = now;
    layoutUpdating.value = true;
    selectedTemplateID.value = templateID;
    updateLiveInfo({
      liveInfo: {
        liveID: liveID.value,
        seatLayoutTemplateID: templateID,
      },
      modifyFlagList: ['SEAT_LAYOUT_TEMPLATE_ID', 'seatLayoutTemplateID'],
      success: () => {
        layoutUpdating.value = false;
        console.log('updateLiveInfo success.');
      },
      fail: (errCode, errMsg) => {
        layoutUpdating.value = false;
        selectedTemplateID.value = prev;
        // 切换失败不占用冷却,允许立即重试。
        lastLayoutSwitchAt = 0;
        console.error(`updateLiveInfo fail errCode: ${errCode}, errMsg: ${errMsg}`);
        showTip(t('layout_change_failed'));
      },
    });
  };

  const handleAccept = (audience) => {
    const userID = audience?.userID;
    if (!userID || pendingUserIDs.value.has(userID)) return;
    if (isLayoutFull.value) {
      showTip(t('capacity_full', { capacity: guestCapacity.value }));
      return;
    }
    pendingUserIDs.value.add(userID);
    acceptApplication({
      liveID: liveID.value,
      userID,
      success: () => {
        pendingUserIDs.value.delete(userID);
        console.log('acceptApplication success.');
      },
      fail: (errCode, errMsg) => {
        pendingUserIDs.value.delete(userID);
        console.error(`acceptApplication fail errCode: ${errCode}, errMsg: ${errMsg}`);
        showTip(t('handle_request_failed'));
      },
    });
  };

  const handleCandidateAction = (item) => {
    const userID = item?.userID;
    if (!userID || pendingUserIDs.value.has(userID)) return;
    if (item.isInvitee) {
      pendingUserIDs.value.add(userID);
      cancelInvitation({
        liveID: liveID.value,
        inviteeID: userID,
        success: () => {
          pendingUserIDs.value.delete(userID);
          console.log('cancelInvitation success.');
        },
        fail: (errCode, errMsg) => {
          pendingUserIDs.value.delete(userID);
          console.error(`cancelInvitation fail errCode: ${errCode}, errMsg: ${errMsg}`);
          showTip(t('handle_request_failed'));
        },
      });
      return;
    }
    if (isLayoutFull.value) {
      showTip(t('capacity_full', { capacity: guestCapacity.value }));
      return;
    }
    pendingUserIDs.value.add(userID);
    inviteToSeat({
      liveID: liveID.value,
      inviteeID: userID,
      seatIndex: -1,
      timeout: 30,
      success: () => {
        pendingUserIDs.value.delete(userID);
        console.log('inviteToSeat success.');
      },
      fail: (errCode, errMsg) => {
        pendingUserIDs.value.delete(userID);
        console.error(`inviteToSeat fail errCode: ${errCode}, errMsg: ${errMsg}`);
        showTip(t('handle_request_failed'));
      },
    });
  };

  const handleEndConnection = (audience) => {
    const userID = audience?.userID;
    if (!userID || pendingUserIDs.value.has(userID)) return;
    pendingUserIDs.value.add(userID);
    kickUserOutOfSeat({
      liveID: liveID.value,
      userID,
      success: () => {
        pendingUserIDs.value.delete(userID);
        console.log('kickUserOutOfSeat success.');
      },
      fail: (errCode, errMsg) => {
        pendingUserIDs.value.delete(userID);
        console.error(`kickUserOutOfSeat fail errCode: ${errCode}, errMsg: ${errMsg}`);
      },
    });
  };

  const handleEndAll = () => {
    if (endAllDisabled.value) return;
    connectedGuests.value.forEach(audience => handleEndConnection(audience));
  };
</script>

<style>
  @import './CoGuestPanel.scss';
</style>
