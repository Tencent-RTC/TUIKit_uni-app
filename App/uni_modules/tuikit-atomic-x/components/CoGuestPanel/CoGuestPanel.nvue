<template>
  <BaseDrawer
    v-model="innerVisible"
    :height="drawerHeight"
    :overlayOpacity="0.4"
    bgImage="/uni_modules/tuikit-atomic-x/static/assets/live/drawer-bg.png"
    :bgImageHeight="drawerHeight"
    padding="0 32rpx 32rpx 32rpx"
    :preload="false"
  >
    <view class="panel-header">
      <text class="panel-title">{{ t('manage_tab') }}</text>
    </view>

    <view class="card">
      <text class="section-title">{{ t('layout_title') }}</text>
      <view class="layout-grid">
        <view class="layout-row" v-for="(row, rowIndex) in layoutRows" :key="rowIndex">
          <view
            v-for="opt in row"
            :key="opt.id"
            class="layout-option"
            :class="{ 'is-active': selectedTemplateID === opt.id }"
            @tap="selectLayout(opt.id)"
          >
            <image class="layout-icon" :src="selectedTemplateID === opt.id ? opt.iconActive : opt.icon" mode="aspectFit" />
            <text class="layout-label" :class="{ 'is-active-label': selectedTemplateID === opt.id }">{{ t(opt.key) }}</text>
          </view>
        </view>
      </view>
    </view>

    <view class="card">
      <text class="section-title">{{ connectedCount > 0 ? t('connected_viewers_count', { count: connectedCount }) : t('connected_viewers') }}</text>
      <scroll-view
        v-if="connectedCount > 0"
        class="list-scroll"
        :style="{ height: listContentH(connectedCount) + 'rpx' }"
        scroll-y
        :show-scrollbar="false"
      >
        <view
          v-for="(audience, index) in connectedGuests"
          :key="audience?.userID"
          class="audience-row"
          :class="{ 'row-divider': index > 0 }"
        >
          <view class="audience-identity">
            <view class="audience-avatar-wrap">
              <image class="audience-avatar" :src="audience?.avatarURL || defaultAvatarURL" mode="aspectFill" />
            </view>
            <text class="audience-name" :numberOfLines="1">{{ audience?.userName || audience?.userID }}</text>
          </view>
          <view class="audience-actions">
            <view class="row-btn danger" @tap="handleEndConnection(audience)">
              <text class="row-btn-text danger-text">{{ t('end') }}</text>
            </view>
          </view>
        </view>
      </scroll-view>
      <view v-else class="list-empty">
        <text class="list-empty-text">{{ t('no_participants') }}</text>
      </view>
    </view>

    <view class="card" v-if="applicantCount > 0">
      <text class="section-title">{{ t('applicants_count', { count: applicantCount }) }}</text>
      <scroll-view
        class="list-scroll"
        :style="{ height: listContentH(applicantCount) + 'rpx' }"
        scroll-y
        :show-scrollbar="false"
      >
        <view
          v-for="(audience, index) in applicants || []"
          :key="audience?.userID"
          class="audience-row"
          :class="{ 'row-divider': index > 0 }"
        >
          <view class="audience-identity">
            <view class="audience-avatar-wrap">
              <image class="audience-avatar" :src="audience?.avatarURL || defaultAvatarURL" mode="aspectFill" />
            </view>
            <text class="audience-name" :numberOfLines="1">{{ audience?.userName || audience?.userID }}</text>
          </view>
          <view class="audience-actions">
            <view class="row-btn" @tap="handleRequest(audience, 'accept')">
              <text class="row-btn-text">{{ t('agree') }}</text>
            </view>
            <view class="row-btn danger" @tap="handleRequest(audience, 'reject')">
              <text class="row-btn-text danger-text">{{ t('reject') }}</text>
            </view>
          </view>
        </view>
      </scroll-view>
    </view>

    <view class="card" v-if="availableCount > 0">
      <text class="section-title">{{ t('available_count', { count: availableCount }) }}</text>
      <scroll-view
        class="list-scroll"
        :style="{ height: listContentH(availableCount) + 'rpx' }"
        scroll-y
        :show-scrollbar="false"
      >
        <view
          v-for="(audience, index) in availableList"
          :key="audience?.userID"
          class="audience-row"
          :class="{ 'row-divider': index > 0 }"
        >
          <view class="audience-identity">
            <view class="audience-avatar-wrap">
              <image class="audience-avatar" :src="audience?.avatarURL || defaultAvatarURL" mode="aspectFill" />
            </view>
            <text class="audience-name" :numberOfLines="1">{{ audience?.userName || audience?.userID }}</text>
          </view>
          <view class="audience-actions">
            <view
              class="row-btn"
              :class="{ 'is-disabled': isInvited(audience) }"
              @tap="handleInvite(audience)"
            >
              <text class="row-btn-text" :class="{ 'disabled-text': isInvited(audience) }">{{ isInvited(audience) ? t('invited') : t('invite') }}</text>
            </view>
          </view>
        </view>
      </scroll-view>
    </view>
  </BaseDrawer>
  <LiveToast
    v-if="tipVisible"
    :key="tipSeq"
    v-model="tipVisible"
    :title="tipTitle"
    :duration="2000"
  />
</template>

<script setup>
  import { ref, computed, watch } from 'vue'
  import BaseDrawer from '@/components/live/BaseDrawer/index.nvue';
  import { useCoGuestState } from '@/uni_modules/tuikit-atomic-x/state/CoGuestState';
  import { useLiveSeatState } from '@/uni_modules/tuikit-atomic-x/state/LiveSeatState';
  import { useLiveListState } from '@/uni_modules/tuikit-atomic-x/state/LiveListState';
  import { t } from '../locales';
  import LiveToast from '@/uni_modules/tuikit-atomic-x/components/LiveToast.nvue';

  const props = defineProps({
    modelValue: {
      type: Boolean,
      default: false
    },
    activeTab: {
      type: String,
      default: 'requests',
    },
  })

  const emit = defineEmits(['update:modelValue'])

  const tipVisible = ref(false);
  const tipSeq = ref(0);
  const tipTitle = ref('');
  const showTip = (title) => {
    tipTitle.value = title;
    tipSeq.value++;
    tipVisible.value = true;
  };

  const innerVisible = computed({
    get: () => props.modelValue,
    set: (val) => emit('update:modelValue', val)
  })

  const { currentLive, updateLiveInfo } = useLiveListState();
  const liveID = computed(() => String(currentLive.value?.liveID || ''));
  const {
    connected,
    invitees,
    applicants,
    candidates,
    acceptApplication,
    rejectApplication,
    inviteToSeat,
  } = useCoGuestState(liveID.value);
  const { kickUserOutOfSeat } = useLiveSeatState();

  const defaultAvatarURL = '/uni_modules/tuikit-atomic-x/static/assets/live/default-avatar.png';

  const HANDLE_H = 76;
  const HEADER_H = 72;
  const BOTTOM_BASE_H = 32;
  const CARD_GAP = 24;
  const SECTION_PAD_H = 64;
  const SECTION_TITLE_H = 54;
  const LAYOUT_GRID_H = 208;
  const ROW_H = 132;
  const EMPTY_H = 184;
  const MAX_ROWS = 3;

  const LAYOUTS = [
    { id: 601, key: 'layout_floating', icon: '/uni_modules/tuikit-atomic-x/static/assets/live/co-mic-layout-floating.png', iconActive: '/uni_modules/tuikit-atomic-x/static/assets/live/co-mic-layout-floating-active.png' },
    { id: 600, key: 'layout_grid2', icon: '/uni_modules/tuikit-atomic-x/static/assets/live/co-mic-layout-grid2.png', iconActive: '/uni_modules/tuikit-atomic-x/static/assets/live/co-mic-layout-grid2-active.png' },
    { id: 801, key: 'layout_fixed', icon: '/uni_modules/tuikit-atomic-x/static/assets/live/co-mic-layout-fixed.png', iconActive: '/uni_modules/tuikit-atomic-x/static/assets/live/co-mic-layout-fixed-active.png' },
    { id: 800, key: 'layout_grid9', icon: '/uni_modules/tuikit-atomic-x/static/assets/live/co-mic-layout-grid9.png', iconActive: '/uni_modules/tuikit-atomic-x/static/assets/live/co-mic-layout-grid9-active.png' },
  ];

  const selectedTemplateID = ref(600);
  const layoutUpdating = ref(false);

  const layoutRows = computed(() => [LAYOUTS.slice(0, 2), LAYOUTS.slice(2, 4)]);

  const anchorUserID = computed(() => currentLive.value?.liveOwner?.userID || uni.$userID || '');
  const connectedGuests = computed(() =>
    (connected.value || []).filter(user => user?.userID !== anchorUserID.value)
  );
  const connectedCount = computed(() => connectedGuests.value.length);
  const applicantCount = computed(() => (applicants.value || []).length);
  const availableList = computed(() => candidates.value || []);
  const availableCount = computed(() => availableList.value.length);

  const listContentH = (count) => (count > 0 ? Math.min(count, MAX_ROWS) * ROW_H : EMPTY_H);

  const drawerHeight = computed(() => {
    const layoutCardH = SECTION_PAD_H + SECTION_TITLE_H + LAYOUT_GRID_H;
    const connectedCardH = SECTION_PAD_H + SECTION_TITLE_H + listContentH(connectedCount.value);
    const applicantsCardH = applicantCount.value > 0
      ? SECTION_PAD_H + SECTION_TITLE_H + listContentH(applicantCount.value)
      : 0;
    const availableCardH = availableCount.value > 0
      ? SECTION_PAD_H + SECTION_TITLE_H + listContentH(availableCount.value)
      : 0;
    const cardCount = 2 + (applicantCount.value > 0 ? 1 : 0) + (availableCount.value > 0 ? 1 : 0);
    return HANDLE_H + HEADER_H + BOTTOM_BASE_H
      + layoutCardH + connectedCardH + applicantsCardH + availableCardH
      + CARD_GAP * cardCount;
  });

  watch(() => props.modelValue, (val) => {
    if (val) {
      selectedTemplateID.value = Number(currentLive.value?.seatLayoutTemplateID) || 600;
    }
  });

  const selectLayout = (templateID) => {
    if (templateID === selectedTemplateID.value || layoutUpdating.value) return;
    const prev = selectedTemplateID.value;
    layoutUpdating.value = true;
    selectedTemplateID.value = templateID;
    updateLiveInfo({
      liveInfo: {
        liveID: liveID.value,
        seatLayoutTemplateID: templateID,
      },
      modifyFlagList: ['SEAT_LAYOUT_TEMPLATE_ID', 'seatLayoutTemplateID'],
      success: () => {
        layoutUpdating.value = false;
        console.log('updateLiveInfo success.');
      },
      fail: (errCode, errMsg) => {
        layoutUpdating.value = false;
        selectedTemplateID.value = prev;
        console.error(`updateLiveInfo fail errCode: ${errCode}, errMsg: ${errMsg}`);
        showTip(t('layout_change_failed'));
      },
    });
  };

  const isInvited = (audience) => {
    if (!audience?.userID) return false;
    return (invitees.value || []).some(user => user?.userID === audience.userID);
  };

  const handleRequest = (audience, action) => {
    if (action === 'accept') {
      acceptApplication({
        liveID: liveID.value,
        userID: audience?.userID,
        success: () => {
          console.log('acceptApplication success.');
        },
        fail: (errCode, errMsg) => {
          console.error(`acceptApplication fail errCode: ${errCode}, errMsg: ${errMsg}`);
        },
      });
      return;
    }
    if (action === 'reject') {
      rejectApplication({
        liveID: liveID.value,
        userID: audience?.userID,
        success: () => {
          console.log('rejectApplication success.');
        },
        fail: (errCode, errMsg) => {
          console.error(`rejectCoGuestRequest fail errCode: ${errCode}, errMsg: ${errMsg}`);
        },
      });
      uni.$localGuestStatus = 'IDLE'
    }
  };

  const handleInvite = (audience) => {
    if (!audience?.userID || isInvited(audience)) return;
    inviteToSeat({
      liveID: liveID.value,
      inviteeID: audience.userID,
      seatIndex: -1,
      timeout: 30,
      success: () => {
        console.log('inviteToSeat success.');
      },
      fail: (errCode, errMsg) => {
        console.error(`inviteToSeat fail errCode: ${errCode}, errMsg: ${errMsg}`);
      },
    });
  };

  const handleEndConnection = (audience) => {
    if (!audience?.userID) return;
    kickUserOutOfSeat({
      liveID: liveID.value,
      userID: audience.userID,
      success: () => {
        console.log('kickUserOutOfSeat success.');
      },
      fail: (errCode, errMsg) => {
        console.error(`kickUserOutOfSeat fail errCode: ${errCode}, errMsg: ${errMsg}`);
      },
    });
  };
</script>

<style>
  .panel-header {
    width: 686rpx;
    height: 40rpx;
    margin-bottom: 32rpx;
    justify-content: center;
    align-items: center;
    flex-direction: row;
  }

  .panel-title {
    color: #ffffff;
    font-size: 30rpx;
    font-weight: 600;
  }

  .card {
    width: 686rpx;
    margin-bottom: 24rpx;
    padding: 32rpx;
    border-radius: 32rpx;
    background-color: rgba(0, 0, 0, 0.28);
    border-width: 1rpx;
    border-color: rgba(255, 255, 255, 0.05);
    flex-direction: column;
  }

  .section-title {
    color: rgba(255, 255, 255, 0.85);
    font-size: 24rpx;
    font-weight: 600;
    margin-bottom: 24rpx;
  }

  .layout-grid {
    width: 622rpx;
    flex-direction: column;
  }

  .layout-row {
    width: 622rpx;
    height: 96rpx;
    margin-bottom: 16rpx;
    flex-direction: row;
  }

  .layout-option {
    width: 303rpx;
    height: 96rpx;
    margin-right: 16rpx;
    border-radius: 24rpx;
    border-width: 1rpx;
    border-color: rgba(255, 255, 255, 0.14);
    background-color: rgba(0, 0, 0, 0.22);
    flex-direction: row;
    justify-content: center;
    align-items: center;
  }

  .layout-option.is-active {
    border-color: rgba(74, 158, 255, 0.8);
    background-color: rgba(74, 158, 255, 0.2);
  }

  .layout-icon {
    width: 40rpx;
    height: 40rpx;
    margin-right: 16rpx;
  }

  .layout-label {
    color: rgba(255, 255, 255, 0.72);
    font-size: 26rpx;
  }

  .layout-label.is-active-label {
    color: #8ecfff;
    font-weight: 600;
  }

  .list-scroll {
    width: 622rpx;
  }

  .audience-row {
    width: 622rpx;
    height: 132rpx;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
  }

  .row-divider {
    border-top-width: 1rpx;
    border-top-color: rgba(255, 255, 255, 0.07);
  }

  .audience-identity {
    flex: 1;
    flex-direction: row;
    align-items: center;
  }

  .audience-avatar-wrap {
    width: 68rpx;
    height: 68rpx;
    margin-right: 20rpx;
    border-radius: 34rpx;
    background-color: rgba(255, 255, 255, 0.06);
    border-width: 1rpx;
    border-color: rgba(74, 158, 255, 0.22);
    overflow: hidden;
    justify-content: center;
    align-items: center;
  }

  .audience-avatar {
    width: 68rpx;
    height: 68rpx;
    border-radius: 34rpx;
  }

  .audience-name {
    flex: 1;
    font-size: 26rpx;
    color: rgba(255, 255, 255, 0.88);
    lines: 1;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .audience-actions {
    flex-direction: row;
    align-items: center;
    margin-left: 16rpx;
  }

  .row-btn {
    width: 136rpx;
    height: 72rpx;
    margin-left: 16rpx;
    border-radius: 20rpx;
    background-color: rgba(74, 158, 255, 0.18);
    border-width: 1rpx;
    border-color: rgba(74, 158, 255, 0.42);
    flex-direction: row;
    justify-content: center;
    align-items: center;
  }

  .row-btn.danger {
    background-color: rgba(255, 79, 86, 0.1);
    border-color: rgba(255, 79, 86, 0.22);
  }

  .row-btn.is-disabled {
    background-color: rgba(255, 255, 255, 0.06);
    border-color: rgba(255, 255, 255, 0.06);
  }

  .row-btn-text {
    color: #ffffff;
    font-size: 24rpx;
  }

  .row-btn-text.danger-text {
    color: #ff7076;
  }

  .row-btn-text.disabled-text {
    color: rgba(255, 255, 255, 0.4);
  }

  .list-empty {
    width: 622rpx;
    min-height: 184rpx;
    justify-content: center;
    align-items: center;
  }

  .list-empty-text {
    color: rgba(255, 255, 255, 0.52);
    font-size: 28rpx;
  }
</style>
