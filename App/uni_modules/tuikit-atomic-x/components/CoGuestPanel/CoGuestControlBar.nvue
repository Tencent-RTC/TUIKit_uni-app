<template>
  <BaseDrawer
    v-model="innerVisible"
    :height="260"
    :showHandle="true"
    bgImage="/uni_modules/tuikit-atomic-x/static/assets/live/drawer-bg.png"
    :bgImageHeight="340"
    padding="0 40rpx 0 40rpx"
  >
    <view class="guest-control-actions">
      <view class="ctrl-btn" :class="{ 'is-active': selfMuted }" @tap="onToggleMute">
        <image
          class="ctrl-icon-img"
          :src="selfMuted ? MIC_OFF_ICON : MIC_ON_ICON"
          mode="aspectFit"
        />
      </view>
      <view v-if="isVideoGuest" class="ctrl-btn" :class="{ 'is-active': cameraOff }" @tap="onToggleCamera">
        <image
          class="ctrl-icon-img"
          :src="cameraOff ? CAMERA_OFF_ICON : CAMERA_ON_ICON"
          mode="aspectFit"
        />
      </view>
      <view v-if="isVideoGuest" class="ctrl-btn" @tap="onOpenDetail">
        <image class="ctrl-icon-img" :src="ADJUST_ICON" mode="aspectFit" />
      </view>
      <view class="ctrl-btn is-danger" :class="{ 'is-disabled': isBusy }" @tap="onEndCoMic">
        <image class="ctrl-icon-img" :src="DISCONNECT_ICON" mode="aspectFit" />
      </view>
    </view>
  </BaseDrawer>
</template>

<script setup lang="ts">
  import { ref, computed, watch } from 'vue';
  import BaseDrawer from '@/uni_modules/tuikit-atomic-x/components/Common/BaseDrawer/index.nvue';
  import { useLiveSeatState } from '@/uni_modules/tuikit-atomic-x/state/LiveSeatState';
  import { useDeviceState, DeviceStatus } from '@/uni_modules/tuikit-atomic-x/state/DeviceState';
  import { useCoGuestState } from '@/uni_modules/tuikit-atomic-x/state/CoGuestState';
  import permission from '@/uni_modules/tuikit-atomic-x/utils/permission';
  import { t } from '../locales';

  const props = defineProps({
    modelValue: {
      type: Boolean,
      default: false,
    },
    liveID: {
      type: String,
      default: '',
    },
    userID: {
      type: String,
      default: '',
    },
    freezeCamera: {
      type: Boolean,
      default: false,
    },
  });
  const emit = defineEmits(['update:modelValue', 'openDetail', 'end', 'tip']);

  const MIC_ON_ICON = '/uni_modules/tuikit-atomic-x/static/assets/live/co-mic-mic.png';
  const MIC_OFF_ICON = '/uni_modules/tuikit-atomic-x/static/assets/live/co-mic-mic-slash-dark.png';
  const CAMERA_ON_ICON = '/uni_modules/tuikit-atomic-x/static/assets/live/co-mic-camera.png';
  const CAMERA_OFF_ICON = '/uni_modules/tuikit-atomic-x/static/assets/live/co-mic-camera-slash-dark.png';
  const ADJUST_ICON = '/uni_modules/tuikit-atomic-x/static/assets/live/co-mic-adjust.png';
  const DISCONNECT_ICON = '/uni_modules/tuikit-atomic-x/static/assets/live/co-mic-hangup.png';

  const { seatList, muteMicrophone, unmuteMicrophone } = useLiveSeatState(props.liveID);
  const { openLocalCamera, closeLocalCamera, openLocalMicrophone, closeLocalMicrophone, isFrontCamera, localMirrorType, switchMirror, switchCamera } = useDeviceState();

  // 相机 / 麦克风各自独立确认权限;SDK 采集失败由 openXxx 的 fail 兜底。
  const ensurePermission = async (kind: 'camera' | 'microphone', deniedTip: string): Promise<boolean> => {
    const result = await permission.ensureMediaPermission(kind);
    if (result === 1) return true;
    if (result === -1) emit('tip', deniedTip);
    return false;
  };
  const { disconnect } = useCoGuestState(props.liveID);

  const innerVisible = computed({
    get: () => props.modelValue,
    set: (val) => emit('update:modelValue', val),
  });

  const selfSeat = computed(() => {
    const list: any[] = Array.isArray(seatList.value) ? seatList.value : [];
    for (let i = 0; i < list.length; i++) {
      if (list[i]?.userInfo?.userID === props.userID) return list[i];
    }
    return null;
  });

  const selfMuted = computed(() => selfSeat.value?.userInfo?.microphoneStatus === DeviceStatus.OFF);

  const cameraOff = computed(() => {
    if (props.freezeCamera) return false;
    return selfSeat.value?.userInfo?.cameraStatus === DeviceStatus.OFF;
  });


  const isVideoGuest = computed(() => (uni as any).$localCoGuestType !== 'mic');


  let lastFrontBeforeClose = true;
  let lastMirrorBeforeClose: any = null;
  const isBusy = ref(false);

  watch(innerVisible, (val) => {
    if (!val) isBusy.value = false;
  });

  const onToggleMute = async () => {
    if (selfMuted.value) {
      if (selfSeat.value?.userInfo?.allowOpenMicrophone === false) {
        emit('tip', t('micLocked'));
        return;
      }
      const micGranted = await ensurePermission('microphone', t('micPermissionDenied'));
      if (!micGranted) {
        return;
      }
      // 先确保设备麦克风采集已开,成功后再解除座位静音(对齐 iOS:座位静音为权威状态,
      // 避免"设备已采集但座位仍静音"这类显示与实际不一致)。
      openLocalMicrophone({
        liveID: props.liveID,
        success: () => {
          unmuteMicrophone({ liveID: props.liveID });
        },
        fail: () => {
          // 开不了设备采集就不要解除座位静音,保持"都关闭"的一致状态。
          closeLocalMicrophone();
          emit('tip', t('micPermissionDenied'));
        },
      });
    } else {
      muteMicrophone({ liveID: props.liveID });
    }
  };

  const onToggleCamera = async () => {
    // 对齐 iOS CoGuestingPanel:仅在前台才开摄像头;开启回调里二次校验,期间已进后台则立刻关掉。
    if (cameraOff.value) {
      const cameraGranted = await ensurePermission('camera', t('cameraPermissionDenied'));
      if (!cameraGranted) {
        return;
      }
      openLocalCamera({
        isFront: true,
        success: () => {
          if ((uni as any).$appIsActive === false) {
            closeLocalCamera();
            return;
          }
          if (lastFrontBeforeClose === false) {
            switchCamera({ isFront: false });
          }
          if (lastMirrorBeforeClose !== undefined && lastMirrorBeforeClose !== null) {
            switchMirror({ mirrorType: lastMirrorBeforeClose });
          }
        },
        fail: (errCode, errMsg) => {
          // iOS SDK 的 openLocalCamera 会强制申请麦克风权限,麦克风被拒时返回
          // -1105 requestMicrophonePermissions:[onDenied],视频也开不了 —— 此时应提示麦克风权限。
          const micDenied = Number(errCode) === -1105 || String(errMsg || '').includes('Microphone');
          emit('tip', micDenied ? t('micPermissionDenied') : t('cameraLocked'));
        },
      });
    } else {
      lastFrontBeforeClose = isFrontCamera.value !== false;
      lastMirrorBeforeClose = localMirrorType.value;
      closeLocalCamera();
    }
  };

  const onOpenDetail = () => {
    innerVisible.value = false;
    emit('openDetail');
  };

  const onEndCoMic = () => {
    if (isBusy.value) return;
    isBusy.value = true;
    disconnect({
      liveID: props.liveID,
      success: () => {
        isBusy.value = false;
        innerVisible.value = false;
        emit('end');
      },
      fail: () => {
        isBusy.value = false;
      },
    });
  };
</script>

<style scoped>
  .guest-control-actions {
    width: 670rpx;
    height: 144rpx;
    flex-direction: row;
    align-items: center;
    justify-content: space-around;
  }

  .ctrl-btn {
    width: 96rpx;
    height: 96rpx;
    border-radius: 48rpx;
    justify-content: center;
    align-items: center;
    background-color: rgba(255, 255, 255, 0.09);
  }

  .ctrl-btn.is-active {
    background-color: rgba(255, 255, 255, 0.96);
  }

  .ctrl-btn.is-danger {
    background-color: #ff5158;
  }

  .ctrl-btn.is-disabled {
    opacity: 0.46;
  }

  .ctrl-icon-img {
    width: 48rpx;
    height: 48rpx;
  }
</style>
