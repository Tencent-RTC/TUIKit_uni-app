<template>
  <view v-if="visible" class="confirm-dialog">
    <view class="confirm-dialog__mask" @click="handleMaskClick"></view>

    <view class="confirm-dialog__content">
      <view class="confirm-dialog__header">
        <text class="confirm-dialog__title">{{ title }}</text>
        <!-- 两种内容来源：message prop（字符串） 或 默认 slot（任意内容） -->
        <text v-if="message" class="confirm-dialog__message">{{ message }}</text>
        <view v-else class="confirm-dialog__slot"><slot></slot></view>
      </view>

      <view class="confirm-dialog__buttons" :class="{ 'confirm-dialog__buttons--single': !cancelText }">
        <view v-if="cancelText" class="confirm-dialog__button" @click="handleCancel">
          <text class="confirm-dialog__button-text confirm-dialog__button-text--cancel">{{ cancelText }}</text>
        </view>
        <view class="confirm-dialog__button" @click="handleConfirm">
          <text
            class="confirm-dialog__button-text"
            :class="{
              'confirm-dialog__button-text--confirm': !confirmButtonDanger,
              'confirm-dialog__button-text--confirm-danger': confirmButtonDanger,
            }"
          >{{ confirmText }}</text>
        </view>
      </view>
    </view>
  </view>
</template>

<script setup lang="ts">
import { ref, watch } from 'vue'

/**
 * ConfirmDialog —— 合并自 RoomDialog（支持 slot + confirmButtonDanger + modal）
 * 与原 ConfirmDialog 行为兼容：modelValue / title / message / cancelText / confirmText / closeOnClickMask
 * 扩展能力：
 *  - 默认 slot：message 留空时启用（用于 scroll-view / 富文本）
 *  - confirmButtonDanger：危险操作时确认按钮变红（false 蓝色，true 红色）
 */
interface ConfirmDialogProps {
  modelValue?: boolean
  title?: string
  /** 简单字符串文案。留空时用 slot 渲染（caller 提供任意内容） */
  message?: string
  cancelText?: string
  confirmText?: string
  /** 默认 false（蓝色）；true 时确认按钮变红，用于"结束共享"等危险操作 */
  confirmButtonDanger?: boolean
  /** 点遮罩是否关闭。默认 true（ConfirmDialog 行为）；Room 端用法：保持默认即可 */
  closeOnClickMask?: boolean
}

interface ConfirmDialogEmits {
  (e: 'update:modelValue', value: boolean): void
  (e: 'confirm'): void
  (e: 'cancel'): void
}

const props = withDefaults(defineProps<ConfirmDialogProps>(), {
  modelValue: false,
  title: '提示',
  message: '',
  cancelText: '取消',
  confirmText: '确定',
  confirmButtonDanger: false,
  closeOnClickMask: true,
})

const emit = defineEmits<ConfirmDialogEmits>()

const visible = ref(props.modelValue)

watch(() => props.modelValue, (newVal) => {
  visible.value = newVal
})

const close = () => {
  visible.value = false
  emit('update:modelValue', false)
}

const handleMaskClick = () => {
  if (props.closeOnClickMask) {
    close()
    emit('cancel')
  }
}

const handleCancel = () => {
  close()
  emit('cancel')
}

const handleConfirm = () => {
  close()
  emit('confirm')
}

defineExpose({
  open: () => {
    visible.value = true
    emit('update:modelValue', true)
  },
  close,
})
</script>

<style>
.confirm-dialog {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  justify-content: center;
  align-items: center;
}

.confirm-dialog__mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
}

.confirm-dialog__content {
  width: 654rpx;
  background-color: #FFFFFF;
  border-radius: 24rpx;
  align-items: center;
  overflow: hidden;
}

.confirm-dialog__header {
  padding: 40rpx 48rpx;
}

.confirm-dialog__title {
  font-size: 36rpx;
  font-weight: 600;
  color: rgba(0, 0, 0, 0.9);
  line-height: 52rpx;
  margin: 24rpx 0 16rpx;
  text-align: center;
}

.confirm-dialog__message {
  font-size: 32rpx;
  color: rgba(0, 0, 0, 0.9);
  line-height: 48rpx;
  text-align: center;
}

/* slot 容器：让 caller 完全控制内容（ScreenShareButton 用 scroll-view） */
.confirm-dialog__slot {
  flex-direction: column;
  align-items: center;
}

.confirm-dialog__buttons {
  flex: 1;
  width: 654rpx;
  flex-direction: row;
  border-top: 1rpx solid #E6E9F0;
}

/* 单按钮模式：确认按钮居中全宽（caller 传 cancelText=""） */
.confirm-dialog__buttons--single {
  justify-content: center;
}

.confirm-dialog__buttons--single .confirm-dialog__button {
  flex: 1;
  border-right: none;
}

.confirm-dialog__button {
  flex: 1;
  justify-content: center;
  align-items: center;
  padding: 32rpx;
  border-right: 1rpx solid #E6E9F0;
}

.confirm-dialog__button:last-child {
  border-right: none;
}

.confirm-dialog__button-text {
  font-size: 32rpx;
  line-height: 48rpx;
  font-weight: 500;
}

.confirm-dialog__button-text--cancel {
  color: rgba(0, 0, 0, 0.9);
}

.confirm-dialog__button-text--confirm {
  color: #1C66E5;
}

.confirm-dialog__button-text--confirm-danger {
  color: #E54545;
}
</style>
