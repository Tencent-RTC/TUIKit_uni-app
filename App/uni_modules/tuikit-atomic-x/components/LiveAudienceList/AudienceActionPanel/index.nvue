<template>
  <BaseDrawer
    v-model="innerVisible"
    :height="382"
    :overlayOpacity="0.4"
    bgImage="/uni_modules/tuikit-atomic-x/static/assets/live/drawer-bg.png"
    :bgImageHeight="460"
    padding="0 32rpx 0 32rpx"
    :showHandle="true"
    :useSafeBottom="true"
  >
    <text class="host-viewer-manage-title">{{ userName }}</text>
    <view class="host-viewer-manage-row">
      <view class="host-viewer-manage-item" :style="itemStateStyle('follow')" @tap="toggleFollow">
        <view class="host-viewer-manage-icon">
          <image
            class="host-viewer-manage-icon-image"
            :src="isFollowed ? followedIcon : followIcon"
            mode="aspectFit"
          />
        </view>
        <text class="host-viewer-manage-item-title">{{ isFollowed ? t('al.followed') : t('al.follow') }}</text>
      </view>
      <view class="host-viewer-manage-item" :style="itemStateStyle('mute')" @tap="toggleMute">
        <view class="host-viewer-manage-icon">
          <image class="host-viewer-manage-icon-image" :src="muteIcon" mode="aspectFit" />
        </view>
        <text class="host-viewer-manage-item-title">{{ isMuted ? t('al.unmute') : t('al.mute') }}</text>
      </view>
      <view class="host-viewer-manage-item" :style="itemStateStyle('remove')" @tap="kickOut">
        <view class="host-viewer-manage-icon">
          <image
            class="host-viewer-manage-icon-image is-remove"
            :src="removeIcon"
            mode="aspectFit"
          />
        </view>
        <text class="host-viewer-manage-item-title">{{ t('al.block') }}</text>
      </view>
    </view>
  </BaseDrawer>
</template>

<script setup>
  import { ref, computed, watch, onMounted, onUnmounted } from 'vue';
  import BaseDrawer from '@/uni_modules/tuikit-atomic-x/components/Common/BaseDrawer/index.nvue';
  import { useLiveAudienceState } from '@/uni_modules/tuikit-atomic-x/state/LiveAudienceState';
  import { safeJsonParse } from '@/uni_modules/tuikit-atomic-x/utils/utsUtils';
  import { isUserFollowed, toggleUserFollowed } from '@/uni_modules/tuikit-atomic-x/utils/followStore';
  import { t } from '../../locales';

  const props = defineProps({
    modelValue: { type: Boolean, default: false },
    userInfo: { type: Object },
    liveID: { type: String },
  });
  const emit = defineEmits(['update:modelValue', 'tip']);

  const { audienceList, kickUserOutOfRoom, disableSendMessage, messageBannedUserList, addAudienceListener, removeAudienceListener } = useLiveAudienceState(props.liveID);

  const followIcon = '/uni_modules/tuikit-atomic-x/static/assets/live/pusher-audience-follow.png';
  const followedIcon = '/uni_modules/tuikit-atomic-x/static/assets/live/pusher-audience-followed.png';
  const muteIcon = '/uni_modules/tuikit-atomic-x/static/assets/live/pusher-audience-mute.png';
  const removeIcon = '/uni_modules/tuikit-atomic-x/static/assets/live/pusher-audience-remove.png';

  const isFollowed = ref(false);
  const pendingMute = ref(null);
  const pendingAction = ref(null);
  let sawNonEmptyAudienceList = false;

  const innerVisible = computed({
    get: () => props.modelValue,
    set: (val) => emit('update:modelValue', val),
  });
  const isBusy = computed(() => pendingAction.value !== null);

  const userName = computed(() => props.userInfo?.userName || props.userInfo?.userID || '');
  const mutedByList = computed(() =>
    (messageBannedUserList.value || []).some((u) => u?.userID === props.userInfo?.userID)
  );
  const isMuted = computed(() => (pendingMute.value === null ? mutedByList.value : pendingMute.value));

  const itemStateStyle = (key) => {
    if (key === 'follow') return isBusy.value ? { opacity: 0.46 } : {};
    return pendingAction.value === key ? { opacity: 0.46 } : {};
  };

  const resetPending = () => {
    pendingMute.value = null;
    pendingAction.value = null;
  };

  watch(() => props.userInfo?.userID, () => {
    resetPending();
  });
  watch(() => props.modelValue, (val) => {
    if (val) {
      isFollowed.value = isUserFollowed(props.userInfo?.userID);
      resetPending();
    } else {
      sawNonEmptyAudienceList = false;
    }
  });
  watch(mutedByList, () => { resetPending(); });

  watch([() => props.modelValue, audienceList], () => {
    if (!props.modelValue) return;
    const uid = props.userInfo?.userID;
    if (!uid) return;
    const list = audienceList.value || [];
    if (list.length > 0) {
      sawNonEmptyAudienceList = true;
      if (!list.some((u) => u?.userID === uid)) innerVisible.value = false;
      return;
    }
    if (sawNonEmptyAudienceList) innerVisible.value = false;
  });

  const parseAudienceEventUserID = (eventData) => {
    const parsed = safeJsonParse(eventData, null);
    let user = parsed?.audience ?? parsed?.userInfo ?? parsed;
    if (typeof user === 'string') {
      user = safeJsonParse(user, null);
    }
    return user?.userID || user?.userId || '';
  };

  const onAudienceLeft = (eventData) => {
    const uid = props.userInfo?.userID;
    if (!uid || !props.modelValue) return;
    if (parseAudienceEventUserID(eventData) === uid) {
      innerVisible.value = false;
    }
  };

  onMounted(() => {
    addAudienceListener(props.liveID, 'onAudienceLeft', onAudienceLeft);
  });

  onUnmounted(() => {
    removeAudienceListener(props.liveID, 'onAudienceLeft', onAudienceLeft);
  });

  const toggleFollow = () => {
    const uid = props.userInfo?.userID;
    if (!uid || isBusy.value) return;
    isFollowed.value = toggleUserFollowed(uid);
  };

  const toggleMute = () => {
    const uid = props.userInfo?.userID;
    if (!uid || isBusy.value) return;
    const next = !isMuted.value;
    pendingMute.value = next;
    pendingAction.value = 'mute';
    disableSendMessage({
      liveID: props.liveID,
      userID: uid,
      isDisable: next,
      success: () => {
        emit('tip', t(next ? 'al.mutedToast' : 'al.unmutedToast', { name: userName.value }));
        innerVisible.value = false;
      },
      fail: (errCode, errMsg) => {
        resetPending();
        console.log(`disableSendMessage fail errCode: ${errCode}, errMsg: ${errMsg}`);
      },
    });
  };

  const kickOut = () => {
    const uid = props.userInfo?.userID;
    if (!uid || isBusy.value) return;
    const name = userName.value;
    pendingAction.value = 'remove';
    kickUserOutOfRoom({
      liveID: props.liveID,
      userID: uid,
      success: () => {
        innerVisible.value = false;
        emit('tip', t('al.kickedOut', { name: name }));
      },
      fail: (errCode, errMsg) => {
        resetPending();
        console.error(`kickUserOutOfRoom fail errCode: ${errCode}, errMsg: ${errMsg}`);
      },
    });
  };
</script>

<style lang="scss">
  @import './AudienceActionPanel.scss';
</style>
