<template>
  <BaseDrawer
    v-model="innerVisible"
    :height="drawerHeight"
    :overlayOpacity="0.4"
    bgImage="/uni_modules/tuikit-atomic-x/static/assets/live/drawer-bg.png"
    :bgImageHeight="drawerHeight"
    padding="0 32rpx 0 32rpx"
    :showHandle="true"
  >
    <view class="audience-header">
      <text class="audience-title">{{ t('al.title') }}</text>
    </view>
    <list class="audience-content" :style="{ height: scrollHeightRpx + 'rpx' }" :show-scrollbar="false">
      <cell v-for="(audience, index) in audienceList" :key="audience.userID">
        <view class="audience-row-wrap">
          <view class="audience-item" @tap="onTapAudience(audience)">
            <text class="audience-marker" :style="{ width: markerWidthRpx + 'rpx' }">{{ index + 1 }}</text>
            <view class="audience-avatar-container">
              <image
                class="audience-avatar"
                :src="avatarOf(audience)"
                mode="aspectFill"
                @error="onAvatarError(audience)"
              />
            </view>
            <view class="audience-identity">
              <text class="audience-name" :numberOfLines="1">{{ audience.userName || audience.userID }}</text>
              <view class="aud-level-badge">
                <image class="aud-level-bg" :src="audLevelBadge(audience)" mode="scaleToFill" />
                <text class="aud-level-num">{{ audLevel(audience) }}</text>
              </view>
            </view>
            <text class="audience-gift-value">{{ audGiftValue(audience) }}</text>
          </view>
          <view class="audience-divider" v-if="index !== audienceList.length - 1"></view>
        </view>
      </cell>
      <cell v-if="audienceList.length === 0">
        <view class="empty-state">
          <text class="empty-text">{{ t('al.empty') }}</text>
        </view>
      </cell>
      <cell v-if="isLoading">
        <view class="loading-state">
          <image src="/static/icon/loading.png" mode="aspectFit" class="loading-image" />
        </view>
      </cell>
    </list>
  </BaseDrawer>

  <AudienceActionPanel v-model="isShowAudienceActionPanel" :userInfo="selectedAudience" :liveID="liveID" @tip="showTip">
  </AudienceActionPanel>
  <AudienceProfilePanel v-model="isShowAudienceProfilePanel" :userInfo="selectedAudience" :liveID="liveID">
  </AudienceProfilePanel>
</template>

<script setup>
  import { ref, computed, watch, onMounted, nextTick } from 'vue';
  import BaseDrawer from '@/uni_modules/tuikit-atomic-x/components/Common/BaseDrawer/index.nvue';
  import AudienceActionPanel from '@/uni_modules/tuikit-atomic-x/components/LiveAudienceList/AudienceActionPanel/index.nvue';
  import AudienceProfilePanel from '@/uni_modules/tuikit-atomic-x/components/LiveAudienceList/AudienceProfilePanel/index.nvue';
  import { showLiveToast } from '@/uni_modules/tuikit-atomic-x/components/Common/LiveToast/index.ts';
  import { getScreenSizeAsync, heightPercentToRpx } from '../../../utils/screen';
  import { t } from '../../locales';
  import { useLiveListState } from '@/uni_modules/tuikit-atomic-x/state/LiveListState';
  import { useLoginState } from '@/uni_modules/tuikit-atomic-x/state/LoginState';
  import { useLiveAudienceState } from '@/uni_modules/tuikit-atomic-x/state/LiveAudienceState';

  const props = defineProps({
    modelValue: { type: Boolean, default: false },
    liveID: { type: String },
  });
  const emit = defineEmits(['update:modelValue', 'overlayActiveChange']);

  const { currentLive } = useLiveListState();
  const liveID = computed(() => props.liveID || String(currentLive.value?.liveID || ''));
  const { loginUserInfo } = useLoginState();
  const { audienceList, fetchAudienceList: refreshAudienceList } = useLiveAudienceState(liveID.value);

  const defaultAvatarURL = '/uni_modules/tuikit-atomic-x/static/assets/live/default-avatar.png';
  const ROW_H = 169;
  const DRAWER_HANDLE_H = 76;
  const DRAWER_HEADER_H = 80;
  const DRAWER_BOTTOM_PAD = 44;

  const failedAvatarIDs = ref({});
  const isLoading = ref(false);
  const isShowAudienceActionPanel = ref(false);
  const isShowAudienceProfilePanel = ref(false);
  const selectedAudience = ref(null);
  const targetDrawerRpx = ref(heightPercentToRpx(0.6));

  const isAnchor = computed(() => {
    return loginUserInfo.value?.userID === currentLive.value?.liveOwner?.userID;
  });

  const innerVisible = computed({
    get: () => props.modelValue,
    set: (val) => emit('update:modelValue', val)
  });


  const markerWidthRpx = computed(() => {
    const digits = String(Math.max(1, audienceList.value.length)).length;
    return Math.max(48, digits * 18);
  });

  const scrollHeightRpx = computed(() => {
    const avail = targetDrawerRpx.value - DRAWER_HANDLE_H - DRAWER_HEADER_H - DRAWER_BOTTOM_PAD;
    const rows = Math.max(1, Math.floor(avail / ROW_H));
    return rows * ROW_H;
  });
  const drawerHeight = computed(() =>
    DRAWER_HANDLE_H + DRAWER_HEADER_H + scrollHeightRpx.value + DRAWER_BOTTOM_PAD
  );

  const anyInnerPanelVisible = computed(() =>
    isShowAudienceActionPanel.value || isShowAudienceProfilePanel.value
  );
  watch(anyInnerPanelVisible, (val) => {
    emit('overlayActiveChange', !!val);
  });

  watch(innerVisible, (val) => {
    if (!val || !liveID.value) return;
    refreshAudienceList({ liveID: liveID.value });
  });

  const avatarOf = (audience) => {
    if (audience?.userID && failedAvatarIDs.value[audience.userID]) return defaultAvatarURL;
    return audience?.avatarURL || defaultAvatarURL;
  };
  const onAvatarError = (audience) => {
    const id = audience?.userID;
    if (!id || failedAvatarIDs.value[id]) return;
    failedAvatarIDs.value = { ...failedAvatarIDs.value, [id]: true };
  };

  const levelTier = (level) => {
    if (level >= 40) return 'elite';
    if (level >= 25) return 'premium';
    if (level >= 10) return 'advanced';
    return 'basic';
  };
  const audLevel = (audience) => {
    const lv = Number(audience?.level);
    if (!isNaN(lv) && lv > 0) return lv;
    if (audience?.userID && audience.userID === uni.$userID) {
      const myLv = Number(loginUserInfo.value?.level);
      if (!isNaN(myLv) && myLv > 0) return myLv;
    }
    return 0;
  };
  const audLevelBadge = (audience) => '/uni_modules/tuikit-atomic-x/static/assets/live/level-badge-' + levelTier(audLevel(audience)) + '.png';
  const audGiftValue = (audience) => {
    const v = Number(audience?.giftValue);
    return Number.isFinite(v) && v > 0 ? v : 0;
  };

  // 模板 @tip="showTip" 的处理器(AudienceActionPanel 踢人/管理员等操作提示),勿删。
  const showTip = (title) => showLiveToast(title);

  const onTapAudience = (audience) => {
    if (audience?.userID && audience.userID === uni.$userID) {
      return;
    }
    selectedAudience.value = audience;
    innerVisible.value = false;
    if (isAnchor.value) {
      isShowAudienceActionPanel.value = true;
    } else {
      isShowAudienceProfilePanel.value = true;
    }
  };

  onMounted(() => {
    getScreenSizeAsync().then(() => {
      targetDrawerRpx.value = heightPercentToRpx(0.6);
    });
  });


</script>

<style lang="scss">
  @import './LiveAudienceList.scss';
</style>
