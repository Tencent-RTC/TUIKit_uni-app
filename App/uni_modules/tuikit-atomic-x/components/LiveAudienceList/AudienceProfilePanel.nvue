<template>
  <!-- 观众资料/关注面板：使用统一的 BaseDrawer（背景与其他 drawer 一致），
       内容为头像 + 名字 + 关注/已关注按钮。 -->
  <BaseDrawer
    v-model="innerVisible"
    :height="drawerHeight"
    :overlayOpacity="0.4"
    bgImage="/uni_modules/tuikit-atomic-x/static/assets/live/drawer-bg.png"
    :bgImageHeight="drawerHeight"
    padding="0 40rpx 60rpx 40rpx"
    :showHandle="true"
  >
    <view class="profile-body">
      <!-- 头像 -->
      <view class="profile-avatar-wrap">
        <image class="profile-avatar" :src="userInfo?.avatarURL || defaultAvatarURL" mode="aspectFill" />
      </view>
      <!-- 名字 -->
      <text class="profile-name" :numberOfLines="1">{{ userInfo?.userName || userInfo?.userID || '' }}</text>
      <!-- 关注按钮：关注/已关注切换 -->
      <view class="profile-follow" :class="{ 'is-following': isFollowing }" @tap="toggleFollow">
        <text class="profile-follow-text" :class="{ 'is-following-text': isFollowing }">{{ isFollowing ? '已关注' : '关注' }}</text>
      </view>
    </view>
  </BaseDrawer>

</template>

<script setup>
  import { ref, computed, watch } from 'vue';
  import BaseDrawer from '@/components/live/BaseDrawer.nvue';
  import { isUserFollowed, toggleUserFollowed } from '@/uni_modules/tuikit-atomic-x/utils/followStore';

  const defaultAvatarURL = 'https://web.sdk.qcloud.com/component/TUIKit/assets/avatar_01.png';

  const props = defineProps({
    modelValue: { type: Boolean, default: false },
    userInfo: { type: Object },
    liveID: { type: String },
  });
  const emit = defineEmits(['update:modelValue']);

  // drawer 高度：内容仅头像+名字+关注按钮，用贴合内容的固定高度（避免底部大片留白）。
  const drawerHeight = ref(460);

  const innerVisible = computed({
    get: () => props.modelValue,
    set: (val) => emit('update:modelValue', val),
  });

  // 关注态:读写应用级关注缓存(followStore,模块级 Map)——重复打开面板/退房再进
  // 状态不丢,与直播间主播关注按钮共享同一份缓存(key 均为 userID)。
  // 真实关注 API 接入后仅替换 store 内部实现,此处调用不变。
  const isFollowing = ref(false);

  // 每次打开面板时按当前用户从缓存恢复关注态(不再重置 false)。
  watch(() => props.modelValue, (val) => {
    if (val) {
      isFollowing.value = isUserFollowed(props.userInfo?.userID);
    }
  });

  const toggleFollow = () => {
    const uid = props.userInfo?.userID;
    if (!uid) return;
    // 关注成功后不弹 toast(产品要求,按钮态即反馈)。
    isFollowing.value = toggleUserFollowed(uid);
  };
</script>

<style>
  .profile-body {
    flex-direction: column;
    align-items: center;
    padding-top: 20rpx;
  }

  .profile-avatar-wrap {
    width: 128rpx;
    height: 128rpx;
    border-radius: 64rpx;
    overflow: hidden;
    margin-bottom: 24rpx;
  }

  .profile-avatar {
    width: 128rpx;
    height: 128rpx;
    border-radius: 64rpx;
  }

  .profile-name {
    color: #ffffff;
    font-size: 34rpx;
    font-weight: 600;
    lines: 1;
    overflow: hidden;
    text-overflow: ellipsis;
    margin-bottom: 48rpx;
    max-width: 560rpx;
    text-align: center;
  }

  /* 关注按钮（未关注高亮，已关注置灰） */
  .profile-follow {
    width: 560rpx;
    height: 88rpx;
    border-radius: 44rpx;
    background-color: #396cff;
    justify-content: center;
    align-items: center;
  }

  .profile-follow.is-following {
    background-color: rgba(255, 255, 255, 0.12);
  }

  .profile-follow-text {
    color: #ffffff;
    font-size: 30rpx;
    font-weight: 600;
  }

  .profile-follow-text.is-following-text {
    color: rgba(255, 255, 255, 0.7);
  }
</style>
