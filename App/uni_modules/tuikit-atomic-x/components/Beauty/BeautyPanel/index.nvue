<template>
  <BaseDrawer
    v-model="innerVisible"
    :height="440"
    :overlayOpacity="0.4"
    bgImage="/uni_modules/tuikit-atomic-x/static/assets/live/drawer-bg.png"
    :bgImageHeight="440"
    padding="0 40rpx 0 40rpx"
    :showHandle="true"
    :zIndex="zIndex"
  >
    <text class="beauty-title">{{ t('beauty_title') }}</text>
    <view class="beauty-slider-row">
      <text class="beauty-slider-label">{{ activeLabel }}</text>
      <Slider
        class="beauty-slider"
        :modelValue="activeLevel"
        :min="0"
        :max="9"
        :trackWidth="526"
        :disabled="!beautyOn"
        :style="{ opacity: beautyOn ? 1 : 0.4 }"
        @input="onLevelInput"
        @change="onLevelChange"
      />
      <text class="beauty-slider-value">{{ activeLevel }}</text>
    </view>
    <view class="beauty-option-row">
      <view class="beauty-option">
        <view class="beauty-option-slot">
          <SwitchButton class="beauty-option-switch" :modelValue="beautyOn" @change="setEnabled" />
        </view>
        <text class="beauty-option-label">{{ t('beauty_title') }}</text>
      </view>
      <view
        v-for="tab in tabs"
        :key="tab.key"
        class="beauty-option"
        @tap="activeKey = tab.key"
      >
        <view class="beauty-option-slot">
          <view class="beauty-option-icon" :class="{ 'is-selected': activeKey === tab.key }">
            <image class="beauty-option-img" :src="tab.icon" mode="aspectFit" />
          </view>
        </view>
        <text class="beauty-option-label" :class="{ 'is-selected': activeKey === tab.key }">{{ tab.label }}</text>
      </view>
    </view>
  </BaseDrawer>
</template>

<script setup lang="ts">
  import { ref, computed, watch, onMounted } from 'vue';
  import Slider from '@/uni_modules/tuikit-atomic-x/components/Common/Slider/index.nvue';
  import SwitchButton from '@/uni_modules/tuikit-atomic-x/components/Common/SwitchButton/index.nvue';
  import BaseDrawer from '@/uni_modules/tuikit-atomic-x/components/Common/BaseDrawer/index.nvue';
  import { t } from '../../locales';
  import { useBaseBeautyState } from '@/uni_modules/tuikit-atomic-x/state/BaseBeautyState';
  import { useLoginState } from '@/uni_modules/tuikit-atomic-x/state/LoginState';

  type BeautyKey = 'smooth' | 'whiteness' | 'ruddy';

  type BeautyPrefs = {
    isEnabled: boolean;
    smoothLevel: number;
    whitenessLevel: number;
    ruddyLevel: number;
  };

  const props = defineProps({
    modelValue: {
      type: Boolean,
      default: false
    },
    // 宿主层级更高时（如连麦"调整视频连麦画面"层 z-index 3000）需上调，否则抽屉被压在下面。
    zIndex: {
      type: Number,
      default: 2600
    }
  });

  const emit = defineEmits(['update:modelValue']);

  const innerVisible = computed({
    get: () => props.modelValue,
    set: (v) => emit('update:modelValue', v)
  });

  const {
    smoothLevel,
    whitenessLevel,
    ruddyLevel,
    setSmoothLevel,
    setWhitenessLevel,
    setRuddyLevel,
  } = useBaseBeautyState();
  const { loginUserInfo } = useLoginState();

  const tabs: Array<{ key: BeautyKey; label: string; icon: string }> = [
    { key: 'smooth', label: t('smoothing'), icon: '/uni_modules/tuikit-atomic-x/static/assets/live/beauty-smooth.png' },
    { key: 'whiteness', label: t('whitening'), icon: '/uni_modules/tuikit-atomic-x/static/assets/live/beauty-whiten.png' },
    { key: 'ruddy', label: t('rosy'), icon: '/uni_modules/tuikit-atomic-x/static/assets/live/beauty-rosy.png' },
  ];

  const activeKey = ref<BeautyKey>('smooth');
  const activeLabel = computed(() => tabs.find(tab => tab.key === activeKey.value)?.label || '');

  const clampLevel = (v: any): number => {
    const n = Math.round(Number(v) || 0);
    if (!Number.isFinite(n)) return 0;
    return Math.min(9, Math.max(0, n));
  };

  const defaultPrefs = (): BeautyPrefs => ({
    isEnabled: true,
    smoothLevel: 0,
    whitenessLevel: 0,
    ruddyLevel: 0,
  });

  const prefs = ref<BeautyPrefs>(defaultPrefs());
  let prefsKey = '';

  const beautyOn = computed(() => prefs.value.isEnabled);

  const loadPrefs = () => {
    const uid = loginUserInfo.value?.userID || '';
    prefsKey = uid ? `TUILiveKit.beauty.v1.${uid}` : '';
    let loaded: BeautyPrefs | null = null;
    try {
      const raw = prefsKey ? uni.getStorageSync(prefsKey) : '';
      if (raw) {
        const parsed = typeof raw === 'string' ? JSON.parse(raw) : raw;
        if (parsed && typeof parsed === 'object') {
          loaded = {
            isEnabled: !!parsed.isEnabled,
            smoothLevel: clampLevel(parsed.smoothLevel),
            whitenessLevel: clampLevel(parsed.whitenessLevel),
            ruddyLevel: clampLevel(parsed.ruddyLevel),
          };
        }
      }
    } catch (e) {
      loaded = null;
    }
    prefs.value = loaded || defaultPrefs();
  };

  const savePrefs = () => {
    if (!prefsKey) return;
    try {
      uni.setStorageSync(prefsKey, JSON.stringify(prefs.value));
    } catch (e) {}
  };

  const applyPrefs = () => {
    const p = prefs.value;
    smoothLevel.value = p.isEnabled ? p.smoothLevel : 0;
    whitenessLevel.value = p.isEnabled ? p.whitenessLevel : 0;
    ruddyLevel.value = p.isEnabled ? p.ruddyLevel : 0;
    setSmoothLevel({ smoothLevel: smoothLevel.value });
    setWhitenessLevel({ whitenessLevel: whitenessLevel.value });
    setRuddyLevel({ ruddyLevel: ruddyLevel.value });
  };

  const activeLevel = computed(() => {
    const p = prefs.value;
    if (activeKey.value === 'whiteness') return p.whitenessLevel;
    if (activeKey.value === 'ruddy') return p.ruddyLevel;
    return p.smoothLevel;
  });

  const setEnabled = (enabled: boolean) => {
    if (prefs.value.isEnabled === enabled) return;
    prefs.value.isEnabled = enabled;
    savePrefs();
    applyPrefs();
  };

  const setBeautyLevel = (value: number) => {
    if (!prefs.value.isEnabled) return;
    const v = clampLevel(value);
    const key = activeKey.value;
    if (key === 'whiteness') {
      prefs.value.whitenessLevel = v;
      whitenessLevel.value = v;
      setWhitenessLevel({ whitenessLevel: v });
    } else if (key === 'ruddy') {
      prefs.value.ruddyLevel = v;
      ruddyLevel.value = v;
      setRuddyLevel({ ruddyLevel: v });
    } else {
      prefs.value.smoothLevel = v;
      smoothLevel.value = v;
      setSmoothLevel({ smoothLevel: v });
    }
    savePrefs();
  };

  const onLevelInput = (v: number) => {
    setBeautyLevel(v);
  };
  const onLevelChange = (v: number) => {
    setBeautyLevel(v);
  };

  onMounted(() => {
    loadPrefs();
    applyPrefs();
  });

  watch(innerVisible, (v) => {
    if (!v) return;
    loadPrefs();
    applyPrefs();
    activeKey.value = 'smooth';
  });
</script>

<style lang="scss">
  @import './BeautyPanel.scss';
</style>
