<template>
  <view class="page" :style="{ minHeight: safeArea.height + 'px' }">
    <view
      class="header"
      :style="{
        paddingTop: statusBarHeight + 'px',
        height: (statusBarHeight + HEADER_CONTENT_HEIGHT_PX) + 'px',
      }"
    >
      <view class="back-btn" @tap="handleBack">
        <image class="back-icon" src="/static/images/back-black.png" mode="aspectFit" />
      </view>
      <text class="header-title">{{ t('quickstart.title') }}</text>
    </view>

    <view class="header-gap"></view>

    <view class="card">
      <view class="form-item">
        <text class="form-label">{{ t('join.yourName') }}</text>
        <text class="form-value" :numberOfLines="1">
          {{ loginUserInfo?.nickname || loginUserInfo?.userID || '' }}
        </text>
      </view>
    </view>

    <view class="card-gap"></view>

    <view class="card">
      <view class="switch-item">
        <text class="form-label">{{ t('join.enableMic') }}</text>
        <ToggleSwitch :checked="isAudioEnabled" :activeColor="ROOM_TOKENS.colorBrand" @change="onAudioChange" />
      </view>
      <view class="form-divider"></view>
      <view class="switch-item">
        <text class="form-label">{{ t('join.enableSpeaker') }}</text>
        <ToggleSwitch :checked="isSpeakerEnabled" :activeColor="ROOM_TOKENS.colorBrand" @change="onSpeakerChange" />
      </view>
      <view class="form-divider"></view>
      <view class="switch-item">
        <text class="form-label">{{ t('join.enableCamera') }}</text>
        <ToggleSwitch :checked="isVideoEnabled" :activeColor="ROOM_TOKENS.colorBrand" @change="onVideoChange" />
      </view>
    </view>

    <view class="footer">
      <view class="submit-btn" @tap="handleCreateRoom">
        <text class="submit-btn-text">{{ t('quickstart.submit') }}</text>
      </view>
    </view>
  </view>
</template>

<script setup>
  import { ref, onMounted } from 'vue';
  import { useLoginState } from '@/uni_modules/tuikit-atomic-x/state';
  import { ToggleSwitch } from '@/uni_modules/tuikit-atomic-x/components_compatible';
  import { generateRoomID } from '@/uni_modules/tuikit-atomic-x/utils/roomScheduleUtils';
  import { ROOM_TOKENS } from '../styles/tokens.js';
  import { t } from '../locales';

  const { loginUserInfo } = useLoginState();

  const HEADER_CONTENT_HEIGHT_PX = 60;
  const FALLBACK_SAFE_AREA_WIDTH_PX = 375;
  const FALLBACK_SAFE_AREA_HEIGHT_PX = 750;

  const isAudioEnabled = ref(true);
  const isSpeakerEnabled = ref(true);
  const isVideoEnabled = ref(true);

  const safeArea = ref({
    left: 0,
    right: 0,
    top: 0,
    bottom: 0,
    width: FALLBACK_SAFE_AREA_WIDTH_PX,
    height: FALLBACK_SAFE_AREA_HEIGHT_PX,
  });
  const statusBarHeight = ref(0);

  onMounted(() => {
    uni.getSystemInfo({
      success: (res) => {
        safeArea.value = res.safeArea;
        statusBarHeight.value = res.statusBarHeight || 0;
      }
    });
  });

  const onAudioChange = (e) => {
    isAudioEnabled.value = e.detail.value;
  }

  const onSpeakerChange = (e) => {
    isSpeakerEnabled.value = e.detail.value;
  }

  const onVideoChange = (e) => {
    isVideoEnabled.value = e.detail.value;
  }

  const handleBack = () => {
    uni.navigateBack();
  }

  const handleCreateRoom = () => {
    const roomID = generateRoomID();
    const nickName = loginUserInfo.value?.nickname || loginUserInfo.value?.userID || roomID;
    const roomName = t('quickstart.defaultRoomName', { name: nickName });
    const query = [
      'mode=create',
      `roomID=${encodeURIComponent(roomID)}`,
      `roomName=${encodeURIComponent(roomName)}`,
      `autoEnableCamera=${isVideoEnabled.value ? 1 : 0}`,
      `autoEnableMicrophone=${isAudioEnabled.value ? 1 : 0}`,
      `autoEnableSpeaker=${isSpeakerEnabled.value ? 1 : 0}`,
    ].join('&');
    uni.navigateTo({
      url: `/pages/scenes/room/meeting/index?${query}`,
    });
  }
</script>

<style lang="scss">
  @import './quickstart.scss';
</style>
