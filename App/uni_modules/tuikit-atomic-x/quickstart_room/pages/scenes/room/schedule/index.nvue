<template>
  <view class="root">
    <CustomNavbar
      :title="pageTitle"
      :showShadow="false"
      @back="handleBack"
    />
    <scroll-view
      class="page"
      scroll-y="true"
      :style="{ paddingBottom: keyboardHeight + 'px' }"
    >

    <view class="card" @tap="handleRootTap">
      <view class="form-item">
        <text class="form-label">房间名称</text>
        <input
          ref="roomNameInputRef"
          class="form-input"
          :value="roomName"
          placeholder="请输入房间名称"
          placeholder-style="color: #C2C7D0; font-size: 32rpx;"
          :maxlength="30"
          @input="onRoomNameInput"
        />
      </view>

      <view class="form-item" @tap="handleOpenTimePicker">
        <text class="form-label">开始时间</text>
        <text class="form-value" :numberOfLines="1">{{ startTimeText }}</text>
        <image class="form-arrow" src="/static/images/room/room_chevron-down.png" mode="aspectFit" />
      </view>

      <view class="form-item" @tap="handleOpenDurationPicker">
        <text class="form-label">房间时长</text>
        <text class="form-value" :numberOfLines="1">{{ durationText }}</text>
        <image class="form-arrow" src="/static/images/room/room_chevron-down.png" mode="aspectFit" />
      </view>

      <view class="form-item" @tap="handleOpenTimezonePicker">
        <text class="form-label">时区</text>
        <text class="form-value" :numberOfLines="1">{{ timezoneText }}</text>
        <image class="form-arrow" src="/static/images/room/room_chevron-down.png" mode="aspectFit" />
      </view>

      <view class="form-item" @tap="handleOpenMemberPanel">
        <text class="form-label">参与成员</text>
        <view class="attendee-box">
          <view
            v-for="user in attendeeAvatarList"
            :key="user.userID"
            class="attendee-avatar-wrap">
            <Avatar :src="user.avatarURL || ''" :name="user.displayName || ''" :size="48" :shape="'circle'" defaultAvatarType="user" pureMode />
          </view>
          <text class="attendee-text">{{ attendeeText }}</text>
        </view>
        <image class="form-arrow form-arrow-right" src="/static/images/room/room_chevron-down.png" mode="aspectFit" />
      </view>
    </view>

    <view class="card" v-if="!isEditMode" @tap="handleRootTap">
      <view class="form-item switch-item">
        <text class="form-label">房间加密</text>
        <ToggleSwitch :checked="isRoomEncrypted" activeColor="#0468FC" @change="onRoomEncryptedChange" />
      </view>
      <view v-if="isRoomEncrypted" class="form-item">
        <text class="form-label">进房密码</text>
        <input
          ref="roomPasswordInputRef"
          class="form-input"
          type="number"
          :value="roomPassword"
          placeholder="请输入 6 位数字密码"
          placeholder-style="color: #C2C7D0; font-size: 32rpx;"
          :maxlength="6"
          @input="onRoomPasswordInput"
        />
      </view>
    </view>

    <view class="card" v-if="!isEditMode" @tap="handleRootTap">
      <view class="form-item switch-item">
        <text class="form-label">全体静音</text>
        <ToggleSwitch :checked="isAllMicrophoneDisabled" activeColor="#0468FC" @change="onAllMicChange" />
      </view>
      <view class="form-item switch-item">
        <text class="form-label">全体禁画</text>
        <ToggleSwitch :checked="isAllCameraDisabled" activeColor="#0468FC" @change="onAllCameraChange" />
      </view>
    </view>

    <view class="footer">
      <view class="submit-btn" :style="submitBtnStyle" @tap="handleSubmit">
        <text class="submit-btn-text">{{ submitText }}</text>
      </view>
    </view>

    <TimePicker
      :visible="isTimePickerVisible"
      :timestamp="startWallClockMs"
      @cancel="isTimePickerVisible = false"
      @confirm="handleTimeConfirm"
    />

    <DurationPicker
      :visible="isDurationPickerVisible"
      :initialTotalMinutes="durationMinutes"
      @cancel="isDurationPickerVisible = false"
      @confirm="handleDurationConfirm"
    />

    <ScheduleInviteSheet
      :visible="isInviteSheetVisible"
      :roomID="createdRoomID"
      title="预定成功，邀请他们加入"
      @close="handleInviteSheetClose"
    />
    </scroll-view>

    <SelectMember
      :visible="isMemberPanelVisible"
      :selectOnly="true"
      :initialSelectedIDs="attendeeIDList"
      @selected="handleAttendeeSelected"
      @close="isMemberPanelVisible = false"
    />

    <TimezonePicker
      :visible="isTimezonePickerVisible"
      :options="timezoneOptions"
      :selectedValue="timezoneIndex"
      @cancel="isTimezonePickerVisible = false"
      @select="handleTimezoneSelect"
    />
  </view>
</template>

<script setup lang="ts">
  import { ref, computed, onMounted, onBeforeUnmount } from 'vue';
  import { onLoad } from '@dcloudio/uni-app';
  import { useLoginState, useRoomState, RoomType } from '@/uni_modules/tuikit-atomic-x/state';
  import { ToggleSwitch } from '@/uni_modules/tuikit-atomic-x/components_compatible';
  import CustomNavbar from '@/uni_modules/tuikit-atomic-x/components/CustomNavbar/CustomNavbar.nvue';
  import TimePicker from '@/uni_modules/tuikit-atomic-x/components/TimePicker/index.nvue';
  import TimezonePicker from '@/uni_modules/tuikit-atomic-x/components/TimezonePicker/index.nvue';
  import DurationPicker from '@/uni_modules/tuikit-atomic-x/components/DurationPicker/index.nvue';
  import ScheduleInviteSheet from './components/ScheduleInviteSheet/index.nvue';
  import SelectMember from '@/uni_modules/tuikit-atomic-x/components/UserPicker/SelectMember/index.nvue';
import Avatar from '@/uni_modules/tuikit-atomic-x/components/Avatar/Avatar.nvue';
  import { showErrorToast } from '@/uni_modules/tuikit-atomic-x/utils/roomErrorHandler';
  import {
    formatDuration,
    formatFullDateTime,
    getDefaultStartTime,
    generateRoomID,
    generateRoomPassword,
  } from '@/uni_modules/tuikit-atomic-x/utils/roomScheduleUtils';
  import {
    TIMEZONE_OPTIONS,
    getDefaultTimezoneIndex,
    getTimezoneLabel,
    wallClockToUtcMs,
    utcToWallClockMs,
  } from '@/uni_modules/tuikit-atomic-x/utils/timezones';
  import { showToast } from '@/uni_modules/tuikit-atomic-x/utils/toast';

  const { loginUserInfo } = useLoginState();
  const roomState = useRoomState();

  const MAX_AVATAR_PREVIEW = 4;

  type AttendeeUser = {
    userID: string;
    displayName: string;
    avatarURL: string;
  };

  const roomName = ref('');
  const roomNameInputRef = ref<any>(null);
  const roomPasswordInputRef = ref<any>(null);
  const keyboardHeight = ref(0);
  const roomType = ref<number>(RoomType.Standard);
  const startTime = ref<number>(getDefaultStartTime());
  const timezoneIndex = ref<number>(getDefaultTimezoneIndex());
  const durationMinutes = ref<number>(30);
  const isRoomEncrypted = ref(false);
  const roomPassword = ref('');
  const isPasswordSystemGenerated = ref(false);
  const isAllMicrophoneDisabled = ref(false);
  const isAllCameraDisabled = ref(false);
  const isAllMessageDisabled = ref(false);
  const isAllScreenShareDisabled = ref(false);
  const attendeeList = ref<AttendeeUser[]>([]);
  const originalAttendeeIDs = ref<string[]>([]);

  const editRoomID = ref('');
  const isEditMode = computed(() => editRoomID.value.length > 0);
  const pageTitle = computed(() => (isEditMode.value ? '修改房间' : '预定房间'));
  const submitText = computed(() => (isEditMode.value ? '保存' : '预定房间'));

  const isTimePickerVisible = ref(false);
  const isTimezonePickerVisible = ref(false);
  const isDurationPickerVisible = ref(false);
  const isInviteSheetVisible = ref(false);
  const isMemberPanelVisible = ref(false);
  const createdRoomID = ref('');

  const isSubmitting = ref(false);

  const timezoneOptions = computed(() =>
    TIMEZONE_OPTIONS.map((o) => ({ value: o.value, label: o.label })),
  );
  const timezoneText = computed(() => getTimezoneLabel(timezoneIndex.value));

  const startWallClockMs = computed(() => utcToWallClockMs(startTime.value, timezoneIndex.value));

  const startTimeText = computed(() => formatFullDateTime(startWallClockMs.value));
  const durationText = computed(() => formatDuration(durationMinutes.value));

  const attendeeIDList = computed<string[]>(() => attendeeList.value.map((u) => u.userID));
  const attendeeAvatarList = computed<AttendeeUser[]>(() =>
    attendeeList.value.slice(0, MAX_AVATAR_PREVIEW),
  );
  const attendeeText = computed(() => {
    const n = attendeeList.value.length;
    return n === 0 ? '添加' : `${n}人`;
  });

  const isSubmitDisabled = computed(() => roomName.value.trim().length === 0 || isSubmitting.value);
  const submitBtnStyle = computed(() => ({ opacity: isSubmitDisabled.value ? 0.5 : 1 }));

  onLoad((options: any) => {
    const rid = options?.roomID ? decodeURIComponent(String(options.roomID)) : '';
    if (rid.length > 0) {
      editRoomID.value = rid;
      if (options?.roomName) roomName.value = decodeURIComponent(String(options.roomName));
      if (options?.roomType) roomType.value = parseInt(String(options.roomType), 10) || RoomType.Standard;
      if (options?.startTime) {
        const st = parseInt(String(options.startTime), 10);
        if (st > 0) startTime.value = st;
      }
      if (options?.duration) {
        const du = parseInt(String(options.duration), 10);
        if (du > 0) durationMinutes.value = du;
      }
      isAllMicrophoneDisabled.value = options?.allMicDisabled === '1';
      isAllCameraDisabled.value = options?.allCameraDisabled === '1';
      isAllMessageDisabled.value = options?.allMessageDisabled === '1';
      isAllScreenShareDisabled.value = options?.allScreenShareDisabled === '1';
      if (options?.password) {
        const pwd = decodeURIComponent(String(options.password)).replace(/\D/g, '').slice(0, 6);
        if (pwd.length > 0) {
          roomPassword.value = pwd;
          isRoomEncrypted.value = true;
          isPasswordSystemGenerated.value = false;
        }
      }
    }
  });

  onMounted(() => {
    if (!isEditMode.value && roomName.value.length === 0) {
      const nickName = loginUserInfo.value?.nickname || loginUserInfo.value?.userID || '';
      if (nickName.length > 0) {
        const MAX_LEN = 30
        const SUFFIX = '的临时房间'
        const maxNickLen = MAX_LEN - SUFFIX.length
        const trimmed = nickName.length > maxNickLen ? nickName.slice(0, maxNickLen) : nickName
        roomName.value = `${trimmed}${SUFFIX}`
      } else {
        roomName.value = ''
      }
    }
    if (isEditMode.value) loadScheduledAttendees();
    const onKeyboardChange = (res: any): void => {
      keyboardHeight.value = (res?.height ?? 0) as number;
    };
    uni.onKeyboardHeightChange(onKeyboardChange);
    onBeforeUnmount(() => uni.offKeyboardHeightChange(onKeyboardChange));
  });

  function loadScheduledAttendees(): void {
    const rid = editRoomID.value;
    if (rid.length === 0) return;
    const collected: AttendeeUser[] = [];
    const MAX_PAGES = 50;
    let pageIndex = 0;
    let cursor = '';
    const loopFetch = (): Promise<void> => {
      return roomState
        .getScheduledAttendees({ roomID: rid, cursor })
        .then((res: any) => {
          const list = (res?.attendees || []) as any[];
          for (const a of list) {
            const uid = a.userID || '';
            const nick = a.userName || a.nickname || '';
            collected.push({
              userID: uid,
              displayName: nick.length > 0 ? `${uid}(${nick})` : uid,
              avatarURL: a.avatarURL || '',
            } as AttendeeUser);
          }
          pageIndex += 1;
          if (!res?.cursor || pageIndex >= MAX_PAGES) {
            attendeeList.value = collected;
            originalAttendeeIDs.value = collected.map((u) => u.userID);
            return;
          }
          cursor = res.cursor;
          return loopFetch();
        });
    };
    loopFetch().catch((e: any) => {
      console.warn('[schedule] getScheduledAttendees failed:', e);
    });
  }

  function onRoomNameInput(e: any): void {
    roomName.value = (e?.detail?.value ?? '') as string;
  }


  function onRoomEncryptedChange(e: any): void {
    const on = e.detail.value as boolean;
    isRoomEncrypted.value = on;
    if (!on) return;
    if (roomPassword.value.length !== 6 && !isEditMode.value) {
      roomPassword.value = generateRoomPassword();
      isPasswordSystemGenerated.value = true;
    }
  }
  function onRoomPasswordInput(e: any): void {
    const raw = (e?.detail?.value ?? '') as string;
    roomPassword.value = raw.replace(/\D/g, '').slice(0, 6);
    isPasswordSystemGenerated.value = false;
  }

  function onAllMicChange(e: any): void {
    isAllMicrophoneDisabled.value = e.detail.value;
  }
  function onAllCameraChange(e: any): void {
    isAllCameraDisabled.value = e.detail.value;
  }
  function onAllMessageChange(e: any): void {
    isAllMessageDisabled.value = e.detail.value;
  }
  function onAllScreenShareDisabledChange(e: any): void {
    isAllScreenShareDisabled.value = e.detail.value;
  }

  function handleRootTap(): void {
    roomNameInputRef.value?.blur?.();
    roomPasswordInputRef.value?.blur?.();
    uni.hideKeyboard();
  }

  function handleOpenTimePicker(): void {
    uni.hideKeyboard();
    isTimePickerVisible.value = true;
  }
  function handleTimeConfirm(ts: number): void {
    startTime.value = wallClockToUtcMs(ts, timezoneIndex.value);
    isTimePickerVisible.value = false;
  }

  function handleOpenTimezonePicker(): void {
    uni.hideKeyboard();
    isTimezonePickerVisible.value = true;
  }
  function handleTimezoneSelect(value: number): void {
    timezoneIndex.value = value;
    isTimezonePickerVisible.value = false;
  }

  function handleOpenDurationPicker(): void {
    uni.hideKeyboard();
    isDurationPickerVisible.value = true;
  }
  function handleDurationConfirm(totalMinutes: number): void {
    durationMinutes.value = totalMinutes;
    isDurationPickerVisible.value = false;
  }

  function handleOpenMemberPanel(): void {
    uni.hideKeyboard();
    isMemberPanelVisible.value = true;
  }
  function handleAttendeeSelected(payload: { users: AttendeeUser[] }): void {
    attendeeList.value = (payload?.users || []).slice();
    isMemberPanelVisible.value = false;
  }

  function handleBack(): void {
    uni.navigateBack();
  }

  function handleSubmit(): void {
    if (isSubmitDisabled.value) {
      if (roomName.value.trim().length === 0) {
        showToast('请输入房间名称');
      }
      return;
    }
    if (startTime.value <= Date.now()) {
      showToast('开始时间不能早于当前时间');
      return;
    }
    if (isRoomEncrypted.value && roomPassword.value.length !== 6) {
      showToast('请输入 6 位数字进房密码');
      return;
    }
    uni.hideKeyboard();
    isSubmitting.value = true;

    const targetRoomID = isEditMode.value ? editRoomID.value : generateRoomID();
    const currentIDs = attendeeIDList.value.slice();
    const utcStartMs = startTime.value;
    const scheduleOptions = {
      roomName: roomName.value.trim(),
      password: isRoomEncrypted.value ? roomPassword.value : '',
      scheduleStartTime: Math.floor(utcStartMs / 1000),
      scheduleEndTime: Math.floor((utcStartMs + durationMinutes.value * 60 * 1000) / 1000),
      scheduleAttendees: isEditMode.value ? undefined : currentIDs.slice(),
      isAllMicrophoneDisabled: isAllMicrophoneDisabled.value,
      isAllCameraDisabled: isAllCameraDisabled.value,
      isAllMessageDisabled: isAllMessageDisabled.value,
      isAllScreenShareDisabled: isAllScreenShareDisabled.value,
    };

    const task = isEditMode.value
      ? roomState.updateScheduledRoom({ roomID: targetRoomID, options: scheduleOptions })
      : roomState.scheduleRoom({ roomID: targetRoomID, options: scheduleOptions });

    task
      .then(() => {
        if (isEditMode.value) {
          return syncAttendeesDiff(targetRoomID);
        }
        return Promise.resolve();
      })
      .then(() => {
        isSubmitting.value = false;
        if (isEditMode.value) {
          showToast('保存成功');
          setTimeout(() => {
            uni.navigateBack();
          }, 600);
          return;
        }
        createdRoomID.value = targetRoomID;
        isInviteSheetVisible.value = true;
      })
      .catch((e: any) => {
        isSubmitting.value = false;
        showErrorToast(e, isEditMode.value ? '保存失败' : '预定房间失败');
      });
  }

  function handleInviteSheetClose(): void {
    isInviteSheetVisible.value = false;
    uni.navigateBack();
  }

  function syncAttendeesDiff(roomID: string): Promise<void> {
    const before = new Set(originalAttendeeIDs.value);
    const after = new Set(attendeeIDList.value);
    const toRemove: string[] = [];
    const toAdd: string[] = [];
    before.forEach((id) => {
      if (!after.has(id)) toRemove.push(id);
    });
    after.forEach((id) => {
      if (!before.has(id)) toAdd.push(id);
    });

    const tasks: Promise<unknown>[] = [];
    if (toRemove.length > 0) {
      tasks.push(
        roomState
          .removeScheduledAttendees({ roomID, userIDList: toRemove.slice() })
          .catch((e: any) => {
            console.warn('[schedule] removeScheduledAttendees failed:', e);
            showToast('部分成员移除失败');
          }),
      );
    }
    if (toAdd.length > 0) {
      tasks.push(
        roomState
          .addScheduledAttendees({ roomID, userIDList: toAdd.slice() })
          .catch((e: any) => {
            console.warn('[schedule] addScheduledAttendees failed:', e);
            showToast('部分成员添加失败');
          }),
      );
    }
    if (tasks.length === 0) return Promise.resolve();
    return Promise.all(tasks).then(() => undefined);
  }
</script>

<style>
  .root {
    flex: 1;
    background-color: #F2F5FC;
    flex-direction: column;
  }
  .page {
    flex: 1;
    flex-direction: column;
    padding-bottom: 32rpx;
  }

  .card {
    margin: 40rpx 32rpx 0;
    padding: 20rpx 40rpx;
    background-color: #FFFFFF;
    border-radius: 12rpx;
    flex-direction: column;
  }

  .form-item {
    flex-direction: row;
    align-items: center;
    padding: 20rpx 0;
  }

  .switch-item {
    justify-content: space-between;
  }

  .form-label {
    width: 176rpx;
    font-size: 32rpx;
    color: #2B2E38;
  }

  .form-input {
    flex: 1;
    font-size: 32rpx;
    font-weight: 500;
    color: #A2A4A8;
    lines: 1;
    padding: 0;
    text-align: right;
  }

  .form-value {
    flex: 1;
    font-size: 32rpx;
    font-weight: 500;
    color: #A2A4A8;
    text-align: right;
    lines: 1;
    text-overflow: ellipsis;
  }

  .form-arrow {
    width: 28rpx;
    height: 28rpx;
    margin-left: 8rpx;
  }

  .form-arrow-right {
    transform: rotate(-90deg);
  }

  .attendee-box {
    flex: 1;
    flex-direction: row;
    align-items: center;
    justify-content: flex-end;
  }

  .attendee-avatar-wrap {
    margin-left: 8rpx;
  }

  .attendee-text {
    font-size: 32rpx;
    font-weight: 500;
    color: #A2A4A8;
    margin-left: 12rpx;
  }

  .form-hint-wrap {
    padding-top: 8rpx;
    padding-bottom: 8rpx;
    padding-left: 4rpx;
    padding-right: 32rpx;
    flex-direction: row;
  }

  .form-hint-text {
    flex: 1;
    color: #A2A4A8;
    font-size: 24rpx;
    line-height: 36rpx;
  }

  .footer {
    margin-top: 40rpx;
    padding: 0 32rpx;
  }

  .submit-btn {
    border-radius: 16rpx;
    background-image: linear-gradient(to right, #006EFF, #0C59F2);
    flex-direction: row;
    justify-content: center;
    align-items: center;
  }

  .submit-btn-text {
    color: #FFFFFF;
    font-size: 32rpx;
    font-weight: 500;
    padding: 22rpx 0;
  }
</style>
