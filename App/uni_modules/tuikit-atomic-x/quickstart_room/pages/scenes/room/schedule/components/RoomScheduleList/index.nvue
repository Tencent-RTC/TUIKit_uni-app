<template>
  <view class="room-schedule-list">
    <view v-if="isEmpty" class="empty">
      <image class="empty-icon" src="/static/images/room/room_schedule_placeholder.png" mode="aspectFit" />
      <text class="empty-text">{{ emptyText }}</text>
    </view>

    <scroll-view
      v-else
      class="list-scroll"
      scroll-y="true"
      show-scrollbar="false"
      @scrolltolower="handleLoadMore"
    >
      <view v-for="(group, groupIndex) in groups" :key="groupIndex" class="group">
        <view class="group-title-row">
          <image class="group-title-icon" src="/static/images/room/room_calendar.png" mode="aspectFit" />
          <text class="group-title-text">{{ group.title }}</text>
        </view>
        <view
          v-for="(room, roomIndex) in group.rooms"
          :key="roomIndex"
          class="item"
          @tap="handleRoomTap(room)"
        >
          <view class="item-main">
            <view class="item-top">
              <text class="item-name" :numberOfLines="1">{{ truncateRoomNameDisplay(room.roomName || room.roomID, 6) }}</text>
              <image class="item-arrow" src="/static/images/room/room_chevron-down.png" mode="aspectFit" />
            </view>
            <view class="item-bottom">
              <text class="item-time">{{ formatRoomTimeRange(room) }}</text>
              <text class="item-divider">|</text>
              <text class="item-id">{{ formatRoomIDDisplay(room.roomID) }}</text>
              <text class="item-divider">|</text>
              <text
                class="item-status-text"
                :class="{ 'item-status-running': isRoomRunning(room) }"
              >{{ formatRoomStatusText(room) }}</text>
            </view>
          </view>
          <view class="enter-btn" @tap.stop="handleEnterRoom(room)">
            <text class="enter-btn-text">进入</text>
          </view>
        </view>
      </view>

      <view v-if="isLoadingMore" class="loading-more">
        <text class="loading-more-text">加载中...</text>
      </view>
    </scroll-view>
  </view>
</template>

<script setup lang="ts">
  import { ref, computed, onMounted } from 'vue';
  import { useRoomState, RoomStatus } from '@/uni_modules/tuikit-atomic-x/state';
  import type { RoomInfo } from '@/uni_modules/tuikit-atomic-x/types/room';
  import { showErrorToast } from '@/uni_modules/tuikit-atomic-x/utils/roomErrorHandler';
  import { formatTimeSec, formatRoomIDDisplay, groupRoomsByDate, truncateRoomNameDisplay } from '@/uni_modules/tuikit-atomic-x/utils/roomScheduleUtils';

  const roomState = useRoomState();
  const scheduledRoomList = roomState.scheduledRoomList;
  const scheduledRoomListCursor = roomState.scheduledRoomListCursor;

  const isLoadingMore = ref(false);

  const hasMore = computed(() => (scheduledRoomListCursor.value || '').length > 0);

  const groups = computed(() => groupRoomsByDate(scheduledRoomList.value || []));

  const isEmpty = computed(() => (scheduledRoomList.value || []).length === 0);
  const emptyText = computed(() => '暂无预定的房间');

  onMounted(() => {
    roomState
      .getScheduledRoomList({ cursor: '' })
      .catch((e: any) => {
        showErrorToast(e, '获取预定房间失败');
      });
  });

  function handleLoadMore(): void {
    if (isLoadingMore.value || !hasMore.value) return;
    isLoadingMore.value = true;
    roomState
      .getScheduledRoomList({ cursor: scheduledRoomListCursor.value })
      .then(() => {
        isLoadingMore.value = false;
      })
      .catch((e: any) => {
        isLoadingMore.value = false;
        showErrorToast(e, '加载更多失败');
      });
  }

  function formatRoomTimeRange(room: RoomInfo): string {
    const start = formatTimeSec(room?.scheduledStartTime);
    const end = formatTimeSec(room?.scheduledEndTime);
    if (start.length === 0) return '';
    if (end.length === 0) return start;
    return `${start} - ${end}`;
  }

  function isRoomRunning(room: RoomInfo): boolean {
    return room?.roomStatus === RoomStatus.Running;
  }

  function formatRoomStatusText(room: RoomInfo): string {
    return isRoomRunning(room) ? '进行中' : '未开始';
  }

  function handleRoomTap(room: RoomInfo): void {
    const rid = room?.roomID || '';
    if (rid.length === 0) return;
    uni.navigateTo({
      url: `/pages/scenes/room/schedule/detail/index?roomID=${encodeURIComponent(rid)}`,
    });
  }

  function handleEnterRoom(room: RoomInfo): void {
    const rid = room?.roomID || '';
    if (rid.length === 0) return;
    const query = [
      'mode=join',
      `roomID=${encodeURIComponent(rid)}`,
      'autoEnableCamera=0',
      'autoEnableMicrophone=1',
      'autoEnableSpeaker=1',
    ].join('&');
    uni.navigateTo({ url: `/pages/scenes/room/meeting/index?${query}` });
  }
</script>

<style>
  .room-schedule-list {
    flex: 1;
    flex-direction: column;
  }

  .list-scroll {
    flex: 1;
    padding: 0 40rpx;
  }

  .group {
    flex-direction: column;
    padding-top: 40rpx;
    padding-bottom: 20rpx;
  }

  .group-title-row {
    flex-direction: row;
    align-items: center;
  }

  .group-title-icon {
    width: 32rpx;
    height: 32rpx;
    margin-right: 4rpx;
  }

  .group-title-text {
    font-weight: 400;
    font-size: 28rpx;
    color: #969EB4;
  }

  .item {
    flex-direction: row;
    align-items: center;
    padding-top: 40rpx;
  }

  .item-main {
    flex: 1;
    flex-direction: column;
  }

  .item-top {
    flex-direction: row;
    align-items: center;
    flex: 1;
    overflow: hidden;
  }

  .item-name {
    max-width: 460rpx;
    font-size: 32rpx;
    font-weight: 500;
    color: #4F586B;
    lines: 1;
    text-overflow: ellipsis;
  }

  .item-arrow {
    width: 32rpx;
    height: 32rpx;
    flex-shrink: 0;
    transform: rotate(-90deg);
  }

  .item-bottom {
    flex-direction: row;
    align-items: center;
    margin-top: 12rpx;
    flex: 1;
    overflow: hidden;
  }

  .item-time {
    font-weight: 400;
    font-size: 28rpx;
    color: #4F586B;
    lines: 1;
    text-overflow: ellipsis;
    flex-shrink: 0;
  }

  .item-divider {
    font-weight: 400;
    font-size: 28rpx;
    color: #969EB4;
    margin-left: 16rpx;
    margin-right: 16rpx;
    flex-shrink: 0;
  }

  .item-id {
    font-weight: 400;
    font-size: 28rpx;
    color: #4F586B;
    /* flex:1 + min-width:0 是 weex 中让 ellipsis 生效的标配——
       默认 min-width:auto（=内容宽度）会让 flex item 无法收缩到内容以下 */
    flex: 1;
    min-width: 0;
    lines: 1;
    text-overflow: ellipsis;
  }

  .item-status-text {
    font-weight: 400;
    font-size: 28rpx;
    color: #FF643D;
    lines: 1;
    flex-shrink: 0;
  }

  .item-status-running {
    color: #0468FC;
  }

  .enter-btn {
    margin-left: 40rpx;
    padding: 10rpx 40rpx;
    border-radius: 28rpx;
    background-color: #F0F3FA;
    flex-direction: row;
    justify-content: center;
    align-items: center;
  }

  .enter-btn-text {
    font-size: 28rpx;
    font-weight: 400;
    line-height: 44rpx;
    color: #4F586B;
  }

  .empty {
    flex: 1;
    flex-direction: column;
    justify-content: center;
    align-items: center;
  }

  .empty-icon {
    width: 300rpx;
    height: 198rpx;
    margin-bottom: 16rpx;
  }

  .empty-text {
    font-weight: 400;
    font-size: 28rpx;
    line-height: 44rpx;
    color: #8F9AB2;
  }
</style>
