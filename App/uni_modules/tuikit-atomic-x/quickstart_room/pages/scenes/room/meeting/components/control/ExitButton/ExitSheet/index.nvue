<template>
  <view class="exit-mask" v-if="visible" @tap.stop="handleCancel">
    <view class="exit-sheet" @tap.stop>
      <view class="drop-bar" @tap.stop="handleCancel">
        <image class="drop-line" src="/static/images/room/room_lineImage.png" mode="aspectFit" />
      </view>
      <text class="exit-sheet-tip">{{ tipText }}</text>
      <view class="exit-sheet-divider"></view>
      <view class="exit-sheet-btn" @tap.stop="handleLeave">
        <text class="exit-sheet-btn-text-leave">{{ t('exit.leaveRoom') }}</text>
      </view>
      <view class="exit-sheet-divider" v-if="isOwner"></view>
      <view class="exit-sheet-btn" v-if="isOwner" @tap.stop="handleEnd">
        <text class="exit-sheet-btn-text-end">{{ t('exit.endRoom') }}</text>
      </view>
    </view>
  </view>
</template>

<script setup lang="ts">
  import { computed } from 'vue';
  import { t } from '../../../../../locales';

  const props = defineProps({
    visible: { type: Boolean, default: false },
    isOwner: { type: Boolean, default: false },
  });

  const emit = defineEmits<{
    (e: 'leave'): void
    (e: 'end'): void
    (e: 'cancel'): void
  }>();

  const tipText = computed(() => (props.isOwner ? t('exit.ownerTip') : t('exit.memberTip')));

  function handleLeave() { emit('leave'); }
  function handleEnd() { emit('end'); }
  function handleCancel() { emit('cancel'); }
</script>

<style lang="scss">
  @import './ExitSheet.scss';
</style>
