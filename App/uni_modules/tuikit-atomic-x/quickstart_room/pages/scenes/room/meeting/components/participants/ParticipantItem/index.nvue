<template>
  <view class="member-row" @tap="onPress">
    <view class="avatar-wrap">
      <image
        class="avatar-img"
        :src="avatarSrc"
        mode="aspectFill"
      />
    </view>

    <view class="user-info">
      <view class="name-row">
        <text class="name-text" :numberOfLines="1">{{ displayName }}</text>
        <text v-if="isLocal" class="me-tag">{{ t('participant.meTag') }}</text>
      </view>

      <view v-if="badgeConfig" class="badge-row">
        <image
          class="badge-icon"
          :src="badgeConfig.icon"
          mode="aspectFit"
        />
        <text
          class="badge-text"
          :style="{ color: badgeConfig.color }"
        >{{ badgeConfig.text }}</text>
      </view>
    </view>

    <view v-if="type === 'participant'" class="status-icons">
      <image
        v-if="participant?.screenShareStatus === DeviceStatus.ON && !isWebinar"
        class="status-icon"
        src="/static/images/room/room_screen_share_icon.png"
        mode="aspectFit"
      />
      <image
        class="status-icon"
        :src="micIconSrc"
        mode="aspectFit"
      />
      <image
        v-if="!isWebinar"
        class="status-icon"
        :src="cameraIconSrc"
        mode="aspectFit"
      />
    </view>

    <!-- 未进房右侧 action：呼叫 / 取消（与 person 操作互斥，按钮自带 tap.stop 不冒泡） -->
    <view v-else-if="type === 'notJoined'" class="action-area">
      <text v-if="isCalling" class="calling-tag">{{ t('participant.calling') }}</text>
      <text v-else-if="isRejected" class="rejected-tag">{{ t('participant.rejected') }}</text>
      <view v-else class="action-btn action-btn-call" @tap.stop="emit('call')">
        <text class="action-btn-text-call">{{ t('participant.call') }}</text>
      </view>
    </view>
  </view>
</template>

<script setup lang="ts">
  import { computed } from 'vue';
  import type { PropType } from 'vue';
  import type { RoomUser } from '@/uni_modules/tuikit-atomic-x/types';
  import type { RoomParticipant } from '@/uni_modules/tuikit-atomic-x/types';
  import { DeviceStatus, RoomParticipantRole } from '@/uni_modules/tuikit-atomic-x/state';
  import { ROOM_TOKENS } from '../../../../styles/tokens.js';
  import { t } from '../../../../locales';

  const props = defineProps({
    type: { type: String as PropType<'participant' | 'audience' | 'notJoined'>, required: true },
    participant: { type: Object as PropType<RoomParticipant | null>, default: null },
    audience: { type: Object as PropType<RoomUser | null>, default: null },
    notJoinedUser: { type: Object as PropType<RoomUser | null>, default: null },
    isAdmin: { type: Boolean, default: false },
    isLocal: { type: Boolean, default: false },
    canControl: { type: Boolean, default: false },
    isWebinar: { type: Boolean, default: false },
    isCalling: { type: Boolean, default: false },
    isRejected: { type: Boolean, default: false },
  });

  const emit = defineEmits<{
    (e: 'press'): void
    (e: 'call'): void
    (e: 'cancelCall'): void
  }>();

  const user = computed<RoomParticipant | RoomUser | null>(() => {
    if (props.type === 'participant') return props.participant;
    if (props.type === 'audience') return props.audience;
    return props.notJoinedUser;
  });

  const displayName = computed(() => {
    const currentUser = user.value;
    if (!currentUser) return '';
    const nameCard = (currentUser as RoomParticipant).nameCard;
    return nameCard || currentUser.userName || currentUser.userID || '';
  });

  const avatarSrc = computed(() => user.value?.avatarURL || '/static/images/room/room_default_avatar.png');

  const micIconSrc = computed(() =>
    props.participant?.microphoneStatus === DeviceStatus.ON
      ? '/static/images/room/room_user_mic_on.png'
      : '/static/images/room/room_user_mic_off.png',
  );

  const cameraIconSrc = computed(() =>
    props.participant?.cameraStatus === DeviceStatus.ON
      ? '/static/images/room/room_user_camera_on.png'
      : '/static/images/room/room_user_camera_off.png',
  );

  type BadgeConfig = { icon: string; color: string; text: string };
  const badgeConfig = computed<BadgeConfig | null>(() => {
    let role: 'owner' | 'admin' | 'none' = 'none';
    if (props.type === 'participant') {
      const r = props.participant?.role;
      if (r === RoomParticipantRole.Owner) role = 'owner';
      else if (r === RoomParticipantRole.Admin) role = 'admin';
    } else if (props.isAdmin) {
      role = 'admin';
    }

    if (role === 'owner') {
      return {
        icon: '/static/images/room/room_owner_icon.png',
        color: ROOM_TOKENS.colorBrandDeep,
        text: t('participant.owner'),
      };
    }
    if (role === 'admin') {
      return {
        icon: '/static/images/room/room_administrator_icon.png',
        color: ROOM_TOKENS.colorWarning,
        text: t('participant.admin'),
      };
    }
    return null;
  });

  function onPress() {
    if (!props.canControl) return;
    emit('press');
  }
</script>

<style lang="scss">
  @import './ParticipantItem.scss';
</style>
