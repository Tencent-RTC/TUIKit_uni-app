<template>
  <view class="bottom-btn">
    <view class="bottom-icon-box" :class="{ 'bottom-icon-box-webinar': isWebinar }" @tap="showParticipantList">
      <image class="bottom-icon" src="/static/images/room/room_member.png" mode="aspectFit" />
      <text class="bottom-text">{{ (isWebinar || participantCount === 0) ? t('participants.members') : t('participants.membersWithCount', { count: participantCount }) }}</text>
    </view>

    <RoomParticipantList
      :visible="isParticipantListVisible"
      :roomID="roomID"
      :isWebinar="isWebinar"
      @close="hideParticipantList"
      @manage="handleManageParticipant"
      @manageAud="handleManageAudience"
    />

    <ParticipantAction
      :visible="isParticipantManagerVisible"
      :roomID="roomID"
      :type="participantManagerType"
      :participant="participantManagerTarget"
      :audience="audienceManagerTarget"
      :isWebinar="isWebinar"
      @close="hideParticipantManager"
      @transferred="handleOwnerTransferred"
    />
  </view>
</template>

<script setup lang="ts">
  import { computed, ref } from 'vue';
  import { useRoomState } from '@/uni_modules/tuikit-atomic-x/state';
  import { useRoomParticipantState } from '@/uni_modules/tuikit-atomic-x/state';
  import type { RoomParticipant } from '@/uni_modules/tuikit-atomic-x/types';
  import type { RoomUser } from '@/uni_modules/tuikit-atomic-x/types';
  import RoomParticipantList from '../index.nvue';
  import ParticipantAction from '../ParticipantAction/index.nvue';
  import { t } from '../../../../locales';

  defineProps({
    roomID: { type: String, default: '' },
    isWebinar: { type: Boolean, default: false },
  });

  const { currentRoom } = useRoomState();
  const { participantList } = useRoomParticipantState();

  const participantCount = computed(() => {
    const fromRoom = currentRoom.value?.participantCount;
    const fromList = participantList.value?.length || 0;
    if (typeof fromRoom === 'number' && fromRoom > 0) return fromRoom;
    return fromList;
  });

  const isParticipantListVisible = ref(false);
  const isParticipantManagerVisible = ref(false);
  const participantManagerType = ref<'participant' | 'audience'>('participant');
  const participantManagerTarget = ref<RoomParticipant | null>(null);
  const audienceManagerTarget = ref<RoomUser | null>(null);

  function showParticipantList() { isParticipantListVisible.value = true; }
  function hideParticipantList() { isParticipantListVisible.value = false; }

  function handleManageParticipant(p: RoomParticipant) {
    participantManagerType.value = 'participant';
    participantManagerTarget.value = p;
    audienceManagerTarget.value = null;
    isParticipantManagerVisible.value = true;
  }

  function handleManageAudience(u: RoomUser) {
    participantManagerType.value = 'audience';
    participantManagerTarget.value = null;
    audienceManagerTarget.value = u;
    isParticipantManagerVisible.value = true;
  }

  function hideParticipantManager() { isParticipantManagerVisible.value = false; }

  function handleOwnerTransferred(_userID: string) {
    hideParticipantManager();
  }
</script>

<style lang="scss">
  @import './MembersButton.scss';
</style>
