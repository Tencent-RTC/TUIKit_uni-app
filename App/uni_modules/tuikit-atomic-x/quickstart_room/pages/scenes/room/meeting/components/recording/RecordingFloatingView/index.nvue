<template>
  <view v-if="visible" class="recording-root">
    <view v-if="!expanded" class="pill" @tap="onPillTap">
      <view class="dot" :style="{ opacity: blinkAlpha }" />
      <text class="text">{{ t('recording.recording') }}</text>
      <image v-if="canManage" class="arrow" src="/static/images/room/room_recording_arrow.png" mode="aspectFit" />
    </view>

    <view v-if="expanded" class="outside-mask" @tap="collapse">
      <view class="card" :style="{ top: (props.top ?? 0) + 'px' }" @tap.stop>
        <view class="card-header" @tap="collapse">
          <view class="dot" :style="{ opacity: blinkAlpha }" />
          <text class="text">{{ t('recording.recording') }}</text>
          <image class="arrow arrow-up" src="/static/images/room/room_recording_arrow.png" mode="aspectFit" />
        </view>
        <view class="stop-btn" @tap="onStopTap">
          <image class="stop-icon" src="/static/images/room/room_recording_stop.png" mode="aspectFit" />
          <text class="stop-text">{{ t('common.end') }}</text>
        </view>
      </view>
    </view>
  </view>
</template>

<script setup lang="ts">
  import { computed, ref, watch, onUnmounted } from 'vue';
  import {
    useRoomState,
    useRoomParticipantState,
    RoomParticipantRole,
    RecordingStatus,
  } from '@/uni_modules/tuikit-atomic-x/state';
  import { t } from '../../../../locales';
  import { requestStopRecording } from '../recordingConfirmDialog';

  const props = defineProps<{ top?: number }>();

  const roomState = useRoomState();
  const { localParticipant } = useRoomParticipantState();

  const status = computed(
    () => roomState.currentRoom.value?.recordingInfo?.status ?? RecordingStatus.None
  );
  const visible = computed(() => status.value === RecordingStatus.Recording);
  const role = computed(() => localParticipant.value?.role);
  const canManage = computed(
    () => role.value === RoomParticipantRole.Owner || role.value === RoomParticipantRole.Admin
  );

  const expanded = ref(false);

  const blinkAlpha = ref(1);
  const BLINK_PERIOD_MS = 1200;
  const BLINK_TICK_MS = 16;
  const BLINK_MIN = 0.3;
  const BLINK_MAX = 1.0;
  let blinkTimer: any = null;
  let blinkStartTs = 0;

  function tickBlink() {
    const elapsed = (Date.now() - blinkStartTs) % BLINK_PERIOD_MS;
    const phase = elapsed / BLINK_PERIOD_MS;
    const eased = (Math.cos(phase * 2 * Math.PI) + 1) / 2;
    blinkAlpha.value = BLINK_MIN + (BLINK_MAX - BLINK_MIN) * eased;
  }

  function startBlink() {
    if (blinkTimer) return;
    blinkStartTs = Date.now();
    blinkTimer = setInterval(tickBlink, BLINK_TICK_MS);
  }

  function stopBlink() {
    if (blinkTimer) {
      clearInterval(blinkTimer);
      blinkTimer = null;
    }
    blinkAlpha.value = 1;
  }

  watch(
    visible,
    (v) => {
      if (v) startBlink();
      else {
        stopBlink();
        expanded.value = false;
      }
    },
    { immediate: true }
  );

  watch(canManage, (v) => { if (!v) expanded.value = false; });

  function onPillTap() {
    if (!canManage.value) return;
    expanded.value = true;
  }

  function collapse() {
    expanded.value = false;
  }

  function onStopTap() {
    expanded.value = false;
    // 停止确认弹窗由 recording 域共享状态驱动（RecordingButton 渲染并执行）
    requestStopRecording();
  }

  onUnmounted(() => {
    stopBlink();
  });
</script>

<style lang="scss">
  @import './RecordingFloatingView.scss';
</style>
