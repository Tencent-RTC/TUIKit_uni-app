<template>
  <view
    class="room-page"
    :style="{ height: systemInfo?.windowHeight + 'px', width: systemInfo?.safeArea?.width + 'px' }"
  >
    <RoomView
      v-if="!isLocalScreenSharing"
      class="room-view"
      :style="{
        marginTop: ((systemInfo?.statusBarHeight || 0) + ROOM_TOP_BAR_HEIGHT_PX) + 'px',
      }"
      :roomID="roomID"
    />

    <ScreenSharingPlaceholder v-else />

    <view
      v-if="roomID.length > 0"
      class="top-bar"
      :style="{
        paddingTop: (systemInfo?.statusBarHeight || 0) + 'px',
        height: ((systemInfo?.statusBarHeight || 0) + ROOM_TOP_BAR_HEIGHT_PX) + 'px',
      }"
    >
      <view class="top-bar-left">
        <SpeakerButton :autoEnableSpeaker="autoEnableSpeaker" />
        <view class="top-icon-gap"></view>
        <SwitchCameraButton />
      </view>

      <RoomInfo :roomID="roomID" />

      <view class="top-bar-right">
        <ExitButton ref="exitBtnRef" :isOwner="isOwner" @exit="leaveRoom()" />
      </view>
    </view>

    <ToolPanel
      v-if="roomID.length > 0"
      ref="toolPanelRef"
      :roomID="roomID"
      :autoEnableMicrophone="autoEnableMicrophone"
      :autoEnableCamera="autoEnableCamera"
      :threshold="5"
    />

    <RecordingFloatingView
      v-if="roomID.length > 0"
      class="recording-floating"
      :style="{ top: ((systemInfo?.statusBarHeight || 0) + ROOM_TOP_BAR_HEIGHT_PX + RECORDING_FLOAT_OFFSET_PX) + 'px' }"
      :top="(systemInfo?.statusBarHeight || 0) + ROOM_TOP_BAR_HEIGHT_PX + RECORDING_FLOAT_OFFSET_PX"
    />

    <RoomEnterPasswordSheet
      ref="passwordSheetRef"
      :roomID="roomID"
      :roomType="RoomType.Standard"
      @cancelled="leaveRoom()"
      @failed="(e: any) => notifyEnterFailed(e, false)"
    />

    <ConfirmDialog
      :modelValue="tipsDialogRef.visible"
      :title="tipsDialogRef.title"
      :confirmText="tipsDialogRef.confirmButton"
      :cancelText="tipsDialogRef.cancelButton"
      :message="tipsDialogRef.content"
      :closeOnClickMask="tipsDialogRef.closeOnClickMask"
      @confirm="tipsDialogRef.onConfirm"
      @cancel="tipsDialogRef.onCancel"
      @update:modelValue="(val: boolean) => { if (!val) tipsDialogRef.visible = false; }"
    />

    <DeviceFailurePanel />

  </view>
</template>

<script setup lang="ts">
  import { onLoad, onBackPress } from '@dcloudio/uni-app';
  import { ref, computed, watch, onMounted, onUnmounted } from 'vue';
  import {
    useRoomState, RoomType,
    useRoomParticipantState, RoomParticipantRole, DeviceStatus,
  } from '@/uni_modules/tuikit-atomic-x/state';
  import { useLoginState } from '@/uni_modules/tuikit-atomic-x/state/LoginState';
  import { useRoomTips } from '@/uni_modules/tuikit-atomic-x/hooks/useRoomTips';
  import { resolveEnterFailure } from '@/uni_modules/tuikit-atomic-x/utils/roomErrorHandler';
  import { showToast } from '@/uni_modules/tuikit-atomic-x/utils/toast';
  import { t } from '../locales';
  import { RoomView } from '@/uni_modules/tuikit-atomic-x/components';
  import SpeakerButton from './components/device/SpeakerButton/index.nvue';
  import SwitchCameraButton from './components/device/SwitchCameraButton/index.nvue';
  import RoomInfo from './components/summary/RoomInfo/index.nvue';
  import ExitButton from './components/control/ExitButton/index.nvue';
  import ScreenSharingPlaceholder from './components/device/ScreenSharingPlaceholder/index.nvue';
  import DeviceFailurePanel from './components/device/DeviceFailurePanel/index.nvue';
  import RecordingFloatingView from './components/recording/RecordingFloatingView/index.nvue';
  import RoomEnterPasswordSheet from './components/control/RoomEnterPasswordSheet/index.nvue';
  import ConfirmDialog from '@/uni_modules/tuikit-atomic-x/components/ConfirmDialog/ConfirmDialog.nvue';
  import ToolPanel from './components/control/ToolPanel/index.nvue';

  const ROOM_TOP_BAR_HEIGHT_PX = 53;
  const RECORDING_FLOAT_OFFSET_PX = 12;
  const ROOM_EXIT_DELAY_MS = 800;
  const ROUTE_FROM_SCHEDULE_DETAIL = 'scheduleDetail';
  const BACK_DELTA_PREVIOUS_PAGE = 1;
  const BACK_DELTA_SKIP_SCHEDULE_DETAIL = 2;

  const mode = ref<'create' | 'join' | 'accept'>('create');
  const roomID = ref<string>('');
  const roomName = ref<string>('');
  const routeFrom = ref<string>('');
  const autoEnableCamera = ref<boolean>(false);
  const autoEnableMicrophone = ref<boolean>(true);
  const autoEnableSpeaker = ref<boolean>(true);

  const roomState = useRoomState();
  const roomParticipantState = useRoomParticipantState();
  const { loginStatus } = useLoginState();
  const { localParticipant } = roomParticipantState;

  const systemInfo = ref<any>({});
  const exitBtnRef = ref<any>(null);
  const toolPanelRef = ref<any>(null);

  watch(
    () => loginStatus.value,
    (newStatus: number, oldStatus: number) => {
      if (oldStatus === 1 && newStatus === 3) {
        showDialog({
          key: 'replaced-by-another-device',
          title: t('RoomNotifications.Title'),
          content: t('RoomNotifications.ReplacedByAnotherDevice'),
          closeOnClickMask: false,
          onConfirm: () => leaveRoom(),
          onCancel: () => leaveRoom(),
        });
      }
    }
  );

  const isOwner = computed(() => localParticipant.value?.role === RoomParticipantRole.Owner);

  const isLocalScreenSharing = computed(() => localParticipant.value?.screenShareStatus === DeviceStatus.ON);

  const passwordSheetRef = ref<any>(null);

  const { dialogState: tipsDialogRef, showDialog } = useRoomTips({
    onExitConfirmed: () => leaveRoom(),
  });

  function notifyEnterFailed(e: any, isCreate: boolean): void {
    const failure = resolveEnterFailure(e, isCreate);
    if (failure.asToast) {
      showToast({ message: failure.message, type: 'error' });
      leaveRoom(ROOM_EXIT_DELAY_MS);
      return;
    }
    showDialog({
      key: 'enter-failed',
      title: failure.title,
      content: failure.message,
      confirmButton: t('RoomCommon.GotIt'),
      closeOnClickMask: false,
      onConfirm: () => leaveRoom(),
      onCancel: () => leaveRoom(),
    });
  }

  onBackPress((option) => {
    if (toolPanelRef.value?.isChatPanelOpen === true) {
      toolPanelRef.value?.closeChatPanel();
      return true;
    }
    if (option.from === 'backbutton') {
      exitBtnRef.value?.showExit();
      return true;
    }
    return false;
  });

  async function createOrEnterRoom() {
    if (mode.value === 'create') {
      try {
        await roomState.createAndJoinRoom({
          roomID: roomID.value,
          roomType: RoomType.Standard,
          options: {
            roomName: roomName.value || `Room ${roomID.value}`,
          },
        });
      } catch (e) {
        notifyEnterFailed(e, true);
        return;
      }
      await roomParticipantState.getParticipantList({ cursor: '' }).catch(() => {});
    } else {
      await tryJoinRoom();
    }
  }

  function tryJoinRoom(): void {
    passwordSheetRef.value?.enterWithPassword();
  }

  function leaveRoom(delayMs = 0): void {
    toolPanelRef.value?.closeChatPanel();
    if (delayMs > 0) {
      setTimeout(navigateBack, delayMs);
      return;
    }
    navigateBack();
  }

  function navigateBack() {
    const delta =
      routeFrom.value === ROUTE_FROM_SCHEDULE_DETAIL
        ? BACK_DELTA_SKIP_SCHEDULE_DETAIL
        : BACK_DELTA_PREVIOUS_PAGE;
    uni.navigateBack({
      delta,
      fail: () => {
        uni.redirectTo({ url: '/pages/scenes/room/index' });
      },
    });
  }

  onLoad((options: any) => {
    const safeDecode = (value: any): string => {
      const rawValue = (value || '').toString();
      try {
        return decodeURIComponent(rawValue);
      } catch (_) {
        return rawValue;
      }
    };

    if (options?.mode === 'join') mode.value = 'join';
    else if (options?.mode === 'accept') mode.value = 'accept';
    else mode.value = 'create';
    roomID.value = safeDecode(options?.roomID);
    roomName.value = safeDecode(options?.roomName);
    routeFrom.value = safeDecode(options?.from);
    autoEnableCamera.value = options?.autoEnableCamera === '1';
    autoEnableMicrophone.value = options?.autoEnableMicrophone !== '0';
    autoEnableSpeaker.value = options?.autoEnableSpeaker !== '0';
  });

  onMounted(() => {
    uni.setKeepScreenOn({ keepScreenOn: true });
    uni.getSystemInfo({
      success: (res: any) => { systemInfo.value = res; },
    });

    if (!roomID.value) {
      console.warn('[room] missing roomID, back to room index');
      leaveRoom(ROOM_EXIT_DELAY_MS);
      return;
    }

    createOrEnterRoom();
  });

  onUnmounted(() => {
    uni.setKeepScreenOn({ keepScreenOn: false });
  });
</script>

<style lang="scss">
  @import './meeting.scss';
</style>
