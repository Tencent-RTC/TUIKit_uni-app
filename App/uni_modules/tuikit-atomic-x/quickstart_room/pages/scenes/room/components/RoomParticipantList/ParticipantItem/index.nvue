<template>
  <view class="member-row" @tap="onPress">
    <view class="avatar-wrap">
      <image
        class="avatar-img"
        :src="avatarSrc"
        mode="aspectFill"
      />
    </view>

    <view class="user-info">
      <view class="name-row">
        <text class="name-text" :numberOfLines="1">{{ displayName }}</text>
        <text v-if="isLocal" class="me-tag">（我）</text>
      </view>

      <view v-if="badgeConfig" class="badge-row">
        <image
          class="badge-icon"
          :src="badgeConfig.icon"
          mode="aspectFit"
        />
        <text
          class="badge-text"
          :style="{ color: badgeConfig.color }"
        >{{ badgeConfig.text }}</text>
      </view>
    </view>

    <view v-if="type === 'participant'" class="status-icons">
      <image
        v-if="participant?.screenShareStatus === DeviceStatus.ON && !isWebinar"
        class="status-icon"
        src="/static/images/room/room_screen_share_icon.png"
        mode="aspectFit"
      />
      <image
        class="status-icon"
        :src="micIconSrc"
        mode="aspectFit"
      />
      <image
        v-if="!isWebinar"
        class="status-icon"
        :src="cameraIconSrc"
        mode="aspectFit"
      />
    </view>

    <!-- 未进房右侧 action：呼叫 / 取消（与 person 操作互斥，按钮自带 tap.stop 不冒泡） -->
    <view v-else-if="type === 'notJoined'" class="action-area">
      <text v-if="isCalling" class="calling-tag">呼叫中</text>
      <text v-else-if="isRejected" class="rejected-tag">暂不入会</text>
      <view v-else class="action-btn action-btn-call" @tap.stop="emit('call')">
        <text class="action-btn-text-call">呼叫</text>
      </view>
    </view>
  </view>
</template>

<script setup lang="ts">
  import { computed } from 'vue';
  import type { PropType } from 'vue';
  import type { RoomUser } from '@/uni_modules/tuikit-atomic-x/types';
  import type { RoomParticipant } from '@/uni_modules/tuikit-atomic-x/types';
  import { DeviceStatus, RoomParticipantRole } from '@/uni_modules/tuikit-atomic-x/state';

  const props = defineProps({
    type: { type: String as PropType<'participant' | 'audience' | 'notJoined'>, required: true },
    participant: { type: Object as PropType<RoomParticipant | null>, default: null },
    audience: { type: Object as PropType<RoomUser | null>, default: null },
    /**
     * 未进房专用的 RoomUser（type='notJoined' 时必传，其他类型可为空）。
     * 用单独 prop 而不是塞进 audience，是为了类型清晰，避免误用 audience 上下文。
     */
    notJoinedUser: { type: Object as PropType<RoomUser | null>, default: null },
    isAdmin: { type: Boolean, default: false },
    isLocal: { type: Boolean, default: false },
    canControl: { type: Boolean, default: false },
    isWebinar: { type: Boolean, default: false },
    /**
     * 该用户是否正在被我呼叫中（用于切「呼叫」→「取消」按钮 + 显示「呼叫中」徽标）。
     * 仅对 type='notJoined' 有效。
     */
    isCalling: { type: Boolean, default: false },
    /**
     * 该用户刚拒绝了我的呼叫（显示「暂不入会」徽标，由父组件 3s 后自动清除）。
     * 仅对 type='notJoined' 有效。
     */
    isRejected: { type: Boolean, default: false },
  });

  const emit = defineEmits<{
    (e: 'press'): void
    (e: 'call'): void         // 未进房：发起呼叫
    (e: 'cancelCall'): void   // 未进房：取消呼叫
  }>();

  const user = computed<RoomParticipant | RoomUser | null>(() => {
    if (props.type === 'participant') return props.participant;
    if (props.type === 'audience') return props.audience;
    return props.notJoinedUser;
  });

  const displayName = computed(() => {
    const u = user.value;
    if (!u) return '';
    const nameCard = (u as RoomParticipant).nameCard;
    return nameCard || u.userName || u.userID || '';
  });

  const avatarSrc = computed(() => user.value?.avatarURL || '/static/images/room/room_default_avatar.png');

  const micIconSrc = computed(() =>
    props.participant?.microphoneStatus === DeviceStatus.ON
      ? '/static/images/room/room_user_mic_on.png'
      : '/static/images/room/room_user_mic_off.png',
  );

  const cameraIconSrc = computed(() =>
    props.participant?.cameraStatus === DeviceStatus.ON
      ? '/static/images/room/room_user_camera_on.png'
      : '/static/images/room/room_user_camera_off.png',
  );

  type BadgeConfig = { icon: string; color: string; text: string };
  const badgeConfig = computed<BadgeConfig | null>(() => {
    let role: 'owner' | 'admin' | 'none' = 'none';
    if (props.type === 'participant') {
      const r = props.participant?.role;
      if (r === RoomParticipantRole.Owner) role = 'owner';
      else if (r === RoomParticipantRole.Admin) role = 'admin';
    } else if (props.isAdmin) {
      role = 'admin';
    }

    if (role === 'owner') {
      return {
        icon: '/static/images/room/room_owner_icon.png',
        color: '#1C66E5',
        text: '房主',
      };
    }
    if (role === 'admin') {
      return {
        icon: '/static/images/room/room_administrator_icon.png',
        color: '#FF7200',
        text: '管理员',
      };
    }
    return null;
  });

  function onPress() {
    if (!props.canControl) return;
    emit('press');
  }
</script>

<style>
  .member-row {
    flex-direction: row;
    align-items: center;
    height: 100rpx;
    padding-left: 32rpx;
    padding-right: 32rpx;
    margin-bottom: 20rpx;
  }

  .avatar-wrap {
    width: 80rpx;
    height: 80rpx;
    border-radius: 40rpx;
    background-color: #2A2D38;
  }

  .avatar-img {
    width: 80rpx;
    height: 80rpx;
    border-radius: 40rpx;
  }

  .user-info {
    flex: 1;
    margin-left: 24rpx;
    flex-direction: column;
    justify-content: center;
  }

  .name-row {
    flex-direction: row;
    align-items: center;
  }

  .name-text {
    color: #D5E0F2;
    font-size: 32rpx;
    lines: 1;
    text-overflow: ellipsis;
    max-width: 380rpx;
  }

  .me-tag {
    color: #D5E0F2;
    font-size: 28rpx;
    margin-left: 8rpx;
  }

  .badge-row {
    flex-direction: row;
    align-items: center;
    margin-top: 4rpx;
  }

  .badge-icon {
    width: 28rpx;
    height: 28rpx;
    margin-right: 4rpx;
  }

  .badge-text {
    font-size: 24rpx;
  }

  .status-icons {
    flex-direction: row;
    align-items: center;
    margin-left: 24rpx;
  }

  .status-icon {
    width: 40rpx;
    height: 40rpx;
    margin-left: 40rpx;
  }

  /* ── 未进房：呼叫中徽标 + 呼叫/取消按钮 ── */
  .calling-tag {
    color: #D5E0F2;
    font-weight: 400;
    font-size: 28rpx;
    padding: 4rpx 10rpx;
  }

  .rejected-tag {
    color: #D5E0F2;
    font-weight: 400;
    font-size: 28rpx;
    padding: 4rpx 10rpx;
  }

  .action-area {
    flex-direction: row;
    align-items: center;
    margin-left: 24rpx;
  }

  /* 呼叫：实心蓝 */
  .action-btn-call {
    background-color: #6B758A;
    justify-content: center;
    align-items: center;
    padding: 8rpx 20rpx;
    border-radius: 12rpx;
  }

  .action-btn-text-call {
    color: #D5E0F2;
    font-weight: 400;
    font-size: 28rpx;
    line-height: 40rpx;
  }
</style>
