<template>
  <view class="bottom-btn" @tap="handleTap">
    <view class="bottom-icon-box">
      <image
        class="bottom-icon"
        :src="iconSrc"
        mode="aspectFit"
      />
      <text class="bottom-text">聊天</text>
    </view>
    <view v-if="displayUnreadCount.length > 0" class="unread-badge">
      <text class="unread-badge-text">{{ displayUnreadCount }}</text>
    </view>
  </view>
</template>

<script setup lang="ts">
  import { ref, computed, watch, onUnmounted } from 'vue';
  import { useMessageListState } from '@/uni_modules/tuikit-atomic-x/state';
  import type { MessageEvent, MessageInfo } from '@/uni_modules/tuikit-atomic-x/types/message';

  // ==================== Props / Emits ====================
  const props = withDefaults(defineProps<{
    roomID?: string;
    isChatPanelOpen?: boolean;
  }>(), {
    roomID: '',
    isChatPanelOpen: false,
  });

  const emit = defineEmits<{
    (e: 'click', payload: { roomID: string }): void;
  }>();

  const iconSrc = '/static/images/room/room_chat.png';

  const messageListState = ref<any>(null);
  const unreadCount = ref<number>(0);
  let unsubscribeMessage: (() => void) | null = null;

  const ensureMessageListState = (): void => {
    const rid = props.roomID ?? '';
    if (rid.length === 0) {
      messageListState.value = null;
      return;
    }
    const targetID = `group_${rid}`;
    if (messageListState.value?.conversationID === targetID) {
      return;
    }
    // 订阅上一实例前先清理
    if (unsubscribeMessage != null) {
      unsubscribeMessage();
      unsubscribeMessage = null;
    }
    const mlState = useMessageListState({ conversationID: targetID });
    messageListState.value = mlState;
    unsubscribeMessage = mlState.messageListOnEvent((event: MessageEvent) => {
      if (event.eventType !== 'OnReceiveNewMessage') return;
      const message: MessageInfo = event.data.message;
      if (message.isSentBySelf || props.isChatPanelOpen) return;
      unreadCount.value += 1;
    });
  };

  const initUnread = async (): Promise<void> => {
    if (props.roomID?.length === 0) {
      unreadCount.value = 0;
      messageListState.value = null;
      return;
    }
    ensureMessageListState();
  };

  watch(
    () => props.isChatPanelOpen,
    (isOpen: boolean) => {
      if (isOpen === false) {
        unreadCount.value = 0;
      }
    }
  );

  watch(
    () => props.roomID,
    () => initUnread(),
    { immediate: true }
  );

  onUnmounted(() => {
    if (unsubscribeMessage != null) {
      unsubscribeMessage();
      unsubscribeMessage = null;
    }
    messageListState.value = null;
  });

  // ==================== 角标显示 ====================
  // 0 不显示，>99 显示 99+
  const displayUnreadCount = computed<string>(() => {
    const count = unreadCount.value;
    if (count <= 0) return '';
    if (count > 99) return '99+';
    return String(count);
  });

  function handleTap(): void {
    if (props.roomID.length === 0) return;
    emit('click', { roomID: props.roomID });
  }
</script>

<style>
  .bottom-btn {
    position: relative;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    /* nvue 默认 overflow: hidden，角标超出父容器会被裁剪，显式 visible */
    overflow: visible;
  }

  .bottom-icon-box {
    position: relative;
    width: 104rpx;
    height: 104rpx;
    border-radius: 20rpx;
    background-color: #2A2D38;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    /* nvue (weex) view 默认 overflow: hidden，角标 top:-8rpx right:-8rpx 会超出父容器被裁剪
       显式声明 overflow: visible 让角标完整显示 */
    overflow: visible;
  }

  .bottom-icon {
    width: 48rpx;
    height: 48rpx;
  }

  .bottom-text {
    color: #FFFFFF;
    font-size: 20rpx;
    margin-top: 6rpx;
    lines: 1;
    text-overflow: ellipsis;
  }

  /* 未读数角标：右上角绝对定位 */
  .unread-badge {
    position: absolute;
    top: 8rpx;
    right: 10rpx;
    min-width: 32rpx;
    height: 32rpx;
    padding: 0 4rpx;
    border-radius: 16rpx;
    background-color: #FF3B30;
    justify-content: center;
    align-items: center;
  }

  .unread-badge-text {
    color: #FFFFFF;
    font-size: 20rpx;
    line-height: 32rpx;
    text-align: center;
  }
</style>
