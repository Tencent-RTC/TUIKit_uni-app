// ================= AlbumPicker: showAlbumPicker / hideAlbumPicker ====================

/**
 * Show album picker with session isolation
 */
@UTSJS.keepAlive
export function showAlbumPicker(
  configJSON: string, themeJSON: string, sessionId: string, onPickConfirm: (jsonStr: string) => void,
  onMediaProcessing: (jsonStr: string) => void, onMediaProcessed: () => void, onCancel: () => void): void {
  DispatchQueue.main.async(execute = (): void => {
    console.log("showAlbumPicker called, sessionId: " + sessionId);
    const vc = UTSiOS.getCurrentViewController();
    AlbumPickerManager.shared.show( configJSON, themeJSON, sessionId = sessionId, viewController = vc,
      onPickConfirm = onPickConfirm, onMediaProcessing = onMediaProcessing,
      onMediaProcessed = onMediaProcessed, onCancel = onCancel)
  });
}

