// ================= LogUpload: 日志导出 ====================

/**
 * 获取日志文件列表
 * @returns 日志文件列表 JSON 字符串，格式: [{ "fileName": string, "filePath": string }]
 */
export function fetchLogFileList(): string {
  const fileModels = LogUpload.shared.fetchLogfileList()
  let result: UTSJSONObject[] = []
  for (let i = 0; i < Int(fileModels.count); i++) {
    const model = fileModels[Int(i)]
    const item: UTSJSONObject = { "fileName": model.fileName, "filePath": model.filePath }
    result.push(item)
  }
  return JSON.stringify(result) ?? "[]"
}

/**
 * 分享指定索引的日志文件（弹出系统分享面板）
 * @param row 日志文件在列表中的索引
 */
export function shareLog(row: number) {
  DispatchQueue.main.async(execute = (): void => {
    console.log("shareLog called, row:", row)
    LogUpload.shared.shareLog(Int(row))
  })
}

// ================= Engine Bridge =================

type BridgeObserverCallback = (eventName: string, jsonData: string) => void;

const bridgeObservers = new Map<string, BridgeObserverCallback>();
let nativeBridgeToken: NSNumber | null = null;

export function invokeEngineBridgeApi(
  api: string,
  params: string,
  callback: (code: number, message: string, data: string) => void
) {
  DispatchQueue.main.async(execute = (): void => {
    EngineBridgeFacade.shared.invoke(api, params, (code: NSNumber, message: string, data: string): void => {
      callback(code as number, message, data);
    });
  });
}

@UTSJS.keepAlive
export function addEngineBridgeObserver(listenerID: string, callback: BridgeObserverCallback) {
  DispatchQueue.main.async(execute = (): void => {
    if (nativeBridgeToken == null) {
      const token = EngineBridgeFacade.shared.addObserver((eventName: string, jsonData: string): void => {
        bridgeObservers.forEach((cb: BridgeObserverCallback, lid: string) => {
          try {
            cb(eventName, jsonData);
          } catch (e) {
            console.error(`EngineBridge observer dispatch error (${lid}):`, e);
          }
        });
      });
      nativeBridgeToken = token;
    }
    bridgeObservers.set(listenerID, callback);
  });
}

export function removeEngineBridgeObserver(listenerID: string) {
  DispatchQueue.main.async(execute = (): void => {
    bridgeObservers.delete(listenerID);
    if (bridgeObservers.size === 0 && nativeBridgeToken != null) {
      EngineBridgeFacade.shared.removeObserver(nativeBridgeToken!);
      nativeBridgeToken = null;
    }
  });
}
