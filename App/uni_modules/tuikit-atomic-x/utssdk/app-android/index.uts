// ================= Engine Bridge =================

type BridgeObserverCallback = (eventName: string, jsonData: string) => void;

const bridgeObservers = new Map<string, BridgeObserverCallback>();
let nativeBridgeObserver: EngineBridge.Observer | null = null;

export function invokeEngineBridgeApi(
  api: string,
  params: string,
  callback: (code: number, message: string, data: string) => void
) {
  UTSAndroid.getDispatcher("main").async(function (_) {
    EngineBridge.invoke(api, params, new (class implements EngineBridge.ResultCallback {
      override onResult(code: Int, message: String, data: String) {
        callback(code.toInt(), message != null ? (message as string) : "", data != null ? (data as string) : "");
      }
    }));
  }, null)
}

@UTSJS.keepAlive
export function addEngineBridgeObserver(listenerID: string, callback: BridgeObserverCallback) {
  UTSAndroid.getDispatcher("main").async(function (_) {
    if (nativeBridgeObserver == null) {
      const observer = new (class implements EngineBridge.Observer {
        override onEvent(eventName: String, jsonData: String) {
          const evt = eventName as string;
          const data = jsonData != null ? (jsonData as string) : "";
          bridgeObservers.forEach((cb: BridgeObserverCallback, lid: string) => {
            try {
              cb(evt, data);
            } catch (e) {
              console.error(`EngineBridge observer dispatch error (${lid}):`, e);
            }
          });
        }
      });
      nativeBridgeObserver = observer;
      EngineBridge.addObserver(observer);
    }
    bridgeObservers.set(listenerID, callback);
  }, null)
}

export function removeEngineBridgeObserver(listenerID: string) {
  UTSAndroid.getDispatcher("main").async(function (_) {
    bridgeObservers.delete(listenerID);
    if (bridgeObservers.size === 0 && nativeBridgeObserver != null) {
      EngineBridge.removeObserver(nativeBridgeObserver!);
      nativeBridgeObserver = null;
    }
  }, null)
}
