<template>
  <view class="page-container">
    <CustomNavbar
      position="fixed"
      :title="navigationTitle"
      :showBack="true"
      :showMenu="true"
      @back="onNavBack"
      @menuSelect="onNavMenuSelect"
    />
    
    <view
      class="message-list-container"
      :style="{ paddingBottom: messageListBottomPx + 'px' }"
      @tap="closeSoftKeyboard"
    >
      <MessageList
        v-if="conversationID"
        ref="messageListRef"
        :conversationID="conversationID"
        :locateMessage="locateMessage"
        :inputToolbarHeight="inputToolbarHeight"
        :inputPanelHeight="inputPanelHeight"
        :multiSelectTitle="navigationTitle"
        @onMessageListTap="closeSoftKeyboard"
        @onMultiSelectModeChange="onMultiSelectModeChange"
      />
    </view>
    
    <MessageInput
      v-if="conversationID && !isMultiSelectMode"
      ref="messageInputRef"
      :conversationID="conversationID"
      :setOfflinePushInfo="setOfflinePushInfo"
      @height-change="onMessageInputHeightChange"
    />
  </view>
</template>

<script setup lang="ts">
import { ref, computed } from 'vue'
import { onLoad, onShow, onBackPress } from '@dcloudio/uni-app'
import MessageList from '@/uni_modules/tuikit-atomic-x/components/MessageList/MessageList.nvue'
import MessageInput, { DEFAULT_TOOLS } from '@/uni_modules/tuikit-atomic-x/components/MessageInput/MessageInput.nvue'
import CustomNavbar from '@/uni_modules/tuikit-atomic-x/components/CustomNavbar/CustomNavbar.nvue'
import { useConversationListState } from '@/uni_modules/tuikit-atomic-x/state/ConversationListState'
import { useGroupState } from '@/uni_modules/tuikit-atomic-x/state/GroupState'
import { useLoginState } from '@/uni_modules/tuikit-atomic-x/state/LoginState'
import { MessageType } from '@/uni_modules/tuikit-atomic-x/types/message'
import type { OfflinePushContext, OfflinePushInfo } from '@/uni_modules/tuikit-atomic-x/types/message'

// ==================== State ====================
const {
  joinedGroupList,
  loadJoinedGroups,
} = useGroupState();
const { loginUserInfo } = useLoginState();

// ==================== 状态 ====================
const conversationID = ref('')
const locateMessage = ref(null)
const isInGroup = ref(false)
const messageInputRef = ref(null)
const messageListRef = ref(null)
const inputToolbarHeight = ref(0)
const inputPanelHeight = ref(0)
const isMultiSelectMode = ref(false)

// 多选底部操作栏高度（px），与 MessageList 内 .msg-list__multi-bar 的实际高度保持一致
// （padding 32rpx + 图标 80rpx + 间距 12rpx + 文字 32rpx + padding 60rpx = 216rpx）
const MULTI_SELECT_BAR_HEIGHT_RPX = 216
const messageListBottomPx = computed(() => {
  if (!isMultiSelectMode.value) return inputToolbarHeight.value
  return uni.upx2px(MULTI_SELECT_BAR_HEIGHT_RPX)
})

const { getConversationInfo, conversationList } = useConversationListState('chat')

// ==================== 计算属性 ====================
const isC2CConversation = computed(() => conversationID.value.startsWith('c2c_'))

const currentConversation = computed(() => 
  conversationList.value.find(conv => conv.conversationID === conversationID.value)
)

const navigationTitle = computed(() => currentConversation.value?.title || '聊天')

// ==================== 导航栏 ====================
const onNavBack = () => uni.navigateBack()

const onNavMenuSelect = () => {
  if (!isC2CConversation.value) {
    isInGroup.value
      = joinedGroupList.value.some(group => group.groupID === conversationID.value?.replace('group_', ''));
    if (!isInGroup.value) {
      uni.showToast({ title: '您已不在群内，无法进行此操作', icon: 'none' })
      return;
    }
  }
  uni.navigateTo({
    url: `/pages/scenes/chat/chatSetting/index?conversationID=${conversationID.value}&showType=0`
  });
}

// ==================== 输入框 ====================
const onMessageInputHeightChange = ({ inputToolbarHeight: toolbar, inputPanelHeight: panel }) => {
  inputToolbarHeight.value = toolbar
  inputPanelHeight.value = panel
}

const closeSoftKeyboard = () => messageInputRef.value?.collapse()

// 多选模式：输入框被底部操作栏取代；进入多选前先收起键盘 / 面板，并清零输入区高度
const onMultiSelectModeChange = (isOn) => {
  if (isOn) {
    closeSoftKeyboard()
    inputToolbarHeight.value = 0
    inputPanelHeight.value = 0
  }
  isMultiSelectMode.value = isOn
}

// ==================== 离线推送 ====================
const setOfflinePushInfo = (ctx: OfflinePushContext): OfflinePushInfo | null => {
  // 群组会话用群名；C2C 会话用当前登录用户的昵称（消息发送者本人），fallback userID
  const title = isC2CConversation.value
    ? (loginUserInfo.value?.nickname || loginUserInfo.value?.userID || '新消息')
    : (currentConversation.value?.title || '新消息')
  const conv = ctx.conversationID

  let description = '[新消息]'
  switch (ctx.messageType) {
    case MessageType.TEXT:
      description = (ctx.messagePayload as { text?: string })?.text || '[文本消息]'
      break
    case MessageType.IMAGE:
      description = '[图片]'
      break
    case MessageType.VIDEO:
      description = '[视频]'
      break
    case MessageType.AUDIO:
      description = '[语音]'
      break
    case MessageType.FILE:
      description = '[文件]'
      break
    case MessageType.CUSTOM:
      return null
    default:
      return null
  }

  return {
    title,
    description,
    extensionInfo: {
      ext: JSON.stringify({
        conversationID: conv,
        messageType: ctx.messageType,
      })
    },
  }
}

// ==================== 生命周期 ====================
onLoad((options) => {
  if (!options.conversationID) {
    console.error('未接收到 conversationID 参数')
    return
  }
  
  conversationID.value = options.conversationID
  getConversationInfo(conversationID.value);
  loadJoinedGroups();
  
  // 处理定位消息
  if (uni.$locateMessage) {
    locateMessage.value = uni.$locateMessage
    uni.$locateMessage = null
  }
})

onShow(() => getConversationInfo(conversationID.value))

// 多选模式下，系统返回键先退出多选，而不是离开页面
onBackPress(() => {
  if (!isMultiSelectMode.value) return false
  messageListRef.value?.exitMultiSelect()
  return true
})
</script>

<style>
.page-container {
  flex: 1;
  flex-direction: column;
  background-color: #F9FAFC;
}

.message-list-container {
  flex: 1;
  flex-direction: column;
  background-color: #F9FAFC;
}
</style>
