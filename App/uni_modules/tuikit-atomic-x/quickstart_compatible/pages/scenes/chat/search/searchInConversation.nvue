<template>
  <view class="search-page" :style="{ paddingTop: statusBarHeight + 'px' }">
    <Search ref="searchRef" :conversationID="conversationID" :initialKeyword="initialKeyword" :initialOption="initialOption"
      :placeholder="'搜索聊天记录'" :showCancel="true" :debounceTime="300"
      @search="handleSearch" @cancel="handleCancel" @resultItemClick="handleResultItemClick" />
  </view>
</template>

<script>
import Search from '@/uni_modules/tuikit-atomic-x/components/Search/Search.nvue'
import { useMessageListState } from '@/uni_modules/tuikit-atomic-x/state/MessageListState'
import { MessageLoadDirection } from '@/uni_modules/tuikit-atomic-x/types/message'
export default {
  components: { Search },
  data() {
    return { conversationID: '', initialKeyword: '', initialOption: {}, statusBarHeight: uni.getSystemInfoSync().statusBarHeight || 0 }
  },
  onLoad(options) {
    if (options.conversationID) this.conversationID = options.conversationID
    if (options.keyword) this.initialKeyword = decodeURIComponent(options.keyword)
    if (options.option) { try { this.initialOption = JSON.parse(decodeURIComponent(options.option)) } catch(e) {} }
  },
  methods: {
    handleSearch(keyword, option) {},
    handleCancel() { uni.navigateBack() },
    handleResultItemClick(type, data) {
      if (type === 'message') {
        uni.$locateMessage = data
        // 预创建 MessageList store，与导航动画并行。
        //
        // ★ 必须传 initialLoadOption 做定位拉取：本路径的目标是某条历史消息，
        // 若按默认拉最新 20 条，目标消息大概率不在其中 —— chat 页落地后 MessageList
        // 仍要再发一次定位拉取，预创建就只省下 createStore + bindEvent。
        // 传 cursor + BOTH 让首次拉取直接命中目标消息所在的那批。
        useMessageListState({
          conversationID: this.conversationID,
          initialLoadOption: {
            cursor: data,
            direction: MessageLoadDirection.BOTH,
            pageCount: 20
          }
        })
        uni.navigateTo({ url: '/pages/scenes/chat/chat/index?conversationID=' + this.conversationID })
      }
    },
  },
}
</script>

<style>
.search-page { flex: 1; background-color: #ffffff; }
</style>
