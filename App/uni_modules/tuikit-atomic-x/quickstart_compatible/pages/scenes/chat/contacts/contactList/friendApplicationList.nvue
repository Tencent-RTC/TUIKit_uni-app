<template>
	<view class="page">
		<CustomNavbar title="新的联系人" :showBack="true" @back="handleBack" />
		<view class="page-content"><FriendApplicationList @itemClick="handleItemClick" @accept="handleAccept" @reject="handleReject" /></view>
	</view>
</template>

<script>
import CustomNavbar from '@/uni_modules/tuikit-atomic-x/components/CustomNavbar/CustomNavbar.nvue'
import { FriendApplicationList } from '@/uni_modules/tuikit-atomic-x/components/Contact'
export default {
  components: { CustomNavbar, FriendApplicationList },
  methods: {
    handleBack() { uni.navigateBack({ delta: 1 }) },
    handleItemClick(item) {
      uni.$contactInfoData = { applicationInfo: item }
      uni.navigateTo({ url: '/pages/scenes/chat/contacts/contactInfo/index?type=newContact' })
    },
    handleAccept(item) { uni.navigateBack() },
    handleReject(item) { uni.navigateBack() },
  },
}
</script>

<style>
.page { flex: 1; background-color: #f5f5f5; }
.page-content { flex: 1; }
</style>
