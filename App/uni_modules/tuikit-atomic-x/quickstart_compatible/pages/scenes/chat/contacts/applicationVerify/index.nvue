<template>
	<view class="application-verify-page">
		<CustomNavbar :title="navTitle" :showBack="true" @back="handleBack" />
		<view class="page-content">
			<ApplicationVerify :type="type" :userInfo="userInfo" :groupInfo="groupInfo" @success="handleSuccess" @fail="handleFail" />
		</view>
	</view>
</template>

<script>
import { ApplicationVerify } from '@/uni_modules/tuikit-atomic-x/components/Contact/ContactInfo'
import CustomNavbar from '@/uni_modules/tuikit-atomic-x/components/CustomNavbar/CustomNavbar.nvue'
export default {
  components: { ApplicationVerify, CustomNavbar },
  data() { return { type: 'friend', userInfo: null, groupInfo: null } },
  computed: {
    navTitle() { return this.type === 'friend' ? '申请添加好友' : '申请加入群聊' },
  },
  mounted() {
    var pages = getCurrentPages()
    var currentPage = pages[pages.length - 1]
    var options = (currentPage.$page && currentPage.$page.options) || currentPage.options || {}
    if (options.type) this.type = options.type
    // 全局变量方式（同步）
    if (uni.$verifyData) {
      if (uni.$verifyData.userInfo) this.userInfo = uni.$verifyData.userInfo
      if (uni.$verifyData.groupInfo) this.groupInfo = uni.$verifyData.groupInfo
      if (uni.$verifyData.type) this.type = uni.$verifyData.type
      uni.$verifyData = null
    }
  },
  methods: {
    handleBack() { uni.navigateBack({ delta: 1 }) },
    handleSuccess(type, data) {
      var index = type === 'friend' ? 2 : 1
      setTimeout(function() { uni.navigateBack({ delta: index }) }, 1500)
    },
    handleFail(type, error) { console.error('申请发送失败:', error) },
  },
}
</script>

<style>
.application-verify-page { flex: 1; background-color: #f5f5f5; }
.page-content { flex: 1; }
</style>
