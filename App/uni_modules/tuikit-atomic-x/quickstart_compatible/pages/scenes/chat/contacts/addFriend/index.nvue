<template>
	<view class="add-friend-page">
		<CustomNavbar title="添加好友" :showBack="true" @back="handleBack" />
		<view class="page-content"><AddFriend @userSelect="handleUserSelect" /></view>
	</view>
</template>

<script>
import AddFriend from '@/uni_modules/tuikit-atomic-x/components/Contact/AddFriend.nvue'
import CustomNavbar from '@/uni_modules/tuikit-atomic-x/components/CustomNavbar/CustomNavbar.nvue'
export default {
  components: { AddFriend, CustomNavbar },
  methods: {
    handleBack() { uni.navigateBack({ delta: 1 }) },
    handleUserSelect(user) {
      if (!user.isFriend) {
        uni.$contactInfoData = { userInfo: user }
        uni.navigateTo({ url: '/pages/scenes/chat/contacts/contactInfo/index?type=addFriend' })
      } else {
        uni.$contactInfoData = { friendInfo: user }
        uni.navigateTo({ url: '/pages/scenes/chat/contacts/contactInfo/index?type=friend' })
      }
    },
  },
}
</script>

<style>
.add-friend-page { flex: 1; background-color: #f5f5f5; }
.page-content { flex: 1; }
</style>
