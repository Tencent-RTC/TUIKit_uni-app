
import { ref, type Ref } from "vue";
import type { HybridListenerOptions } from "@/uni_modules/tuikit-atomic-x";
import type { HybridCallOptions } from "./hybridCallOptions.uts";
import { callAPI, addListener, removeListener } from "@/uni_modules/tuikit-atomic-x";
import type {
  MediaQuality as MediaQualityType,
} from "../types/message";
import { MediaQuality } from "../types/message";

/**
 * 桥接响应（参照 atomicx HybridResponse data class）
 */
type HybridResponse = {
  api: string | null;
  code: number;
  message: string | null;
  data: any | null;
};

/**
 * 桥接响应默认值
 */
const DEFAULT_HYBRID_RESPONSE: HybridResponse = {
  api: null,
  code: -1,
  message: null,
  data: null
};

type DataPayload = UTSJSONObject;

/**
 * 模块级单例缓存
 */
const InstanceMap: Map<string, MessageActionState> = new Map<string, MessageActionState>();

/**
 * 消息操作状态管理类
 */
class MessageActionState {
  public readonly instanceId: string;
  public readonly message: UTSJSONObject;

  /** 已读成员列表（**新增**） */
  public readonly readMemberList: Ref<any[]>;
  /** 是否有更多已读成员 */
  public readonly hasMoreReadMembers: Ref<boolean>;
  /** 未读成员列表 */
  public readonly unreadMemberList: Ref<any[]>;
  /** 是否有更多未读成员 */
  public readonly hasMoreUnreadMembers: Ref<boolean>;
  /** 表情回应用户列表 */
  public readonly reactionUserList: Ref<any[]>;
  /** 是否有更多表情回应用户 */
  public readonly hasMoreReactionUsers: Ref<boolean>;

  private constructor(message: UTSJSONObject) {
    this.instanceId = MessageActionState.generateInstanceId(message);
    this.message = message;

    this.readMemberList = ref<any[]>([]);
    this.hasMoreReadMembers = ref<boolean>(false);
    this.unreadMemberList = ref<any[]>([]);
    this.hasMoreUnreadMembers = ref<boolean>(false);
    this.reactionUserList = ref<any[]>([]);
    this.hasMoreReactionUsers = ref<boolean>(false);

    this.createStore();
  }

  private createStore(): void {
    const options: HybridCallOptions = {
      api: "createStore",
      params: {
        createStoreParams: this.instanceId,
        message: JSON.stringify(this.message),
      },
    };

    callAPI(JSON.stringify(options), (response: string) => {
      try {
        const result = JSON.parse<HybridResponse>(response) ?? DEFAULT_HYBRID_RESPONSE;
        if (result.code == 0) {
          this.bindEvent();
        } else {
          const msg = result.message ?? 'unknown';
          console.error(`[${this.instanceId}][createStore] Failed: ${msg}`);
        }
      } catch (error: any) {
        const errMsg = error instanceof Error ? (error as Error).message : `${error}`;
        console.error(`[${this.instanceId}][createStore] Parse error: ${errMsg}`);
      }
    });
  }

  private static generateInstanceId(message: UTSJSONObject): string {
    return JSON.stringify({
      storeName: "MessageAction",
      message,
    });
  }

  public static getInstance(message: UTSJSONObject): MessageActionState {
    const instanceId = MessageActionState.generateInstanceId(message);
    if (!InstanceMap.has(instanceId)) {
      InstanceMap.set(instanceId, new MessageActionState(message));
    }
    return InstanceMap.get(instanceId) as MessageActionState;
  }

  /**
   * 绑定事件监听（订阅 6 个新字段）
   */
  private bindEvent(): void {
    const storeName = "MessageAction";

    const dataHandlers: Map<string, (result: any) => void> = new Map();
    dataHandlers.set("readMemberList", (r: any): void => {
      const rObj: UTSJSONObject = r as UTSJSONObject
      const rawList: any | null = rObj['readMemberList']
      if (rawList != null) {
        this.readMemberList.value = rawList as any[]
      }
    });
    dataHandlers.set("hasMoreReadMembers", (r: any): void => {
      const rObj: UTSJSONObject = r as UTSJSONObject
      this.hasMoreReadMembers.value = rObj['hasMoreReadMembers'] == true;
    });
    dataHandlers.set("unreadMemberList", (r: any): void => {
      const rObj: UTSJSONObject = r as UTSJSONObject
      const rawList: any | null = rObj['unreadMemberList']
      if (rawList != null) {
        this.unreadMemberList.value = rawList as any[]
      }
    });
    dataHandlers.set("hasMoreUnreadMembers", (r: any): void => {
      const rObj: UTSJSONObject = r as UTSJSONObject
      this.hasMoreUnreadMembers.value = rObj['hasMoreUnreadMembers'] == true;
    });
    dataHandlers.set("reactionUserList", (r: any): void => {
      const rObj: UTSJSONObject = r as UTSJSONObject
      const rawList: any | null = rObj['reactionUserList']
      if (rawList != null) {
        this.reactionUserList.value = rawList as any[]
      }
    });
    dataHandlers.set("hasMoreReactionUsers", (r: any): void => {
      const rObj: UTSJSONObject = r as UTSJSONObject
      this.hasMoreReactionUsers.value = rObj['hasMoreReactionUsers'] == true;
    });

    const dataNames: string[] = [
      "readMemberList",
      "hasMoreReadMembers",
      "unreadMemberList",
      "hasMoreUnreadMembers",
      "reactionUserList",
      "hasMoreReactionUsers",
    ];

    dataNames.forEach((dataName: string) => {
      const makeOptions = (name: string): HybridListenerOptions => {
        const opts: HybridListenerOptions = {
          type: "",
          store: storeName,
          name: name,
          params: { createStoreParams: this.instanceId },
        };
        return opts;
      };
      addListener(makeOptions(dataName), (data: string) => {
        try {
          const result = JSON.parse<DataPayload>(data);
          if (result != null) {
            const handler = dataHandlers.get(dataName);
            if (handler != null) {
              handler(result);
            }
          }
        } catch (error: any) {
          const errMsg = error instanceof Error ? (error as Error).message : `${error}`;
          console.error(`[${this.instanceId}][${dataName} listener] Error: ${errMsg}`);
        }
      });
    });
  }

  // ============================================================================
  // Actions
  // ============================================================================

  /**
   * 撤回消息（旧名 recallMessage）
   */
  revoke = async (): Promise<void> => {
    return new Promise((resolve, reject) => {
      const options: HybridCallOptions = {
        api: 'revoke',
        params: {
          createStoreParams: this.instanceId,
        },
      };

      callAPI(JSON.stringify(options), (data: string) => {
        try {
          const result = JSON.parse<HybridResponse>(data) ?? DEFAULT_HYBRID_RESPONSE;
          if (result.code == 0) {
            resolve();
          } else {
            const msg = result.message ?? 'revoke failed';
            reject(new Error(msg));
          }
        } catch (error: any) {
          const errMsg = error instanceof Error ? (error as Error).message : `${error}`;
          reject(new Error(errMsg));
        }
      });
    });
  };

  /**
   * 删除消息（单条；旧名 deleteMessage）
   */
