  /**
   * 下载媒体资源（**新增**）
   */
  downloadMedia = async (quality: MediaQualityType | null): Promise<void> => {
    return new Promise((resolve, reject) => {
      const params: UTSJSONObject = new UTSJSONObject()
      params['createStoreParams'] = this.instanceId
      if (quality != null) params['quality'] = quality

      const options: HybridCallOptions = {
        api: 'downloadMedia',
        params,
      };
      callAPI(JSON.stringify(options), (data: string) => {
        try {
          const result = JSON.parse<HybridResponse>(data) ?? DEFAULT_HYBRID_RESPONSE;
          if (result.code == 0) resolve();
          else {
            const msg = result.message ?? 'downloadMedia failed';
            reject(new Error(msg));
          }
        } catch (error: any) {
          const errMsg = error instanceof Error ? (error as Error).message : `${error}`;
          reject(new Error(errMsg));
        }
      });
    });
  };

  downloadMergedMessageList = async (): Promise<any[]> => {
    return new Promise((resolve, reject) => {
      const options: HybridCallOptions = {
        api: 'downloadMergedMessageList',
        params: {
          createStoreParams: this.instanceId,
        },
      };
      callAPI(JSON.stringify(options), (data: string) => {
        try {
          const result = JSON.parse<HybridResponse>(data) ?? DEFAULT_HYBRID_RESPONSE;
          if (result.code == 0) {
            const dataObj: UTSJSONObject = (result.data ?? {}) as UTSJSONObject
            const inner: any | null = dataObj['data']
            const innerObj: UTSJSONObject = ((inner != null ? inner : {}) as UTSJSONObject)
            const listRaw: any | null = innerObj['messageList']
            const list: any[] = Array.isArray(listRaw) ? (listRaw as any[]) : []
            resolve(list);
          } else {
            const msg = result.message ?? 'downloadMergedMessageList failed';
            reject(new Error(msg));
          }
        } catch (error: any) {
          const errMsg = error instanceof Error ? (error as Error).message : `${error}`;
          reject(new Error(errMsg));
        }
      });
    });
  };

  // ============================================================================
  // 销毁
  // ============================================================================

  private unbindEvent(): void {
    const dataNames: string[] = [
      "readMemberList",
      "hasMoreReadMembers",
      "unreadMemberList",
      "hasMoreUnreadMembers",
      "reactionUserList",
      "hasMoreReactionUsers",
    ];

    dataNames.forEach((name: string) => {
      const makeOptions = (n: string): HybridListenerOptions => {
        const opts: HybridListenerOptions = {
          type: "",
          store: "MessageAction",
          name: n,
          params: { createStoreParams: this.instanceId },
        };
        return opts;
      };
      removeListener(makeOptions(name));
    });
  }

  private resetData(): void {
    this.readMemberList.value = [];
    this.hasMoreReadMembers.value = false;
    this.unreadMemberList.value = [];
    this.hasMoreUnreadMembers.value = false;
    this.reactionUserList.value = [];
    this.hasMoreReactionUsers.value = false;
  }

  destroyStore = (): void => {
    // 幂等：实例已被销毁过，直接 return
    if (!InstanceMap.has(this.instanceId)) return;
    this.unbindEvent();
    this.resetData();
    InstanceMap.delete(this.instanceId);

    const options: HybridCallOptions = {
      api: "destroyStore",
      params: {
        createStoreParams: this.instanceId,
      },
    };

    callAPI(JSON.stringify(options), () => {});
  };
}

/**
 * useMessageActionState 参数选项
 *   message 形参改 UTSJSONObject（替代 MessageInfo）
 */
export type UseMessageActionStateOptions = {
  message: UTSJSONObject;
};

/**
 * useMessageActionState 返回类型
 */
export type UseMessageActionStateReturn = MessageActionState;

export function useMessageActionState(options: UseMessageActionStateOptions): UseMessageActionStateReturn {
  const { message } = options;
  return MessageActionState.getInstance(message);
}

export {
  MessageActionState,
  MediaQuality,
};
export default useMessageActionState;
