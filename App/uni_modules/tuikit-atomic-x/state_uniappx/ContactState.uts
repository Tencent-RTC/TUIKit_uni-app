        try {
          const result = JSON.parse<HybridResponse>(response) ?? DEFAULT_HYBRID_RESPONSE;
          if (result.code == 0) {
            resolve();
          } else {
            const msg = result.message ?? 'Failed to load black list';
            console.error(`[${this.instanceId}][loadBlackList] Failed: ${msg}`);
            reject(new Error(msg));
          }
        } catch (error: any) {
          const errMsg = error instanceof Error ? (error as Error).message : `${error}`
          console.error(`[${this.instanceId}][loadBlackList] Parse error: ${errMsg}`);
          reject(error);
        }
      });
    });
  };

  /**
   * 拉取好友申请列表（旧名 fetchFriendApplicationList）
   */
  loadFriendApplications = async (): Promise<void> => {
    return new Promise((resolve, reject) => {
      const options: HybridCallOptions = {
        api: "loadFriendApplications",
        params: {
          createStoreParams: this.instanceId,
        },
      };

      callAPI(JSON.stringify(options), (response: string) => {
        try {
          const result = JSON.parse<HybridResponse>(response) ?? DEFAULT_HYBRID_RESPONSE;
          if (result.code == 0) {
            resolve();
          } else {
            const msg = result.message ?? 'Failed to load friend applications';
            console.error(`[${this.instanceId}][loadFriendApplications] Failed: ${msg}`);
            reject(new Error(msg));
          }
        } catch (error: any) {
          const errMsg = error instanceof Error ? (error as Error).message : `${error}`
          console.error(`[${this.instanceId}][loadFriendApplications] Parse error: ${errMsg}`);
          reject(error);
        }
      });
    });
  };

  /**
   * 添加好友
   */
  addFriend = async (userID: string, remark?: string, addWording?: string): Promise<void> => {
    return new Promise((resolve, reject) => {
      const options: HybridCallOptions = {
        api: "addFriend",
        params: {
          createStoreParams: this.instanceId,
          userID,
          remark,
          addWording,
        },
      };

      callAPI(JSON.stringify(options), (response: string) => {
        try {
          const result = JSON.parse<HybridResponse>(response) ?? DEFAULT_HYBRID_RESPONSE;
          // 30539 = 好友请求待审核
          if (result.code == 0 || result.code == 30539) {
            resolve();
          } else {
            const msg = result.message ?? 'Failed to add friend';
            console.error(`[${this.instanceId}][addFriend] Failed: ${msg}`);
            reject(new Error(msg));
          }
        } catch (error: any) {
          const errMsg = error instanceof Error ? (error as Error).message : `${error}`
          console.error(`[${this.instanceId}][addFriend] Parse error: ${errMsg}`);
          reject(error);
        }
      });
    });
  };

  /**
   * 删除好友
   */
  deleteFriend = async (userID: string): Promise<void> => {
    return new Promise((resolve, reject) => {
      const options: HybridCallOptions = {
        api: "deleteFriend",
        params: {
          createStoreParams: this.instanceId,
