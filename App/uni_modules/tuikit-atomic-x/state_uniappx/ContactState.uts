          }
        } catch (error: any) {
          const errMsg = error instanceof Error ? (error as Error).message : `${error}`
          console.error(`[${this.instanceId}][deleteFriend] Parse error: ${errMsg}`);
          reject(error);
        }
      });
    });
  };

  /**
   * 设置好友备注（旧名 setUserRemark）
   */
  setFriendRemark = async (userID: string, remark: string): Promise<void> => {
    return new Promise((resolve, reject) => {
      const options: HybridCallOptions = {
        api: "setFriendRemark",
        params: {
          createStoreParams: this.instanceId,
