          } else {
            const msg = result.message ?? 'Failed to accept friend application';
            console.error(`[${this.instanceId}][acceptFriendApplication] Failed: ${msg}`);
            reject(new Error(msg));
          }
        } catch (error: any) {
          const errMsg = error instanceof Error ? (error as Error).message : `${error}`
          console.error(`[${this.instanceId}][acceptFriendApplication] Parse error: ${errMsg}`);
          reject(error);
        }
      });
    });
  };

  /**
   * 拒绝好友申请
   */
  refuseFriendApplication = async (application: any): Promise<void> => {
    return new Promise((resolve, reject) => {
      const options: HybridCallOptions = {
        api: "refuseFriendApplication",
        params: {
          createStoreParams: this.instanceId,
          info: JSON.stringify(application),
        },
      };

      callAPI(JSON.stringify(options), (response: string) => {
        try {
          const result = JSON.parse<HybridResponse>(response) ?? DEFAULT_HYBRID_RESPONSE;
          if (result.code == 0) {
            resolve();
          } else {
            const msg = result.message ?? 'Failed to refuse friend application';
            console.error(`[${this.instanceId}][refuseFriendApplication] Failed: ${msg}`);
            reject(new Error(msg));
          }
        } catch (error: any) {
          const errMsg = error instanceof Error ? (error as Error).message : `${error}`
          console.error(`[${this.instanceId}][refuseFriendApplication] Parse error: ${errMsg}`);
          reject(error);
        }
      });
    });
  };

  /**
   * 清空好友申请未读数
   */
  clearFriendApplicationUnreadCount = async (): Promise<void> => {
    return new Promise((resolve, reject) => {
      const options: HybridCallOptions = {
        api: "clearFriendApplicationUnreadCount",
        params: {
          createStoreParams: this.instanceId,
        },
      };

      callAPI(JSON.stringify(options), (response: string) => {
        try {
          const result = JSON.parse<HybridResponse>(response) ?? DEFAULT_HYBRID_RESPONSE;
          if (result.code == 0) {
            resolve();
          } else {
            const msg = result.message ?? 'Failed to clear friend application unread count';
            console.error(`[${this.instanceId}][clearFriendApplicationUnreadCount] Failed: ${msg}`);
            reject(new Error(msg));
          }
        } catch (error: any) {
          const errMsg = error instanceof Error ? (error as Error).message : `${error}`
          console.error(`[${this.instanceId}][clearFriendApplicationUnreadCount] Parse error: ${errMsg}`);
          reject(error);
        }
      });
    });
  };

  // ============================================================================
  // 销毁
  // ============================================================================

  private unbindEvent(): void {
    const dataNames = [
      "blackList",
      "friendList",
      "friendApplicationList",
      "friendApplicationUnreadCount",
    ];

    dataNames.forEach((dataName) => {
      const options: HybridListenerOptions = {
        type: "",
        store: "Contact",
        name: dataName,
        params: { createStoreParams: this.instanceId },
      };
      removeListener(options);
    });

    const loginOptions: HybridListenerOptions = {
      type: "",
      store: "LoginStore",
      name: "loginStatus",
      listenerID: `contact-${this.instanceId}`,
      params: {
        createStoreParams: JSON.stringify({ storeName: 'login', id: '' })
      }
    };
    removeListener(loginOptions);
  }

  private resetData(): void {
    this.blackList.value = [];
    this.friendList.value = [];
    this.friendApplicationList.value = [];
    this.friendApplicationUnreadCount.value = 0;
  }

  destroyStore = (): void => {
    // 幂等：实例已被销毁过，直接 return
    if (!InstanceMap.has(this.instanceId)) return;
    this.unbindEvent();
    this.resetData();
    InstanceMap.delete(this.instanceId);

    const options: HybridCallOptions = {
      api: "destroyStore",
      params: {
        createStoreParams: this.instanceId,
      },
    };

    callAPI(JSON.stringify(options), () => {});
  };
}

/**
 * 联系人状态管理 Hook
 * @param instanceId Store 实例ID（可选；多 instance 场景使用）
 *
 *   内部用 `JSON.stringify({ storeName: 'Contact', instanceId })` 打包成 SDK 端 Gson 期望的 JSON 字符串。
 *   SDK 端 `parseCreateStoreParamsMap` 用 Gson 解析 params.createStoreParams 字段，
 *   期望 BEGIN_OBJECT（Map<String, String>）但拿到裸字符串会抛
 *   `Expected BEGIN_OBJECT but was STRING` 运行时 JsonSyntaxException。
 *   —— 与 GroupMemberState/SearchState 内部 generateInstanceId 模式一致
 *   （GroupState/ConversationListState 已在 useXxxState 层处理）。
 */
export function useContactState(instanceId: string | null = null): ContactState {
  let finalInstanceId: string
  if (instanceId != null && instanceId.length > 0) {
    finalInstanceId = JSON.stringify({ storeName: "Contact", instanceId })
  } else {
    // 默认 instance（无参数调用）：不带 instanceId 字段
    finalInstanceId = JSON.stringify({ storeName: "Contact" })
  }
  return ContactState.getInstance(finalInstanceId)
}

export { ContactState };
export default useContactState;
