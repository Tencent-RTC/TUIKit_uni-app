
import { ref, type Ref } from "vue";
import type { HybridListenerOptions } from "@/uni_modules/tuikit-atomic-x";
import type { HybridCallOptions } from "./hybridCallOptions.uts";
import { callAPI, addListener, removeListener } from "@/uni_modules/tuikit-atomic-x";

/**
 * 桥接响应（参照 atomicx HybridResponse data class）
 */
type HybridResponse = {
  api: string | null;
  code: number;
  message: string | null;
  data: any | null;
};

/**
 * 桥接响应默认值（JSON.parse 失败兜底）
 * code = -1 表示本地异常
 */
const DEFAULT_HYBRID_RESPONSE: HybridResponse = {
  api: null,
  code: -1,
  message: null,
  data: null
};

/**
 * blackList / friendList / friendApplicationList 监听 payload（共用）
 * SDK 实际推送结构化对象/数组（非 JSON 字符串），按对象/数组声明
 *
 *   没有无参构造器，Gson 反序列化时 `UnsafeAllocator.newInstance` 抛 "Interface can't be instantiated"
 *   —— 把 payload 字段类型改成 any[]（Gson 反序列化为 List<Any>，不再触发 interface 实例化）
 */
type ContactListPayload = {
  blackList?: any[] | null;
  friendList?: any[] | null;
  friendApplicationList?: any[] | null;
};

/**
 * friendApplicationUnreadCount 监听 payload
 */
type FriendApplicationUnreadCountPayload = {
  friendApplicationUnreadCount: number | null;
};

type LoginStatusPayload = {
  loginStatus: number | null;
};

type GetContactInfoInner = {
  contactInfoList: any[] | null;
};
type GetContactInfoData = {
  data: GetContactInfoInner | null;
};

/**
 * 模块级单例缓存
 */
const InstanceMap: Map<string, ContactState> = new Map<string, ContactState>();

/**
 * 联系人状态管理类
 */
class ContactState {
  /** Store 实例ID */
  readonly instanceId: string;

  /**
   * 黑名单列表
   *   —— 与 GroupState.uts:155 `Ref<any[]>` 模式一致
   */
  readonly blackList: Ref<any[]>;
  /** 好友列表 */
  readonly friendList: Ref<any[]>;
  /** 好友申请列表 */
  readonly friendApplicationList: Ref<any[]>;
  /** 好友申请未读数 */
  readonly friendApplicationUnreadCount: Ref<number>;

  private constructor(instanceId: string) {
    this.instanceId = instanceId;
    this.blackList = ref<any[]>([] as any[]);
    this.friendList = ref<any[]>([] as any[]);
    this.friendApplicationList = ref<any[]>([] as any[]);
    this.friendApplicationUnreadCount = ref<number>(0);

    this.createStore();
  }

  private loadInit(): void {
    this.loadFriends().catch((e: any | null): void => {
      console.error(`[${this.instanceId}][loadInit] loadFriends swallowed: ${e}`)
    })
    this.loadBlackList().catch((e: any | null): void => {
      console.error(`[${this.instanceId}][loadInit] loadBlackList swallowed: ${e}`)
    })
    this.loadFriendApplications().catch((e: any | null): void => {
      console.error(`[${this.instanceId}][loadInit] loadFriendApplications swallowed: ${e}`)
    })
  }

  static getInstance(instanceId: string): ContactState {
    if (!InstanceMap.has(instanceId)) {
      InstanceMap.set(instanceId, new ContactState(instanceId));
    }
    return InstanceMap.get(instanceId) as ContactState;
  }

  private createStore(): void {
    const options: HybridCallOptions = {
      api: "createStore",
      params: {
        createStoreParams: this.instanceId,
      },
    };

    callAPI(JSON.stringify(options), (response: string) => {
      try {
        const result = JSON.parse<HybridResponse>(response) ?? DEFAULT_HYBRID_RESPONSE;
        if (result.code == 0) {
          this.bindEvent();
          this.loadInit();
        } else {
          const msg = result.message ?? 'unknown'
          console.error(`[${this.instanceId}][createStore] Failed: ${msg}`);
        }
      } catch (error: any) {
        const errMsg = error instanceof Error ? (error as Error).message : `${error}`
        console.error(`[${this.instanceId}][createStore] Parse error: ${errMsg}`);
      }
    });
  }

  private bindEvent(): void {
    const makeOptions = (name: string): HybridListenerOptions => {
      const opts: HybridListenerOptions = {
        type: "",
        store: "Contact",
        name: name,
        params: { createStoreParams: this.instanceId },
      }
      return opts
    }

    addListener(makeOptions("blackList"), (data: string) => {
      try {
        const result = JSON.parse<ContactListPayload>(data);
        if (result != null) {
          const list = result.blackList
          if (list != null) {
            this.blackList.value = list as any[]
          }
        }
      } catch (error: any) {
        const errMsg = error instanceof Error ? (error as Error).message : `${error}`
        console.error(`[${this.instanceId}][blackList listener] Error: ${errMsg}`);
      }
    });

    addListener(makeOptions("friendList"), (data: string) => {
      try {
        const result = JSON.parse<ContactListPayload>(data);
        if (result != null) {
          const list = result.friendList
          if (list != null) {
            this.friendList.value = list as any[]
          }
        }
      } catch (error: any) {
        const errMsg = error instanceof Error ? (error as Error).message : `${error}`
        console.error(`[${this.instanceId}][friendList listener] Error: ${errMsg}`);
      }
    });

    addListener(makeOptions("friendApplicationList"), (data: string) => {
      try {
        const result = JSON.parse<ContactListPayload>(data);
        if (result != null) {
          const list = result.friendApplicationList
          if (list != null) {
            this.friendApplicationList.value = list as any[]
          }
        }
      } catch (error: any) {
        const errMsg = error instanceof Error ? (error as Error).message : `${error}`
        console.error(`[${this.instanceId}][friendApplicationList listener] Error: ${errMsg}`);
      }
    });

    addListener(makeOptions("friendApplicationUnreadCount"), (data: string) => {
      try {
        const result = JSON.parse<FriendApplicationUnreadCountPayload>(data);
        if (result != null && result.friendApplicationUnreadCount != null) {
          this.friendApplicationUnreadCount.value = result.friendApplicationUnreadCount;
        }
      } catch (error: any) {
        const errMsg = error instanceof Error ? (error as Error).message : `${error}`
        console.error(`[${this.instanceId}][friendApplicationUnreadCount listener] Error: ${errMsg}`);
      }
    });
  }


  // ============================================================================
  // Actions
  // ============================================================================

  getContactInfo = async (userIDList: string[]): Promise<any[]> => {
    return new Promise((resolve, reject) => {
      const options: HybridCallOptions = {
        api: "getContactInfo",
        params: {
          createStoreParams: this.instanceId,
          userIDList,
        },
      };

      callAPI(JSON.stringify(options), (response: string) => {
        try {
          const result = JSON.parse<HybridResponse>(response) ?? DEFAULT_HYBRID_RESPONSE;
          if (result.code == 0) {
            const parsed = JSON.parse<GetContactInfoData>(JSON.stringify(result.data));
            const list: any[] = parsed?.data?.contactInfoList ?? [];
            resolve(list);
          } else {
            const msg = result.message ?? 'unknown'
            console.error(`[${this.instanceId}][getContactInfo] Failed: ${msg}`);
            reject(new Error(msg));
          }
        } catch (error: any) {
          const errMsg = error instanceof Error ? (error as Error).message : `${error}`
          console.error(`[${this.instanceId}][getContactInfo] Parse error: ${errMsg}`);
          reject(error);
        }
      });
    });
  };

  /**
   * 拉取好友列表（旧名 fetchFriendList）
   */
  loadFriends = async (): Promise<void> => {
    return new Promise((resolve, reject) => {
      const options: HybridCallOptions = {
        api: "loadFriends",
        params: {
          createStoreParams: this.instanceId,
        },
      };

      callAPI(JSON.stringify(options), (response: string) => {
        try {
          const result = JSON.parse<HybridResponse>(response) ?? DEFAULT_HYBRID_RESPONSE;
          if (result.code == 0) {
            resolve();
          } else {
            const msg = result.message ?? 'Failed to load friends';
            console.error(`[${this.instanceId}][loadFriends] Failed: ${msg}`);
            reject(new Error(msg));
          }
        } catch (error: any) {
          const errMsg = error instanceof Error ? (error as Error).message : `${error}`
          console.error(`[${this.instanceId}][loadFriends] Parse error: ${errMsg}`);
          reject(error);
        }
      });
    });
  };

  /**
   * 拉取黑名单列表（旧名 fetchBlackList）
   */
  loadBlackList = async (): Promise<void> => {
    return new Promise((resolve, reject) => {
      const options: HybridCallOptions = {
        api: "loadBlackList",
        params: {
          createStoreParams: this.instanceId,
        },
