          reject(error);
        }
      });
    });
  };

  /**
   * 从黑名单移除
   */
  removeFromBlacklist = async (userID: string): Promise<void> => {
    return new Promise((resolve, reject) => {
      const options: HybridCallOptions = {
        api: "removeFromBlacklist",
