            const msg = result.message ?? 'Failed to set invite option'
            console.error(`[${this.instanceId}][setInviteOption] Failed: ${msg}`);
            reject(this.buildRejectError(msg, result.code));
          }
        } catch (error: any) {
          reject(error);
        }
      });
    });
  };

  /**
   * 全员禁言（**新增**，从 GroupMemberStore 迁入）
   */
  muteAllMembers = (groupID: string, isMuted: boolean): Promise<void> => {
    return new Promise((resolve, reject) => {
      const options: HybridCallOptions = {
        api: "muteAllMembers",
        params: {
          createStoreParams: this.instanceId,
          groupID,
          isMuted,
        },
      };

      callAPI(JSON.stringify(options), (response: string) => {
        try {
          const result = JSON.parse<HybridResponse>(response) ?? DEFAULT_HYBRID_RESPONSE;
          if (result.code == 0) {
            resolve();
          } else {
            const msg = result.message ?? 'Failed to mute all members'
            console.error(`[${this.instanceId}][muteAllMembers] Failed: ${msg}`);
            reject(this.buildRejectError(msg, result.code));
          }
        } catch (error: any) {
          reject(error);
        }
      });
    });
  };

  /**
   * 订阅群事件流（被踢出群 / 收到入群申请等）
   *
   *   handler 收到的是 UTSJSONObject 原数据（不构造 typed GroupEvent 对象，不拷贝断链）。
   *
   * @returns 取消订阅函数
   */
  onGroupEvent = (handler: (event: any) => void): (() => void) => {
    this.groupEventHandlers.add(handler);
    return () => {
      this.groupEventHandlers.delete(handler);
    };
  };

  // ============================================================================
  // 工具方法
  // ============================================================================

  private buildRejectError(message: string, _code: number): Error {
    return new Error(message)
  }

  // ============================================================================
  // 销毁
  // ============================================================================

  destroyStore = (): Promise<void> => {
    // 幂等：实例已被销毁过，直接 resolve
    if (!InstanceMap.has(this.instanceId)) {
      return Promise.resolve();
    }
    InstanceMap.delete(this.instanceId);
    this.unbindEvent();

    return new Promise((resolve) => {
      const options: HybridCallOptions = {
        api: "destroyStore",
        params: {
          createStoreParams: this.instanceId,
        },
      };

      callAPI(JSON.stringify(options), () => {});
    });
  };
}

// ============================================================================
// Hook 导出
// ============================================================================

function useGroupState(): GroupState {
  return GroupState.getInstance();
}

export {
  GroupType,
  GroupJoinOption,
  GroupInviteOption,
  useGroupState,
};
