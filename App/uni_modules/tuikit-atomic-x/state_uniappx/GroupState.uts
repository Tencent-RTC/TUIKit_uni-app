  /**
   * 转让群主（旧名 changeGroupOwner）
   */
  changeOwner = (groupID: string, newOwnerID: string): Promise<void> => {
    return new Promise((resolve, reject) => {
      const options: HybridCallOptions = {
        api: "changeOwner",
        params: {
          createStoreParams: this.instanceId,
