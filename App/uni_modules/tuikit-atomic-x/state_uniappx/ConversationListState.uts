          } else {
            const msg = result.message ?? 'Failed to pin conversation';
            console.error(`[${this.instanceId}][pinConversation] Failed: ${msg}`);
            reject(new Error(msg));
          }
        } catch (error: any) {
          const errMsg = error instanceof Error ? (error as Error).message : `${error}`;
          console.error(`[${this.instanceId}][pinConversation] Parse error: ${errMsg}`);
          reject(new Error(errMsg));
        }
      });
    });
  }

  setReceiveMessageOpt(conversationID: string, opt: number): Promise<void> {
    return new Promise<void>((resolve, reject) => {
      callAPI(JSON.stringify({
        api: "setReceiveMessageOpt",
