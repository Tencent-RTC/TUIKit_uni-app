        }
      }), (response: string) => {
        try {
          const result = JSON.parse<HybridResponse>(response) ?? DEFAULT_HYBRID_RESPONSE;
          if (result.code == 0) {
            resolve();
          } else {
            const msg = result.message ?? 'Failed to set receive message opt';
            console.error(`[${this.instanceId}][setReceiveMessageOpt] Failed: ${msg}`);
            reject(new Error(msg));
          }
        } catch (error: any) {
          const errMsg = error instanceof Error ? (error as Error).message : `${error}`;
          console.error(`[${this.instanceId}][setReceiveMessageOpt] Parse error: ${errMsg}`);
          reject(new Error(errMsg));
        }
      });
    });
  }

  /**
   * 删除会话
   */
  deleteConversation(conversationID: string): Promise<void> {
    return new Promise<void>((resolve, reject) => {
      callAPI(JSON.stringify({
        api: "deleteConversation",
