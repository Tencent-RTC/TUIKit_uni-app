          } else {
            const msg = result.message ?? 'Failed to delete conversation';
            console.error(`[${this.instanceId}][deleteConversation] Failed: ${msg}`);
            reject(new Error(msg));
          }
        } catch (error: any) {
          const errMsg = error instanceof Error ? (error as Error).message : `${error}`;
          console.error(`[${this.instanceId}][deleteConversation] Parse error: ${errMsg}`);
          reject(new Error(errMsg));
        }
      });
    });
  }

  /**
   * 设置会话草稿
   */
  setConversationDraft(conversationID: string, draft: string | null = null): Promise<void> {
    return new Promise<void>((resolve, reject) => {
      callAPI(JSON.stringify({
        api: "setConversationDraft",
        params: {
          createStoreParams: this.instanceId,
          conversationID: conversationID,
          draft: draft
        }
      }), (response: string) => {
        try {
          const result = JSON.parse<HybridResponse>(response) ?? DEFAULT_HYBRID_RESPONSE;
          if (result.code == 0) {
            resolve();
          } else {
            const msg = result.message ?? 'Failed to set conversation draft';
            console.error(`[${this.instanceId}][setConversationDraft] Failed: ${msg}`);
            reject(new Error(msg));
          }
        } catch (error: any) {
          const errMsg = error instanceof Error ? (error as Error).message : `${error}`;
          console.error(`[${this.instanceId}][setConversationDraft] Parse error: ${errMsg}`);
          reject(new Error(errMsg));
        }
      });
    });
  }

  /**
   * 清空会话消息
   */
  clearConversationMessages(conversationID: string): Promise<void> {
    return new Promise<void>((resolve, reject) => {
      callAPI(JSON.stringify({
        api: "clearConversationMessages",
        params: {
          createStoreParams: this.instanceId,
          conversationID: conversationID
        }
      }), (response: string) => {
        try {
          const result = JSON.parse<HybridResponse>(response) ?? DEFAULT_HYBRID_RESPONSE;
          if (result.code == 0) {
            resolve();
          } else {
            const msg = result.message ?? 'Failed to clear conversation messages';
            console.error(`[${this.instanceId}][clearConversationMessages] Failed: ${msg}`);
            reject(new Error(msg));
          }
        } catch (error: any) {
          const errMsg = error instanceof Error ? (error as Error).message : `${error}`;
          console.error(`[${this.instanceId}][clearConversationMessages] Parse error: ${errMsg}`);
          reject(new Error(errMsg));
        }
      });
    });
  }

  /**
   * 清空会话未读数
   */
  clearConversationUnreadCount(conversationID: string): Promise<void> {
    return new Promise<void>((resolve, reject) => {
      callAPI(JSON.stringify({
        api: "clearConversationUnreadCount",
        params: {
          createStoreParams: this.instanceId,
          conversationID: conversationID
        }
      }), (response: string) => {
        try {
          const result = JSON.parse<HybridResponse>(response) ?? DEFAULT_HYBRID_RESPONSE;
          if (result.code == 0) {
            resolve();
          } else {
            const msg = result.message ?? 'Failed to clear unread count';
            console.error(`[${this.instanceId}][clearConversationUnreadCount] Failed: ${msg}`);
            reject(new Error(msg));
          }
        } catch (error: any) {
          const errMsg = error instanceof Error ? (error as Error).message : `${error}`;
          console.error(`[${this.instanceId}][clearConversationUnreadCount] Parse error: ${errMsg}`);
          reject(new Error(errMsg));
        }
      });
    });
  }

  /**
   * 标记会话
   */
  markConversation(conversationIDList: string[], markType: ConversationMarkTypeValue, enable: boolean): Promise<void> {
    return new Promise<void>((resolve, reject) => {
      callAPI(JSON.stringify({
        api: "markConversation",
        params: {
          createStoreParams: this.instanceId,
          conversationIDList: conversationIDList,
          markType: markType,
          enable: enable
        }
      }), (response: string) => {
        try {
          const result = JSON.parse<HybridResponse>(response) ?? DEFAULT_HYBRID_RESPONSE;
          if (result.code == 0) {
            resolve();
          } else {
            const msg = result.message ?? 'Failed to mark conversation';
            console.error(`[${this.instanceId}][markConversation] Failed: ${msg}`);
            reject(new Error(msg));
          }
        } catch (error: any) {
          const errMsg = error instanceof Error ? (error as Error).message : `${error}`;
          console.error(`[${this.instanceId}][markConversation] Parse error: ${errMsg}`);
          reject(new Error(errMsg));
        }
      });
    });
  }

  // ============================================================================
  // 销毁
  // ============================================================================

  /**
   * 移除事件监听
   */
  private unbindEvent(): void {
    const dataNames: string[] = ["conversationList", "totalUnreadCount", "hasMoreConversations"];

    dataNames.forEach((name: string) => {
      const options: HybridListenerOptions = {
        type: "",
        store: "ConversationList",
        name: name,
        params: {
          createStoreParams: this.instanceId
        }
      };
      removeListener(options);
    });
  }

  /**
   * 重置数据
   */
  private resetData(): void {
    this.conversationList.value = [] as any[];
    this.totalUnreadCount.value = 0;
    this.hasMoreConversations.value = false;
  }

  /**
   * 销毁 Store
   */
  destroyStore(): void {
    // 幂等：实例已被销毁过，直接 return
    if (!InstanceMap.has(this.instanceId)) {
      return;
    }
    this.unbindEvent();
    this.resetData();
    InstanceMap.delete(this.instanceId);

    callAPI(JSON.stringify({
      api: "destroyStore",
      params: {
        createStoreParams: this.instanceId
      }
    }), (response: string) => {
      try {
        const result = JSON.parse<HybridResponse>(response) ?? DEFAULT_HYBRID_RESPONSE;
        console.log(`[${this.instanceId}][destroyStore] Response: ${JSON.stringify(result)}`);
      } catch (error: any) {
        const errMsg = error instanceof Error ? (error as Error).message : `${error}`;
        console.error(`[${this.instanceId}][destroyStore] Parse error: ${errMsg}`);
      }
    });
  }
}

export type UseConversationListStateOptions = {
  /** 实例 ID（多实例场景使用，与 conversationGroup 配合） */
  instanceId?: string;
  /** 会话分组名（可选；按分组过滤会话列表） */
  conversationGroup?: string;
};

/**
 * 会话列表状态管理 Hook
 *
 * @param optionsOrInstanceId 配置选项；为兼容旧调用，可直接传 instanceId 字符串
 */
export function useConversationListState(
  optionsOrInstanceId: UseConversationListStateOptions | string | null = null
): ConversationListState {
  let conversationGroup: string | null = null;
  let instanceIdSeed: string | null = null;

  if (optionsOrInstanceId != null) {
    const raw = optionsOrInstanceId;
    if (typeof raw == 'string') {
      instanceIdSeed = raw;
    } else {
      const opts = raw as UseConversationListStateOptions;
      instanceIdSeed = opts.instanceId ?? null;
      conversationGroup = opts.conversationGroup ?? null;
    }
  }

  const idObject = new UTSJSONObject();
  idObject["storeName"] = "ConversationList";
  if (instanceIdSeed != null && instanceIdSeed.length > 0) {
    idObject["instanceId"] = instanceIdSeed;
  }
  if (conversationGroup != null && conversationGroup.length > 0) {
    idObject["conversationGroup"] = conversationGroup;
  }

  const instanceId: string = JSON.stringify(idObject);
  return ConversationListState.getInstance(instanceId, conversationGroup);
}

export { ConversationListState };
export default useConversationListState;
