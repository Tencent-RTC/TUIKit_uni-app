<template>
  <view class="user-picker">
    <view v-if="enableSearch" class="user-picker__search">
      <view class="search__container">
        <image class="search__icon" :src="searchIconSrc" mode="aspectFit" />
        <input class="search__input" placeholder="搜索" v-model="searchKeyword" @input="handleSearch" />
      </view>
    </view>

    <view class="user-picker__content">
      <scroll-view class="user-list" scroll-y="true" :scroll-into-view="scrollIntoView" @scroll="handleScroll">
        <!-- 置顶项（@所有人）：搜索时不展示 -->
        <view v-if="!searchKeyword.trim() && pinnedTopItems && pinnedTopItems.length > 0" class="pinned-group">
          <view
            v-for="pinned in pinnedTopItems"
            :key="pinned.userID"
            class="user-item user-item--pinned"
            @tap="handlePinnedSelect(pinned)"
          >
            <view v-if="!singleSelect" class="user-item__checkbox">
              <view class="checkbox" :class="{ 'checkbox--checked': isUserSelected(pinned.userID) }">
                <image v-if="isUserSelected(pinned.userID)" class="checkbox__icon" :src="checkedIconSrc" mode="aspectFit" />
              </view>
            </view>
            <view class="user-item__avatar user-item__avatar--all">
              <text class="user-item__avatar-text">@</text>
            </view>
            <view class="user-item__info">
              <text class="user__name">{{ pinned.nickname || pinned.userID }}</text>
            </view>
          </view>
        </view>

        <view v-for="group in filteredGroups" :key="group.letter" class="user-group" :id="`group-${group.letter}`">
          <view class="group__header">
            <text class="group__letter">{{ group.letter }}</text>
          </view>

          <view v-for="user in group.users" :key="user.userID" class="user-item" @tap="handleUserSelect(user)">
            <view v-if="!singleSelect" class="user-item__checkbox">
              <view class="checkbox" :class="{
                'checkbox--checked': isUserSelected(user.userID),
                'checkbox--disabled': isUserDisabled(user.userID)
              }">
                <image v-if="isUserSelected(user.userID)" class="checkbox__icon" :src="checkedIconSrc" mode="aspectFit" />
              </view>
            </view>

            <view class="user-item__avatar">
              <image class="avatar__image" :src="user.avatarURL || defaultAvatar" mode="aspectFill" />
            </view>

            <view class="user-item__info">
              <text class="user__name">{{ user.nickname || user.userID }}</text>
            </view>
          </view>
        </view>

        <!-- 空态：搜索无结果 / 浏览模式无成员 -->
        <view v-if="showEmpty" class="empty">
          <text class="empty__text">{{ emptyText }}</text>
        </view>
      </scroll-view>

      <view class="alphabet-index">
        <view v-for="letter in alphabetList" :key="letter" class="alphabet-item"
          :class="{ 'alphabet-item--active': currentLetter === letter }" @tap="handleAlphabetTap(letter)">
          <text class="alphabet__text">{{ letter }}</text>
        </view>
      </view>
    </view>

    <view v-if="!singleSelect" class="user-picker__footer">
      <view class="selected-users">
        <view v-for="user in selectedUsers.slice(0, 3)" :key="user.userID" class="selected-user">
          <image class="selected-user__avatar" :src="user.avatarURL || defaultAvatar" mode="aspectFill" />
        </view>
        <view v-if="selectedUsers.length > 3" class="selected-user selected-user--more">
          <text class="more-text">+{{ selectedUsers.length - 3 }}</text>
        </view>
      </view>

      <view class="confirm-button" :class="{ 'confirm-button--disabled': selectedUsers.length === 0 }"
        @tap="handleConfirm">
        <text class="confirm-button__text">确定({{ selectedUsers.length }})</text>
      </view>
    </view>
  </view>
</template>

<script>
import { sortByFirstChar } from '../utils/sortByFirstChar'
var searchIcon = '/uni_modules/tuikit-atomic-x/static/icon/search.png'
var checkedIcon = '/uni_modules/tuikit-atomic-x/static/icon/checked.png'
export default {
  props: {
    maxCount: { type: Number, default: 500 },
    dataSource: { type: Array, default: function() { return [] } },
    lockedItems: { type: Array, default: function() { return [] } },
    title: { type: String, default: '选择用户' },
    singleSelect: { type: Boolean, default: false },
    pinnedTopItems: { type: Array, default: function() { return [] } },
    remoteSearch: { type: Boolean, default: false },
    enableSearch: { type: Boolean, default: true },
  },
  data() {
    return {
      searchKeyword: '',
      selectedUserIDs: [],
      currentLetter: 'A',
      scrollIntoView: '',
      defaultAvatar: 'https://web.sdk.qcloud.com/im/assets/all-in-one/user.png',
      searchIconSrc: searchIcon,
      checkedIconSrc: checkedIcon
    }
  },
  watch: {
    searchKeyword: function(kw) { this.$emit('searchChange', kw) }
  },
  computed: {
    groupedUsers() {
      var r = sortByFirstChar(this.dataSource, function(u) { return u.nickname || u.userID }, true)
      var letters = Object.keys(r.groupedList).sort(function(a, b) {
        if (a === '#' && b !== '#') return 1
        if (b === '#' && a !== '#') return -1
        return a.localeCompare(b)
      })
      return letters.map(function(l) { return { letter: l, users: r.groupedList[l] } })
    },
    alphabetList() {
      var gu = this.groupedUsers
      var all = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ#'.split('')
      return all.filter(function(l) { return gu.some(function(g) { return g.letter === l }) })
    },
    filteredGroups() {
      // remoteSearch=true 时本地不再过滤
      if (this.remoteSearch || !this.searchKeyword.trim()) return this.groupedUsers
      var kw = this.searchKeyword.toLowerCase()
      return this.groupedUsers.map(function(g) {
        return {
          letter: g.letter,
          users: g.users.filter(function(u) { return (u.nickname || u.userID).toLowerCase().indexOf(kw) > -1 })
        }
      }).filter(function(g) { return g.users.length > 0 })
    },
    selectedUsers() {
      var ds = this.dataSource
      return this.selectedUserIDs.map(function(id) { return ds.find(function(u) { return u.userID === id }) }).filter(Boolean)
    },
    isSearching() { return this.searchKeyword.trim().length > 0 },
    showEmpty() {
      if (this.filteredGroups.length > 0) return false
      if (this.isSearching) return true
      return (this.pinnedTopItems || []).length === 0
    },
    emptyText() { return this.isSearching ? '没有匹配的成员' : '暂无成员' },
  },
  methods: {
    isUserSelected(userID) { return this.selectedUserIDs.indexOf(userID) > -1 },
    isUserDisabled(userID) { return this.lockedItems.indexOf(userID) > -1 },
    handleUserSelect(user) {
      if (this.isUserDisabled(user.userID)) return
      // 单选模式：立即触发 confirm
      if (this.singleSelect) {
        this.$emit('confirm', [user])
        return
      }
      var idx = this.selectedUserIDs.indexOf(user.userID)
      if (idx > -1) {
        this.selectedUserIDs.splice(idx, 1)
      } else {
        if (this.selectedUserIDs.length >= this.maxCount) {
          uni.showToast({ title: '最多只能选择' + this.maxCount + '人', icon: 'none' })
          return
        }
        this.selectedUserIDs.push(user.userID)
      }
    },
    handlePinnedSelect(user) {
      if (this.singleSelect) {
        this.$emit('confirm', [user])
        return
      }
      var idx = this.selectedUserIDs.indexOf(user.userID)
      if (idx > -1) { this.selectedUserIDs.splice(idx, 1) }
      else { this.selectedUserIDs.push(user.userID) }
    },
    handleSearch() {},
    handleAlphabetTap(letter) { this.currentLetter = letter; this.scrollIntoView = 'group-' + letter },
    handleScroll(e) {},
    handleConfirm() { if (this.selectedUsers.length === 0) return; this.$emit('confirm', this.selectedUsers) },
  },
}
</script>

<style>
.user-picker { flex: 1; background-color: #F0F2F7; }

.user-picker__search { background-color: #ffffff; padding: 24rpx 32rpx; }

.search__container { height: 80rpx; background-color: #F0F2F7; flex-direction: row; align-items: center; padding: 0 24rpx; }

.search__icon { width: 28rpx; height: 28rpx; margin-right: 16rpx; }

.search__input { flex: 1; font-size: 28rpx; color: #333333; height: 72rpx; line-height: 72rpx; }

.user-picker__content { flex: 1; flex-direction: row; position: relative; }

.user-list { flex: 1; background-color: #ffffff; }

.pinned-group { background-color: #ffffff; }

.user-group { margin-bottom: 24rpx; }

.group__header { height: 60rpx; background-color: #f5f5f5; justify-content: flex-start; padding-left: 32rpx; }

.group__letter { font-family: PingFang SC; line-height: 60rpx; font-size: 28rpx; color: #888888; font-weight: 500; }

.user-item { height: 120rpx; flex-direction: row; align-items: center; padding: 0 32rpx; background-color: #ffffff; border-bottom-width: 1rpx; border-bottom-color: #f0f0f0; }

.user-item--pinned { background-color: #ffffff; }

.user-item__checkbox { width: 48rpx; height: 48rpx; margin-right: 24rpx; align-items: center; justify-content: center; }

.checkbox { width: 48rpx; height: 48rpx; border-radius: 24rpx; border-width: 4rpx; border-color: #d9d9d9; align-items: center; justify-content: center; background-color: #ffffff; }

.checkbox--checked { background-color: #1C66E5; border-color: #1C66E5; }

.checkbox--disabled { background-color: #f5f5f5; border-color: #d9d9d9; }

.checkbox__icon { width: 24rpx; height: 24rpx; }

.user-item__avatar { width: 80rpx; height: 80rpx; margin-right: 24rpx; }

.user-item__avatar--all { background-color: #006EFF; border-radius: 8rpx; align-items: center; justify-content: center; }

.user-item__avatar-text { color: #FFFFFF; font-size: 40rpx; font-weight: 600; }

.avatar__image { width: 80rpx; height: 80rpx; background-color: #f5f5f5; border-radius: 10rpx; }

.user-item__info { flex: 1; }

.user__name { font-size: 32rpx; color: #333333; }

.alphabet-index { width: 50rpx; position: absolute; right: 0; top: 0; bottom: 0; align-items: center; justify-content: center; }

.alphabet-item { width: 50rpx; height: 48rpx; align-items: center; justify-content: center; margin-bottom: 4rpx; }

.alphabet__text { font-size: 20rpx; color: #666666; font-weight: 500; }

/* 空态 */
.empty { padding: 80rpx 32rpx; align-items: center; justify-content: center; }

.empty__text { font-size: 26rpx; color: #8F959E; }

.user-picker__footer { height: 120rpx; background-color: #ffffff; flex-direction: row; align-items: center; padding: 0 32rpx; border-top-width: 1rpx; border-top-color: #e5e5e5; }

.selected-users { flex: 1; flex-direction: row; align-items: center; }

.selected-user { width: 80rpx; height: 80rpx; margin-right: 24rpx; }

.selected-user__avatar { width: 80rpx; height: 80rpx; background-color: #f5f5f5; border-radius: 10rpx; }

.selected-user--more { background-color: #f0f0f0; align-items: center; justify-content: center; }

.more-text { font-size: 28rpx; color: #666666; }

.confirm-button { width: 160rpx; height: 72rpx; background-color: #1C66E5; align-items: center; justify-content: center; border-radius: 4rpx; }

.confirm-button--disabled { background-color: #CCE2FF; }

.confirm-button__text { font-size: 28rpx; color: #ffffff; font-weight: 500; }
</style>
