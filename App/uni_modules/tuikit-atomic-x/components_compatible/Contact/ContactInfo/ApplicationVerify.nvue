<template>
  <view class="application-verify">
    <scroll-view class="application-verify__scroll" scroll-y="true">
      <view class="application-verify__form">
        <view class="application-verify__form-item">
          <text class="application-verify__form-label">验证信息</text>
          <input class="application-verify__form-input" type="text" v-model="verifyMessage" :placeholder="defaultVerifyMessage" :maxlength="100" />
        </view>
        <view class="application-verify__form-divider" v-if="type === 'friend'"/>
        <view class="application-verify__form-item" v-if="type === 'friend'">
          <text class="application-verify__form-label">备注名</text>
          <input class="application-verify__form-input" type="text" v-model="remark" placeholder="请输入备注名" :maxlength="50" />
        </view>
      </view>
      <view class="application-verify__action">
        <view class="application-verify__action-btn" :class="{ 'application-verify__action-btn--disabled': isSubmitting }" @tap="handleSubmit">
          <text class="application-verify__action-btn-text">发送</text>
        </view>
      </view>
    </scroll-view>
  </view>
</template>
<script>
import { useGroupState } from '../../../state/GroupState'
import { useContactState } from '../../../state/ContactState'
import { useLoginState } from '../../../state/LoginState'
import { showToast } from '../../../utils/toast'
export default {
  props: {
    type: { type: String, default: 'friend' },
    userInfo: { type: Object, default: null },
    groupInfo: { type: Object, default: null },
  },
  data() {
    var groupState = useGroupState()
    var contactState = useContactState()
    var loginState = useLoginState()
    return { verifyMessage: '', remark: '', isSubmitting: false, groupState: groupState, contactState: contactState, loginState: loginState }
  },
  computed: {
    defaultVerifyMessage() {
      var nickname = (this.loginState.state && this.loginState.state.loginUserInfo && this.loginState.state.loginUserInfo.nickname) || (this.loginState.state && this.loginState.state.loginUserInfo && this.loginState.state.loginUserInfo.userID) || ''
      return nickname ? '我是' + nickname : '请输入验证信息'
    },
  },
  methods: {
    handleSubmit() {
      if (this.isSubmitting) return
      if (this.type === 'group') this.handleJoinGroup()
      else this.handleAddFriend()
    },
    handleJoinGroup() {
      if (!(this.groupInfo && this.groupInfo.groupID)) return
      this.isSubmitting = true
      var self = this
      var message = this.verifyMessage.trim() || this.defaultVerifyMessage
      this.groupState.joinGroup(this.groupInfo.groupID, message).then(function() {
        showToast({ message: '已发送申请', type: 'success' })
        self.$emit('success', 'group', self.groupInfo)
      }).catch(function(error) {
        showToast({ message: error.message || '发送失败', type: 'error' })
        self.$emit('fail', 'group', error)
      }).finally(function() { self.isSubmitting = false })
    },
    handleAddFriend() {
      if (!(this.userInfo && this.userInfo.userID)) return
      this.isSubmitting = true
      var self = this
      var message = this.verifyMessage.trim() || this.defaultVerifyMessage
      this.contactState.addFriend(this.userInfo.userID, this.remark.trim(), message).then(function(res) {
        var title = res.code === 30539 ? '已发送申请' : '添加好友成功'
        showToast({ message: title, type: 'success' })
        self.$emit('success', 'friend', self.userInfo)
      }).catch(function(error) {
        showToast({ message: error.message || '发送失败', type: 'error' })
        self.$emit('fail', 'friend', error)
      }).finally(function() { self.isSubmitting = false })
    },
  },
}
</script>
<style>
.application-verify { flex: 1; background-color: #F0F2F7; }
.application-verify__scroll { flex: 1; }
.application-verify__form { margin: 120rpx 32rpx 88rpx; background-color: #FFFFFF; border-radius: 32rpx; }
.application-verify__form-item { flex-direction: row; align-items: center; padding: 32rpx; }
.application-verify__form-label { font-size: 32rpx; font-weight: 400; color: rgba(0, 0, 0, 0.9); line-height: 40rpx; width: 160rpx; }
.application-verify__form-input { flex: 1; font-size: 32rpx; color: rgba(0, 0, 0, 0.9); line-height: 40rpx; }
.application-verify__form-divider { height: 1rpx; background-color: #E5E5E5; margin-left: 0; }
.application-verify__action { padding: 0 75rpx; }
.application-verify__action-btn { background-color: #1C66E5; border-radius: 48rpx; padding: 26rpx 0; align-items: center; justify-content: center; }
.application-verify__action-btn--disabled { opacity: 0.6; }
.application-verify__action-btn-text { font-size: 32rpx; font-weight: 400; color: #FFFFFF; line-height: 44rpx; }
</style>
