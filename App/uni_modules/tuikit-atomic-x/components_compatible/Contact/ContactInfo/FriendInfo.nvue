<template>
  <view class="friend-info">
    <scroll-view class="friend-info__content" scroll-y="true">
      <ConfirmDialog v-model="showDeleteDialog" title="确定删除该好友" message="删除联系人同时清空聊天记录" cancelText="取消" confirmText="确定删除" @confirm="confirmDeleteFriend" @cancel="showDeleteDialog = false" />
      <view class="friend-info__header">
        <component :is="Avatar" :src="(currentFriendInfo && currentFriendInfo.avatarURL) || ''" :name="(currentFriendInfo && currentFriendInfo.nickname) || (currentFriendInfo && currentFriendInfo.userID) || ''" :size="96" shape="square" defaultAvatarType="user" pureMode />
        <view class="friend-info__header-info">
          <text class="friend-info__name" :numberOfLines="1">{{ (currentFriendInfo && currentFriendInfo.nickname) || (currentFriendInfo && currentFriendInfo.userID) }}</text>
          <text class="friend-info__id" :numberOfLines="1">ID: {{ (currentFriendInfo && currentFriendInfo.userID) }}</text>
          <text v-if="(currentFriendInfo && currentFriendInfo.signature)" class="friend-info__signature" :numberOfLines="2">个性签名：{{ currentFriendInfo.signature }}</text>
        </view>
      </view>
      <view v-if="isFriend" class="friend-info__section">
        <view class="friend-info__row" @tap="handleRemarkEdit">
          <text class="friend-info__label">备注名</text>
          <view class="friend-info__row-value">
            <text class="friend-info__value" :numberOfLines="1">{{ (currentFriendInfo && currentFriendInfo.remark) || '未设置' }}</text>
            <image class="friend-info__arrow" src="/uni_modules/tuikit-atomic-x/static/icon/arrow-right.png" />
          </view>
        </view>
      </view>
      <view class="friend-info__section">
        <view class="friend-info__row"><text class="friend-info__label">消息免打扰</text><ToggleSwitch :checked="isMuted" @change="handleMuteChange" activeColor="#1C66E5" /></view>
        <view class="friend-info__row"><text class="friend-info__label">置顶聊天</text><ToggleSwitch :checked="isPinned" @change="handlePinChange" activeColor="#1C66E5" /></view>
      </view>
      <view class="friend-info__section">
        <view class="friend-info__row"><text class="friend-info__label">加入黑名单</text><ToggleSwitch :checked="isBlacklisted" @change="handleBlacklistChange" activeColor="#1C66E5" /></view>
      </view>
      <view class="friend-info__section">
        <view v-for="action in actionList" :key="action.key" class="friend-info__row friend-info__actions" @tap="handleActionClick(action)">
          <text class="friend-info__link" :style="{ color: action.color || '#147AFF' }">{{ action.label }}</text>
        </view>
      </view>
    </scroll-view>
  </view>
</template>

<script>
import AvatarComponent from '../../Avatar'
import ConfirmDialog from '../../ConfirmDialog/ConfirmDialog.nvue'
import { useContactState } from '../../../state_compatible/ContactState'
import { useConversationListState } from '../../../state_compatible/ConversationListState'
import { useCallState, CallErrorCode } from '../../../state_compatible/CallState'
import { useDeviceState } from '../../../state_compatible/DeviceState'
import { ConversationReceiveOption } from '../../../types/conversation'
import { defaultFriendInfoActions } from '../config'
import { showToast } from '../../../utils/toast'
import ToggleSwitch from '../../ToggleSwitch/ToggleSwitch.nvue'
import { getCurrentPageFullPath, isNavigating, isCallEnding } from '../../../server_compatible/callService'
import { checkCallPermissionWithDialog } from '../../../utils/callPermission'
// @ts-ignore
import { reportScene } from '@/uni_modules/tuikit-atomic-x'

export default {
  components: { ConfirmDialog, ToggleSwitch },
  props: {
    friendInfo: { type: Object, default: null },
    Avatar: { type: [Object, Function], default: function() { return AvatarComponent } },
    actions: { type: Array, default: function() { return [] } },
  },
  data() {
    var contactState = useContactState()
    var convState = useConversationListState('FriendInfo')
    var callStateInstance = useCallState()
    var deviceStateInstance = useDeviceState()
    return {
      contactState: contactState, convState: convState,
      callStateInstance: callStateInstance,
      callState: callStateInstance.state,
      deviceStateInstance: deviceStateInstance,
      showDeleteDialog: false, isCalling: false, fetchedUserInfo: null,
    }
  },
  computed: {
    friendListUserInfo() {
      if (!(this.friendInfo && this.friendInfo.userID)) return null
      var uid = this.friendInfo.userID
      return (this.contactState.friendList.value || []).find(function(item) { return item.userID === uid }) || null
    },
    currentFriendInfo() { return this.friendListUserInfo || this.fetchedUserInfo || this.friendInfo },
    isFriend() { return ((this.currentFriendInfo && this.currentFriendInfo.isFriend) != null ? (this.currentFriendInfo && this.currentFriendInfo.isFriend) : false) },
    isBlacklisted() {
      if (!(this.currentFriendInfo && this.currentFriendInfo.userID)) return false
      if ((this.fetchedUserInfo && this.fetchedUserInfo.userID) === (this.currentFriendInfo && this.currentFriendInfo.userID)) return ((this.fetchedUserInfo && this.fetchedUserInfo.isInBlacklist) != null ? (this.fetchedUserInfo && this.fetchedUserInfo.isInBlacklist) : false)
      return ((this.currentFriendInfo && this.currentFriendInfo.isInBlacklist) != null ? (this.currentFriendInfo && this.currentFriendInfo.isInBlacklist) : false)
    },
    actionList() {
      var actions = this.actions.length > 0 ? this.actions : defaultFriendInfoActions
      var isFriend = this.isFriend
      return actions.filter(function(a) { if (a.key === 'deleteFriend') return isFriend; return true })
    },
    conversationID() { return (this.currentFriendInfo && this.currentFriendInfo.userID) ? 'c2c_' + this.currentFriendInfo.userID : '' },
    isMuted() {
      if (!this.conversationID) return false
      var cid = this.conversationID
      var list = (this.convState.state && this.convState.state.conversationList) || []
      var conv = list.find(function(c) { return c.conversationID === cid })
      return (conv && conv.receiveOption) === ConversationReceiveOption.NOT_NOTIFY
    },
    isPinned() {
      if (!this.conversationID) return false
      var cid = this.conversationID
      var list = (this.convState.state && this.convState.state.conversationList) || []
      var conv = list.find(function(c) { return c.conversationID === cid })
      return (conv && conv.isPinned) || false
    },
  },
  watch: {
    'friendInfo.userID': { handler() { if (this.conversationID) { this.fetchPeerUserInfo(); this.convState.fetchConversationInfo(this.conversationID) } }, immediate: true },
  },
  mounted() { this.fetchPeerUserInfo() },
  onShow() { this.fetchPeerUserInfo() },
  methods: {
    fetchPeerUserInfo() {
      if (!(this.friendInfo && this.friendInfo.userID)) return
      var self = this
      this.contactState.fetchUserInfo([this.friendInfo.userID]).then(function(list) {
        if (list && list.length > 0) self.fetchedUserInfo = list[0]
      }).catch(function(err) { console.error('[FriendInfo] fetchPeerUserInfo failed:', err) })
    },
    handleRemarkEdit() { if (this.currentFriendInfo) this.$emit('remarkEdit', this.currentFriendInfo) },
    handleMuteChange(e) {
      var value = e.detail.value; if (!this.conversationID) return
      var self = this
      this.convState.muteConversation(this.conversationID, value).then(function() { self.$emit('muteChange', value) }).catch(function(err) { showToast({ message: err.message || '设置失败', type: 'error' }) })
    },
    handlePinChange(e) {
      var value = e.detail.value; if (!this.conversationID) return
      var self = this
      this.convState.pinConversation(this.conversationID, value).then(function() { self.$emit('pinChange', value) }).catch(function(err) { showToast({ message: err.message || '设置失败', type: 'error' }) })
    },
    handleBlacklistChange(e) {
      var value = e.detail.value; if (!(this.currentFriendInfo && this.currentFriendInfo.userID)) return
      var self = this; var uid = this.currentFriendInfo.userID
      var p = value ? this.contactState.addToBlacklist(uid) : this.contactState.removeFromBlacklist(uid)
      p.then(function() {
        showToast({ message: value ? '已加入黑名单' : '已移出黑名单', type: 'success' })
        self.$emit('blacklistChange', value)
      }).catch(function(err) { showToast({ message: err.message || '操作失败', type: 'error' }) })
      .then(function() { self.fetchPeerUserInfo() })
    },
    handleSendMessage() { if ((this.currentFriendInfo && this.currentFriendInfo.userID)) this.$emit('sendMessage', this.currentFriendInfo.userID) },
    handleActionClick(action) {
      if (!(this.currentFriendInfo && this.currentFriendInfo.userID)) return
      if (action.click) { action.click(this.currentFriendInfo.userID); return }
      switch (action.key) {
        case 'sendMessage': this.handleSendMessage(); break
        case 'deleteFriend': this.handleDeleteFriend(); break
        case 'voiceCall': this.startCall(0); break
        case 'videoCall': this.startCall(1); break
      }
    },
    handleDeleteFriend() { this.showDeleteDialog = true },
    confirmDeleteFriend() {
      if (!(this.currentFriendInfo && this.currentFriendInfo.userID)) return
      var self = this; var uid = this.currentFriendInfo.userID
      this.contactState.deleteFriend(uid).then(function() { showToast({ message: '已删除', type: 'success' }); self.$emit('deleteFriend', uid) }).catch(function(err) { showToast({ message: err.message || '删除失败', type: 'error' }) })
    },
    startCall: function(mediaType) {
      var self = this;
      var callStateInstance = self.callStateInstance;
      var deviceStateInstance = self.deviceStateInstance;
      var selfInfo = self.callState.selfInfo;

      // 防抖：上一次呼叫流程尚未完成时，不允许再次呼叫
      if (self.isCalling) {
        console.log('[FriendInfo] call skipped: isCalling is true');
        return;
      }
      if (isNavigating()) {
        console.log('[FriendInfo] call skipped: navigation in progress');
        return;
      }
      if (isCallEnding()) {
        console.log('[FriendInfo] call skipped: previous call end still processing');
        return;
      }
      if (selfInfo && (selfInfo.status === 1 || selfInfo.status === 2)) {
        plus.nativeUI.toast('您正在通话中，无法再次发起通话', {
          align: 'center',
          verticalAlign: 'center'
        });
        return;
      }

      self.isCalling = true;

      if (mediaType === 1) {
        deviceStateInstance.openLocalCamera({ isFront: true });
      }
      deviceStateInstance.openLocalMicrophone({
        fail: function(error) {
          if (error === -1104) {
            setTimeout(function() {
              deviceStateInstance.openLocalMicrophone();
            }, 200);
          }
        }
      });

      checkCallPermissionWithDialog(mediaType).then(function(hasPermission) {
        if (!hasPermission) {
          self.isCalling = false;
          return;
        }
        reportScene('CHAT_INVOKE_CALL');
        callStateInstance.setFramework(15);
        var userID = self.currentFriendInfo && self.currentFriendInfo.userID;
        if (!userID) {
          self.isCalling = false;
          return;
        }
        callStateInstance.calls({
          participantIds: [userID],
          mediaType: mediaType,
          success: function() {
            uni.$callSource = 'caller';
            uni.$lastPage = getCurrentPageFullPath();
            uni.navigateTo({
              url: '/uni_modules/tuikit-atomic-x/pages/call?layoutTemplate=Float',
              complete: function() { self.isCalling = false; }
            });
          },
          fail: function(error) {
            if (error === CallErrorCode.PACKAGE_NOT_PURCHASED) {
              uni.showToast({
                icon: 'none',
                title: '您的应用还未开通音视频通话（TUICallKit）能力，您可以去控制台申请免费体验'
              });
              console.error('控制台申请免费体验,https://console.cloud.tencent.com/trtc');
            }
            self.isCalling = false;
          }
        });
      }).catch(function() {
        self.isCalling = false;
      });
    },
  },
}
</script>

<style>
.friend-info { flex: 1; background-color: #F5F5F5; }
.friend-info__content { flex: 1; }
.friend-info__header { flex-direction: row; align-items: flex-start; padding: 24rpx 32rpx; background-color: #FFFFFF; }
.friend-info__header-info { flex: 1; margin-left: 32rpx; }
.friend-info__name { font-size: 36rpx; font-weight: 400; color: #000000; line-height: 48rpx; lines: 1; text-overflow: ellipsis; }
.friend-info__id { font-size: 26rpx; color: #888888; line-height: 40rpx; margin-top: 8rpx; lines: 1; text-overflow: ellipsis; }
.friend-info__signature { font-size: 26rpx; color: #888888; line-height: 40rpx; margin-top: 4rpx; lines: 2; text-overflow: ellipsis; }
.friend-info__section { margin-top: 20rpx; background-color: #FFFFFF; }
.friend-info__row { flex-direction: row; align-items: center; padding: 24rpx 32rpx; border-bottom: 1rpx solid #E6E9F0; }
.friend-info__label { flex: 1; font-size: 32rpx; font-weight: 400; line-height: 48rpx; color: #444444; }
.friend-info__row-value { flex-direction: row; align-items: center; }
.friend-info__value { font-size: 30rpx; color: rgba(0, 0, 0, 0.5); max-width: 400rpx; lines: 1; text-overflow: ellipsis; }
.friend-info__arrow { width: 14rpx; height: 24rpx; margin-left: 22rpx; }
.friend-info__actions { padding: 30rpx 32rpx; justify-content: center; align-items: center; }
.friend-info__link { font-size: 34rpx; line-height: 52rpx; font-weight: 400; color: #147AFF; }
.friend-info__danger-actions { padding: 30rpx 32rpx; align-items: center; }
.friend-info__danger-link { font-size: 34rpx; line-height: 52rpx; font-weight: 400; color: #FF584C; }
</style>
