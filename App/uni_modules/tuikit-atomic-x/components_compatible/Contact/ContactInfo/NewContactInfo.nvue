<template>
  <view class="new-contact-info">
    <scroll-view class="new-contact-info__content" scroll-y="true">
      <view class="new-contact-info__header">
        <component :is="Avatar" :src="(application && application.avatarURL) || ''" :name="(application && application.title) || (application && application.applicationID) || ''" :size="96" shape="square" defaultAvatarType="user" pureMode />
        <view class="new-contact-info__header-info">
          <text class="new-contact-info__name" :numberOfLines="1">{{ (application && application.title) }}</text>
          <text class="new-contact-info__id" :numberOfLines="1">ID: {{ (application && application.applicationID) }}</text>
          <text v-if="(application && application.signature)" class="new-contact-info__signature" :numberOfLines="2">个性签名：{{ application.signature }}</text>
        </view>
      </view>
      <view class="new-contact-info__section">
        <view class="new-contact-info__row">
          <text class="new-contact-info__label">验证信息</text>
          <text class="new-contact-info__value" :numberOfLines="1">{{ (application && application.addWording) || '无' }}</text>
        </view>
      </view>
      <view v-if="!isHandled" class="new-contact-info__actions">
        <view class="new-contact-info__btn new-contact-info__btn--primary" @tap="handleAccept"><text class="new-contact-info__btn-text new-contact-info__btn-text--primary">同意</text></view>
        <view class="new-contact-info__btn new-contact-info__btn--danger" @tap="handleReject"><text class="new-contact-info__btn-text new-contact-info__btn-text--danger">拒绝</text></view>
      </view>
      <view v-else class="new-contact-info__handled"><text class="new-contact-info__handled-text">{{ handledText }}</text></view>
    </scroll-view>
  </view>
</template>
<script>
import AvatarComponent from '../../Avatar'
import { useContactState } from '../../../state/ContactState'
import { showToast } from '../../../utils/toast'
export default {
  props: {
    application: { type: Object, default: null },
    Avatar: { type: [Object, Function], default: function() { return AvatarComponent } },
  },
  data() { return { isHandled: false, handledResult: null, contactState: useContactState() } },
  computed: {
    handledText() { if (this.handledResult === 'accepted') return '已同意'; if (this.handledResult === 'rejected') return '已拒绝'; return '' },
  },
  methods: {
    handleAccept() {
      if (!this.application || this.isHandled) return
      var self = this
      this.contactState.acceptFriendApplication(this.application).then(function() {
        self.isHandled = true; self.handledResult = 'accepted'
        showToast({ message: '已同意', type: 'success' })
        self.$emit('accept', self.application)
      }).catch(function(err) { showToast({ message: err.message || '操作失败', type: 'error' }) })
    },
    handleReject() {
      if (!this.application || this.isHandled) return
      var self = this
      this.contactState.refuseFriendApplication(this.application).then(function() {
        self.isHandled = true; self.handledResult = 'rejected'
        showToast({ message: '已拒绝', type: 'success' })
        self.$emit('reject', self.application)
      }).catch(function(err) { showToast({ message: err.message || '操作失败', type: 'error' }) })
    },
  },
}
</script>
<style>
.new-contact-info { flex: 1; background-color: #F5F5F5; }
.new-contact-info__content { flex: 1; }
.new-contact-info__header { flex-direction: row; padding: 32rpx; background-color: #FFFFFF; }
.new-contact-info__header-info { flex: 1; margin-left: 30rpx; padding-bottom: 20rpx; }
.new-contact-info__name { font-size: 36rpx; font-weight: 500; color: rgba(0, 0, 0, 0.9); line-height: 48rpx; lines: 1; text-overflow: ellipsis; }
.new-contact-info__id { font-size: 26rpx; color: rgba(0, 0, 0, 0.4); line-height: 40rpx; margin-top: 8rpx; lines: 1; text-overflow: ellipsis; }
.new-contact-info__signature { font-size: 26rpx; color: rgba(0, 0, 0, 0.4); line-height: 40rpx; margin-top: 4rpx; lines: 2; text-overflow: ellipsis; }
.new-contact-info__section { margin-bottom: 20rpx; padding: 0 32rpx; background-color: #FFFFFF; }
.new-contact-info__row { flex-direction: row; align-items: center; padding: 20rpx 0rpx; border-top: 1rpx solid #E5E5E5; }
.new-contact-info__label { font-size: 28rpx; font-weight: 400; line-height: 40rpx; color: #888888; }
.new-contact-info__value { flex: 1; margin-left: 10rpx; font-size: 28rpx; font-weight: 400; line-height: 40rpx; color: #444444; lines: 1; text-overflow: ellipsis; }
.new-contact-info__actions { background-color: #FFFFFF; }
.new-contact-info__btn { align-items: center; justify-content: center; padding: 30rpx 0; border-bottom: 2rpx solid #E5E5E5; }
.new-contact-info__btn:last-child { border-bottom-width: 0; }
.new-contact-info__btn-text { font-size: 34rpx; font-weight: 400; line-height: 52rpx; }
.new-contact-info__btn-text--primary { color: #1C66E5; }
.new-contact-info__btn-text--danger { color: #E54545; }
.new-contact-info__handled { padding: 40rpx 32rpx; align-items: center; background-color: #FFFFFF; margin-top: 20rpx; }
.new-contact-info__handled-text { font-size: 28rpx; color: #999999; }
</style>
