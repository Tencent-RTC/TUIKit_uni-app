<template>
  <view class="set-remark">
    <view class="set-remark__form">
      <view class="set-remark__form-item">
        <text class="set-remark__form-label">备注名</text>
        <input class="set-remark__form-input" type="text" v-model="remarkInput" placeholder="请输入备注名" :maxlength="20" :focus="inputFocused" />
        <view v-if="remarkInput" class="set-remark__clear" @tap="handleClear"><image class="set-remark__clear-icon" src="/uni_modules/tuikit-atomic-x/static/icon/close.png" mode="aspectFit" /></view>
      </view>
    </view>
    <view class="set-remark__action">
      <view class="set-remark__action-btn" :class="{ 'set-remark__action-btn--disabled': isSubmitting }" @tap="handleSave">
        <text class="set-remark__action-btn-text">保存</text>
      </view>
    </view>
  </view>
</template>
<script>
import { useContactState } from '../../../state/ContactState'
import { showToast } from '../../../utils/toast'
export default {
  props: { userID: { type: String, default: '' }, remark: { type: String, default: '' } },
  data() { return { remarkInput: '', inputFocused: false, isSubmitting: false, contactState: useContactState() } },
  watch: { remark: { handler(v) { this.remarkInput = v || ''; this.inputFocused = true }, immediate: true } },
  methods: {
    handleClear() { this.remarkInput = '' },
    handleSave() {
      if (this.isSubmitting || !this.userID) return
      this.isSubmitting = true
      var self = this
      this.contactState.setFriendRemark(this.userID, this.remarkInput.trim()).then(function() {
        showToast({ message: '设置成功', type: 'success' })
        self.$emit('success', self.userID, self.remarkInput.trim())
      }).catch(function(err) {
        showToast({ message: err.message || '设置失败', type: 'error' })
        self.$emit('fail', err)
      }).finally(function() { self.isSubmitting = false })
    },
  },
}
</script>
<style>
.set-remark { flex: 1; background-color: #F0F2F7; }
.set-remark__form { margin: 120rpx 32rpx 88rpx; background-color: #FFFFFF; border-radius: 24rpx; }
.set-remark__form-item { flex-direction: row; align-items: center; padding: 32rpx 20rpx; }
.set-remark__form-label { margin-right: 43rpx; font-size: 32rpx; font-weight: 400; color: rgba(0, 0, 0, 0.9); line-height: 40rpx; width: 96rpx; }
.set-remark__form-input { flex: 1; font-size: 32rpx; font-weight: 400; color: rgba(0, 0, 0, 0.9); line-height: 40rpx; }
.set-remark__clear { padding: 8rpx; margin-left: 8rpx; }
.set-remark__clear-icon { width: 28rpx; height: 28rpx; }
.set-remark__action { padding: 0 75rpx; }
.set-remark__action-btn { background-color: #1C66E5; border-radius: 48rpx; padding: 26rpx 0; align-items: center; justify-content: center; }
.set-remark__action-btn--disabled { opacity: 0.6; }
.set-remark__action-btn-text { font-size: 32rpx; font-weight: 400; color: #FFFFFF; line-height: 44rpx; }
</style>
