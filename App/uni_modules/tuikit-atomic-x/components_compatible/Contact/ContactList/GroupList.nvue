<template>
  <view class="group-list">
    <list class="group-list__scroll" :show-scrollbar="false">
      <cell v-if="joinedGroupList.length === 0" key="empty"><view class="group-list__placeholder"><component v-if="PlaceholderEmptyList" :is="PlaceholderEmptyList" text="暂无群组" /></view></cell>
      <cell v-for="item in showFlatList" :key="item.cellKey">
        <view v-if="item.type === 'letter'" class="group-list__index"><text class="group-list__index-text">{{ item.letter }}</text></view>
        <view v-if="item.type === 'group'" class="group-list__item" @tap="handleGroupClick(item.group)">
          <component :is="Avatar" :src="item.group.avatarURL || ''" :name="item.group.groupName || item.group.groupID" :size="80" shape="square" :defaultAvatarType="item.group.groupType.toLowerCase()" pureMode />
          <view class="group-list__item-content"><view class="group-list__item-info"><text class="group-list__item-name" :numberOfLines="1">{{ item.group.groupName || item.group.groupID }}</text></view></view>
        </view>
      </cell>
    </list>
  </view>
</template>
<script>
import AvatarComponent from '../../Avatar'
import DefaultEmptyList from '../placeholders/EmptyList.nvue'
import DefaultLoading from '../placeholders/Loading.nvue'
import { useGroupState } from '../../../state/GroupState'
import { sortByFirstChar } from '../../../utils/sortByFirstChar'
export default {
  props: {
    Avatar: { type: [Object, Function], default: function() { return AvatarComponent } },
    PlaceholderEmptyList: { type: [Object, Function], default: function() { return DefaultEmptyList } },
    PlaceholderLoading: { type: [Object, Function], default: function() { return DefaultLoading } },
  },
  data() { var gs = useGroupState(); return { groupState: gs, selectedGroupID: '' } },
  computed: {
    joinedGroupList() { return this.groupState.joinedGroupList.value || [] },
    groupedGroupList() {
      var result = sortByFirstChar(this.joinedGroupList, function(item) { return item.groupName || item.groupID || '' })
      var letters = Object.keys(result.groupedList).sort(function(a, b) { if (a === '#') return 1; if (b === '#') return -1; return a.localeCompare(b) })
      return letters.map(function(letter) { return { letter: letter, groups: result.groupedList[letter] } })
    },
    showFlatList() {
      if (this.joinedGroupList.length === 0) return []
      var result = []
      this.groupedGroupList.forEach(function(s) {
        result.push({ type: 'letter', letter: s.letter, cellKey: 'idx-' + s.letter })
        s.groups.forEach(function(g) {
          result.push({ type: 'group', group: g, cellKey: 'g-' + g.groupID })
        })
      })
      return result
    },
  },
  mounted() { this.groupState.fetchJoinedGroupList() },
  onShow() { this.groupState.fetchJoinedGroupList() },
  methods: {
    handleGroupClick(group) { this.selectedGroupID = group.groupID; this.$emit('groupSelect', group) },
  },
}
</script>
<style>
.group-list { flex: 1; background-color: #FFFFFF; }
.group-list__scroll { flex: 1; }
.group-list__placeholder { padding-top: 100rpx; padding-bottom: 100rpx; justify-content: center; align-items: center; }
.group-list__index { flex-direction: row; align-items: center; padding: 12rpx 32rpx; background-color: #F0F2F7; }
.group-list__index-text { font-size: 28rpx; color: rgba(0, 0, 0, 0.4); font-weight: 400; line-height: 40rpx; }
.group-list__item { flex-direction: row; align-items: center; padding: 0 32rpx; background-color: #FFFFFF; }
.group-list__item-content { flex: 1; flex-direction: row; align-items: center; justify-content: space-between; margin-left: 24rpx; padding: 36rpx 0; border-bottom: 1rpx solid #DBDBDB; }
.group-list__item-info { flex: 1; flex-direction: row; align-items: center; }
.group-list__item-name { flex: 1; font-size: 36rpx; font-weight: 400; line-height: 48rpx; color: #111111; lines: 1; text-overflow: ellipsis; }
</style>
