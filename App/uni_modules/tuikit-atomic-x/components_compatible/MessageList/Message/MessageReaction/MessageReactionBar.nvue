<template>
  <view v-if="chipList.length > 0" class="rb" :class="{ 'rb--out': message.isSentBySelf }">
    <view
      v-for="chip in chipList"
      :key="chip.reactionID"
      class="rb__chip"
      :class="chipThemeClass"
    >
      <image class="rb__emoji" :src="chip.src" mode="aspectFit" @tap.stop="handleEmojiTap(chip.reactionID)" />
      <view class="rb__texts" @tap.stop="handleChipTap(chip.reactionID)">
        <view v-if="chip.name.length > 0" class="rb__line"></view>
        <text v-if="chip.name.length > 0" class="rb__name rb__text--no-select" :numberOfLines="1">{{ chip.name }}</text>
        <text v-if="chip.suffix.length > 0" class="rb__suffix rb__text--no-select">{{ chip.suffix }}</text>
      </view>
    </view>
  </view>
</template>

<script>
import { buildReactionEmojiSrc } from '../../../../utils/reactionEmoji'
import { buildReactionChipText } from '../../../../utils/messageReaction'
import { toggleMessageReaction } from '../../../../utils/messageReaction'

export default {
  name: 'MessageReactionBar',
  props: {
    message: { type: Object, required: true }
  },
  computed: {
    chipThemeClass() {
      return this.message.isSentBySelf ? 'rb__chip--out' : 'rb__chip--in'
    },
    chipList() {
      var chips = []
      var reactions = this.message.reactionList || []
      for (var i = 0; i < reactions.length; i++) {
        var reaction = reactions[i]
        var src = buildReactionEmojiSrc(reaction.reactionID)
        if (!src || (reaction.totalUserCount || 0) <= 0) continue
        const text = buildReactionChipText(reaction)
        chips.push({
          reactionID: reaction.reactionID,
          src: src,
          name: text.name,
          suffix: text.suffix
        })
      }
      return chips
    }
  },
  methods: {
    // 点表情 → 快速 toggle（添加/移除），失败提示由 toggleMessageReaction 统一处理
    handleEmojiTap(reactionID) {
      toggleMessageReaction(this.message, reactionID)
    },
    // 点名字区域 → 唤起回应详情
    handleChipTap(reactionID) {
      this.$emit('showDetail', reactionID)
    }
  }
}
</script>

<style>
.rb {
  flex: 1;
  flex-direction: row;
  flex-wrap: wrap;
  /* 父级 .msg__main 是 column 且 align-items: flex-start，子项宽度默认按内容自适应，
     没有上界时 flex-wrap 永远不换行、整行向右溢出（多选时左侧勾选列占宽后直接被裁掉）。
     stretch 让 .rb 宽度跟随父容器，chip 才能按可用宽度换行 */
  align-self: stretch;
}

.rb--out {
  /* .rb 已经是 stretch（撑满父宽），这里只需把 chip 内容右对齐 */
  justify-content: flex-end;
}

.rb__chip {
  flex-direction: row;
  align-items: center;
  max-width: 360rpx;
  margin-top: 12rpx;
  padding: 8rpx 16rpx;
  border-radius: 24rpx;
  background-color: #E4E7EF;
}

.rb__chip--in {
  margin-right: 16rpx;
}

.rb__chip--out {
  margin-left: 16rpx;
}

.rb__emoji {
  width: 32rpx;
  height: 32rpx;
}

.rb__texts {
  flex-direction: row;
  align-items: center;
}

.rb__line {
  width: 2rpx;
  height: 28rpx;
  margin: 0 8rpx;
  background-color: rgba(0, 0, 0, 0.12);
}

.rb__suffix {
  font-size: 24rpx;
  line-height: 32rpx;
  color: rgba(0, 0, 0, 0.55);
}

.rb__name {
  max-width: 200rpx;
  font-size: 24rpx;
  line-height: 32rpx;
  color: rgba(0, 0, 0, 0.55);
  lines: 1;
  text-overflow: ellipsis;
}

.rb__text--no-select {
  user-select: none;
  -webkit-user-select: none;
  -webkit-touch-callout: none;
}
</style>
