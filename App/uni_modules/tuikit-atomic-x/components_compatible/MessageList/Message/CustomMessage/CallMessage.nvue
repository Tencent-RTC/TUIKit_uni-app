<template>
  <view v-if="isGroupCall" class="group-call-message"><text class="group-call-text">{{ callText }}</text></view>
  <view v-else :class="['call-message', 'call-msg__content--'+ (message.isSelf ? 'out' : 'in')]">
    <text class="call-text">{{ callText }}</text>
    <image :class="['call-icon--'+ (isVideo ? 'video' : 'voice'), 'call-icon--'+ (message.isSelf ? 'out' : 'in')]" :src="isVideo ? videoIconSrc : voiceIconSrc" />
  </view>
</template>

<script>
import { parseCallMessageData, isVideoCall, getCallMessageText } from '../../../../utils/callMessageUtils'

export default {
  name: 'CallMessage',
  props: {
    message: { type: Object, required: true },
    isGroupCall: { type: Boolean, default: false }
  },
  data() {
    return {
      voiceIconSrc: '/uni_modules/tuikit-atomic-x/static/assets/message-list/voice-icon.png',
      videoIconSrc: '/uni_modules/tuikit-atomic-x/static/assets/message-list/video-icon.png'
    }
  },
  computed: {
    callData() { return parseCallMessageData(this.message) },
    isVideo() { return isVideoCall(this.callData) },
    callText() { return getCallMessageText(this.message) }
  }
}
</script>

<style>
.group-call-message { flex-direction: row; align-items: center; justify-content: center; }
.group-call-text { font-size: 24rpx; font-weight: 400; line-height: 34rpx; color: rgba(0, 0, 0, 0.4); }
.call-message { flex-direction: row; align-items: center; justify-content: center; border-radius: 12rpx; padding: 20rpx 24rpx; min-width: 160rpx; }
.call-msg__content--in { flex-direction: row-reverse; background-color: #F0F2F7; border-radius: 4rpx 20rpx 20rpx 20rpx; }
.call-msg__content--out { background-color: #CCE2FF; border-radius: 20rpx 4rpx 20rpx 20rpx; }
.call-text { font-size: 24rpx; font-weight: 400; line-height: 34rpx; color: rgba(0, 0, 0, 0.9); }
.call-icon--video { width: 32rpx; height: 22rpx; }
.call-icon--voice { width: 32rpx; height: 12rpx; }
.call-icon--out { margin-left: 10rpx; }
.call-icon--in { margin-right: 10rpx; }
.call-icon--video.call-icon--in { transform: rotate(180deg); }
</style>
