<template>
  <view class="video-message" :style="videoContainerStyle" @touchstart="handleTouchStart">
    <view class="video-highlight">
      <view class="video-cover">
        <image class="cover-image" :src="videoSnapshotUrl" mode="aspectFill" @load="handleSizeLoad" @error="handleCoverError" />
        <view class="play-button" @tap="handlePlayTap">
          <image v-if="!isDownloadingVideo" src="/uni_modules/tuikit-atomic-x/static/icon/play.png" class="icon-image" mode="aspectFill" />
          <text v-else class="download-percent">{{ downloadProgress }}%</text>
        </view>
        <view v-if="isDownloadingVideo" class="progress-bar">
          <view class="progress-bar__track">
            <view class="progress-bar__fill" :style="{ width: downloadProgress + '%' }"></view>
          </view>
        </view>
      </view>
    </view>
  </view>
</template>

<script>
import { MediaQuality } from '../../../../types/message'
import { useMessageListState } from '../../../../state/MessageListState'
import { useMessageActionState } from '../../../../state/MessageActionState'
import { stopGlobalAudioPlayer, RECORDING_PSEUDO_ID } from '../../../../hooks/useAudioPlayer'

var PLACEHOLDER_PREFIX = 'placeholder_video_'

// 长按判定阈值，与 Message.nvue 中保持一致
var LONG_PRESS_THRESHOLD = 350

export default {
  name: 'VideoMessage',
  props: {
    message: { type: Object, required: true },
    conversationID: { type: String, default: '' }
  },
  data() {
    var msgState = useMessageListState({ conversationID: this.conversationID })
    return { actualSize: { width: 0, height: 0 }, coverError: false, isDownloadingSnapshot: false, isDownloadingVideo: false, touchStartTime: 0, msgState: msgState }
  },
  computed: {
    videoSnapshotUrl() { var url = (this.message.messagePayload && this.message.messagePayload.videoSnapshotPath) || ''; if (url && url.startsWith('/') && !url.startsWith('file://')) url = 'file://' + url; return url },
    videoUrl() { var url = (this.message.messagePayload && this.message.messagePayload.videoPath) || ''; if (url && url.startsWith('/') && !url.startsWith('file://')) url = 'file://' + url; return url },
    videoSnapshotWidth() { return (this.message.messagePayload && this.message.messagePayload.videoSnapshotWidth) || 0 },
    videoSnapshotHeight() { return (this.message.messagePayload && this.message.messagePayload.videoSnapshotHeight) || 0 },
    downloadProgress() { return (this.message && this.message.progress != null) ? this.message.progress : 0 },
    videoContainerStyle() {
      var w = this.actualSize.width || this.videoSnapshotWidth || 400
      var h = this.actualSize.height || this.videoSnapshotHeight || 400
      if (w > 400) { h = (h * 400) / w; w = 400 }
      if (h > 300) { w = (w * 300) / h; h = 300 }
      if (w < 200) { h = (h * 200) / w; w = 200 }
      if (h < 150) { w = (w * 150) / h; h = 150 }
      return { width: w + 'rpx', height: h + 'rpx' }
    }
  },
  watch: {
    'message.msgID': { 
      handler: function(id) { 
        if (!id || id.indexOf(PLACEHOLDER_PREFIX) === 0) return;
        if (!this.videoSnapshotUrl) {
          this.checkAndDownloadSnapshot()
        }
        if (!this.videoUrl) {
          this.checkAndDownloadVideo()
        }
      }, immediate: true },
    videoSnapshotUrl: function(n, o) { if (n && !o && this.coverError) this.coverError = false }
  },
  methods: {
    handleTouchStart(e) { this.touchStartTime = Date.now() },
    handleSizeLoad(e) { if (e.detail) this.actualSize = { width: e.detail.width, height: e.detail.height } },
    handleCoverError() { this.coverError = true },
    handlePlayTap() {
      // 长按判定：触摸持续时间超过阈值视为长按，交由父级 Message.nvue 处理消息操作菜单
      // 注意：判定后必须复位 touchStartTime，否则下一次"未收到 touchstart 直接 tap"
      // （nvue 部分场景事件丢失）会用旧时间戳算出极大 duration，导致正常点击被误判为长按
      var startTime = this.touchStartTime
      this.touchStartTime = 0
      if (startTime > 0 && Date.now() - startTime >= LONG_PRESS_THRESHOLD) return
      if (this.videoUrl) {
        // 播放视频前停掉所有正在播放的语音消息：销毁全局 ctx + 广播 audioPlayerStart 让 AudioMessage 重置 UI
        stopGlobalAudioPlayer()
        uni.$emit('audioPlayerStart', { messageId: RECORDING_PSEUDO_ID })
        uni.navigateTo({ url: '/pages/scenes/chat/videoPlayer/videoPlayer?url=' + encodeURIComponent(this.videoUrl) })
        return
      }
      if(!this.videoUrl && this.isDownloadingVideo === false) {
        this.checkAndDownloadVideo()
      }
    },
    async checkAndDownloadSnapshot() {
      if (this.message && this.message.msgID && !this.videoSnapshotUrl && !this.isDownloadingSnapshot) {
        this.isDownloadingSnapshot = true
        try { await useMessageActionState({ message: this.message }).downloadMedia(MediaQuality.THUMBNAIL) } catch (e) { this.coverError = true } finally { this.isDownloadingSnapshot = false }
      }
    },
    async checkAndDownloadVideo() {
      if (!this.message || !this.message.msgID) { uni.showToast({ title: '视频地址无效', icon: 'none' }); return }
      if (this.isDownloadingVideo) { uni.showToast({ title: '正在加载视频资源...', icon: 'none' }); return }
      this.isDownloadingVideo = true
      try {
        await useMessageActionState({ message: this.message }).downloadMedia(MediaQuality.ORIGINAL)
      } catch (e) {
        uni.showToast({ title: '视频下载失败', icon: 'none' })
      } finally {
        this.isDownloadingVideo = false
      }
    }
  }
}
</script>

<style>
.video-message { position: relative; border-radius: 12rpx; overflow: hidden; }
.video-highlight { flex: 1; }
.video-cover { flex: 1; position: relative; }
.cover-image { flex: 1; border-radius: 20rpx; }
.play-button { position: absolute; top: 0; left: 0; right: 0; bottom: 0; align-items: center; justify-content: center; border-radius: 20rpx; background-color: rgba(0, 0, 0, 0.3); }
.icon-image { width: 80rpx; height: 80rpx; }
.download-percent { font-size: 32rpx; color: #FFFFFF; font-weight: 600; }
.progress-bar { position: absolute; left: 20rpx; right: 20rpx; bottom: 20rpx; }
.progress-bar__track { height: 6rpx; border-radius: 3rpx; background-color: rgba(255, 255, 255, 0.3); }
.progress-bar__fill { height: 6rpx; border-radius: 3rpx; background-color: #FFFFFF; }
</style>
