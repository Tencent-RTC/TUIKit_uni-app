<template>
  <view class="audio-message-wrapper" :class="{ 'audio-message-wrapper--self': message.isSentBySelf }">
    <view 
      class="audio-message" 
      :class="'content-'+ (message.isSentBySelf ? 'out' : 'in')" 
      :style="{ width: audioWidth + 'rpx' }"
      @touchstart="handleTouchStart"
      @tap="handlePlayTap"
    >
      <view class="audio-highlight">
        <view class="audio-wave-container" :class="'wave-'+ (message.isSentBySelf ? 'out' : 'in')">
          <view class="audio-wave-clip" :style="{ width: '12rpx', opacity: waveOpacity0 }">
            <image src="/uni_modules/tuikit-atomic-x/static/icon/audio.png" class="audio-wave-icon" mode="aspectFit" />
          </view>
          <view class="audio-wave-clip" :style="{ width: '26rpx', opacity: waveOpacity1 }">
            <image src="/uni_modules/tuikit-atomic-x/static/icon/audio.png" class="audio-wave-icon" mode="aspectFit" />
          </view>
          <view class="audio-wave-clip" :style="{ width: '40rpx', opacity: waveOpacity2 }">
            <image src="/uni_modules/tuikit-atomic-x/static/icon/audio.png" class="audio-wave-icon" mode="aspectFit" />
          </view>
        </view>
        <view class="audio-duration">
          <text class="duration-text">{{ formatDuration(soundDuration) }}</text>
        </view>
      </view>
    </view>

    <view
      v-if="convertBoxVisible"
      ref="convertBoxRef"
      class="audio-convert-box"
      :style="convertBoxInitStyle"
    >
      <text v-if="isConverting" class="audio-convert-text">...</text>
      <text v-else ref="convertTextRef" class="audio-convert-text" :style="convertTextInitStyle">{{ asrText }}</text>
    </view>
  </view>
</template>

<script>
import { MediaQuality } from '../../../../types/message'
import { useMessageListState } from '../../../../state/MessageListState'
import { useMessageActionState } from '../../../../state/MessageActionState'
import { useAudioPlayer, stopGlobalAudioPlayer } from '../../../../hooks/useAudioPlayer'
import { useCallState } from '../../../../state/CallState'

// nvue 原生动画模块：transition 在合成线程执行；nvue 对 css @keyframes 支持不稳定，必须用此模块
var animation = uni.requireNativePlugin('animation')

// 长按判定阈值，与 Message.nvue 中保持一致
var LONG_PRESS_THRESHOLD = 350

/**
 * Vue2 兼容版 AudioMessage（Options API）
 *
 * 关键设计：
 * 1. player 对象不放入 data()，避免 Vue2 深度 observe 破坏 makeRef 内部的响应式引用
 *    → 挂在 this._audioPlayer（_ 前缀实例属性不受 data 限制）
 * 2. 通过 useAudioPlayer 的 onPlayingChange 回调显式桥接 isPlaying → this.playingFlag
 *    → 避免轮询开销，响应即时
 * 3. 切后台暂停改用 plus.globalEvent 'pause' 事件（uni.onAppHide 在 nvue 中不可靠）
 */

// 本地存储 key：仅持久化用户主动\"隐藏\"的 msgID（值固定为 false）
// 默认未存储 → 视为可见 true，节省空间；切会话/重启 App 后保持用户上次的隐藏选择
var STORAGE_KEY = 'tuikit_audio_convert_visible_v1'

function readVisibleStore() {
  try {
    var raw = uni.getStorageSync(STORAGE_KEY)
    if (raw && typeof raw === 'object') return raw
    if (typeof raw === 'string' && raw) return JSON.parse(raw)
  } catch (e) {}
  return {}
}

function writeVisibleStore(store) {
  try {
    uni.setStorageSync(STORAGE_KEY, store)
  } catch (e) {
    console.error('[AudioMessage] writeVisibleStore failed:', e)
  }
}

export default {
  name: 'AudioMessage',
  props: {
    message: { type: Object, required: true },
    conversationID: { type: String, default: '' }
  },
  data: function() {
    // 初值从本地存储恢复：仅当显式标记为 false 时才隐藏，否则默认 true
    var store = readVisibleStore()
    var visible = (store[this.message.msgID] === false) ? false : true
    return {
      isDownloading: false,
      pendingPlay: false,
      waveStep: 0,
      waveTimer: null,
      playingFlag: false,
      touchStartTime: 0,
      // 语音转文字 loading 状态（仅本地控制，转换结果走 SDK 推送 message.messagePayload.asrText）
      isConverting: false,
      // 当前是否展示转换文本框；初值从本地存储恢复，"隐藏文字"会置 false 并持久化
      showConvertedText: visible,
      // 幕布动画三态机：
      // 'idle'：无动画需求（初始/历史消息），inline style 不输出 transform/opacity
      // 'pending'：v-if 渲染瞬间以 (opacity:0, scale(0,0)) 初始态挂载，等待 animation.transition
      // 'done'：动画完成后切到此态，inline style 输出 (opacity:1, scale(1,1)) 终态
      //   关键：iOS 下 animation.transition 不持久化样式，必须显式输出终态防止"飞回初始"
      curtainPhase: 'idle',
      msgState: useMessageListState({ conversationID: this.conversationID })
    }
  },
  created: function() {
    var self = this
    // 本次播放是否已尝试过远端 URL 回退（避免死循环重试）
    // 挂在 this._hasTriedRemoteFallback，不进 data() 避免不必要的响应式
    this._hasTriedRemoteFallback = false
    // player 挂在实例属性上，不进 data()，不被 Vue2 深度 observe
    this._audioPlayer = useAudioPlayer({
      messageId: this.message.msgID,
      onPlayingChange: function(playing) {
        // hook 内 isPlaying 变化时同步到 data，触发 watch(isPlaying) 启停波形动画
        self.playingFlag = playing
      },
      onComplete: function() { self._onPlayerComplete() },
      onError: function(error) { self._onPlayerError(error) }
    })
  },
  computed: {
    isPlaying: function() {
      return this.playingFlag
    },
    soundUrl: function() {
      return (this.message.messagePayload && this.message.messagePayload.audioPath) || ''
    },
    soundDuration: function() {
      return (this.message.messagePayload && this.message.messagePayload.audioDuration) || 0
    },
    audioWidth: function() {
      var d = this.soundDuration
      if (d <= 20) return 220
      if (d >= 60) return 474
      return 220 + (474 - 220) * ((d - 20) / (60 - 20))
    },
    waveOpacity0: function() {
      if (!this.isPlaying) return 0
      return this.waveStep === 0 ? 1 : 0
    },
    waveOpacity1: function() {
      if (!this.isPlaying) return 0
      return this.waveStep === 1 ? 1 : 0
    },
    waveOpacity2: function() {
      if (!this.isPlaying) return 1
      return this.waveStep === 2 ? 1 : 0
    },
    /**
     * 语音转文字结果：直接读 message.messagePayload.asrText
     * SDK 转换完成后会更新整条 message，由 MessageList 响应式刷新
     */
    asrText: function() {
      return (this.message && this.message.messagePayload && this.message.messagePayload.asrText) || ''
    },
    /**
     * 转写容器是否显示：loading 中 或 已有结果且未被用户隐藏
     * 合并 loading/result 为同一个 view，仅切换内层 text，避免 v-if/v-else-if 切换时
     * 外层 view 重建导致 ref 失效、滚动位置抖动
     */
    convertBoxVisible: function() {
      return this.isConverting || (!!this.asrText && this.showConvertedText)
    },
    /**
     * 转写容器初始 inline style（三态机驱动）
     * - 'pending'：(opacity:0, scale(0,0)) 等动画拉开
     * - 'done'：(opacity:1, scale(1,1)) 显式终态，防止 iOS animation.transition 完成后样式被清空
     * - 'idle'：空对象（历史消息直接显示）
     *
     * loading 态强制返回空对象，避免"正在转换..."也被 scale 缩放
     *
     * origin 区分发送方：
     * - 接收（isSelf=false）：从左上角拉开
     * - 发送（isSelf=true）：从右上角拉开（消息整体右对齐，文本框右贴气泡）
     */
    convertBoxInitStyle: function() {
      if (this.isConverting) return {}
      if (this.curtainPhase === 'pending') {
        return { opacity: 0, transform: 'scale(0, 0)', transformOrigin: this._curtainOrigin() }
      }
      if (this.curtainPhase === 'done') {
        return { opacity: 1, transform: 'scale(1, 1)', transformOrigin: this._curtainOrigin() }
      }
      return {}
    },
    convertTextInitStyle: function() {
      if (this.isConverting) return {}
      if (this.curtainPhase === 'pending') return { opacity: 0 }
      if (this.curtainPhase === 'done') return { opacity: 1 }
      return {}
    }
  },
  watch: {
    isPlaying: function(playing) {
      if (playing) this._startWaveAnimation()
      else this._stopWaveAnimation()
    },
    // asrText 变化策略：
    // - 由 isConverting=true → 出现新文本：转换完成，关闭 loading；置 curtainPhase='pending' 后由
    //   animation.transition 拉开幕布
    // - 通知 MessageList 跟随滚动：避免幕布展开后底部被输入框遮挡
    asrText: function(newText) {
      if (this.isConverting && newText) {
        this.curtainPhase = 'pending'
        this.isConverting = false
        this._playCurtainAnimation()
      }
      if (newText) {
        // 通知 MessageList：转写文本框出现，可能被输入框遮挡需要滚动让它可视
        // 附带 boxRef：MessageList 直接 getComponentRect(boxRef) 测可视性
        // nextTick 等渲染完成后再 emit，确保 boxRef 已绑定真实元素
        var self0 = this
        this.$nextTick(function() {
          var boxEl = self0.$refs.convertBoxRef
          if (Array.isArray(boxEl)) boxEl = boxEl[0]
          uni.$emit('audioConvertStreamGrow', { msgID: self0.message.msgID, boxRef: boxEl })
        })
      }
      this._syncVisibleMap()
    },
    // showConvertedText 变化时同步可见态到模块级 Map + 持久化到本地存储
    showConvertedText: function(visible) {
      this._syncVisibleMap()
      this._persistShowConvertedText(visible)
    }
  },
  mounted: function() {
    this._audioPlayer.setup()
    uni.$on('audioPlayerStart', this._handleGlobalAudioStart)
    // 转文字事件订阅（开始/失败/隐藏；成功结果通过 SDK 更新 message.messagePayload.asrText）
    uni.$on('audioConvertingStart', this._handleConvertingStart)
    uni.$on('audioConvertingError', this._handleConvertingError)
    uni.$on('audioConvertHide', this._handleConvertHide)
    // 初始化时同步一次可见态到模块级 Map
    this._syncVisibleMap()
    // 切后台暂停：使用 plus.globalEvent 代替不可靠的 uni.onAppHide
    var self = this
    if (typeof plus !== 'undefined' && plus.globalEvent) {
      this._pauseHandler = function() { self._handleAppHide() }
      plus.globalEvent.addEventListener('pause', this._pauseHandler)
    }
    if (!this.soundUrl) this._preDownloadSound()
  },
  beforeDestroy: function() { this._cleanup() },
  beforeUnmount: function() { this._cleanup() },
  methods: {
    _cleanup: function() {
      this._stopWaveAnimation()
      if (this._audioPlayer) this._audioPlayer.destroy()
      uni.$off('audioPlayerStart', this._handleGlobalAudioStart)
      uni.$off('audioConvertingStart', this._handleConvertingStart)
      uni.$off('audioConvertingError', this._handleConvertingError)
      uni.$off('audioConvertHide', this._handleConvertHide)
      // 清理模块级可见态缓存，避免 msgID 复用 / 内存泄漏
      try {
        var map = this._getVisibleMap()
        if (map) map['delete'](this.message.msgID)
      } catch (e) {}
      if (typeof plus !== 'undefined' && plus.globalEvent && this._pauseHandler) {
        plus.globalEvent.removeEventListener('pause', this._pauseHandler)
      }
    },
    _onPlayerComplete: function() {
      this._hasTriedRemoteFallback = false
      // playingFlag 会由 hook 的 onPlayingChange 回调自动置为 false
      this._stopWaveAnimation()
    },
    _onPlayerError: function(error) {
      // 本地播放失败时，尝试远端 URL 回退（仅回退一次）
      if (!this._hasTriedRemoteFallback) {
        var remoteUrl = this._getRemoteSoundUrl()
        if (remoteUrl) {
          this._hasTriedRemoteFallback = true
          // 不 toast、不停止动画，直接用远端 URL 重新播放
          // playingFlag 由 hook 的 onPlayingChange 回调维护
          this._audioPlayer.play(remoteUrl)
          return
        }
      }
      // 远端也无可用 URL 或远端也失败 → 最终报错
      this._hasTriedRemoteFallback = false
      this._stopWaveAnimation()
      var errCode = error && error.errCode
      var tip = errCode === -99 ? '音频格式暂不支持' : '播放失败'
      uni.showToast({ title: tip, icon: 'none' })
    },
    /**
     * 获取远端语音下载 URL
     * 路径: rawMessage.message.messageBaseElements[0].soundDownloadUrl
     * 任一层级缺失时返回空串
     */
    _getRemoteSoundUrl: function() {
      try {
        var rawMsg = this.message && this.message.rawMessage
        var elements = rawMsg && rawMsg.message && rawMsg.message.messageBaseElements
        if (elements && elements.length > 0) {
          return (elements[0] && elements[0].soundDownloadUrl) || ''
        }
      } catch (e) {
        console.error('[AudioMessage] _getRemoteSoundUrl error:', e)
      }
      return ''
    },
    formatDuration: function(d) {
      if (!d) return "0''"
      return Math.floor(d) + "''"
    },
    _startWaveAnimation: function() {
      this._stopWaveAnimation()
      this.waveStep = 0
      var self = this
      this.waveTimer = setInterval(function() {
        self.waveStep = (self.waveStep + 1) % 3
      }, 300)
    },
    _stopWaveAnimation: function() {
      if (this.waveTimer) {
        clearInterval(this.waveTimer)
        this.waveTimer = null
      }
      this.waveStep = 0
    },
    _handleGlobalAudioStart: function(data) {
      if (data && data.messageId && data.messageId !== this.message.msgID && this.playingFlag) {
        this._stopWaveAnimation()
        // stop() 内部会调 setPlaying(false) → onPlayingChange → this.playingFlag = false
        this._audioPlayer.stop()
      }
    },
    _handleAppHide: function() {
      if (this.playingFlag) {
        this._stopWaveAnimation()
        this._audioPlayer.stop()
      }
    },
    /**
     * 监听 MessageActions 广播的"开始转文字"事件
     * - 已有 asrText（之前转过 / 用户曾隐藏后再次点"转文字"）：直接走流式回放，不进 loading
     * - 没有 asrText：进入 loading 态等待 SDK 推送，watch(asrText) 收到结果后再启动流式
     */
    _handleConvertingStart: function(data) {
      if (!data || data.msgID !== this.message.msgID) return
      this.showConvertedText = true
      if (this.asrText) {
        // 已有缓存文本：直接展示并播幕布动画（asrText 未变化，watch 不触发，需手动驱动）
        this.curtainPhase = 'pending'
        this.isConverting = false
        this._playCurtainAnimation()
        // 主动通知 MessageList 跟随滚动；ref 此刻未必就绪，nextTick 后再 emit 拿到真实元素
        var self2 = this
        this.$nextTick(function() {
          var boxEl = self2.$refs.convertBoxRef
          if (Array.isArray(boxEl)) boxEl = boxEl[0]
          uni.$emit('audioConvertStreamGrow', { msgID: self2.message.msgID, boxRef: boxEl })
        })
      } else {
        this.isConverting = true
        // loading 容器也可能被输入框遮挡，通知 MessageList 测量并滚动让它可视
        // nextTick 等 v-if 渲染容器后 ref 才就绪
        var self3 = this
        this.$nextTick(function() {
          var boxEl = self3.$refs.convertBoxRef
          if (Array.isArray(boxEl)) boxEl = boxEl[0]
          uni.$emit('audioConvertStreamGrow', { msgID: self3.message.msgID, boxRef: boxEl })
        })
      }
    },
    /**
     * 监听 MessageActions 广播的"转文字失败"事件，释放 loading
     */
    _handleConvertingError: function(data) {
      if (data && data.msgID === this.message.msgID) {
        this.isConverting = false
      }
    },
    /**
     * 监听 MessageActions 广播的"隐藏文字"事件
     */
    _handleConvertHide: function(data) {
      if (data && data.msgID === this.message.msgID) {
        this.showConvertedText = false
      }
    },
    /**
     * 模块级 Map（msgID → 当前文本是否可见），供 MessageActions 长按时同步按钮文案
     * nvue 没有 globalThis，统一挂在 uni 上做跨组件共享
     */
    _getVisibleMap: function() {
      if (!uni.__audioConvertVisibleMap__) {
        uni.__audioConvertVisibleMap__ = new Map()
      }
      return uni.__audioConvertVisibleMap__
    },
    _syncVisibleMap: function() {
      var visible = !!this.asrText && this.showConvertedText
      this._getVisibleMap().set(this.message.msgID, visible)
    },
    /**
     * 幕布动画的 transform-origin：接收消息从左上角，自己发送从右上角
     */
    _curtainOrigin: function() {
      return (this.message && this.message.isSentBySelf) ? '100% 0' : '0 0'
    },
    /**
     * 播放"幕布从角拉开"入场动画（同 Vue3 实现）
     *
     * 容器 scale(0,0) → scale(1,1) ease-out-expo 360ms；
     * 文字 opacity 0 → 1 延迟 120ms 启动 240ms ease-out。
     *
     * 关键：动画结束后切到 'done' 阶段，inline style 显式输出终态，
     * 防止 iOS 下 animation.transition 完成后样式被清空导致"飞回初始"
     *
     * 健壮性：ref 时序兜底（重试 3 次），最终失败则切到 'done' 兜底显示
     */
    _playCurtainAnimation: function() {
      var self = this
      var attempt = 0
      var BOX_DURATION = 360
      var TEXT_DELAY = 120
      var TEXT_DURATION = 240
      var tryAnimate = function() {
        attempt += 1
        var boxEl = self.$refs.convertBoxRef
        var textEl = self.$refs.convertTextRef
        if (Array.isArray(boxEl)) boxEl = boxEl[0]
        if (Array.isArray(textEl)) textEl = textEl[0]
        if (boxEl) {
          animation.transition(boxEl, {
            styles: { opacity: 1, transform: 'scale(1, 1)', transformOrigin: self._curtainOrigin() },
            duration: BOX_DURATION,
            timingFunction: 'cubic-bezier(0.16, 1, 0.3, 1)',
            delay: 0
          })
          if (textEl) {
            animation.transition(textEl, {
              styles: { opacity: 1 },
              duration: TEXT_DURATION,
              timingFunction: 'ease-out',
              delay: TEXT_DELAY
            })
          }
          // 动画完成 + 50ms 缓冲后切到 'done' 终态
          var totalDuration = Math.max(BOX_DURATION, TEXT_DELAY + TEXT_DURATION) + 50
          setTimeout(function() { self.curtainPhase = 'done' }, totalDuration)
          return
        }
        if (attempt < 3) {
          setTimeout(tryAnimate, 32)
        } else {
          // 兜底：ref 始终拿不到，强制切到终态让元素显示
          console.error('[AudioMessage] curtain anim: ref unavailable, fallback to done state')
          self.curtainPhase = 'done'
        }
      }
      this.$nextTick(function() { setTimeout(tryAnimate, 16) })
    },
    /**
     * 持久化 showConvertedText 到本地存储
     * 仅写入 false（"用户主动隐藏"），true 即默认值不写
     */
    _persistShowConvertedText: function(visible) {
      var store = readVisibleStore()
      var msgID = this.message.msgID
      if (visible) {
        if (msgID in store) {
          delete store[msgID]
          writeVisibleStore(store)
        }
      } else {
        if (store[msgID] !== false) {
          store[msgID] = false
          writeVisibleStore(store)
        }
      }
    },
    handleTouchStart: function() {
      this.touchStartTime = Date.now()
    },
    handlePlayTap: function() {
      // 长按判定：触摸持续时间超过阈值视为长按，交由父级 Message.nvue 处理消息操作菜单
      // 注意：判定后必须复位 touchStartTime，否则下一次"未收到 touchstart 直接 tap"
      // （nvue 部分场景事件丢失）会用旧时间戳算出极大 duration，导致正常点击被误判为长按
      var startTime = this.touchStartTime
      this.touchStartTime = 0
      if (startTime > 0 && Date.now() - startTime >= LONG_PRESS_THRESHOLD) return
      // 通话中（呼叫中 / 通话中）禁止播放语音消息，避免抢占通话音频焦点
      if (this._isInCallNow()) {
        uni.showToast({ title: '您正在通话中，无法播放语音消息', icon: 'none', duration: 2000 })
        return
      }
      if (this.playingFlag) {
        this._audioPlayer.stop()
      } else {
        if (!this.soundUrl) {
          // 标记等待播放，并触发预下载（预下载内部会在失败时自动 fallback 远端）
          this.pendingPlay = true
          if (!this.isDownloading) {
            this._preDownloadSound()
          }
        } else {
          this._handlePlay()
        }
      }
    },
    /**
     * 判断当前是否处于音视频通话中
     * selfInfo.status === 1（呼叫中/待接听）或 2（通话中）
     */
    _isInCallNow: function() {
      var callStore = useCallState()
      var status = callStore && callStore.state && callStore.state.selfInfo && callStore.state.selfInfo.status
      return status === 1 || status === 2
    },
    _preDownloadSound: function() {
      var self = this
      if (!this.message || !this.message.msgID) return
      if (this.soundUrl) {
        if (this.pendingPlay) {
          this.pendingPlay = false
          this._handlePlay()
        }
        return
      }
      if (this.isDownloading) return
      this.isDownloading = true
      useMessageActionState({ message: this.message }).downloadMedia(MediaQuality.ORIGINAL).then(function() {
        if (self.pendingPlay && self.soundUrl) {
          self.pendingPlay = false
          self._handlePlay()
        }
      }).catch(function(err) {
        console.error('[AudioMessage] preDownloadSound failed:', err)
        // 下载失败，尝试用远端 URL 直接播放作为兜底
        if (self.pendingPlay) {
          self.pendingPlay = false
          var remoteUrl = self._getRemoteSoundUrl()
          if (remoteUrl) {
            // 标记为已尝试远端回退，避免 onError 再次重试
            self._hasTriedRemoteFallback = true
            stopGlobalAudioPlayer()
            // playingFlag 由 hook 的 onPlayingChange 回调维护
            self._audioPlayer.play(remoteUrl)
          } else {
            uni.showToast({ title: '语音下载失败', icon: 'none' })
          }
        }
      }).finally(function() {
        self.isDownloading = false
      })
    },
    /**
     * 开始播放（三级兜底）
     * 1. 优先本地路径
     * 2. 无本地路径但有远端 URL → 直接用远端
     * 3. 都没有 → toast 报错
     * 本地播放失败时 _onPlayerError 内会自动回退到远端
     */
    _handlePlay: function() {
      // 通话中（呼叫中 / 通话中）禁止播放——拦截所有路径（用户主动 tap、下载完成自动播）
      // 静默 return：tap 入口已弹过 toast，下载完成的自动播放属内部流程，无需再扰民
      if (this._isInCallNow()) {
        this.pendingPlay = false
        return
      }
      // 进入新一轮播放，重置远端回退标志
      this._hasTriedRemoteFallback = false
      
      var localUrl = this.soundUrl
      var remoteUrl = this._getRemoteSoundUrl()
      
      if (!localUrl && !remoteUrl) {
        uni.showToast({ title: '语音资源不可用', icon: 'none' })
        return
      }
      
      stopGlobalAudioPlayer()
      
      // 没本地路径，直接走远端（标记为已尝试过回退，避免 onError 再次回退）
      if (!localUrl && remoteUrl) {
        this._hasTriedRemoteFallback = true
        this._audioPlayer.play(remoteUrl)
        return
      }
      
      // 播放本地资源（失败时 _onPlayerError 内会自动回退到远端）
      // playingFlag 由 hook 的 onPlayingChange 回调维护
      this._audioPlayer.play(localUrl)
    }
  }
}
</script>

<style>
.audio-message-wrapper { flex-direction: column; align-items: flex-start; }
/* 自己发送的消息整体右对齐 */
.audio-message-wrapper--self { align-items: flex-end; }
.audio-message { min-width: 200rpx; }
.content-in { background-color: #F0F2F7; border-radius: 4rpx 20rpx 20rpx 20rpx; }
.content-out { background-color: #CCE2FF; border-radius: 20rpx 4rpx 20rpx 20rpx; }
.audio-highlight { flex: 1; flex-direction: row; align-items: center; padding: 20rpx; background-color: transparent; }
.content-out .audio-highlight { flex-direction: row-reverse; }
.audio-wave-container { position: relative; width: 40rpx; height: 40rpx; }
.wave-in { transform: scaleX(-1); }
.audio-wave-clip { position: absolute; right: 0; top: 0; height: 40rpx; overflow: hidden; }
.audio-wave-icon { position: absolute; right: 0; top: 0; width: 40rpx; height: 40rpx; }
.audio-duration { margin-left: 8rpx; margin-right: 8rpx; }
.duration-text { padding: 0 4rpx; font-size: 28rpx; line-height: 32rpx; font-weight: 500; color: rgba(0, 0, 0, 0.9); }
/* 语音转文字结果展示
 * 入场动画使用 nvue 原生 animation.transition 驱动（见 _playCurtainAnimation），
 * 而非 css @keyframes—— nvue 对 @keyframes 支持不稳定 */
.audio-convert-box { max-width: 474rpx; margin-top: 12rpx; padding: 16rpx 20rpx; background-color: rgba(255, 255, 255, 0.95); border-radius: 12rpx; border: 1rpx solid rgba(0, 0, 0, 0.08); }
.audio-convert-text { font-size: 28rpx; line-height: 40rpx; color: rgba(0, 0, 0, 0.85); lines: 0; }
</style>
