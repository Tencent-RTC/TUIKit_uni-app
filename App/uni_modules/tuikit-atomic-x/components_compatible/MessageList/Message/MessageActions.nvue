<template>
  <view class="msg-actions">
    <view class="msg-actions__mask" @tap="handleMaskTap"></view>
    <view ref="panelRef" class="msg-actions__panel" :style="panelStyle">
      <ReactionPicker
        v-if="reactionMode"
        :message="message"
        @collapse="handleReactionCollapse"
        @showAll="handleReactionShowAll"
        @close="safeClose"
      />
      <view v-else class="msg-actions__rows">
        <view
          v-for="(row, rowIndex) in actionRows"
          :key="rowIndex"
          class="msg-actions__row-wrap"
        >
          <view class="msg-actions__row">
            <view
              v-for="item in row"
              :key="item.key"
              class="msg-actions__item"
              @tap="handleActionTap(item)"
            >
              <image class="msg-actions__icon" :src="item.icon" mode="aspectFit"></image>
              <text class="msg-actions__text">{{ item.label }}</text>
            </view>
          </view>
          <view v-if="rowIndex < actionRows.length - 1" class="msg-actions__divider"></view>
        </view>
      </view>
    </view>
    <view class="msg-actions__arrow" :style="arrowStyle"></view>
  </view>
</template>

<script>
import { MessageStatus, MessageType } from '../../../types/message'
import { useMessageActionState } from '../../../state/MessageActionState'
import { throttle } from '../../../utils/lodash'
import { isCallMessage } from '../../../utils/callMessageUtils'
import { emitPremiumRequired } from '../../../utils/premiumRequired'
import ReactionPicker from './MessageReaction/ReactionPicker.nvue'
import { listAllReactionEmojis } from '../../../utils/reactionEmoji'

var ARROW_SIZE = 24
var GAP = 20
var ACTION_THROTTLE_WAIT = 1000
var ACTIONS_PER_ROW = 4
var TRANSLATE_TARGET_LANGUAGE = 'zh'
var TRANSLATE_STORAGE_KEY = 'tuikit_message_translate_visible_v1'

export default {
  name: 'MessageActions',
  components: { ReactionPicker },
  props: {
    message: { type: Object, required: true },
    actions: { type: Array, default: function() { return [] } }
  },
  data() {
    return {
      triggerPosition: { x: 0, y: 0 },
      phase: 'measure',
      showBelow: false,
      isCentered: false,
      panelHeightRpx: 0,
      panelLeftRpx: 0,
      panelWidthRpx: 0,
      reactionMode: false,
      actionState: null,
      copyIconSrc: '/uni_modules/tuikit-atomic-x/static/assets/message-list/msg_copy.png',
      deleteIconSrc: '/uni_modules/tuikit-atomic-x/static/assets/message-list/msg_delete.png',
      recallIconSrc: '/uni_modules/tuikit-atomic-x/static/assets/message-list/msg_recall.png',
      voiceToTextIconSrc: '/uni_modules/tuikit-atomic-x/static/assets/message-list/msg_voice_to_text.png',
      forwardIconSrc: '/uni_modules/tuikit-atomic-x/static/assets/message-list/msg_forward.png',
      multiSelectIconSrc: '/uni_modules/tuikit-atomic-x/static/assets/message-list/msg_multi_select.png',
      quoteIconSrc: '/uni_modules/tuikit-atomic-x/static/assets/message-list/msg_quote.png',
      translateIconSrc: '/uni_modules/tuikit-atomic-x/static/assets/message-list/msg_translate.png',
      hideIconSrc: '/uni_modules/tuikit-atomic-x/static/assets/message-list/msg_hide.png',
      reactionIconSrc: '/uni_modules/tuikit-atomic-x/static/assets/message-list/msg_reaction.png'
    }
  },
  computed: {
    canCopy() { return this.message.messageType === MessageType.TEXT && this.message.messagePayload && this.message.messagePayload.text },
    canRecall() {
      if (!this.message.isSentBySelf) return false
      if (this.message.status === MessageStatus.REVOKED || this.message.status === MessageStatus.DELETED) return false
      if (this.message.timestamp) { var diff = Math.floor(Date.now() / 1000) - this.message.timestamp; return diff <= 120 }
      return false
    },
    canConvertVoice() { return this.message.messageType === MessageType.AUDIO },
    canForward() {
      if (!this.message) return false
      if (this.message.status === MessageStatus.REVOKED || this.message.status === MessageStatus.DELETED) return false
      if (this.message.messageType === MessageType.TIPS) return false
      if (this.message.messageType === MessageType.CUSTOM && isCallMessage(this.message)) return false
      return true
    },
    // 多选入口：已撤回 / 已删除的消息本身不会走到长按菜单，这里只兜底过滤
    canMultiSelect() {
      if (!this.message) return false
      return this.message.status !== MessageStatus.REVOKED && this.message.status !== MessageStatus.DELETED
    },
    canQuote() {
      if (!this.message) return false
      if (this.message.status === MessageStatus.REVOKED || this.message.status === MessageStatus.DELETED) return false
      if (this.message.messageType === MessageType.TIPS) return false
      return true
    },
    // 与 native 一致：仅发送成功的消息且存在可用表情时才提供「贴表情」入口
    showReactionPicker() {
      return this.message.status === MessageStatus.SEND_SUCCESS && !!this.message.msgID && listAllReactionEmojis().length > 0
    },
    canTranslate() {
      if (!this.message) return false
      if (this.message.messageType !== MessageType.TEXT) return false
      if (this.message.status === MessageStatus.REVOKED || this.message.status === MessageStatus.DELETED) return false
      return !!(this.message.messagePayload && this.message.messagePayload.text)
    },
    voiceTextHasContent() {
      return !!(this.message && this.message.messagePayload && this.message.messagePayload.asrText)
    },
    voiceTextVisible() {
      if (!this.voiceTextHasContent) return false
      return this._readVisibleFlag(uni.__audioConvertVisibleMap__, 'tuikit_audio_convert_visible_v1')
    },
    voiceActionLabel() {
      return this.voiceTextVisible ? '隐藏文字' : '转文字'
    },
    translateHasContent() {
      var payload = this.message && this.message.messagePayload
      var sourceText = (payload && payload.text) || ''
      var map = payload && payload.translatedText
      if (!map || !sourceText) return false
      return !!map[sourceText]
    },
    translateVisible() {
      if (!this.translateHasContent) return false
      return this._readVisibleFlag(uni.__messageTranslateVisibleMap__, TRANSLATE_STORAGE_KEY)
    },
    translateActionLabel() {
      return this.translateVisible ? '隐藏' : '翻译'
    },
    actionConfig() {
      return [
        { key: 'copy', label: '复制', icon: this.copyIconSrc, visible: this.canCopy, handler: this.handleCopy },
        { key: 'delete', label: '删除', icon: this.deleteIconSrc, visible: true, handler: this.handleDelete },
        { key: 'voiceToText', label: this.voiceActionLabel, icon: this.voiceToTextIconSrc, visible: this.canConvertVoice, handler: this.handleVoiceToText },
        { key: 'recall', label: '撤回', icon: this.recallIconSrc, visible: this.canRecall, handler: this.handleRecall },
        { key: 'forward', label: '转发', icon: this.forwardIconSrc, visible: this.canForward, handler: this.handleForward },
        { key: 'multiSelect', label: '多选', icon: this.multiSelectIconSrc, visible: this.canMultiSelect, handler: this.handleMultiSelect },
        { key: 'reaction', label: '贴表情', icon: this.reactionIconSrc, visible: this.showReactionPicker, handler: this.handleReactionEntry },
        { key: 'quote', label: '引用', icon: this.quoteIconSrc, visible: this.canQuote, handler: this.handleQuote },
        { key: 'translate', label: this.translateActionLabel, icon: this.translateVisible ? this.hideIconSrc : this.translateIconSrc, visible: this.canTranslate, handler: this.handleTranslate }
      ]
    },
    visibleActions() {
      var available = this.actionConfig.filter(function(item) { return item.visible })
      var configured = this.actions
      if (!configured || configured.length === 0) return available
      var result = []
      configured.forEach(function(key) {
        var found = null
        for (var i = 0; i < available.length; i++) {
          if (available[i].key === key) { found = available[i]; break }
        }
        if (found) result.push(found)
      })
      return result
    },
    actionRows() {
      var rows = []
      var list = this.visibleActions
      for (var i = 0; i < list.length; i += ACTIONS_PER_ROW) {
        rows.push(list.slice(i, i + ACTIONS_PER_ROW))
      }
      return rows
    },
    viewportMinRpx() {
      var si = uni.getSystemInfoSync()
      var sw = si.windowWidth || 375
      var navH = si.platform === 'android' ? 48 : 44
      var safeTop = (si.safeArea && si.safeArea.top) ? si.safeArea.top : 0
      return (safeTop + navH + 8) / sw * 750
    },
    viewportMaxRpx() {
      var si = uni.getSystemInfoSync()
      var sw = si.windowWidth || 375
      var sh = si.screenHeight || si.windowHeight || 667
      var safeBottom = (si.safeArea && si.safeArea.bottom) ? (sh - si.safeArea.bottom) : 0
      return (sh - safeBottom - 8) / sw * 750
    },
    panelTopRpx() {
      var tp = this.triggerPosition
      var ph = this.panelHeightRpx
      var want = this.showBelow ? (tp.y + tp.messageHeight + GAP) : (tp.y - ph - GAP)
      if (ph <= 0) return want
      var minTop = this.viewportMinRpx
      var maxBottom = this.viewportMaxRpx
      if (this.isCentered) return Math.round((minTop + maxBottom - ph) / 2)
      var result = want
      if (result < minTop) result = minTop
      if (result > maxBottom - ph) result = maxBottom - ph
      return Math.round(result)
    },
    panelStyle() {
      var tp = this.triggerPosition
      if (this.phase === 'measure') {
        return { top: '-9999rpx', left: '0rpx', opacity: 0 }
      }
      if (!tp.x || !tp.y) return { visibility: 'hidden' }
      var pos = { top: this.panelTopRpx + 'rpx' }
      if (this.isCentered && this.panelWidthRpx > 0) {
        pos.left = Math.round((750 - this.panelWidthRpx) / 2) + 'rpx'
      } else if (tp.isSentBySelf) {
        pos.right = tp.x + 'rpx'
      } else {
        pos.left = tp.x + 'rpx'
      }
      return pos
    },
    arrowStyle() {
      if (this.phase !== 'ready') return { visibility: 'hidden' }
      if (this.isCentered) return { visibility: 'hidden' }
      var tp = this.triggerPosition
      if (!tp.x || !tp.y) return { visibility: 'hidden' }
      var si = uni.getSystemInfoSync()
      var sw = si.windowWidth || 375
      var arrowLeft = (tp.messageX + tp.messageWidth / 2) / sw * 750 - ARROW_SIZE / 2
      var pw = this.panelWidthRpx
      if (pw > 0) {
        var panelFinalLeft
        if (tp.isSentBySelf) {
          panelFinalLeft = 750 - tp.x - pw
        } else {
          panelFinalLeft = tp.x
        }
        var panelFinalRight = panelFinalLeft + pw
        var inset = 16
        var minLeft = panelFinalLeft + inset
        var maxLeft = panelFinalRight - ARROW_SIZE - inset
        if (arrowLeft < minLeft) arrowLeft = minLeft
        if (arrowLeft > maxLeft) arrowLeft = maxLeft
      }
      var style = { left: arrowLeft + 'rpx', visibility: 'visible' }
      if (this.showBelow) {
        style.top = (this.panelTopRpx - ARROW_SIZE / 2) + 'rpx'
      } else {
        style.top = (this.panelTopRpx + this.panelHeightRpx - ARROW_SIZE / 2) + 'rpx'
      }
      return style
    }
  },
  created() {
    var self = this
    this.handleCopy = throttle(function() { self._handleCopyImpl() }, ACTION_THROTTLE_WAIT, { leading: true, trailing: false })
    this.handleDelete = throttle(function() { self._handleDeleteImpl() }, ACTION_THROTTLE_WAIT, { leading: true, trailing: false })
    this.handleRecall = throttle(function() { self._handleRecallImpl() }, ACTION_THROTTLE_WAIT, { leading: true, trailing: false })
    this.handleVoiceToText = throttle(function() { self._handleVoiceToTextImpl() }, ACTION_THROTTLE_WAIT, { leading: true, trailing: false })
    this.handleForward = throttle(function() { self._handleForwardImpl() }, ACTION_THROTTLE_WAIT, { leading: true, trailing: false })
    this.handleMultiSelect = throttle(function() { self._handleMultiSelectImpl() }, ACTION_THROTTLE_WAIT, { leading: true, trailing: false })
    this.handleQuote = throttle(function() { self._handleQuoteImpl() }, ACTION_THROTTLE_WAIT, { leading: true, trailing: false })
    this.handleTranslate = throttle(function() { self._handleTranslateImpl() }, ACTION_THROTTLE_WAIT, { leading: true, trailing: false })
  },
  mounted() {
    this.actionState = useMessageActionState({ message: this.message })
  },
  beforeDestroy() { if (this.actionState) this.actionState.destroyStore() },
  beforeUnmount() { if (this.actionState) this.actionState.destroyStore() },
  methods: {
    _readVisibleFlag(runtimeMap, storageKey) {
      var msgID = this.message.msgID
      if (runtimeMap && typeof runtimeMap.has === 'function' && runtimeMap.has(msgID)) {
        return runtimeMap.get(msgID) === true
      }
      try {
        var raw = uni.getStorageSync(storageKey)
        var store = null
        if (raw && typeof raw === 'object') {
          store = raw
        } else if (typeof raw === 'string' && raw) {
          store = JSON.parse(raw)
        }
        if (store && store[msgID] === false) return false
      } catch (e) {}
      return true
    },
    handleActionTap(item) {
      if (item && item.handler) item.handler()
    },
    setTriggerPosition(position) {
      this.triggerPosition = {
        x: position.x, y: position.y,
        messageX: position.messageX, messageWidth: position.messageWidth,
        messageHeight: position.messageHeight, isSentBySelf: position.isSentBySelf
      }
      this.phase = 'measure'
      var self = this
      this.$nextTick(function() {
        setTimeout(function() {
          self._measureAndPosition()
        }, 30)
      })
    },
    _measureAndPosition() {
      var self = this
      var panelEl = this.$refs.panelRef
      if (!panelEl) { self.phase = 'ready'; return }
      var dom = uni.requireNativePlugin('dom')
      dom.getComponentRect(panelEl, function(result) {
        if (result && result.result) {
          var si = uni.getSystemInfoSync()
          var sw = si.windowWidth || 375
          self.panelHeightRpx = Math.round(result.size.height / sw * 750)
          self.panelLeftRpx = Math.round(result.size.left / sw * 750)
          self.panelWidthRpx = Math.round(result.size.width / sw * 750)
        }
        if (self.panelHeightRpx <= 0) { self.phase = 'ready'; return }
        var tp = self.triggerPosition
        var minTop = self.viewportMinRpx
        var maxBottom = self.viewportMaxRpx
        var ph = self.panelHeightRpx
        var inSafeArea = function(top) { return top >= minTop && top + ph <= maxBottom }
        var canBelow = inSafeArea(tp.y + tp.messageHeight + GAP)
        var canAbove = inSafeArea(tp.y - GAP - ph)
        if (canBelow) {
          self.showBelow = true
          self.isCentered = false
        } else if (canAbove) {
          self.showBelow = false
          self.isCentered = false
        } else {
          self.isCentered = true
        }
        self.phase = 'ready'
      })
    },
    safeClose() {
      // #ifdef APP-IOS
      var self = this; setTimeout(function() { self.$emit('close') }, 300)
      // #endif
      // #ifndef APP-IOS
      this.$emit('close')
      // #endif
    },
    handleMaskTap() { this.safeClose() },
    _handleCopyImpl() {
      if (this.message.messagePayload && this.message.messagePayload.text) {
        uni.setClipboardData({ data: this.message.messagePayload.text, success: function() { uni.showToast({ title: '已复制', icon: 'none' }) } })
      }
      this.$emit('action', { key: 'copy', text: '复制' }); this.safeClose()
    },
    async _handleDeleteImpl() {
      try { await this.actionState.delete(); this.safeClose() }
      catch (e) { uni.showToast({ title: '删除失败', icon: 'none', duration: 2000 }); this.safeClose() }
    },
    async _handleRecallImpl() {
      try { await this.actionState.revoke(); this.safeClose() }
      catch (e) { uni.showToast({ title: '撤回失败', icon: 'none', duration: 2000 }); this.safeClose() }
    },
    _handleForwardImpl() {
      this.$emit('action', { key: 'forward', text: '转发' })
      this.safeClose()
    },
    _handleMultiSelectImpl() {
      this.$emit('action', { key: 'multiSelect', text: '多选' })
      this.safeClose()
    },
    _handleQuoteImpl() {
      this.$emit('action', { key: 'quote', text: '引用' })
      this.safeClose()
    },
    // 点「贴表情」→ 切换到表情面板（panel 高度变化，需重新测量定位）
    handleReactionEntry() {
      this.reactionMode = true
      this.phase = 'measure'
      var self = this
      this.$nextTick(function() {
        setTimeout(function() { self._measureAndPosition() }, 30)
      })
    },
    // 收起表情面板 → 返回操作菜单（重新测量定位）
    handleReactionCollapse() {
      this.reactionMode = false
      this.phase = 'measure'
      var self = this
      this.$nextTick(function() {
        setTimeout(function() { self._measureAndPosition() }, 30)
      })
    },
    // 点「更多」→ 关闭菜单，唤起全量表情选择器（底部弹层）
    handleReactionShowAll() {
      this.$emit('showAll')
      this.safeClose()
    },
    _handleVoiceToTextImpl() {
      var msgID = this.message.msgID
      var visible = this.voiceTextVisible
      this.$emit('action', { key: visible ? 'voiceTextHide' : 'voiceToText', text: this.voiceActionLabel })
      this.safeClose()

      if (visible) {
        uni.$emit('audioConvertHide', { msgID: msgID })
        return
      }

      uni.$emit('audioConvertingStart', { msgID: msgID })

      var language = 'zh'
      if (!this.actionState || !this.actionState.convertVoiceToText) {
        uni.$emit('audioConvertingError', { msgID: msgID })
        uni.showToast({ title: '转换失败', icon: 'none' })
        return
      }
      this.actionState.convertVoiceToText(language).catch(function(err) {
        console.error('[MessageActions] convertVoiceToText failed:', err)
        uni.$emit('audioConvertingError', { msgID: msgID })
        var toastTitle = '转换失败'
        if (err && err.code === 140008) {
          toastTitle = '当前 SDKAppID 尚未开通语音转文字（ASR）服务'
        } else if (err && err.message) {
          toastTitle = err.message
        }
        uni.showToast({ title: toastTitle, icon: 'none' })
      })
    },
    _handleTranslateImpl() {
      var msgID = this.message.msgID
      var visible = this.translateVisible
      this.$emit('action', { key: visible ? 'translateHide' : 'translate', text: this.translateActionLabel })
      this.safeClose()

      if (visible) {
        uni.$emit('messageTranslateHide', { msgID: msgID })
        return
      }

      uni.$emit('messageTranslateStart', { msgID: msgID })

      if (this.translateHasContent) return

      var sourceText = (this.message.messagePayload && this.message.messagePayload.text) || ''
      if (!this.actionState || !this.actionState.translateText || !sourceText) {
        uni.$emit('messageTranslateError', { msgID: msgID })
        uni.showToast({ title: '翻译失败', icon: 'none' })
        return
      }
      this.actionState.translateText([sourceText], undefined, TRANSLATE_TARGET_LANGUAGE).catch(function(err) {
        console.error('[MessageActions] translateText failed:', err)
        uni.$emit('messageTranslateError', { msgID: msgID })
        if (err && /require.*payment|purchase/i.test(err.message || '')) {
          emitPremiumRequired('文本翻译能力需要单独购买，请购买后再使用')
          return
        }
        uni.showToast({ title: (err && err.message) ? err.message : '翻译失败', icon: 'none' })
      })
    }
  }
}
</script>

<style>
.msg-actions { position: fixed; top: 0; left: 0; right: 0; bottom: 0; z-index: 999; }
.msg-actions__mask { position: absolute; top: 0; left: 0; right: 0; bottom: 0; background-color: rgba(255, 255, 255, 0.01); }
.msg-actions__panel { position: absolute; flex-direction: column; background-color: #FFFFFF; border-radius: 12rpx; box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.25); padding-top: 11rpx; max-width: 560rpx; z-index: 1000; justify-content: center; align-items: flex-start; left: auto; right: auto; }
.msg-actions__rows { padding: 22rpx 0 22rpx; flex-direction: column; align-items: flex-start; }
.msg-actions__row-wrap { flex-direction: column; align-items: flex-start; }
.msg-actions__row { flex-direction: row; justify-content: flex-start; align-items: center; }
.msg-actions__divider { width: 420rpx; height: 2rpx; background-color: #F0F2F7; margin: 20rpx 40rpx; }
.msg-actions__item { flex-direction: column; align-items: center; justify-content: center; width: 125rpx; margin: 0rpx; }
.msg-actions__item:active { opacity: 0.6; }
.msg-actions__icon { width: 36rpx; height: 36rpx; margin-bottom: 10rpx; }
.msg-actions__text { font-size: 20rpx; color: rgba(0, 0, 0, 0.55); text-align: center; }
.msg-actions__arrow { position: absolute; width: 24rpx; height: 24rpx; background-color: #FFFFFF; transform: rotate(45deg); z-index: 1001; }
</style>
