<template>
  <view class="conversation-actions">
    <view 
      v-for="action in actionList"
      :key="action.key"
      class="conversation-actions__action"
      :style="getActionStyle(action)"
      @tap.stop="handleActionTap(action)"
    >
      <text 
        class="conversation-actions__action-text"
        :style="getTextStyle(action)"
      >
        {{ action.text }}
      </text>
    </view>
  </view>
</template>

<script>
import { ConversationReceiveOption } from '../../types/conversation'
import { ConversationActionType } from '../../types/conversationList'

export default {
  name: 'ConversationActions',
  props: {
    conversation: {
      type: Object,
      required: true
    },
    actions: {
      type: Array,
      default: null
    },
    isSupportPin: {
      type: Boolean,
      default: true
    },
    isSupportMute: {
      type: Boolean,
      default: true
    },
    isSupportDelete: {
      type: Boolean,
      default: true
    }
  },
  computed: {
    isMuted() {
      return this.conversation.receiveOption === ConversationReceiveOption.NOT_RECEIVE ||
             this.conversation.receiveOption === ConversationReceiveOption.NOT_NOTIFY
    },
    actionList() {
      if (this.actions && this.actions.length > 0) {
        return this.actions.map(action => ({
          ...action,
          text: action.text || this.getDefaultText(action.key)
        }))
      }
      
      const actions = []
      
      if (this.isSupportMute) {
        actions.push({
          key: ConversationActionType.MUTE,
          text: this.isMuted ? '取消免打扰' : '免打扰'
        })
      }
      
      if (this.isSupportPin) {
        actions.push({
          key: ConversationActionType.PIN,
          text: this.conversation.isPinned ? '取消置顶' : '置顶'
        })
      }
      
      if (this.isSupportDelete) {
        actions.push({
          key: ConversationActionType.DELETE,
          text: '删除'
        })
      }
      
      return actions
    }
  },
  methods: {
    getDefaultText(key) {
      switch (key) {
        case ConversationActionType.PIN:
          return this.conversation.isPinned ? '取消置顶' : '置顶'
        case ConversationActionType.MUTE:
          return this.isMuted ? '取消免打扰' : '免打扰'
        case ConversationActionType.DELETE:
          return '删除'
        default:
          return key
      }
    },
    getDefaultBackgroundColor(key) {
      switch (key) {
        case ConversationActionType.PIN:
          return '#FF7200'
        case ConversationActionType.MUTE:
          return '#1C66E5'
        case ConversationActionType.DELETE:
          return '#E54545'
        default:
          return '#999999'
      }
    },
    getActionStyle(action) {
      return {
        backgroundColor: action.backgroundColor || this.getDefaultBackgroundColor(action.key)
      }
    },
    getTextStyle(action) {
      return {
        color: action.color || '#ffffff'
      }
    },
    handleActionTap(action) {
      const conversationID = this.conversation.conversationID
      
      if (action.onClick && typeof action.onClick === 'function') {
        action.onClick(conversationID)
        return
      }
      
      switch (action.key) {
        case ConversationActionType.PIN:
          this.$emit('conversationPin', conversationID, !this.conversation.isPinned)
          break
        case ConversationActionType.MUTE:
          this.$emit('conversationMute', conversationID, !this.isMuted)
          break
        case ConversationActionType.DELETE:
          this.$emit('conversationDelete', conversationID)
          break
      }
    }
  }
}
</script>

<style>
.conversation-actions {
  flex-direction: row;
  flex: 1;
}

.conversation-actions__action {
  width: 160rpx;
  justify-content: center;
  align-items: center;
}

.conversation-actions__action-text {
  font-size: 28rpx;
  line-height: 39rpx;
  font-weight: 400;
}
</style>
