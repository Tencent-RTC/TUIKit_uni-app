<template>
  <view class="conversation-list">
    <view v-if="isLoading && PlaceholderLoading" class="conversation-list__placeholder">
      <component :is="PlaceholderLoading" />
    </view>

    <view v-else-if="loadError && PlaceholderLoadError" class="conversation-list__placeholder">
      <component :is="PlaceholderLoadError" :error="loadError" />
    </view>

    <view v-else-if="filteredAndSortedList.length === 0 && PlaceholderEmptyList" class="conversation-list__placeholder">
      <component :is="PlaceholderEmptyList" />
    </view>

    <list v-else class="conversation-list__scroll" :show-scrollbar="false">
      <cell 
        v-for="(conversation, index) in filteredAndSortedList" 
        :key="conversation.conversationID"
      >
        <SwipeActions
          :ref="'swipe_' + conversation.conversationID"
          :actionsWidth="computedActionsWidth"
          :disabled="!hasVisibleActions"
          @contentTap="handleConversationTap(conversation)"
          @open="handleSwipeOpen(conversation.conversationID)"
        >
          <component 
            :is="Preview"
            :conversation="conversation"
            :Avatar="Avatar"
          />
          
          <template v-slot:actions v-if="hasVisibleActions">
            <component
              :is="ConversationActionsComp"
              :conversation="conversation"
              :actions="actionsConfig.actions"
              :isSupportPin="actionsConfig.isSupportPin"
              :isSupportMute="actionsConfig.isSupportMute"
              :isSupportDelete="actionsConfig.isSupportDelete"
              @conversationPin="handlePin"
              @conversationMute="handleMute"
              @conversationDelete="handleDelete"
            />
          </template>
        </SwipeActions>
      </cell>
    </list>
  </view>
</template>

<script>
import { useConversationListState } from '../../state/ConversationListState'
import SwipeActions from '../SwipeActions/SwipeActions.nvue'
import DefaultPreview from './ConversationPreview.nvue'
import ConversationActionsComponent from './ConversationActions.nvue'
import AvatarComponent from '../Avatar'
import DefaultEmptyList from './placeholders/EmptyList.nvue'
import DefaultLoading from './placeholders/Loading.nvue'
import DefaultLoadError from './placeholders/LoadError.nvue'

export default {
  name: 'ConversationList',
  components: {
    SwipeActions,
  },
  props: {
    actionsConfig: {
      type: Object,
      default() {
        return {
          isSupportPin: true,
          isSupportMute: true,
          isSupportDelete: true
        }
      }
    },
    Preview: {
      type: [Object, Function],
      default() { return DefaultPreview }
    },
    ConversationActions: {
      type: [Object, Function],
      default() { return ConversationActionsComponent }
    },
    Avatar: {
      type: [Object, Function],
      default() { return AvatarComponent }
    },
    PlaceholderEmptyList: {
      type: [Object, Function],
      default() { return DefaultEmptyList }
    },
    PlaceholderLoading: {
      type: [Object, Function],
      default() { return DefaultLoading }
    },
    PlaceholderLoadError: {
      type: [Object, Function],
      default() { return DefaultLoadError }
    },
    filter: {
      type: Function,
      default: null
    },
    sort: {
      type: Function,
      default: null
    }
  },
  data() {
    const storeInstance = useConversationListState()
    return {
      storeInstance,
      isLoading: false,
      loadError: null,
      openedSwipeActionId: null,
      isCleaned: false,
    }
  },
  computed: {
    ConversationActionsComp() {
      return this.ConversationActions
    },
    filteredAndSortedList() {
      let list = [...this.storeInstance.state.conversationList]
      if (this.filter) {
        list = list.filter(this.filter)
      }
      if (this.sort) {
        list.sort(this.sort)
      }
      return list
    },
    computedActionsWidth() {
      const config = this.actionsConfig || {}
      if (config.actions && config.actions.length > 0) {
        return config.actions.length * 160
      }
      let count = 0
      if (config.isSupportPin) count++
      if (config.isSupportMute) count++
      if (config.isSupportDelete) count++
      return count * 160 || 480
    },
    hasVisibleActions() {
      const config = this.actionsConfig || {}
      if (config.actions && config.actions.length > 0) {
        return true
      }
      return config.isSupportPin || config.isSupportMute || config.isSupportDelete
    }
  },
  // Vue2 生命周期
  beforeDestroy() {
    this._cleanup()
  },
  // Vue3 生命周期
  beforeUnmount() {
    this._cleanup()
  },
  methods: {
    _cleanup() {
      if (this.isCleaned) return
      this.isCleaned = true
      if (this.openedSwipeActionId) {
        const refKey = 'swipe_' + this.openedSwipeActionId
        const ref = this.$refs[refKey]
        if (ref) {
          const el = Array.isArray(ref) ? ref[0] : ref
          if (el && el.close) el.close()
        }
      }
      this.openedSwipeActionId = null
      this.storeInstance.destroyStore()
    },
    getSwipeRef(conversationID) {
      const refKey = 'swipe_' + conversationID
      const ref = this.$refs[refKey]
      if (!ref) return null
      return Array.isArray(ref) ? ref[0] : ref
    },
    handleSwipeOpen(conversationID) {
      if (this.openedSwipeActionId && this.openedSwipeActionId !== conversationID) {
        const prevRef = this.getSwipeRef(this.openedSwipeActionId)
        if (prevRef && prevRef.close) {
          try { prevRef.close() } catch (e) {}
        }
      }
      this.openedSwipeActionId = conversationID
    },
    handleConversationTap(conversation) {
      if (this.openedSwipeActionId) {
        this.closeSwipeAction()
        this.openedSwipeActionId = null
      } else {
        if (conversation.unreadCount > 0) {
          this.storeInstance.clearConversationUnreadCount(conversation.conversationID)
        }
        this.$emit('conversationSelect', conversation)
      }
    },
    async handlePin(conversationID, isPinned) {
      try {
        this.$emit('conversationPin', conversationID, isPinned)
        await this.storeInstance.pinConversation(conversationID, isPinned)
      } catch (error) {
        uni.showToast({
          title: isPinned ? '置顶失败' : '取消置顶失败',
          icon: 'none',
          duration: 2000
        })
      } finally {
        this.closeSwipeAction()
      }
    },
    async handleMute(conversationID, isMuted) {
      try {
        this.$emit('conversationMute', conversationID, isMuted)
        await this.storeInstance.muteConversation(conversationID, isMuted)
      } catch (error) {
        uni.showToast({
          title: isMuted ? '设置免打扰失败' : '取消免打扰失败',
          icon: 'none',
          duration: 2000
        })
      } finally {
        this.closeSwipeAction()
      }
    },
    async handleDelete(conversationID) {
      try {
        this.$emit('conversationDelete', conversationID)
        await this.storeInstance.deleteConversation(conversationID)
      } catch (error) {}
    },
    closeSwipeAction() {
      if (this.openedSwipeActionId) {
        const ref = this.getSwipeRef(this.openedSwipeActionId)
        if (ref && ref.close) {
          ref.close()
        }
        this.openedSwipeActionId = null
      }
    }
  }
}
</script>

<style>
.conversation-list {
  flex: 1;
  background-color: #ffffff;
}

.conversation-list__placeholder {
  flex: 1;
  justify-content: center;
  align-items: center;
}

.conversation-list__scroll {
  flex: 1;
}
</style>
