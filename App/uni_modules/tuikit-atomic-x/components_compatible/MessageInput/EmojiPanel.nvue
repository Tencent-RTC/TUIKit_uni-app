<template>
  <view class="emoji-panel">
    <list class="emoji-list" :show-scrollbar="false">
      <cell v-for="(row, rowIndex) in chunkedEmojiList" :key="rowIndex" class="emoji-cell">
        <view class="emoji-row">
          <view v-for="(emoji, colIndex) in row" :key="colIndex" class="emoji-item" @tap="handleEmojiTap(emoji)">
            <text class="emoji-text">{{ emoji.key || emoji }}</text>
          </view>
        </view>
      </cell>
      <cell><view style="height: 40rpx;"></view></cell>
    </list>
  </view>
</template>

<script>
var DEFAULT_EMOJIS = [
  '😀','😃','😄','😁','😆','😅','🤣','😂','🙂','🙃','😉','😊','😇','🥰','😍','🤩',
  '😘','😗','☺️','😚','😙','😋','😛','😜','🤪','😝','🤑','🤗','🤭','🤫','🤔',
  '🤐','🤨','😐','😑','😶','😏','😒','🙄','😬','🤥','😌','😔','😪','🤤','😴','😷',
  '🤒','🤕','🤢','🤮','🤧','🥵','🥶','🥴','😵','🤯','🤠','🥳','😠','😎','🤓','🧐',
  '😕','😟','🙁','☹️','😮','😯','😲','😳','🥺','😦','😧','😨','😰','😥','😢','😭',
  '😱','😖','😣','😞','😓','😩','😫','🥱','😤','😡','🤬','😈','👿','💀','☠️',
  '🤡','👹','👺','👻','👽','👾','🤖','😺','😸','😹','😻','😼','😽','🙀','😿',
  '😾','🙈','🙉','🙊','💋','💌','💘','💝','💖','💗','💓','💞','💕','💟','❣️','💔'
]
var COLUMNS = 8

export default {
  name: 'EmojiPanel',
  computed: {
    normalizedList() { return DEFAULT_EMOJIS.map(function(e) { return { key: e } }) },
    chunkedEmojiList() {
      var result = []; var list = this.normalizedList
      for (var i = 0; i < list.length; i += COLUMNS) { result.push(list.slice(i, i + COLUMNS)) }
      return result
    }
  },
  methods: {
    handleEmojiTap(emoji) {
      this.$emit('select', emoji)
    }
  }
}
</script>

<style scoped>
.emoji-panel { flex: 1; background-color: #fff; padding-top: 23rpx; padding-bottom: 23rpx; transform: translateY(0); }
.emoji-list { flex: 1; }
.emoji-cell { background-color: #fff; }
.emoji-row { flex-direction: row; padding-left: 48rpx; padding-right: 48rpx; height: 104rpx; align-items: center; justify-content: space-around; }
.emoji-item { width: 60rpx; height: 60rpx; margin-right: 8rpx; justify-content: center; align-items: center; border-radius: 8rpx; }
.emoji-item:active { background-color: #e0e0e0; }
.emoji-text { font-size: 52rpx; font-family: sans-serif; }
</style>
