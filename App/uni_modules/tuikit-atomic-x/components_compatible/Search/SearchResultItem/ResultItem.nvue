  font-weight: 500;
  color: rgba(0, 0, 0, 0.9);
}

.result-item__file {
  flex-direction: row;
  align-items: center;
  padding: 12rpx 16rpx;
  background-color: #FFFFFF;
  border-radius: 12rpx;
  border-width: 1rpx;
  border-color: #E6E9F0;
  max-width: 400rpx;
}

.result-item__file-icon {
  width: 48rpx;
  height: 48rpx;
  justify-content: center;
  align-items: center;
  background-color: #E54545;
  border-radius: 8rpx;
  margin-right: 12rpx;
}

.result-item__file-icon-text {
  font-size: 24rpx;
