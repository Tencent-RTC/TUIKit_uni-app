.search-bar__input-wrapper { flex: 1; flex-direction: row; align-items: center; background-color: #F0F2F7; border-radius: 8rpx; padding: 20rpx 24rpx; }
.search-bar__icon { width: 36rpx; height: 36rpx; margin-right: 13rpx; }
.search-bar__input { flex: 1; font-weight: 400; font-size: 28rpx; line-height: 40rpx; color: rgba(0, 0, 0, 0.9); }
