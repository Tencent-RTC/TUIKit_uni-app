<template>
  <view class="search-tab">
    <view v-for="tab in tabs" :key="tab.value" class="search-tab__item" :class="{ 'search-tab__item--active': modelValue === tab.value }" @tap="handleTabClick(tab.value)">
      <text class="search-tab__text" :class="{ 'search-tab__text--active': modelValue === tab.value }">{{ tab.label }}</text>
    </view>
  </view>
</template>
<script>
import { SearchTabValue } from '../../types/search'
export default {
  model: { prop: 'modelValue', event: 'update:modelValue' },
  props: {
    modelValue: { type: String, default: 'all' },
    tabs: { type: Array, default: function() { return [{ label: '全部', value: SearchTabValue.All }, { label: '用户', value: SearchTabValue.Friend }, { label: '群聊', value: SearchTabValue.Group }, { label: '消息', value: SearchTabValue.Message }] } },
  },
  methods: {
    handleTabClick(value) { if (value !== this.modelValue) { this.$emit('update:modelValue', value); this.$emit('change', value) } },
  },
}
</script>
<style>
.search-tab { flex-direction: row; background-color: #ffffff; border-top: 1rpx solid #E6E9F0; padding-top: 20rpx; }
.search-tab__item { justify-content: center; align-items: center; padding: 20rpx 0; margin-left: 40rpx; border-bottom: 4rpx solid transparent; }
.search-tab__text { font-size: 28rpx; font-weight: 400; line-height: 40rpx; color: #666666; }
.search-tab__text--active { color: #1C66E5; }
.search-tab__item--active { border-bottom: 4rpx solid #1C66E5; }
</style>
