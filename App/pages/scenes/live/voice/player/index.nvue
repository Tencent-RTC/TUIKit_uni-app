<template>
  <view class="voice-audience-container" :style="{ height: systemInfo?.windowHeight + 'px' }">
    <image class="voice-bg" src="/static/images/index/voice-background.png" mode="aspectFill" :style="{ width: systemInfo?.windowWidth + 'px', height: systemInfo?.windowHeight + 'px' }"></image>
    <view class="voice-bg-mask" :style="{ width: systemInfo?.windowWidth + 'px', height: systemInfo?.windowHeight + 'px' }"></view>

    <view class="live-header">
      <view class="header-left">
        <view class="stream-info">
          <image class="header-avatar" :src="currentLive?.liveOwner?.avatarURL || defaultAvatarURL" mode="aspectFill" />
          <view class="stream-details">
            <text class="stream-title" :numberOfLines="1">{{ currentLive?.liveOwner?.userName || currentLive?.liveOwner?.userID || '' }}</text>
          </view>
        </view>
      </view>
      <view class="header-right">
        <view class="control-icons" @tap="navigateBack()">
          <image class="control-icon" src="/static/images/close.png" />
        </view>
      </view>
    </view>

    <VoiceSeatGrid
      :seatRows="liveSeatRows"
      :speakingUserIDs="speakingUserIDs"
      :currentUserID="uni.$userID"
      :isMicOn="isMicOn"
      role="audience"
      :live="true"
      @seatTap="handleSeatTap"
    />

    <view class="action-buttons">
      <image class="action-btn action-btn-bg" v-if="uni.$localGuestStatus === 'IDLE'" @tap="handleCoGuestButtonClick" src="/static/images/live/live-co-guest.png" mode="aspectFit" />
      <image class="action-btn action-btn-bg" v-if="uni.$localGuestStatus === 'USER_APPLYING'" @tap="ShowCoGuestRequestPanel()" src="/static/images/live-request.png" />
      <image class="action-btn action-btn-bg" v-if="uni.$localGuestStatus === 'CONNECTED'" @tap="ShowCoGuestRequestPanel()" src="/static/images/live-disconnect.png" />
    </view>

    <ActionSheet v-model="isShowExitSheet" :title="exitSheetTitle" :itemList="exitSheetItems" @select="onExitSheetSelect" />
    <ActionSheet v-model="isShowCoGuestSheet" :title="coGuestSheetTitle" :itemList="coGuestSheetItems" @select="onCoGuestSheetSelect" />
    <ActionSheet v-model="isShowSeatActionSheet" :itemList="seatActionItems" @select="onSeatActionSelect" />

    <!-- 轻提示(替代 uni.showToast):直播结束/被踢出/静音/连麦申请等。
         放模板末尾——nvue 后写在上;纯提示不拦截触摸。 -->
    <LiveToast
      v-if="tipVisible"
      :key="tipSeq"
      v-model="tipVisible"
      :title="tipTitle"
      :duration="2000"
    />
  </view>
</template>

<script setup lang="ts">
  import { onLoad, onBackPress } from '@dcloudio/uni-app';
  import { ref, onMounted, computed, onUnmounted, watch, nextTick } from 'vue';
  import ActionSheet from '@/components/ActionSheet.nvue';
  import LiveToast from '@/uni_modules/tuikit-atomic-x/components/LiveToast.nvue';
  import VoiceSeatGrid from '../components/VoiceSeatGrid.nvue';
  import { useLiveListState } from "@/uni_modules/tuikit-atomic-x/state/LiveListState";
  import { useLiveSeatState } from "@/uni_modules/tuikit-atomic-x/state/LiveSeatState";
  import { useDeviceState, DeviceStatus } from "@/uni_modules/tuikit-atomic-x/state/DeviceState";
  import { useCoGuestState, NoResponseReason } from '@/uni_modules/tuikit-atomic-x/state/CoGuestState';
  import { useLoginState } from "@/uni_modules/tuikit-atomic-x/state/LoginState";

  uni.$localGuestStatus = 'IDLE';

  onBackPress((option) => {
    if (option.from === 'backbutton') return true;
  });

  const { loginUserInfo } = useLoginState();
  const { joinLive, leaveLive, currentLive, addLiveListListener, removeLiveListListener } = useLiveListState();
  const { seatList, speakingUsers, muteMicrophone, unmuteMicrophone, addLiveSeatEventListener, removeLiveSeatEventListener } = useLiveSeatState(uni?.$liveID);
  const { openLocalMicrophone, closeLocalMicrophone, microphoneStatus } = useDeviceState(uni?.$liveID);
  const { applyForSeat, disconnect, cancelApplication, connected, addCoGuestGuestListener, removeCoGuestGuestListener } = useCoGuestState(uni?.$liveID);

  const systemInfo = ref<any>({});
  const defaultAvatarURL = 'https://web.sdk.qcloud.com/component/TUIKit/assets/avatar_01.png';

  const liveID = ref('');

  const isShowSeatActionSheet = ref(false);

  const isMicOn = computed(() => microphoneStatus.value === DeviceStatus.ON);

  const speakingUserIDs = computed(() => {
    const map = speakingUsers.value;
    if (!map) return new Set<string>();
    const ids = new Set<string>();
    if (map instanceof Map) {
      map.forEach((volume, userID) => {
        if (volume > 0) ids.add(userID);
      });
    } else if (typeof map === 'object') {
      Object.keys(map).forEach(userID => {
        if ((map as any)[userID] > 0) ids.add(userID);
      });
    }
    return ids;
  });

  const isSpeaking = (userID: string) => speakingUserIDs.value.has(userID);

  const seatActionItems = computed(() => [isMicOn.value ? '关闭麦克风' : '打开麦克风']);

  const isShowExitSheet = ref(false);
  const isShowCoGuestSheet = ref(false);
  const exitSheetTitle = ref('');
  const exitSheetItems = ref(['退出直播间']);
  const coGuestSheetItems = ref(['取消连麦申请']);
  const coGuestSheetTitle = ref('');

  const liveSeatRows = computed(() => {
    const seats = seatList.value || [];
    if (seats.length === 0) {
      const placeholders = [];
      for (let i = 0; i < 10; i++) {
        placeholders.push({ index: i + 1, isLocked: false, userInfo: {}, region: {} });
      }
      return [placeholders.slice(0, 5), placeholders.slice(5, 10)];
    }
    const rows = [];
    for (let i = 0; i < seats.length; i += 5) {
      rows.push(seats.slice(i, i + 5));
    }
    return rows;
  });

  watch(connected, (newList) => {
    const list = Array.isArray(newList) ? newList : [];
    const hasSelfInConnected = list.some(item => item?.userID === uni.$userID);
    if (!hasSelfInConnected) {
      uni.$localGuestStatus = 'IDLE';
    }
  }, { deep: true, immediate: true });

  // 轻提示(LiveToast)状态:tipSeq 递增强制重建(重复触发时 v-model 同值不触发 watch)。
  const tipVisible = ref(false);
  const tipSeq = ref(0);
  const tipTitle = ref('');
  const showTip = (title: string) => {
    tipTitle.value = title;
    tipVisible.value = false;
    nextTick(() => {
      tipSeq.value++;
      tipVisible.value = true;
    });
  };

  onLoad((options: any) => {
    console.warn('VoiceAudience onLoad = ', options);
    // 与 videoView 一致:优先页面参数,再退全局,兜底 ''——避免 uni.$liveID 为
    // undefined 时把 undefined 赋给 liveID 引发下游空指针。
    liveID.value = options?.liveID || uni.$liveID || '';

    if (liveID.value) {
      joinLive({
        liveID: liveID.value,
        success: () => {
          console.log('VoiceAudience joinLive success');
        },
        fail: () => {
          showTip('直播已结束');
          setTimeout(() => uni.redirectTo({ url: '/pages/scenes/live/voice/liveList/index' }), 500);
        },
      });
      return;
    }
    showTip('liveID 为空');
  });

  onMounted(() => {
    uni.setKeepScreenOn({ keepScreenOn: true });
    uni.getSystemInfo({
      success: (res: any) => {
        systemInfo.value = res;
      }
    });
    addLiveListListener('onLiveEnded', handleLiveEnded);
    addLiveListListener('onKickedOutOfLive', handleKickedOutOfLive);
    addLiveSeatEventListener(uni?.$liveID, 'onLocalMicrophoneOpenedByAdmin', handleLocalMicrophoneOpenedByAdmin);
    addLiveSeatEventListener(uni?.$liveID, 'onLocalMicrophoneClosedByAdmin', handleLocalMicrophoneClosedByAdmin);
    addCoGuestGuestListener(uni?.$liveID, 'onGuestApplicationResponded', handleGuestApplicationResponded);
    addCoGuestGuestListener(uni?.$liveID, 'onGuestApplicationNoResponse', handleGuestApplicationNoResponse);
  });

  onUnmounted(() => {
    removeLiveListListener('onLiveEnded', handleLiveEnded);
    removeLiveListListener('onKickedOutOfLive', handleKickedOutOfLive);
    removeLiveSeatEventListener(uni?.$liveID, 'onLocalMicrophoneOpenedByAdmin', handleLocalMicrophoneOpenedByAdmin);
    removeLiveSeatEventListener(uni?.$liveID, 'onLocalMicrophoneClosedByAdmin', handleLocalMicrophoneClosedByAdmin);
    removeCoGuestGuestListener(uni?.$liveID, 'onGuestApplicationResponded', handleGuestApplicationResponded);
    removeCoGuestGuestListener(uni?.$liveID, 'onGuestApplicationNoResponse', handleGuestApplicationNoResponse);
  });

  const handleLocalMicrophoneOpenedByAdmin = () => {
    showTip('您已被解除静音');
  };

  const handleLocalMicrophoneClosedByAdmin = () => {
    showTip('您已被静音');
  };

  const handleLiveEnded = () => {
    removeLiveListListener('onLiveEnded', handleLiveEnded);
    removeLiveListListener('onKickedOutOfLive', handleKickedOutOfLive);
    removeLiveSeatEventListener(uni?.$liveID, 'onLocalMicrophoneOpenedByAdmin', handleLocalMicrophoneOpenedByAdmin);
    removeLiveSeatEventListener(uni?.$liveID, 'onLocalMicrophoneClosedByAdmin', handleLocalMicrophoneClosedByAdmin);
    showTip('直播已结束');
    uni.$liveID = '';
    // 同"被踢出":延迟跳转,让 toast 先显示再跳回列表页(否则页面秒销毁看不到提示)。
    setTimeout(() => {
      uni.redirectTo({ url: '/pages/scenes/live/voice/liveList/index' });
    }, 1500);
  };

  const handleKickedOutOfLive = () => {
    removeLiveListListener('onLiveEnded', handleLiveEnded);
    removeLiveListListener('onKickedOutOfLive', handleKickedOutOfLive);
    removeLiveSeatEventListener(uni?.$liveID, 'onLocalMicrophoneOpenedByAdmin', handleLocalMicrophoneOpenedByAdmin);
    removeLiveSeatEventListener(uni?.$liveID, 'onLocalMicrophoneClosedByAdmin', handleLocalMicrophoneClosedByAdmin);
    showTip('被踢出直播间');
    uni.$liveID = '';
    // showTip 的 toast 挂在当前页面,同步 redirectTo 会秒销毁页面导致 toast 看不到,
    // 延迟跳转让提示先显示一会儿(≈1.5s)再跳回列表页。
    setTimeout(() => {
      uni.redirectTo({ url: '/pages/scenes/live/voice/liveList/index' });
    }, 1500);
  };

  const navigateBack = () => {
    if (uni.$localGuestStatus === 'CONNECTED') {
      exitSheetItems.value = ['断开连麦', '退出直播间'];
      exitSheetTitle.value = '当前处于连麦状态，是否需要「断开连麦」或「退出直播间」';
    } else {
      exitSheetItems.value = ['退出直播间'];
      exitSheetTitle.value = '';
    }
    isShowExitSheet.value = true;
  };

  const onExitSheetSelect = (res: { tapIndex: number }) => {
    const index = res.tapIndex;
    if (uni.$localGuestStatus === 'CONNECTED' && index === 0) {
      disconnect({ liveID: uni?.$liveID });
      uni.$localGuestStatus = 'IDLE';
      return;
    }
    if ((uni.$localGuestStatus === 'CONNECTED' && index === 1) || (uni.$localGuestStatus !== 'CONNECTED' && index === 0)) {
      if (uni.$localGuestStatus === 'CONNECTED') {
        disconnect({
          liveID: uni?.$liveID,
          success: () => {
            leaveLive({
              success: () => {
                uni.$liveID = '';
                uni.redirectTo({ url: '/pages/scenes/live/voice/liveList/index' });
              }
            });
            console.log('disconnect success.');
          },
        });
        uni.$localGuestStatus = 'IDLE';
        return
      }
      leaveLive({
        success: () => {
          uni.$liveID = '';
          uni.redirectTo({ url: '/pages/scenes/live/voice/liveList/index' });
        }
      });
    }
  };

  const handleCoGuestButtonClick = () => {
    if (uni.$localGuestStatus === 'IDLE') {
      showTip('你提交了连麦申请 请等待主播同意');
      applyForSeat({
        liveID: uni.$liveID,
        seatIndex: -1,
        timeout: 30,
        success: () => {
          console.log('applyForSeat success.');
        },
        fail: (errorCode: number) => {
          if (errorCode === 100006) {
            showTip('您当前无法执行此操作');
          }
          uni.$localGuestStatus = 'IDLE';
        },
      });
      uni.$localGuestStatus = 'USER_APPLYING';
    }
  };

  const ShowCoGuestRequestPanel = () => {
    if (uni.$localGuestStatus === 'USER_APPLYING') {
      coGuestSheetItems.value = ['取消连麦申请'];
      isShowCoGuestSheet.value = true;
    } else if (uni.$localGuestStatus === 'CONNECTED') {
      coGuestSheetItems.value = ['断开连麦'];
      isShowCoGuestSheet.value = true;
    }
  };

  const handleGuestApplicationResponded = (event: any) => {
    const res = JSON.parse(event);
    if (res.isAccept) {
      uni.$localGuestStatus = 'CONNECTED';
      openLocalMicrophone({
        success: () => {
          console.log('openLocalMicrophone success.');
        },
        fail: (errCode: number, errMsg: string) => {
          console.error(`openLocalMicrophone fail errCode: ${errCode}, errMsg: ${errMsg}`);
        },
      });
    } else {
      uni.$localGuestStatus = 'IDLE';
      showTip('上麦申请被拒绝');
    }
  };

  const handleGuestApplicationNoResponse = (event: any) => {
    const res = JSON.parse(event);
    if (res.reason === NoResponseReason.TIMEOUT) {
      uni.$localGuestStatus = 'IDLE';
      showTip('上麦申请超时');
    }
  };

  const handleSeatTap = (seat: any) => {
    if (seat?.userInfo?.userID === uni.$userID) {
      isShowSeatActionSheet.value = true;
    }
  };

  const onSeatActionSelect = (res: { tapIndex: number }) => {
    if (res.tapIndex === 0) {
      if (isMicOn.value) {
        muteMicrophone({ liveID: uni.$liveID });
        closeLocalMicrophone();
      } else {
        unmuteMicrophone({
          liveID: uni.$liveID,
          success: () => {
            openLocalMicrophone();
          },
          fail: (errCode: number, errMsg: string) => {
            console.error(`unmuteMicrophone fail: ${errCode}, ${errMsg}`);
          },
        });
      }
    }
  };

  const onCoGuestSheetSelect = (res: { tapIndex: number }) => {
    if (uni.$localGuestStatus === 'CONNECTED' && res.tapIndex === 0) {
      disconnect({ liveID: uni?.$liveID });
      uni.$localGuestStatus = 'IDLE';
    } else if (uni.$localGuestStatus === 'USER_APPLYING' && res.tapIndex === 0) {
      cancelApplication({ liveID: uni?.$liveID });
      uni.$localGuestStatus = 'IDLE';
    }
  };
</script>

<style>
  .voice-audience-container {
    width: 750rpx;
    position: relative;
    flex-direction: column;
  }

  .voice-bg {
    position: absolute;
    left: 0;
    top: 0;
  }

  .voice-bg-mask {
    position: absolute;
    left: 0;
    top: 0;
    background-color: rgba(0, 0, 0, 0.7);
  }

  .live-header {
    position: relative;
    z-index: 10;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding-left: 32rpx;
    padding-right: 32rpx;
    padding-top: 20rpx;
    padding-bottom: 20rpx;
    margin-top: 80rpx;
  }

  .header-left {
    flex-direction: row;
    align-items: center;
    flex: 1;
  }

  .stream-info {
    flex-direction: row;
    align-items: center;
    background-color: rgba(0, 0, 0, 0.3);
    padding-top: 6rpx;
    padding-bottom: 6rpx;
    padding-left: 10rpx;
    padding-right: 10rpx;
    border-radius: 40rpx;
  }

  .header-avatar {
    width: 56rpx;
    height: 56rpx;
    border-radius: 28rpx;
    border-width: 2rpx;
    border-style: solid;
    border-color: #ffffff;
    margin-right: 12rpx;
  }

  .stream-details {
    flex-direction: column;
  }

  .stream-title {
    color: #ffffff;
    font-size: 26rpx;
    font-weight: 500;
    width: 120rpx;
    lines: 1;
  }

  .header-right {
    flex-direction: row;
    align-items: center;
    justify-content: flex-end;
  }

  .control-icons {
    flex-direction: row;
    align-items: center;
  }

  .control-icon {
    width: 48rpx;
    height: 48rpx;
    margin-left: 16rpx;
  }


  .action-buttons {
    position: fixed;
    right: 40rpx;
    bottom: 80rpx;
    flex-direction: row;
    align-items: center;
  }

  .action-btn {
    width: 64rpx;
    height: 64rpx;
    margin-left: 16rpx;
  }

  .action-btn-bg {
    background-color: rgba(20, 20, 22, 0.54);
    border-radius: 50%;
    border: 2rpx solid rgba(255, 255, 255, 0.055);
  }
</style>
