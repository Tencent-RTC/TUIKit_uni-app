<template>
  <view style="position: relative; height: 160rpx; padding-top: 80rpx;  background-color: #fff; display: flex; flex-direction: row; justify-content: center; align-items: center;">
    <image style="width: 21rpx; height: 34rpx; position: absolute; left: 60rpx;" src="/static/images/back-black.png" @tap="handleGoBack" />
    <text>{{ t('liveList.title') }}</text>
    <image style="width: 36rpx; height: 36rpx; position: absolute; right: 60rpx;" src="/static/images/refresh.png" @tap="handlePageRefresh" />
  </view>
  <view class="home-container" :style="{ height: safeArea.height + 'px' }">
    <live-list />
    <view class="home-footer">
      <view class="create-btn" @click="goAnchorPage()">
        <image style="width: 36rpx; height: 36rpx; margin-right: 10rpx;" src="/static/images/create-live.png" />
        <text class="btn-text">{{ t('liveList.startLive') }}</text>
      </view>
    </view>
  </view>

  <LiveToast
    v-if="tipVisible"
    :key="tipSeq"
    v-model="tipVisible"
    :title="tipTitle"
    :duration="2000"
  />
</template>

<script setup>
  import {
    ref,
    onMounted,
    watch,
    nextTick
  } from 'vue';
  import {
    onLoad,
    onShow
  } from '@dcloudio/uni-app';

  import LiveList from '@/uni_modules/tuikit-atomic-x/components/LiveList';
  import LiveToast from '@/uni_modules/tuikit-atomic-x/components/LiveToast.nvue';
  import { t } from '../../locales';
  import {
    useLiveListState
  } from "@/uni_modules/tuikit-atomic-x/state/LiveListState";
  const {
    fetchLiveList,
    liveListCursor
  } = useLiveListState();

  const tipVisible = ref(false);
  const tipSeq = ref(0);
  const tipTitle = ref('');
  const showTip = (title) => {
    tipTitle.value = title;
    tipVisible.value = false;
    nextTick(() => {
      tipSeq.value++;
      tipVisible.value = true;
    });
  };

  const safeArea = ref({
    left: 0,
    right: 0,
    top: 0,
    bottom: 0,
    width: 375,
    height: 750,
  });

  onMounted(() => {
    uni.getSystemInfo({
      success: (res) => {
        safeArea.value = res.safeArea;
      }
    });
  });

  onShow(() => {
    console.warn(`home onShow`);
    try {
      const leftoverWebview = plus.webview.getWebviewById('barrage-input-webview');
      if (leftoverWebview) leftoverWebview.close();
    } catch (e) { /* ignore */ }
  });

  const goAnchorPage = () => {
    uni.redirectTo({
      url: '/pages/scenes/live/video/pusher/index'
    });
  }

  const handleGoBack = () => {
    uni.redirectTo({
      url: '/pages/scenes/live/index'
    });
  }

  const handlePageRefresh = () => {
    const params = {
      cursor: '',
      count: 20,
      success: () => {
        showTip(t('liveList.refreshDone'));
      }
    };
    fetchLiveList(params);
  }
</script>

<style lang="scss">
  @import './liveList.scss';
</style>