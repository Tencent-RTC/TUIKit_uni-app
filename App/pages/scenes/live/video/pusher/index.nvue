<template>
  <view class="live-container" @click="handleHideInput" :style="{
                                          height: systemInfo?.windowHeight + 'px',
                                          width: systemInfo?.safeArea?.width + 'px',
                                       }">
    <LiveStreamView v-if="liveID && liveID.length > 0 && !isLiveEnded" :liveID="liveID || ''" :isAnchor="true" :templateLayout="templateLayout" :isLiving="isStartLive" :onStreamViewClick="ShowAnchorViewClickPanel"></LiveStreamView>
    <BeforeLiveView v-if="!isStartLive && !isLiveEnded" v-model:templateLayout="templateLayout" @back="goBackToTabBar" @tip="showTip" @started="onStartLive" />
    <LivingView v-if="isStartLive" :liveID="liveID" :safeArea="safeArea" @tip="showTip" @ended="onLiveEnded" @receiveGift="onBarrageReceiveGift" />
    <LiveSummaryView v-if="isLiveEnded" :summary="liveSummary" :liveDuration="endedElapsedSeconds" @close="goBackToTabBar" />
    <GiftPlayer ref="giftPlayerRef" v-model="isLargeSizeGiftPlayer" :url="giftInfo?.resourceURL" :safeArea="safeArea" @finished="svgaPlayerFinished" />
    <LiveToast
      v-if="tipVisible"
      :key="tipSeq"
      v-model="tipVisible"
      :title="tipTitle"
      :duration="2000"
    />
  </view>
</template>

<script setup lang="ts">
  import { reactive, ref, computed, watch, nextTick, onMounted } from 'vue';
  import { onLoad, onBackPress } from '@dcloudio/uni-app';
  import { GiftPlayer, giftService } from '@/uni_modules/tuikit-atomic-x/components/Gift';
  import { AudioChangerType, AudioReverbType, useAudioEffectState } from '@/uni_modules/tuikit-atomic-x/state/AudioEffectState';
  import { useBaseBeautyState } from '@/uni_modules/tuikit-atomic-x/state/BaseBeautyState';
  import { useDeviceState } from '@/uni_modules/tuikit-atomic-x/state/DeviceState';
  import { useLoginState } from '@/uni_modules/tuikit-atomic-x/state/LoginState';
  import { useLiveListState } from '@/uni_modules/tuikit-atomic-x/state/LiveListState';
  import { useLiveSummaryState } from '@/uni_modules/tuikit-atomic-x/state/LiveSummaryState';
  import { setSdkLanguageFromSystem } from '@/uni_modules/tuikit-atomic-x/utils/setSdkLanguageFromSystem';
  import { BeforeLiveView, LiveSummaryView, LivingView } from './views';
  import LiveStreamView from '@/uni_modules/tuikit-atomic-x/components/LiveStreamView';
  import LiveToast from '@/uni_modules/tuikit-atomic-x/components/LiveToast.nvue';

  const { loginUserInfo } = useLoginState();
  uni.$liveID = `live_${uni.$userID}`
  uni.$localGuestStatus = 'IDLE'
  const { setVoiceEarMonitorEnable,
    setVoiceEarMonitorVolume,
    setAudioChangerType,
    setAudioReverbType,
  } = useAudioEffectState()
  const { setSmoothLevel, setWhitenessLevel, setRuddyLevel } = useBaseBeautyState()
  const { openLocalCamera, openLocalMicrophone, closeLocalMicrophone, closeLocalCamera } = useDeviceState();
  const { currentLive } = useLiveListState(uni?.$liveID);
  const { summaryData } = useLiveSummaryState(uni?.$liveID);

  enum PusherStatus {
    PREPARE = 'PREPARE',
    PUSHER = 'PUSHER',
    SUMMARY = 'SUMMARY',
  }

  const pusherState = reactive({ liveStatus: PusherStatus.PREPARE });
  const tipVisible = ref(false);
  const tipSeq = ref(0);
  const tipTitle = ref('');
  const systemInfo = ref({});
  const safeArea = ref({
    left: 0,
    right: 0,
    top: 0,
    bottom: 0,
    width: 375,
    height: 750,
  });
  const liveID = ref(uni?.$liveID);
  const templateLayout = ref(600);
  const liveStartAt = ref(0);
  const endedElapsedSeconds = ref(0);

  const giftInfo = ref({});
  const isLargeSizeGiftPlayer = ref(false);
  const liveSummary = ref(null);
  const giftPlayerRef = ref();
  const { showGift, onGiftFinished } = giftService({
    roomId: uni?.$liveID,
    giftPlayerRef,
  })

  const isStartLive = computed(() => pusherState.liveStatus === PusherStatus.PUSHER);
  const isLiveEnded = computed(() => pusherState.liveStatus === PusherStatus.SUMMARY);

  const showTip = (title: string) => {
    tipTitle.value = title;
    tipVisible.value = false;
    nextTick(() => {
      tipSeq.value++;
      tipVisible.value = true;
    });
  };

  const clearAudioEffectSet = () => {
    setVoiceEarMonitorEnable({
      enable: false
    })
    setVoiceEarMonitorVolume({
      volume: 100
    })
    setAudioChangerType({
      changerType: AudioChangerType.NONE
    })
    setAudioReverbType({
      reverbType: AudioReverbType.NONE
    })
  }

  const clearBeautyPanelSet = () => {
    setSmoothLevel({ smoothLevel: 0 })
    setWhitenessLevel({ whitenessLevel: 0 })
    setRuddyLevel({ ruddyLevel: 0 })
  }

  const handleHideInput = () => {
    uni.hideKeyboard()
  }

  const ShowAnchorViewClickPanel = (userInfo) => {
    uni.$emit('anchorStreamViewClick', userInfo);
  };

  const goBackToTabBar = () => {
    clearAudioEffectSet();
    clearBeautyPanelSet();
    closeLocalMicrophone();
    closeLocalCamera();

    console.warn(` 后退 `);
    uni.redirectTo({
      url: '/pages/scenes/live/video/liveList/index',
      success: () => {
        console.log(`redirect success`);
      },
      fail: (error) => {
        console.error(`redirect, error: ${JSON.stringify(error)}`);
      },
    });
  };

  const toMsTimestamp = (value: unknown): number => {
    const n = Number(value);
    if (!Number.isFinite(n) || n <= 0) return 0;
    if (n > 1e12) return Math.floor(n);
    if (n > 1e9) return Math.floor(n * 1000);
    return 0;
  };

  watch(() => currentLive.value?.createTime, (createTime) => {
    if (liveStartAt.value > 0) return;
    liveStartAt.value = toMsTimestamp(createTime);
  }, { immediate: true });

  const onStartLive = () => {
    pusherState.liveStatus = PusherStatus.PUSHER;
  };

  const onLiveEnded = () => {
    clearAudioEffectSet();
    clearBeautyPanelSet();
    endedElapsedSeconds.value = liveStartAt.value > 0
      ? Math.max(0, Math.round((Date.now() - liveStartAt.value) / 1000))
      : 0;
    pusherState.liveStatus = PusherStatus.SUMMARY;
  };

  const onBarrageReceiveGift = (giftData: any) => {
    if (!giftData) return;
    giftInfo.value = giftData;
    showGift(giftData, { onlyDisplay: true });
  };

  const svgaPlayerFinished = () => {
    isLargeSizeGiftPlayer.value = false;
    onGiftFinished();
  }

  watch(summaryData, (val) => {
    if (val) {
      liveSummary.value = { ...val };
    }
  }, { immediate: true, deep: true });

  watch(() => loginUserInfo.value?.userID, (newUserId, oldUserId) => {
    if (newUserId) {
      uni.$liveID = `live_${newUserId}`;
      liveID.value = uni.$liveID;
    }
  }, { immediate: true, deep: true });

  onBackPress((option) => {
    if (option.from === 'backbutton')
      return true;
  });

  onLoad((options) => {
    if (options && options.isLiving === 'true') {
      pusherState.liveStatus = PusherStatus.PUSHER;
    }
    if (uni.getSystemInfoSync().platform === 'ios') {
      const pages = getCurrentPages();
      if (pages.length > 0) {
        const currentPage = pages[pages.length - 1];
        currentPage.$page.style.disableSwipeBack = true;
      }
    }
  });

  onMounted(() => {
    setSdkLanguageFromSystem()
    uni.setKeepScreenOn({
      keepScreenOn: true,
    });
    openLocalCamera({
      isFront: true,
    });
    openLocalMicrophone();
    uni.getSystemInfo({
      success: (res) => {
        systemInfo.value = res;
        safeArea.value = res.safeArea;

        console.warn(`systemInfo: ${systemInfo.value.windowHeight}`)
      }
    });
  });
</script>

<style lang="scss">
  @import './pusher.scss';
</style>
