<template>
  <view class="living-view" @touchend="onStageTouchEnd">
    <LiveStatusPanel v-if="liveID" :liveID="liveID" />
    <view class="live-content">
      <BarrageList mode="anchor" :liveID="liveID" :topPx="barrageTopPx" @receiveGift="onBarrageReceiveGift" ref="barrageListRef" />
      <AudienceEntryBanner ref="audienceEntryBannerRef" :topPx="audienceEntryTopPx" />
      <GiftEntryBanner ref="giftEntryBannerRef" :bottomPx="giftEntryBottomPx" :hidden="anyOverlayVisible" />
      <view class="live-bottom-Panel">
        <view class="action-button-item" @tap="showCoGuestPanel('requests')">
          <image class="action-button-icon" src="/static/images/live/icon/co-guest-manage.png" mode="aspectFit" />
          <view v-if="hasCoGuestApplication" class="co-mic-request-dot"></view>
          <text class="action-button-text">{{ t('anchor.linkAudience') }}</text>
        </view>
        <view class="action-button-item more-action" @tap="handleSettings">
          <image class="action-button-icon" src="/static/images/live/icon/more-grid.png" mode="aspectFit" />
          <text class="action-button-text">{{ t('anchor.more') }}</text>
        </view>
      </view>
      <view class="living-top-bar" :style="{ top: topOffsetPx + 'px' }">
        <AnchorInfoCapsule role="anchor" :liveID="liveID" @fanClubTap="showFanClubTip" />
        <view class="living-top-bar-right">
          <AudienceListEntry :liveID="liveID" @audienceTap="showAudienceList" />
          <view class="living-top-bar-close" @tap="onEndTap">
            <image class="living-top-bar-close-icon" src="/static/images/live/icon/close.png" mode="aspectFill" />
          </view>
        </view>
      </view>
      <LiveAudienceList v-model="isShowAudienceList" :liveID="liveID" @overlayActiveChange="onAudienceInnerPanelChange"></LiveAudienceList>
      <CoGuestPanel v-if="liveID" v-model="isShowCoGuestPanel" :activeTab="activeTab"></CoGuestPanel>
      <MoreOperatePanel v-if="liveID" v-model="isShowMoreOperatePanel" @tip="showTip" @pause="pauseLive" @comment="openCommentInput" />
      <BarrageInput v-if="liveID" v-model="isShowCommentInput" :liveID="liveID" @tip="showTip" />
      <Like v-if="liveID" role="anchor" :liveID="liveID" />
      <PauseOverlay :visible="isPaused" :seconds="pausedSeconds" @resume="resumeLive" />
      <UserInfoPanel v-if="liveID" v-model="isShowUserInfoPanel" :userInfo="clickUserInfo" :isShowAnchor="isShowAnchorInfo"></UserInfoPanel>
      <EndConfirmPanel
        ref="endConfirmPanelRef"
        v-if="liveID"
        @ended="onLiveEnded"
        @overlayActiveChange="onEndLiveOverlayChange"
      />
      <view class="custom-modal-overlay" v-if="showCustomModal">
        <view class="custom-modal" @click.stop>
          <view class="modal-content">
            <text class="modal-text"> {{ modalContent }}</text>
          </view>
          <view class="modal-actions">
            <view class="modal-btn modal-btn-cancel" @tap="handleModalCancel">
              <text class="modal-btn-reject">{{ t('anchor.reject') }}</text>
            </view>
            <view class="modal-btn modal-btn-confirm" @tap="handleModalConfirm">
              <text class="modal-btn-accept">{{ t('anchor.accept') }}</text>
            </view>
          </view>
        </view>
      </view>
      <CoGuestManagePanel
        v-if="liveID"
        v-model="innerShowManage"
        :liveID="liveID"
        :userInfo="props.manageUser"
        @tip="showTip"
      />
    </view>
  </view>
</template>

<script setup lang="ts">
  import { ref, computed, watch, onMounted, onUnmounted } from 'vue';
  import { CoGuestPanel } from '@/uni_modules/tuikit-atomic-x/components/CoGuestPanel';
  import { LiveAudienceList } from '@/uni_modules/tuikit-atomic-x/components/LiveAudienceList';
  import { UserInfoPanel } from '@/uni_modules/tuikit-atomic-x/components/LiveStreamView';
  import { CoHostStatusType, useCoHostState } from '@/uni_modules/tuikit-atomic-x/state/CoHostState';
  import { useCoGuestState } from '@/uni_modules/tuikit-atomic-x/state/CoGuestState';
  import { useDeviceState, DeviceStatus } from '@/uni_modules/tuikit-atomic-x/state/DeviceState';
  import { useLiveAudienceState } from '@/uni_modules/tuikit-atomic-x/state/LiveAudienceState';
  import { useLiveListState } from '@/uni_modules/tuikit-atomic-x/state/LiveListState';
  import { useLiveSeatState } from '@/uni_modules/tuikit-atomic-x/state/LiveSeatState';
  import { useLoginState } from '@/uni_modules/tuikit-atomic-x/state/LoginState';
  import { t } from '../../../../locales';
  import { getTopBarOffsetPx, LIVE_SUMMARY_BACKGROUND_IMAGE, preloadLiveImages } from '../../../../utils';
  import BarrageList from '@/uni_modules/tuikit-atomic-x/components/BarrageList';
  import Like from '@/uni_modules/tuikit-atomic-x/components/Like.nvue';
  import { GiftEntryBanner } from '@/uni_modules/tuikit-atomic-x/components/Gift';
  import EndConfirmPanel from '../../components/EndConfirmPanel/index.nvue';
  import LiveStatusPanel from '../../components/LiveStatusPanel/index.nvue';
  import MoreOperatePanel from '../../components/MoreOperatePanel/index.nvue';
  import CoGuestManagePanel from '../../components/CoGuestManagePanel/index.nvue';
  import PauseOverlay from '../../components/PauseOverlay/index.nvue';
  import AnchorInfoCapsule from '@/pages/scenes/live/common/AnchorInfoCapsule/index.nvue';
  import AudienceListEntry from '../../components/AudienceListEntry/index.nvue';
  import BarrageInput from '@/pages/scenes/live/common/BarrageInput/index.nvue';
  import AudienceEntryBanner from '@/pages/scenes/live/common/AudienceEntryBanner/index.nvue';
  import { safeJsonParse } from '@/uni_modules/tuikit-atomic-x/utils/utsUtils';

  const props = defineProps({
    liveID: { type: String, default: '' },
    manageUser: { type: Object, default: () => ({}) },
    showManage: { type: Boolean, default: false },
    safeArea: {
      type: Object,
      default: () => ({
        left: 0,
        right: 0,
        top: 0,
        bottom: 0,
        width: 375,
        height: 750,
      }),
    },
  });
  const emit = defineEmits(['tip', 'ended', 'receiveGift', 'update:showManage', 'stageTap']);

  const innerShowManage = computed({
    get: () => props.showManage,
    set: (val) => emit('update:showManage', val),
  });

  const { loginUserInfo } = useLoginState();
  const { currentLive, addLiveListListener, removeLiveListListener } = useLiveListState();
  const liveID = computed(() => props.liveID || String(currentLive.value?.liveID || ''));
  const { addCoHostListener, removeCoHostListener, acceptHostConnection, rejectHostConnection, coHostStatus, invitees } = useCoHostState(liveID.value)
  const { applicants, rejectApplication, connected } = useCoGuestState(liveID.value);
  const { audienceList, addAudienceListener, removeAudienceListener } = useLiveAudienceState(liveID.value);
  const { closeLocalCamera, openLocalCamera, isFrontCamera, microphoneStatus } = useDeviceState();
  const { muteMicrophone, unmuteMicrophone } = useLiveSeatState(liveID.value);

  const BARRAGE_LIST_H_PX = uni.upx2px(380);

  const SYNC_WIN_H = (() => {
    try { return uni.getSystemInfoSync().windowHeight || 0; } catch (e) { return 0; }
  })();

  const BOTTOM_PANEL_H_PX = (() => {
    try { return uni.getSystemInfoSync().platform === 'ios' ? 60 : 80; } catch (e) { return 80; }
  })();

  const topOffsetPx = getTopBarOffsetPx();

  const isShowUserInfoPanel = ref(false);
  const isShowAudienceList = ref(false);
  const isShowCoGuestPanel = ref(false);
  const isShowMoreOperatePanel = ref(false);
  const isShowCommentInput = ref(false);
  const endConfirmPanelRef = ref<any>(null);
  const isShowAnchorInfo = ref(false);
  const isShowCoGuestPanelAvatar = ref(true);
  const activeTab = ref('requests');
  const clickUserInfo = ref({});
  const barrageListRef = ref();
  const audienceEntryBannerRef = ref();
  const giftEntryBannerRef = ref();

  const showCustomModal = ref(false);
  const modalContent = ref('');
  const currentModalUserInfo = ref(null);

  const audienceInnerPanelVisible = ref(false);
  const endLiveOverlayVisible = ref(false);

  const isPaused = ref(false);
  const pausedSeconds = ref(0);
  let pauseTimer: ReturnType<typeof setInterval> | null = null;
  let pauseStartAt = 0;
  let accumulatedPauseMs = 0;
  let micWasOnBeforePause = false;

  const currentUserID = computed(() => loginUserInfo.value?.userID);
  const hasCoGuestApplication = computed(() => (applicants.value || []).length > 0 && !isShowCoGuestPanel.value);
  const videoBottomPx = computed(() => {
    const sa: any = props.safeArea || {};
    return (Number(sa.top) || 0) + (Number(sa.height) || 0) - BOTTOM_PANEL_H_PX;
  });
  const barrageTopPx = computed(() => {
    const winH = SYNC_WIN_H;
    if (winH <= 0) return -9999;
    const videoBottom = videoBottomPx.value;
    if (videoBottom > BARRAGE_LIST_H_PX && videoBottom <= winH) {
      return Math.max(0, Math.round(videoBottom - BARRAGE_LIST_H_PX));
    }
    return Math.max(0, Math.round(winH - 84 - BARRAGE_LIST_H_PX));
  });
  const giftEntryBottomPx = computed(() => {
    const bottomGap = (Number(props.safeArea && props.safeArea.height) || 0) * 1 / 8;
    return bottomGap + uni.upx2px(380 + 16);
  });
  const audienceEntryTopPx = computed(() => barrageTopPx.value - uni.upx2px(64));
  const anyOverlayVisible = computed(() =>
    isShowAudienceList.value ||
    isShowCoGuestPanel.value ||
    isShowMoreOperatePanel.value ||
    isShowUserInfoPanel.value ||
    endLiveOverlayVisible.value ||
    showCustomModal.value ||
    audienceInnerPanelVisible.value
  );

  const openCommentInput = () => {
    isShowCommentInput.value = true;
  };

  const pauseLive = () => {
    if (isPaused.value) return;
    isPaused.value = true;
    pauseStartAt = Date.now();
    pausedSeconds.value = 0;
    isShowMoreOperatePanel.value = false;
    micWasOnBeforePause = microphoneStatus.value === DeviceStatus.ON;
    closeLocalCamera();
    if (micWasOnBeforePause) {
      muteMicrophone({ liveID: liveID.value });
    }
    pauseTimer = setInterval(() => {
      pausedSeconds.value = Math.floor((Date.now() - pauseStartAt) / 1000);
    }, 1000);
    uni.$emit('pusher:pauseChanged', true);
  };

  const resumeLive = () => {
    if (!isPaused.value) return;
    accumulatedPauseMs += Date.now() - pauseStartAt;
    if (pauseTimer != null) {
      clearInterval(pauseTimer);
      pauseTimer = null;
    }
    pauseStartAt = 0;
    pausedSeconds.value = 0;
    isPaused.value = false;
    openLocalCamera({ isFront: isFrontCamera.value });
    if (micWasOnBeforePause) {
      micWasOnBeforePause = false;
      if (uni.$pusherSelfMuted === true) {
        muteMicrophone({ liveID: liveID.value });
      } else {
        unmuteMicrophone({ liveID: liveID.value });
      }
    }
    uni.$emit('pusher:pauseChanged', false);
  };

  const onStageTouchEnd = (event: any) => {
    const list = event?.changedTouches || event?.touches || [];
    const t = list[0] || {};
    const detail = event?.detail || {};
    const x = Number(t.pageX ?? t.clientX ?? t.x ?? t.screenX ?? detail.x ?? NaN);
    const y = Number(t.pageY ?? t.clientY ?? t.y ?? t.screenY ?? detail.y ?? NaN);
    if (!Number.isFinite(x) || !Number.isFinite(y)) return;
    emit('stageTap', { x, y });
  };

  const showTip = (title: string) => {
    emit('tip', title);
  };

  const showUserInfoPanel = () => {
    isShowUserInfoPanel.value = true;
  };

  const showCustomModalDialog = (userInfo) => {
    currentModalUserInfo.value = userInfo;
    modalContent.value = t('anchor.linkInvite', { name: userInfo.userName || userInfo.userID || '' });
    showCustomModal.value = true;
  };

  const closeCustomModal = () => {
    showCustomModal.value = false;
    currentModalUserInfo.value = null;
  };

  const showAudienceList = () => {
    isShowAudienceList.value = true;
  };

  const onEndTap = () => {
    endConfirmPanelRef.value?.requestEnd?.();
  };

  const showFanClubTip = () => {
    showTip(t('anchor.fanClubComingSoon'));
  }

  const showCoGuestPanel = (activeTabValue: string = 'requests') => {
    console.warn(`go guest Panel activeTab = ${activeTabValue}`);
    activeTab.value = activeTabValue;
    isShowCoGuestPanel.value = true;
  };

  const onBarrageReceiveGift = (giftData: any) => {
    if (!giftData) return;
    const count = Math.max(1, Math.round(Number(giftData.count) || 1));
    const anchor = currentLive.value?.liveOwner || null;
    giftEntryBannerRef.value?.push?.({
      gift: giftData.gift,
      sender: giftData.sender,
      recipient: anchor ? {
        userID: anchor.userID || '',
        userName: anchor.userName || anchor.userID || '',
      } : null,
      count: count,
    });
    emit('receiveGift', giftData);
  };

  const pushAudienceEntry = (user: { userID: string; userName: string; level: number }) => {
    if (isPaused.value) return;
    audienceEntryBannerRef.value?.push?.(user);
  };

  const parseAudienceEventUser = (eventData: string): { userID: string; userName: string; level: number } => {
    const parsed = safeJsonParse<any>(eventData, null);
    let user = parsed?.audience ?? parsed?.userInfo ?? parsed;
    if (typeof user === 'string') {
      user = safeJsonParse<any>(user, null);
    }
    user = user ?? {};
    return {
      userID: user?.userID || user?.userId || '',
      userName: user?.userName || user?.nameCard || user?.userID || user?.userId || '',
      level: Number(user?.level) || 0,
    };
  };

  const onAudienceJoined = (eventData: string) => {
    pushAudienceEntry(parseAudienceEventUser(eventData));
  };

  const handleSettings = () => {
    isShowMoreOperatePanel.value = true;
  };

  const onAudienceInnerPanelChange = (visible: boolean) => {
    audienceInnerPanelVisible.value = !!visible;
  };

  const onLiveEnded = (statisticsData = null) => {
    if (isPaused.value) {
      accumulatedPauseMs += Date.now() - pauseStartAt;
      if (pauseTimer != null) {
        clearInterval(pauseTimer);
        pauseTimer = null;
      }
      pauseStartAt = 0;
      pausedSeconds.value = 0;
      isPaused.value = false;
    }
    emit('ended', Math.floor(accumulatedPauseMs / 1000), statisticsData);
  };

  const handleSdkLiveEnded = () => onLiveEnded();

  const onEndLiveOverlayChange = (visible: boolean) => {
    endLiveOverlayVisible.value = !!visible;
  };

  const handleModalCancel = () => {
    if (currentModalUserInfo.value) {
      rejectHostConnection({
        liveID: liveID.value,
        fromHostLiveID: currentModalUserInfo.value.liveID
      });
    }
    isShowCoGuestPanelAvatar.value = true
    closeCustomModal();
  };

  const handleModalConfirm = () => {
    if (currentModalUserInfo.value) {
      acceptHostConnection({
        liveID: liveID.value,
        fromHostLiveID: currentModalUserInfo.value.liveID
      });
    }
    closeCustomModal();
  };

  const handleCoHostRequestAccepted = (event) => {
    showTip(t('anchor.linkAccepted'))
  }

  const handleCoHostRequestRejected = (event) => {
    showTip(t('anchor.linkRejected'))
  }

  const handleCoHostRequestTimeout = (event) => {
    showTip(t('anchor.linkTimeout'))
    isShowCoGuestPanelAvatar.value = true
    closeCustomModal();
  }

  const handleCoHostRequestReceived = (event) => {
    if (isShowCoGuestPanelAvatar.value && applicants.value.length === 0) {
      isShowCoGuestPanelAvatar.value = false
    }
    const res = JSON.parse(event);
    const inviter = JSON.parse(res.inviter);
    if (connected.value.length > 1 || applicants.value.length > 0) {
      rejectHostConnection({
        liveID: liveID.value,
        fromHostLiveID: inviter.liveID
      })
      return
    }
    showCustomModalDialog(inviter);
  }

  const ShowAnchorViewClickPanel = (userInfo) => {
    clickUserInfo.value = userInfo,
      showUserInfoPanel()
    isShowAnchorInfo.value = false
  }

  let seenAudienceIDs = new Set<string>();
  let audienceListInitialized = false;
  watch(audienceList, (list) => {
    const arr = Array.isArray(list) ? list : [];
    const ids = new Set(arr.map((u: any) => u?.userID).filter(Boolean));
    if (ids.size === 0) {
      seenAudienceIDs.clear();
      audienceListInitialized = false;
      return;
    }
    if (!audienceListInitialized) {
      seenAudienceIDs = ids;
      audienceListInitialized = true;
      return;
    }
    ids.forEach(id => {
      if (!seenAudienceIDs.has(id)) {
        const user = arr.find((u: any) => u?.userID === id);
        pushAudienceEntry({ userID: id, userName: user?.userName || id, level: Number(user?.level) || 0 });
      }
    });
    seenAudienceIDs = ids;
  });

  watch(applicants, (newVal, oldVal) => {
    if (!isShowCoGuestPanelAvatar.value) {
      applicants.value.forEach(applicant => {
        rejectApplication({
          liveID: liveID.value,
          userID: applicant.userID,
        });
      });
    }
  }, {
    deep: true,
    immediate: true,
  })

  watch(coHostStatus, (newVal) => {
    if (newVal === CoHostStatusType.DISCONNECTED) {
      isShowCoGuestPanelAvatar.value = true
    }
  }, {
    deep: true,
    immediate: true,
  })

  watch(invitees, (newVal) => {
    if (!newVal && !isShowCoGuestPanelAvatar.value) {
      isShowCoGuestPanelAvatar.value = true
    } else {
      applicants.value.forEach(applicant => {
        rejectApplication({
          liveID: liveID.value,
          userID: applicant.userID,
        });
      });
    }
  })

  watch(currentLive, (newVal, oldVal) => {
    if (newVal) {
      console.log(`currentLive change: ${JSON.stringify(newVal)}`);
    }
  });

  onMounted(() => {
    setTimeout(() => {
      preloadLiveImages([LIVE_SUMMARY_BACKGROUND_IMAGE], 1);
    }, 1500);
    addLiveListListener('onLiveEnded', handleSdkLiveEnded);
    addCoHostListener(liveID.value,
      'onCoHostRequestAccepted',
      handleCoHostRequestAccepted
    )
    addCoHostListener(liveID.value,
      'onCoHostRequestRejected',
      handleCoHostRequestRejected
    )
    addCoHostListener(liveID.value,
      'onCoHostRequestTimeout',
      handleCoHostRequestTimeout
    )
    addCoHostListener(liveID.value,
      'onCoHostRequestReceived',
      handleCoHostRequestReceived
    )
    uni.$on('anchorStreamViewClick', ShowAnchorViewClickPanel);
    addAudienceListener(liveID.value, 'onAudienceJoined', onAudienceJoined);
  });

  onUnmounted(() => {
    if (pauseTimer != null) {
      clearInterval(pauseTimer);
      pauseTimer = null;
    }
    removeLiveListListener('onLiveEnded', handleSdkLiveEnded);
    removeCoHostListener(liveID.value,
      'onCoHostRequestAccepted',
      handleCoHostRequestAccepted
    )
    removeCoHostListener(liveID.value,
      'onCoHostRequestRejected',
      handleCoHostRequestRejected
    )
    removeCoHostListener(liveID.value,
      'onCoHostRequestTimeout',
      handleCoHostRequestTimeout
    )
    removeCoHostListener(liveID.value,
      'onCoHostRequestReceived',
      handleCoHostRequestReceived
    )
    uni.$off('anchorStreamViewClick', ShowAnchorViewClickPanel);
    removeAudienceListener(liveID.value, 'onAudienceJoined', onAudienceJoined);
  });
</script>

<style lang="scss">
  @import './LivingView.scss';
</style>
