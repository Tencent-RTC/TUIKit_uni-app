<template>
  <view class="live-status-root">
    <view :class="['live-status-trigger', 'live-status-trigger--' + networkStatus]" @tap="open">
      <image
        v-if="networkIcon"
        class="live-status-trigger-network"
        :style="{ width: networkIconWidth + 'rpx' }"
        :src="networkIcon"
        mode="aspectFit"
      />
      <text class="live-status-trigger-label">{{ t('liveStatus.title') }}</text>
      <view class="live-status-trigger-chevron"></view>
    </view>

    <BaseDrawer
      v-model="visible"
      :height="drawerHeight"
      :overlayOpacity="0.4"
      bgImage="/uni_modules/tuikit-atomic-x/static/assets/live/drawer-bg.png"
      :bgImageHeight="drawerHeight"
      padding="20rpx 36rpx 48rpx"
    >
      <view class="live-status-heading">
        <text class="live-status-heading-title">{{ t('liveStatus.title') }}</text>
        <view class="live-status-timer">
          <view class="live-status-timer-dot"></view>
          <text class="live-status-timer-text">{{ durationText }}</text>
        </view>
      </view>

      <view class="live-status-tabs">
        <view
          :class="['live-status-tab', activeTab === 'data' ? 'live-status-tab--active' : '']"
          @tap="activeTab = 'data'"
        >
          <text :class="['live-status-tab-text', activeTab === 'data' ? 'live-status-tab-text--active' : '']">{{ t('liveStatus.realtimeData') }}</text>
        </view>
        <view
          :class="['live-status-tab', activeTab === 'device' ? 'live-status-tab--active' : '']"
          @tap="activeTab = 'device'"
        >
          <text :class="['live-status-tab-text', activeTab === 'device' ? 'live-status-tab-text--active' : '']">{{ t('liveStatus.deviceStatus') }}</text>
        </view>
      </view>

      <view v-if="activeTab === 'data'" class="live-status-page">
        <view class="live-status-card">
          <view class="live-status-card-heading">
            <text class="live-status-card-heading-title">{{ t('liveStatus.realtimeData') }}</text>
            <text class="live-status-card-heading-tag">{{ t('liveStatus.sessionTotal') }}</text>
          </view>
          <view class="live-status-data-row">
            <view class="live-status-metric live-status-metric--divider">
              <text class="live-status-metric-label">{{ t('liveStatus.giftScore') }}</text>
              <view class="live-status-metric-value-row">
                <text class="live-status-metric-value" :style="metricValueStyle(giftCoinsText)">{{ giftCoinsText }}</text>
                <text class="live-status-metric-unit">{{ t('common.pointUnit') }}</text>
              </view>
            </view>
            <view class="live-status-metric live-status-metric--divider">
              <text class="live-status-metric-label">{{ t('liveStatus.gifters') }}</text>
              <view class="live-status-metric-value-row">
                <text class="live-status-metric-value" :style="metricValueStyle(gifterCountText)">{{ gifterCountText }}</text>
                <text class="live-status-metric-unit">{{ t('common.personUnit') }}</text>
              </view>
            </view>
            <view class="live-status-metric live-status-metric--divider">
              <text class="live-status-metric-label">{{ t('liveStatus.newFollowers') }}</text>
              <view class="live-status-metric-value-row">
                <text class="live-status-metric-value">0</text>
                <text class="live-status-metric-unit">{{ t('common.personUnit') }}</text>
              </view>
            </view>
          </view>
          <view class="live-status-data-row">
            <view class="live-status-metric">
              <text class="live-status-metric-label">{{ t('liveStatus.onlineCount') }}</text>
              <view class="live-status-metric-value-row">
                <text class="live-status-metric-value" :style="metricValueStyle(onlineCountText)">{{ onlineCountText }}</text>
                <text class="live-status-metric-unit">{{ t('common.personUnit') }}</text>
              </view>
            </view>
            <view class="live-status-metric">
              <text class="live-status-metric-label">{{ t('liveStatus.likeCount') }}</text>
              <view class="live-status-metric-value-row">
                <text class="live-status-metric-value" :style="metricValueStyle(likeCountText)">{{ likeCountText }}</text>
                <text class="live-status-metric-unit">{{ t('common.timeUnit') }}</text>
              </view>
            </view>
            <view class="live-status-metric">
              <text class="live-status-metric-label">{{ t('liveStatus.commenterCount') }}</text>
              <view class="live-status-metric-value-row">
                <text class="live-status-metric-value">0</text>
                <text class="live-status-metric-unit">{{ t('common.personUnit') }}</text>
              </view>
            </view>
          </view>
        </view>
        <view class="live-status-tip-card">
          <text class="live-status-tip-icon">↗</text>
          <view class="live-status-tip-copy">
            <text class="live-status-tip-title">{{ t('liveStatus.updating') }}</text>
            <text class="live-status-tip-sub">{{ t('liveStatus.updatingCopy') }}</text>
          </view>
        </view>
      </view>

      <view v-else class="live-status-page">
        <view class="live-status-health-list">
          <view class="live-status-health-item">
            <view class="live-status-health-icon">
              <image class="live-status-health-icon-img" :src="ICON_VIDEO" mode="aspectFit" />
            </view>
            <view class="live-status-health-copy">
              <text class="live-status-health-title">{{ videoStateText }}</text>
              <text class="live-status-health-sub">{{ videoStateCopy }}</text>
            </view>
            <text class="live-status-health-value">720P</text>
          </view>

          <view class="live-status-health-item live-status-audio-item">
            <view class="live-status-health-icon">
              <image class="live-status-health-icon-img" :src="ICON_AUDIO" mode="aspectFit" />
            </view>
            <view class="live-status-health-copy">
              <text class="live-status-health-title">{{ audioStateText }}</text>
              <text class="live-status-health-sub">{{ audioStateCopy }}</text>
              <view class="live-status-volume-row">
                <slider
                  class="live-status-volume"
                  :value="volume"
                  :min="0"
                  :max="100"
                  activeColor="#4A9EFF"
                  backgroundColor="rgba(255, 255, 255, 0.16)"
                  blockSize="14"
                  blockColor="#FFFFFF"
                  @change="onVolumeChange"
                />
                <text class="live-status-volume-value">{{ volume }}</text>
              </view>
            </view>
          </view>

          <view class="live-status-health-item">
            <view class="live-status-health-icon">
              <image class="live-status-health-icon-img" :src="ICON_TEMPERATURE" mode="aspectFit" />
            </view>
            <view class="live-status-health-copy">
              <text class="live-status-health-title">{{ t('liveStatus.temperatureNormal') }}</text>
              <text class="live-status-health-sub">{{ t('liveStatus.temperatureCopy') }}</text>
            </view>
          </view>

          <view class="live-status-health-item live-status-health-item--last">
            <view :class="['live-status-health-icon', 'live-status-health-icon--' + networkStatus]">
              <image class="live-status-health-icon-img" :src="networkHealthIcon" mode="aspectFit" />
            </view>
            <view class="live-status-health-copy">
              <text class="live-status-health-title">{{ networkStateText }}</text>
              <text class="live-status-health-sub">{{ t('liveStatus.networkCopy') }}</text>
            </view>
          </view>
        </view>

        <view :class="['live-status-network-card', 'live-status-network-card--' + networkStatus]">
          <view class="live-status-network-metric">
            <text class="live-status-network-value">{{ rttText }}</text>
            <text class="live-status-network-label">{{ t('liveStatus.roundTripLatency') }}</text>
          </view>
          <view class="live-status-network-metric">
            <text class="live-status-network-value">{{ downLossText }}</text>
            <text class="live-status-network-label">{{ t('liveStatus.downstreamLoss') }}</text>
          </view>
          <view class="live-status-network-metric">
            <text class="live-status-network-value">{{ upLossText }}</text>
            <text class="live-status-network-label">{{ t('liveStatus.upstreamLoss') }}</text>
          </view>
        </view>

        <view class="live-status-media-card">
          <view class="live-status-media-column live-status-media-column--first">
            <text class="live-status-media-title">{{ t('liveStatus.videoInfo') }}</text>
            <view class="live-status-media-row">
              <text class="live-status-media-key">{{ t('liveStatus.resolution') }}</text>
              <text class="live-status-media-value">720×1280</text>
            </view>
            <view class="live-status-media-row">
              <text class="live-status-media-key">{{ t('liveStatus.bitrate') }}</text>
              <text class="live-status-media-value">1800 kbps</text>
            </view>
            <view class="live-status-media-row">
              <text class="live-status-media-key">{{ t('liveStatus.frameRate') }}</text>
              <text class="live-status-media-value">25 FPS</text>
            </view>
          </view>
          <view class="live-status-media-column">
            <text class="live-status-media-title">{{ t('liveStatus.audioInfo') }}</text>
            <view class="live-status-media-row">
              <text class="live-status-media-key">{{ t('liveStatus.sampleRate') }}</text>
              <text class="live-status-media-value">48000 Hz</text>
            </view>
            <view class="live-status-media-row">
              <text class="live-status-media-key">{{ t('liveStatus.bitrate') }}</text>
              <text class="live-status-media-value">64 kbps</text>
            </view>
          </view>
        </view>
      </view>
    </BaseDrawer>
  </view>
</template>

<script setup lang="ts">
  import { ref, computed, watch, onMounted, onUnmounted } from 'vue';
  import { useLiveAudienceState } from '@/uni_modules/tuikit-atomic-x/state/LiveAudienceState';
  import { useDeviceState, DeviceStatus, NetworkQuality } from '@/uni_modules/tuikit-atomic-x/state/DeviceState';
  import { useLiveListState } from '@/uni_modules/tuikit-atomic-x/state/LiveListState';
  import { useLiveSummaryState } from '@/uni_modules/tuikit-atomic-x/state/LiveSummaryState';
  import { t } from '@/pages/scenes/live/locales';
  import BaseDrawer from '@/components/live/BaseDrawer/index.nvue';

  const props = defineProps({
    liveID: { type: String, default: '' },
  });

  const { audienceList, audienceCount } = useLiveAudienceState(props.liveID);
  const { currentLive } = useLiveListState(props.liveID);
  const { cameraStatus, microphoneStatus, captureVolume, setCaptureVolume, networkInfo } = useDeviceState();
  const { summaryData } = useLiveSummaryState(props.liveID);

  const ICON_DIR = '/static/images/live';
  const ICON_VIDEO = `${ICON_DIR}/live-status-video.png`;
  const ICON_AUDIO = `${ICON_DIR}/live-status-audio.png`;
  const ICON_TEMPERATURE = `${ICON_DIR}/live-status-temperature.png`;
  const ICON_NETWORK_GOOD = `${ICON_DIR}/live-status-network.png`;
  const ICON_NETWORK_WARN = `${ICON_DIR}/live-status-network-warn.png`;
  const ICON_NETWORK_DANGER = `${ICON_DIR}/live-status-network-danger.png`;
  const ICON_TRIGGER_POOR = `${ICON_DIR}/live-status-network-poor.png`;
  const ICON_TRIGGER_DISCONNECTED = `${ICON_DIR}/live-status-network-disconnected.png`;
  const drawerHeight = 1050;

  const visible = ref(false);
  const activeTab = ref('data');
  const liveDuration = ref(0);
  const volume = ref(0);
  const systemNetworkConnected = ref(true);
  const systemNetworkWeak = ref(false);

  let liveStartAt = 0;
  let durationTimer: ReturnType<typeof setInterval> | null = null;

  const localElapsedSeconds = () => Math.max(0, (Date.now() - liveStartAt) / 1000);

  const toMsTimestamp = (value: unknown): number => {
    const n = Number(value);
    if (!Number.isFinite(n) || n <= 0) return 0;
    if (n > 1e12) return Math.floor(n);
    if (n > 1e9) return Math.floor(n * 1000);
    return 0;
  };

  const formatCount = (value: number): string => {
    const v = Math.max(0, Math.floor(Number(value) || 0));
    if (v >= 1000000000) return `${Math.floor(v / 100000000)}${t('common.yiUnit')}+`;
    if (v >= 100000000) {
      const y = v / 100000000;
      return `${y >= 10 ? Math.floor(y) : Math.round(y * 10) / 10}${t('common.yiUnit')}`;
    }
    if (v >= 100000) return `${Math.floor(v / 10000)}${t('common.wanUnit')}+`;
    if (v >= 10000) {
      const w = v / 10000;
      return `${w >= 10 ? Math.floor(w) : Math.round(w * 10) / 10}${t('common.wanUnit')}`;
    }
    return String(v);
  };

  const metricValueStyle = (text: string) => {
    const base = 40;
    const cjk = (text.match(/[\u4e00-\u9fa5]/g) || []).length;
    const estimated = cjk * base + (text.length - cjk) * base * 0.6;
    const maxWidth = 170;
    if (estimated <= maxWidth) return { fontSize: base + 'rpx' };
    return { fontSize: Math.max(24, Math.floor((base * maxWidth) / estimated)) + 'rpx' };
  };

  const formatNetworkMetric = (value: unknown, suffix: string): string => {
    const n = Number(value);
    if (!Number.isFinite(n) || n < 0) return '--';
    return `${Math.round(n)}${suffix}`;
  };

  const networkStatus = computed<'good' | 'poor' | 'disconnected'>(() => {
    if (!systemNetworkConnected.value) return 'disconnected';
    const quality = Number(networkInfo.value?.quality);
    if (quality === NetworkQuality.Poor || quality === NetworkQuality.Bad || quality === NetworkQuality.VeryBad) {
      return 'poor';
    }
    if (quality === NetworkQuality.Excellent || quality === NetworkQuality.Good) {
      return 'good';
    }
    return systemNetworkWeak.value ? 'poor' : 'good';
  });

  const durationText = computed(() => {
    const h = String(Math.floor(liveDuration.value / 3600)).padStart(2, '0');
    const m = String(Math.floor((liveDuration.value % 3600) / 60)).padStart(2, '0');
    const s = String(liveDuration.value % 60).padStart(2, '0');
    return `${h}:${m}:${s}`;
  });

  const onlineCount = computed(() =>
    audienceList.value.length > 100 ? Number(audienceCount?.value) || 0 : audienceList.value.length
  );

  const giftCoins = computed(() => Math.max(0, Math.floor(Number(summaryData.value?.totalGiftCoins) || 0)));
  const gifterCount = computed(() => Math.max(0, Math.floor(Number(summaryData.value?.totalGiftUniqueSenders) || 0)));
  const likeCount = computed(() => Math.max(0, Math.floor(Number(summaryData.value?.totalLikesReceived) || 0)));
  const onlineCountText = computed(() => formatCount(onlineCount.value));
  const giftCoinsText = computed(() => formatCount(giftCoins.value));
  const gifterCountText = computed(() => formatCount(gifterCount.value));
  const likeCountText = computed(() => formatCount(likeCount.value));

  const networkIcon = computed(() => {
    if (networkStatus.value === 'poor') return ICON_TRIGGER_POOR;
    if (networkStatus.value === 'disconnected') return ICON_TRIGGER_DISCONNECTED;
    return '';
  });

  const networkIconWidth = computed(() =>
    networkStatus.value === 'disconnected' ? 34 : 26
  );

  const networkHealthIcon = computed(() => {
    if (networkStatus.value === 'poor') return ICON_NETWORK_WARN;
    if (networkStatus.value === 'disconnected') return ICON_NETWORK_DANGER;
    return ICON_NETWORK_GOOD;
  });

  const networkStateText = computed(() => {
    if (networkStatus.value === 'poor') return t('liveStatus.networkPoorLabel');
    if (networkStatus.value === 'disconnected') return t('liveStatus.networkDisconnectedLabel');
    return t('liveStatus.networkExcellent');
  });

  const rttText = computed(() => formatNetworkMetric(networkInfo.value?.delay, 'ms'));
  const downLossText = computed(() => formatNetworkMetric(networkInfo.value?.downLoss, '%'));
  const upLossText = computed(() => formatNetworkMetric(networkInfo.value?.upLoss, '%'));

  const videoStateText = computed(() =>
    cameraStatus.value === DeviceStatus.ON ? t('liveStatus.videoNormal') : t('liveStatus.videoOff')
  );
  const videoStateCopy = computed(() =>
    cameraStatus.value === DeviceStatus.ON ? t('liveStatus.videoNormalCopy') : t('liveStatus.videoOffCopy')
  );
  const audioStateText = computed(() =>
    microphoneStatus.value === DeviceStatus.ON ? t('liveStatus.audioNormal') : t('liveStatus.audioOff')
  );
  const audioStateCopy = computed(() =>
    microphoneStatus.value === DeviceStatus.ON ? t('liveStatus.audioNormalCopy') : t('liveStatus.audioOffCopy')
  );

  const open = () => {
    visible.value = true;
  };

  const onVolumeChange = (e: any) => {
    volume.value = Math.round(Number(e?.detail?.value) || 0);
    setCaptureVolume({ volume: volume.value });
  };

  const applyNetworkType = (networkType?: string, isConnected?: boolean) => {
    systemNetworkConnected.value = !(isConnected === false || !networkType || networkType === 'none');
    systemNetworkWeak.value = networkType === '2g' || networkType === '3g';
  };

  const onNetworkChange = (res: any) => {
    applyNetworkType(res?.networkType, res?.isConnected);
  };

  watch(captureVolume, (val) => {
    volume.value = Math.max(0, Math.round(Number(val) || 0));
  }, { immediate: true });

  watch(() => currentLive.value?.createTime, (createTime) => {
    if (liveStartAt > 0) return;
    liveStartAt = toMsTimestamp(createTime);
  }, { immediate: true });

  onMounted(() => {
    durationTimer = setInterval(() => {
      liveDuration.value = Math.floor(localElapsedSeconds());
    }, 1000);
    uni.getNetworkType({
      success: (res: any) => applyNetworkType(res?.networkType),
    });
    uni.onNetworkStatusChange(onNetworkChange);
  });

  onUnmounted(() => {
    if (durationTimer != null) {
      clearInterval(durationTimer);
      durationTimer = null;
    }
    uni.offNetworkStatusChange(onNetworkChange);
  });
</script>

<style lang="scss">
  @import './LiveStatusPanel.scss';
</style>
