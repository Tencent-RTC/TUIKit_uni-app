<template>
  <view>
    <BaseDrawer
      v-model="innerVisible"
      :height="300"
      :overlayOpacity="0.5"
      bgImage="/uni_modules/tuikit-atomic-x/static/assets/live/drawer-bg.png"
      :bgImageHeight="710"
      padding="0 48rpx 40rpx 48rpx"
      :useSafeBottom="true"
    >
      <text class="title">{{ t('anchor.moreSettings') }}</text>

      <view class="setting-list">
        <view class="cap" @tap="openQualityPanel">
          <view class="cap-icon">
            <image class="cap-icon-img" src="/static/images/live/icon/prepare-quality.png" mode="aspectFit" />
          </view>
          <text class="cap-label">{{ qualityLabel }}</text>
        </view>
        <view class="cap" @tap="handleMirror">
          <view class="cap-icon">
            <image
              class="cap-icon-img"
              :style="{ transform: mirrorEnabled ? 'scaleX(1)' : 'scaleX(-1)' }"
              src="/static/images/live/icon/prepare-mirror-on.png"
              mode="aspectFit"
            />
          </view>
          <text class="cap-label">{{ t('morePanel.mirror') }}</text>
        </view>
        <view class="cap" @tap="handleAudioEffect">
          <view class="cap-icon">
            <image class="cap-icon-img" src="/static/images/live/icon/prepare-sound-effect.png" mode="aspectFit" />
          </view>
          <text class="cap-label">{{ t('anchor.soundEffect') }}</text>
        </view>
      </view>
    </BaseDrawer>
    <QualityPanel v-model="qualityVisible" />
    <AudioEffectPanel v-model="isShowAudioEffect" />
  </view>
</template>

<script setup lang="ts">
  import { ref, computed, watch } from 'vue';
  import { MirrorType, VideoQuality, useDeviceState } from '@/uni_modules/tuikit-atomic-x/state/DeviceState';
  import { t } from '../../../../locales';
  import BaseDrawer from '@/components/live/BaseDrawer/index.nvue';
  import QualityPanel from '../QualityPanel/index.nvue';
  import AudioEffectPanel from '@/uni_modules/tuikit-atomic-x/components/AudioEffectPanel';

  const props = defineProps({
    modelValue: {
      type: Boolean,
      default: false,
    },
  });

  const emit = defineEmits(['update:modelValue', 'tip']);

  const { localMirrorType, isFrontCamera, switchMirror, localVideoQuality } = useDeviceState();

  const qualityVisible = ref(false);
  const isShowAudioEffect = ref(false);

  const innerVisible = computed({
    get: () => props.modelValue,
    set: (val) => emit('update:modelValue', val),
  });

  const mirrorEnabled = computed(() => {
    return localMirrorType.value === MirrorType.AUTO
      || localMirrorType.value === MirrorType.ENABLE;
  });

  const qualityLabel = computed(() => {
    const q = Number(localVideoQuality.value);
    if (q === VideoQuality.QUALITY_1080P) return t('morePanel.qualityUltra');
    return t('morePanel.qualityHD');
  });

  const handleMirror = () => {
    if (!isFrontCamera.value) {
      emit('tip', t('morePanel.frontOnly'));
      return;
    }
    switchMirror({
      mirrorType: mirrorEnabled.value ? MirrorType.DISABLE : MirrorType.ENABLE,
    });
  };

  const openQualityPanel = () => {
    qualityVisible.value = true;
  };

  const handleAudioEffect = () => {
    innerVisible.value = false;
    isShowAudioEffect.value = true;
  };

  watch(qualityVisible, (val, oldVal) => {
    if (oldVal && !val) {
      innerVisible.value = false;
    }
  });
</script>

<style lang="scss">
  @import './BeforeLiveMorePanel.scss';
</style>
