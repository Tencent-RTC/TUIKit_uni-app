<template>
  <view>
    <OptionSheet v-model="isShowEndSheet" :title="endSheetTitle" :itemList="endSheetItems" @select="onEndSheetSelect" />
    <BaseDrawer
      v-model="isShowEndConfirm"
      :height="drawerHeight"
      :overlayOpacity="0.4"
      :zIndex="2700"
      bgImage="/uni_modules/tuikit-atomic-x/static/assets/live/drawer-bg.png"
      :bgImageHeight="drawerHeight"
      padding="20rpx 48rpx 96rpx 48rpx"
      :showHandle="true"
    >
      <view class="end-live-confirm-text">
        <view v-if="hasViewer" class="end-live-viewers">
          <text class="end-live-viewers-text">{{ t('anchor.endConfirmHasPrefix') }}</text>
          <text class="end-live-viewers-count">{{ viewerCount }}</text>
          <text class="end-live-viewers-text">{{ t('anchor.endConfirmWatchingSuffix') }}</text>
        </view>
        <text v-if="hasViewer" class="end-live-question">{{ t('anchor.endConfirmQuestion') }}</text>
        <text v-else class="end-live-empty">{{ t('anchor.endConfirmEmpty') }}</text>
      </view>
      <view class="end-live-confirm-actions">
        <view class="end-live-btn end-live-btn-secondary" @tap="closeConfirm">
          <text class="end-live-btn-text">{{ t('anchor.endConfirmContinue') }}</text>
        </view>
        <view class="end-live-btn end-live-btn-danger" @tap="onConfirmEndLive">
          <text class="end-live-btn-text">{{ t('anchor.endConfirmEnd') }}</text>
        </view>
      </view>
    </BaseDrawer>
  </view>
</template>

<script setup lang="ts">
  import { ref, computed, watch } from 'vue';
  import { CoHostStatusType, useCoHostState } from '@/uni_modules/tuikit-atomic-x/state/CoHostState';
  import { useLiveAudienceState } from '@/uni_modules/tuikit-atomic-x/state/LiveAudienceState';
  import { useLiveListState } from '@/uni_modules/tuikit-atomic-x/state/LiveListState';
  import { t } from '../../../../locales';
  import BaseDrawer from '@/components/live/BaseDrawer/index.nvue';
  import OptionSheet from '@/components/live/OptionSheet/index.nvue';

  const emit = defineEmits(['ended', 'overlayActiveChange']);

  defineExpose({ requestEnd });

  const { endLive, currentLive } = useLiveListState();
  const liveID = computed(() => String(currentLive.value?.liveID || ''));
  const { coHostStatus, exitHostConnection } = useCoHostState(liveID.value);
  const { audienceList, audienceCount } = useLiveAudienceState(liveID.value);

  const isShowEndSheet = ref(false);
  const endSheetTitle = ref('');
  const endSheetItems = ref([t('anchor.closeLive')]);
  const isShowEndConfirm = ref(false);
  const isEndingLive = ref(false);

  const viewerCount = computed(() =>
    (audienceList.value?.length || 0) > 100 ? audienceCount.value : (audienceList.value?.length || 0)
  );
  const hasViewer = computed(() => (viewerCount.value || 0) > 0);
  const drawerHeight = computed(() => (hasViewer.value ? 490 : 424));

  function requestEnd() {
    if (coHostStatus.value === CoHostStatusType.CONNECTED) {
      endSheetItems.value = [t('anchor.disconnectLink'), t('anchor.closeLive')];
      endSheetTitle.value = t('anchor.linkEndingTip');
      isShowEndSheet.value = true;
    } else {
      isShowEndConfirm.value = true;
    }
  }

  const closeConfirm = () => {
    isShowEndConfirm.value = false;
  };

  const onConfirmEndLive = () => {
    if (isEndingLive.value) return;
    isEndingLive.value = true;
    isShowEndConfirm.value = false;
    endLive({
      success: () => {
        console.warn('[EndConfirmPanel] endLive success, emit ended');
        emit('ended');
      },
      fail: (errCode, errMsg) => {
        isEndingLive.value = false;
        console.error(`[EndConfirmPanel] endLive fail errCode: ${errCode}, errMsg: ${errMsg}`);
      },
    });
  };

  const onEndSheetSelect = (res: { tapIndex: number }) => {
    if (coHostStatus.value === CoHostStatusType.CONNECTED && res.tapIndex === 0) {
      exitHostConnection({
        liveID: liveID.value,
      });
      return;
    }
    onConfirmEndLive();
  };

  watch(() => isShowEndSheet.value || isShowEndConfirm.value, (visible) => {
    emit('overlayActiveChange', !!visible);
  });
</script>

<style lang="scss">
  @import './EndConfirmPanel.scss';
</style>
