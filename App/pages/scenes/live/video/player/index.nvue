<template>
  <view
    class="live-container"
    @click="handleHideInput"
    :style="{
      height: systemInfo?.windowHeight + 'px',
      width: (systemInfo?.windowWidth || systemInfo?.screenWidth) ? ((Math.max(systemInfo?.windowWidth || 0, systemInfo?.screenWidth || 0) + 2) + 'px') : undefined,
    }"
  >
    <view class="live-content">
      <LiveStreamView v-if="liveID && liveID.length > 0" :liveID="liveID" :isAnchor="false" :templateLayout="templateLayout" :currentLoginUserId="currentLoginUserId" :enableClickPanel="true" :isLiving="true" @streamViewClick="onStreamViewSeatClick">
      </LiveStreamView>
      <LivingView
        v-if="liveID"
        ref="livingViewRef"
        :liveID="liveID"
        :safeArea="safeArea"
        :templateLayout="templateLayout"
        :currentLoginUserId="currentLoginUserId"
        :systemInfo="systemInfo"
        @tip="onLivingTip"
        @receiveGift="handleReceiveGift"
        @back="navigateBack"
      />
      <LiveEndedView
        v-if="isShowLiveEnded"
        :hostName="endedInfo.hostName"
        :avatarURL="endedInfo.avatarURL"
        :reason="endedReason"
        @close="doExitLive"
      />
      <GiftPlayer
        ref="giftPlayerRef"
        v-model="isLargeSizeGiftPlayer"
        :url="latestGift?.resourceURL"
        :safeArea="safeArea"
        @finished="onGiftPlayerFinished"
      />
    </view>
  </view>

  <LiveToast :duration="2000"/>
</template>

<script setup lang="ts">
  import { onLoad, onBackPress, onShow } from '@dcloudio/uni-app';
  import { ref, onMounted, computed, onUnmounted, watch, nextTick } from 'vue';
  import LiveStreamView from '@/uni_modules/tuikit-atomic-x/components/LiveStreamView';
  import LiveToast from '@/uni_modules/tuikit-atomic-x/components/Common/LiveToast/index.nvue';
  import { showLiveToast } from '@/uni_modules/tuikit-atomic-x/components/Common/LiveToast/index.ts';
  import { GiftPlayer, giftService } from '@/uni_modules/tuikit-atomic-x/components/Gift';
  import { setSdkLanguageFromSystem } from '@/uni_modules/tuikit-atomic-x/utils/setSdkLanguageFromSystem';
  import { useLiveListState } from "@/uni_modules/tuikit-atomic-x/state/LiveListState";
  import { useLiveSeatState } from "@/uni_modules/tuikit-atomic-x/state/LiveSeatState";
  import permission from "@/uni_modules/tuikit-atomic-x/utils/permission";
  import { DeviceStatus, useDeviceState } from "@/uni_modules/tuikit-atomic-x/state/DeviceState";
  import { useBaseBeautyState } from "@/uni_modules/tuikit-atomic-x/state/BaseBeautyState";
  import { useCoGuestState } from '@/uni_modules/tuikit-atomic-x/state/CoGuestState';
  import { useLoginState } from "@/uni_modules/tuikit-atomic-x/state/LoginState";
  import { LivingView, LiveEndedView } from './views';
  import { t } from '../../locales';

  const { loginUserInfo } = useLoginState()
  const liveID = ref('');
  const { joinLive, liveList, leaveLive, currentLive, addLiveListListener, removeLiveListListener } = useLiveListState(liveID.value);
  const { addLiveSeatEventListener, removeLiveSeatEventListener, seatList, muteMicrophone, unmuteMicrophone } = useLiveSeatState(liveID.value);
  const { disconnect } = useCoGuestState(liveID.value)
  const { closeLocalCamera, openLocalCamera, isFrontCamera } = useDeviceState();
  const { setSmoothLevel, setWhitenessLevel, setRuddyLevel, smoothLevel, whitenessLevel, ruddyLevel } = useBaseBeautyState();

  const applyBeautyPrefs = () => {
    setSmoothLevel({ smoothLevel: smoothLevel.value });
    setWhitenessLevel({ whitenessLevel: whitenessLevel.value });
    setRuddyLevel({ ruddyLevel: ruddyLevel.value });
  };

  let bgCameraClosed = false;
  let bgMicMuted = false;
  let bgIsFront = true;

  const selfSeatForBackground = computed(() =>
    (seatList.value || []).find((s: any) => s?.userInfo?.userID === (loginUserInfo.value?.userID || ''))
  );

  const handleAppHide = () => {
    if (permission.isPermissionPrompting()) return;
    uni.$appIsActive = false;
    if (uni.$localGuestStatus !== 'CONNECTED') return;
    if (!selfSeatForBackground.value) return;
    const selfSeatInfo = selfSeatForBackground.value?.userInfo;
    const isMicCoGuest = uni.$localCoGuestType === 'mic';
    if (!isMicCoGuest && selfSeatInfo?.cameraStatus === DeviceStatus.ON) {
      bgCameraClosed = true;
      bgIsFront = isFrontCamera.value !== false;
      closeLocalCamera();
    }
    if (selfSeatInfo?.microphoneStatus === DeviceStatus.ON) {
      bgMicMuted = true;
      muteMicrophone({ liveID: liveID.value });
    }
  };

  const handleAppShow = () => {
    uni.$appIsActive = true;
    if (!bgCameraClosed && !bgMicMuted) return;
    if (uni.$localGuestStatus !== 'CONNECTED' || !selfSeatForBackground.value) {
      bgCameraClosed = false;
      bgMicMuted = false;
      return;
    }
    if (bgCameraClosed) {
      bgCameraClosed = false;
      if (uni.$localCoGuestType !== 'mic') {
        openLocalCamera({ isFront: bgIsFront });
        applyBeautyPrefs();
      }
    }
    if (bgMicMuted) {
      bgMicMuted = false;
      if (selfSeatForBackground.value?.userInfo?.allowOpenMicrophone === false) return;
      unmuteMicrophone({ liveID: liveID.value });
      if (uni.$appIsActive === false) {
        muteMicrophone({ liveID: liveID.value });
      }
    }
  };
  uni.onAppHide?.(handleAppHide);
  uni.onAppShow?.(handleAppShow);

  let isExitingLive = false;
  const isShowLiveEnded = ref(false);
  const endedInfo = ref({ hostName: '', avatarURL: '' });
  const endedReason = ref('');
  const liveInfoSnapshot = ref({ hostName: '', avatarURL: '' });
  const systemInfo = ref({});
  const safeArea = ref({
    left: 0, right: 0, top: 0, bottom: 0, width: 375, height: 750,
  });
  const isLargeSizeGiftPlayer = ref(false);
  const latestGift = ref({});
  const giftPlayerRef = ref(null);
  const giftPlayerHolder = { current: null };
  const livingViewRef = ref<any>(null);
  const currentLoginUserId = ref();
  const templateLayout = ref(600);
  const JOIN_FAIL_REDIRECT_MS = 500;
  const EXIT_REDIRECT_DELAY_MS = 1500;

  const { showGift, onGiftFinished } = giftService({
    roomId: liveID.value,
    giftPlayerRef: giftPlayerHolder,
  });

  const showTip = (title: string, position: string = 'center') => showLiveToast(title, position);
  const onLivingTip = (title: string, position: string = 'center') => {
    showTip(title, position);
  };
  const handleHideInput = () => {
    uni.hideKeyboard();
  };

  const handleReceiveGift = (giftData: any, count: number) => {
    showGift(giftData, { count });
  };

  const onGiftPlayerFinished = () => {
    isLargeSizeGiftPlayer.value = false;
    onGiftFinished();
  };

  const joinLiveRoom = (onSuccess: () => void) => {
    joinLive({
      liveID: liveID.value,
      success: onSuccess,
      fail: () => {
        showTip(t('audience.liveEnded'));
        setTimeout(() => uni.redirectTo({ url: `/pages/scenes/live/video/liveList/index` }), JOIN_FAIL_REDIRECT_MS);
      },
    });
  };

  const handlePageLoad = (options: any) => {
    console.warn('Live page onLoad = ', options);
    liveID.value = options?.liveID || '';

    if (liveID.value) {
      joinLiveRoom(() => {
        templateLayout.value = currentLive.value?.seatLayoutTemplateID || templateLayout.value;
        console.log('joinLive success templateLayout: ', templateLayout.value);
      });
      return;
    }
    showTip(t('audience.emptyLiveID'));
  };

  const handleCallEndedBackToLive = () => {
    console.warn('[Audience] callEndedBackToLive: rejoining live room');
    if (liveID.value) {
      joinLiveRoom(() => {
        templateLayout.value = currentLive.value?.seatLayoutTemplateID || templateLayout.value;
        console.log('[Audience] rejoinLive success after call ended');
      });
    }
  };

  const handleLocalCameraOpenedByAdmin = (event) => {
    showTip(t('audience.cameraUnmutedByAdmin'));
  };
  const handleLocalCameraClosedByAdmin = (event) => {
    showTip(t('audience.cameraMutedByAdmin'));
  };
  const handleLocalMicrophoneOpenedByAdmin = (event) => {
    showTip(t('audience.micUnmutedByAdmin'));
  };
  const handleLocalMicrophoneClosedByAdmin = (event) => {
    showTip(t('audience.micMutedByAdmin'));
  };
  const exitLiveWithTip = (tip: string) => {
    isExitingLive = true;
    removeAllLiveListeners();
    showTip(tip);
    setTimeout(() => {
      uni.redirectTo({
        url: `/pages/scenes/live/video/liveList/index`,
        delta: 1,
        success: () => {
          console.log('返回成功');
        },
        fail: (err) => {
          console.error('返回失败', err);
        }
      });
    }, EXIT_REDIRECT_DELAY_MS);
  };
  const fillEndedInfo = () => {
    const cur = currentLive.value;
    const snap = liveInfoSnapshot.value;
    endedInfo.value = {
      hostName: cur?.liveOwner?.userName || cur?.liveOwner?.userID || snap.hostName,
      avatarURL: cur?.liveOwner?.avatarURL || snap.avatarURL,
    };
  };
  const handleLiveEnded = (event) => {
    fillEndedInfo();
    endedReason.value = '';
    isShowLiveEnded.value = true;
  };
  const handleKickedOutOfLive = (event) => {
    isExitingLive = true;
    removeAllLiveListeners();
    fillEndedInfo();
    endedReason.value = t('audience.kickedOut');
    isShowLiveEnded.value = true;
    showTip(t('audience.kickedOut'));
  };

  const removeAllLiveListeners = () => {
    removeLiveListListener('onLiveEnded', handleLiveEnded)
    removeLiveListListener('onKickedOutOfLive', handleKickedOutOfLive)
    removeLiveSeatEventListener(liveID.value, 'onLocalCameraOpenedByAdmin', handleLocalCameraOpenedByAdmin)
    removeLiveSeatEventListener(liveID.value, 'onLocalCameraClosedByAdmin', handleLocalCameraClosedByAdmin)
    removeLiveSeatEventListener(liveID.value, 'onLocalMicrophoneOpenedByAdmin', handleLocalMicrophoneOpenedByAdmin)
    removeLiveSeatEventListener(liveID.value, 'onLocalMicrophoneClosedByAdmin', handleLocalMicrophoneClosedByAdmin)
  };

  const onStreamViewSeatClick = (payload: any) => {
    livingViewRef.value?.openCoGuestRequestFromSeat?.(payload);
  };

  const navigateBack = () => {
    doExitLive();
  };
  const doExitLive = () => {
    isExitingLive = true;
    if (uni.$localGuestStatus === 'CONNECTED') {
      disconnect({
        liveID: liveID.value,
      })
      uni.$localGuestStatus = 'IDLE';
    }
    leaveLive({
      success: () => {
        uni.redirectTo({
          url: `/pages/scenes/live/video/liveList/index`,
          delta: 1,
          animationType: 'pop-out',
          animationDuration: 300,
          success: () => {
            console.log('返回成功');
          },
          fail: (err) => {
            console.error('返回失败', err);
          }
        });
      }
    });
  };

  watch(giftPlayerRef, (val) => { giftPlayerHolder.current = val; });
  watch(() => loginUserInfo.value?.userID, (newUserId, oldUserId) => {
    if (newUserId) {
      currentLoginUserId.value = newUserId;
    }
  }, { immediate: true, deep: true });
  watch(currentLive, (newVal, oldVal) => {
    if (newVal) {
      templateLayout.value = newVal.seatLayoutTemplateID || templateLayout.value;
      console.log(`currentLive change: ${JSON.stringify(newVal)}`);
      if (newVal.liveID) {
        liveInfoSnapshot.value = {
          hostName: newVal.liveOwner?.userName || newVal.liveOwner?.userID || '',
          avatarURL: newVal.liveOwner?.avatarURL || '',
        };
      }
    }
  }, { immediate: true });
  watch(liveList, (newValue, oldValue) => {
    for (let i = 0; i < (oldValue || []).length; i++) {
      const liveNewInfo = (newValue || [])[i];
      const liveOldInfo = (oldValue || [])[i];
      if (!liveNewInfo || !liveOldInfo) continue;

      if (!liveOldInfo?.isMessageDisable && liveNewInfo?.isMessageDisable) {
        showTip(t('audience.allMuted'));
      }
    }
  }, { immediate: true, deep: true });

  onBackPress((option) => {
    if (option.from === 'backbutton')
      return true;
  });
  onLoad(handlePageLoad);
  // 对齐 iOS:在系统设置里【关闭】麦克风/摄像头权限后,App 会被终止并回到入口页。
  // uniapp 不会被杀进程,故在从系统设置返回(onShow)时检测。
  // 只对"本次会话内被回收"生效:进房时就未授权的(如纯看直播不需要麦克风)不应被挡在门外。
  const permissionBaseline = {
    camera: !permission.isMediaPermissionDenied('camera'),
    microphone: !permission.isMediaPermissionDenied('microphone'),
  };

  const redirectToEntryForPermission = () => {
    if (isExitingLive) return;
    const cameraRevoked = permissionBaseline.camera && permission.isMediaPermissionDenied('camera');
    const micRevoked = permissionBaseline.microphone && permission.isMediaPermissionDenied('microphone');
    if (!cameraRevoked && !micRevoked) return;
    showTip(t('audience.permissionRevoked'));
    doExitLive();
  };

  onShow(() => {
    redirectToEntryForPermission();
  });

  onMounted(() => {
    setSdkLanguageFromSystem()
    uni.setKeepScreenOn({
      keepScreenOn: true,
    });
    uni.getSystemInfo({
      success: (res) => {
        systemInfo.value = res;
        safeArea.value = res.safeArea;
      }
    });
    addLiveListListener('onLiveEnded', handleLiveEnded)
    addLiveListListener('onKickedOutOfLive', handleKickedOutOfLive)
    addLiveSeatEventListener(liveID.value, 'onLocalCameraOpenedByAdmin', handleLocalCameraOpenedByAdmin)
    addLiveSeatEventListener(liveID.value, 'onLocalCameraClosedByAdmin', handleLocalCameraClosedByAdmin)
    addLiveSeatEventListener(liveID.value, 'onLocalMicrophoneOpenedByAdmin', handleLocalMicrophoneOpenedByAdmin)
    addLiveSeatEventListener(liveID.value, 'onLocalMicrophoneClosedByAdmin', handleLocalMicrophoneClosedByAdmin)
    uni.$on('callEndedBackToLive', handleCallEndedBackToLive);
  });
  onUnmounted(() => {
    removeAllLiveListeners();
    uni.$off('callEndedBackToLive', handleCallEndedBackToLive);
  });
</script>

<style lang="scss">
  @import './player.scss';
</style>
