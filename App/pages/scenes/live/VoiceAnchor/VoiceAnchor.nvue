    border-radius: 16rpx;
    background-color: rgba(0, 0, 0, 0.6);
    justify-content: center;
    align-items: center;
    z-index: 2;
  }

  .seat-mic-off-icon {
    width: 22rpx;
    height: 22rpx;
  }

  .bottom-actions {
    position: absolute;
    bottom: 60rpx;
    left: 0;
    right: 0;
    padding-left: 60rpx;
    padding-right: 60rpx;
    z-index: 5;
    flex-direction: column;
  }

  .start-live-button {
    height: 100rpx;
    background-color: #2B65FB;
    border-radius: 200rpx;
    justify-content: center;
    align-items: center;
  }

  .start-live-text {
    font-size: 32rpx;
    color: #FFFFFF;
    font-weight: bold;
  }

  .live-header {
    position: relative;
    z-index: 10;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding-left: 32rpx;
    padding-right: 32rpx;
    padding-top: 20rpx;
    padding-bottom: 20rpx;
    margin-top: 80rpx;
  }

  .header-left {
    flex-direction: row;
    align-items: center;
    flex: 1;
  }

  .stream-info {
    flex-direction: row;
    align-items: center;
    background-color: rgba(0, 0, 0, 0.3);
    padding-top: 6rpx;
    padding-bottom: 6rpx;
    padding-left: 6rpx;
    padding-right: 16rpx;
    border-radius: 40rpx;
  }

