    width: 750rpx;
    position: relative;
    flex-direction: column;
  }

  .voice-bg {
    position: absolute;
    left: 0;
    top: 0;
  }

  .voice-bg-mask {
    position: absolute;
    left: 0;
    top: 0;
    background-color: rgba(0, 0, 0, 0.7);
  }

  .pre-live-wrapper {
    flex: 1;
    flex-direction: column;
  }

  .living-wrapper {
    flex: 1;
    flex-direction: column;
  }

  .navigate-back-arrow {
    position: absolute;
    top: 100rpx;
    left: 40rpx;
    z-index: 10;
    width: 60rpx;
    height: 60rpx;
    justify-content: center;
    align-items: center;
  }

  .navigate-back-arrow-image {
    width: 20rpx;
    height: 35rpx;
  }

  .live-info-card {
    position: relative;
    z-index: 5;
    flex-direction: row;
    align-items: flex-start;
    background-color: rgba(0, 0, 0, 0.25);
    border-radius: 24rpx;
    margin-top: 180rpx;
    margin-left: 32rpx;
    margin-right: 32rpx;
    padding: 16rpx;
  }

  .cover-section {
    position: relative;
    border-radius: 24rpx;
  }

  .cover-image {
    width: 140rpx;
    height: 188rpx;
    border-radius: 24rpx;
  }

  .cover-label {
    flex-direction: column;
    justify-content: center;
    align-items: center;
    width: 140rpx;
    position: absolute;
    bottom: 0;
    left: 0;
    padding-top: 5rpx;
    padding-bottom: 5rpx;
    background-color: rgba(0, 0, 0, 0.5);
    border-bottom-left-radius: 24rpx;
    border-bottom-right-radius: 24rpx;
  }

  .cover-label-text {
    color: #fff;
    font-size: 22rpx;
  }

  .info-section {
    flex: 1;
    margin-left: 24rpx;
    padding-top: 20rpx;
  }

  .title-row {
    flex-direction: row;
    align-items: center;
  }

  .live-title {
    color: #fff;
    font-size: 32rpx;
    font-weight: 500;
    flex: 1;
  }

  .edit-icon-container {
    width: 80rpx;
    height: 40rpx;
    justify-content: center;
    align-items: center;
  }

  .edit-icon {
    width: 32rpx;
    height: 32rpx;
    margin-left: 8rpx;
  }

  .underline {
    height: 2rpx;
    background-color: rgba(255, 255, 255, 0.2);
    margin-top: 10rpx;
  }

  .seat-grid {
    position: relative;
    z-index: 5;
    margin-top: 60rpx;
    padding-left: 32rpx;
    padding-right: 32rpx;
  }

  .seat-grid-live {
    margin-top: 30rpx;
  }

  .seat-row {
    flex-direction: row;
    justify-content: space-around;
    margin-bottom: 30rpx;
  }

  .seat-item {
    flex-direction: column;
    align-items: center;
    width: 120rpx;
  }

  .seat-circle {
    width: 100rpx;
    height: 100rpx;
    border-radius: 50rpx;
    background-color: rgba(255, 255, 255, 0.15);
    justify-content: center;
    align-items: center;
  }

  .seat-occupied {
    background-color: transparent;
  }

  .seat-wrapper {
    position: relative;
    width: 120rpx;
    height: 120rpx;
