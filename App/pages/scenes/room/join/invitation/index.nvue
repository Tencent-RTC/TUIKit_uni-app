<template>
  <view class="invite-page">
    <image
      v-if="callerAvatar.length > 0"
      class="bg-image"
      :style="{ width: bgWidth + 'px', height: bgHeight + 'px' }"
      :src="callerAvatar"
      mode="aspectFill"
    />
    <view
      class="bg-overlay"
      :class="{ 'bg-overlay--no-image': callerAvatar.length === 0 }"
      :style="{ width: bgWidth + 'px', height: bgHeight + 'px' }"
    ></view>

    <view class="content">
      <Avatar
        :src="callerAvatar || ''"
        :name="callerName || ''"
        :size="CALLER_AVATAR_SIZE_PX"
        :shape="'circle'"
        defaultAvatarType="user"
        pureMode
      />
      <text class="invite-text">{{ inviteText }}</text>
      <text class="room-name" :numberOfLines="2">{{ displayRoomName }}</text>
      <text v-if="metaText.length > 0" class="meta-text">{{ metaText }}</text>
    </view>

    <view class="bottom">
      <view class="slider-track" :style="{ width: trackWidthPx + 'px' }">
        <text class="slider-label" :style="{ opacity: labelOpacity }">{{ t('invitation.joinNow') }}</text>
        <view
          class="slider-thumb"
          :style="thumbStyle"
          @touchstart="onThumbTouchStart"
          @touchmove="onThumbTouchMove"
          @touchend="onThumbTouchEnd"
          @touchcancel="onThumbTouchEnd"
        >
          <image class="slider-thumb-icon" src="/static/images/room/room_arrow_invite.png" mode="aspectFit" />
        </view>
      </view>

      <view class="reject-btn" @tap="handleReject">
        <text class="reject-text">{{ t('invitation.reject') }}</text>
      </view>
    </view>
  </view>
</template>

<script setup lang="ts">
  import { ref, computed, onMounted, onUnmounted } from 'vue';
  import { onLoad, onUnload } from '@dcloudio/uni-app';
  import { useRoomState } from '@/uni_modules/tuikit-atomic-x/state';
  import { showErrorToast } from '@/uni_modules/tuikit-atomic-x/utils/roomErrorHandler';
  import Avatar from '@/uni_modules/tuikit-atomic-x/components/Avatar/Avatar.nvue';
  import {
    INVITATION_CLOSE_EVENT,
    ROOM_MAIN_PAGE,
    clearPendingInvite,
  } from '@/uni_modules/tuikit-atomic-x/server/roomCallService';
  import { t } from '../../locales';

  const roomState = useRoomState();

  const roomID = ref('');
  const roomName = ref('');
  const callerName = ref('');
  const callerAvatar = ref('');
  const ownerName = ref('');
  const participantCount = ref(0);

  const isHandling = ref(false);

  const inviteText = computed(() =>
    callerName.value.length > 0
      ? t('invitation.callerInvite', { name: callerName.value })
      : t('invitation.defaultInvite')
  );

  const displayRoomName = computed(() => {
    if (roomName.value.length > 0) return roomName.value;
    if (roomID.value.length > 0) return t('invitation.meetingNo', { roomId: roomID.value });
    return t('invitation.title');
  });

  const metaText = computed(() => {
    const parts: string[] = [];
    if (ownerName.value.length > 0) parts.push(t('invitation.host', { name: ownerName.value }));
    if (participantCount.value > 0) {
      parts.push(t('invitation.participants', { count: participantCount.value }));
    }
    return parts.join('  |  ');
  });

  const DESIGN_WIDTH_RPX = 750;
  const FALLBACK_WINDOW_WIDTH_PX = 375;
  const FALLBACK_SCREEN_HEIGHT_PX = 667;
  const SLIDER_TRACK_WIDTH_RPX = 400;
  const SLIDER_THUMB_SIZE_RPX = 128;
  const SLIDER_THUMB_INSET_RPX = 12;
  const CALLER_AVATAR_SIZE_PX = 128;
  const VIBRATE_INTERVAL_MS = 2000;
  const CLOSE_BACK_DELAY_MS = 300;

  const _sysInfo = uni.getSystemInfoSync();
  const _windowWidth = (_sysInfo?.windowWidth ?? FALLBACK_WINDOW_WIDTH_PX) as number;
  const rpx2px = (rpx: number): number => (rpx / DESIGN_WIDTH_RPX) * _windowWidth;

  const bgWidth = ref(_windowWidth);
  const bgHeight = ref(
    (_sysInfo?.screenHeight ?? _sysInfo?.windowHeight ?? FALLBACK_SCREEN_HEIGHT_PX) as number
  );

  const trackWidthPx = ref(rpx2px(SLIDER_TRACK_WIDTH_RPX));
  const thumbSizePx = ref(rpx2px(SLIDER_THUMB_SIZE_RPX));
  const thumbInsetPx = ref(rpx2px(SLIDER_THUMB_INSET_RPX));
  const TRIGGER_RATIO = 0.7;
  const thumbOffset = ref(0);

  const thumbStyle = computed(() => ({
    width: thumbSizePx.value + 'px',
    height: thumbSizePx.value + 'px',
    borderRadius: thumbSizePx.value / 2 + 'px',
    transform: `translateX(${thumbOffset.value}px)`,
  }));

  const labelOpacity = computed((): number => {
    const sliderMaxOffset = maxOffset();
    let opacity = 1 - (thumbOffset.value / sliderMaxOffset) * 2;
    if (opacity < 0) opacity = 0;
    if (opacity > 1) opacity = 1;
    return opacity;
  });

  let dragStartX = 0;
  let dragStartOffset = 0;
  let isDragging = false;

  function maxOffset(): number {
    return Math.max(1, trackWidthPx.value - thumbSizePx.value - thumbInsetPx.value * 2);
  }

  function touchScreenX(e: any): number {
    const touch = e?.changedTouches?.[0] ?? e?.touches?.[0];
    if (!touch) return 0;
    return (touch.screenX ?? touch.pageX ?? touch.clientX ?? 0) as number;
  }

  function onThumbTouchStart(e: any): void {
    if (isHandling.value) return;
    isDragging = true;
    dragStartX = touchScreenX(e);
    dragStartOffset = thumbOffset.value;
  }

  function onThumbTouchMove(e: any): void {
    if (!isDragging || isHandling.value) return;
    const sliderMaxOffset = maxOffset();
    let next = dragStartOffset + (touchScreenX(e) - dragStartX);
    if (next < 0) next = 0;
    if (next > sliderMaxOffset) next = sliderMaxOffset;
    if (next === thumbOffset.value) return;
    thumbOffset.value = next;
  }

  function onThumbTouchEnd(): void {
    if (!isDragging) return;
    isDragging = false;
    const sliderMaxOffset = maxOffset();
    if (thumbOffset.value / sliderMaxOffset >= TRIGGER_RATIO) {
      thumbOffset.value = sliderMaxOffset;
      handleAccept();
      return;
    }
    thumbOffset.value = 0;
  }

  function resetThumb(): void {
    thumbOffset.value = 0;
  }

  let _ringAudioCtx: any = null;
  let _vibrateTimer: number | null = null;

  function startRinging(): void {
    try {
      const audioContext: any = uni.createInnerAudioContext();
      audioContext.src = '/static/phone_ringing.mp3';
      audioContext.loop = true;
      audioContext.obeyMuteSwitch = false;
      audioContext.play();
      _ringAudioCtx = audioContext;
    } catch (e) {
      console.warn('[invitation] createInnerAudioContext failed:', e);
    }

    try {
      uni.vibrateLong({ type: 'medium' });
    } catch (e) {
      console.error('[invitation] vibrate failed:', e);
    }
    _vibrateTimer = setInterval((): void => {
      try {
        uni.vibrateLong({ type: 'medium' });
      } catch (e) {
        console.error('[invitation] vibrate repeat failed:', e);
      }
    }, VIBRATE_INTERVAL_MS) as unknown as number;
  }

  function stopRinging(): void {
    if (_vibrateTimer != null) {
      clearInterval(_vibrateTimer);
      _vibrateTimer = null;
    }
    if (_ringAudioCtx != null) {
      try {
        _ringAudioCtx.stop();
        _ringAudioCtx.destroy();
      } catch (e) {
        console.error('[invitation] stop ringtone failed:', e);
      }
      _ringAudioCtx = null;
    }
  }

  function handleAccept(): void {
    if (isHandling.value || roomID.value.length === 0) return;
    isHandling.value = true;
    stopRinging();
    clearPendingInvite();
    roomState
      .acceptCall({ roomID: roomID.value })
      .then(() => {
        uni.redirectTo({
          url: `${ROOM_MAIN_PAGE}?mode=accept&roomID=${encodeURIComponent(roomID.value)}`,
          fail: (err: any) => {
            console.error('[invitation] redirect to room main failed:', err);
            isHandling.value = false;
            resetThumb();
            showErrorToast(err, t('RoomInvite.EnterFailed'));
          },
        });
      })
      .catch((e: any) => {
        resetThumb();
        showErrorToast(e, t('RoomInvite.AcceptFailed'));
      });
  }

  function handleReject(): void {
    if (isHandling.value || roomID.value.length === 0) {
      uni.navigateBack();
      return;
    }
    isHandling.value = true;
    stopRinging();
    clearPendingInvite();
    roomState
      .rejectCall({ roomID: roomID.value })
      .then(() => {
        uni.navigateBack();
      })
  }

  function onInviteClosed(payload: any): void {
    const closedRoomID = payload?.roomID;
    if (typeof closedRoomID === 'string' && closedRoomID.length > 0 && closedRoomID !== roomID.value) {
      return;
    }
    setTimeout(() => uni.navigateBack(), CLOSE_BACK_DELAY_MS);
  }

  onLoad((options: any) => {
    const decodeParam = (value: any): string => {
      const rawValue = (value ?? '').toString();
      try {
        return decodeURIComponent(rawValue);
      } catch (_e) {
        return rawValue;
      }
    };
    roomID.value = decodeParam(options?.roomID);
    roomName.value = decodeParam(options?.roomName);
    callerName.value = decodeParam(options?.callerName);
    callerAvatar.value = decodeParam(options?.callerAvatar);
    ownerName.value = decodeParam(options?.ownerName);
    const parsedCount = parseInt(decodeParam(options?.participantCount), 10);
    participantCount.value = Number.isNaN(parsedCount) ? 0 : parsedCount;
    fetchRoomInfoIfNeeded();
  });

  function fetchRoomInfoIfNeeded(): void {
    if (roomID.value.length === 0) return;
    const needName = roomName.value.length === 0;
    const needOwner = ownerName.value.length === 0;
    const needCount = participantCount.value === 0;
    if (!needName && !needOwner && !needCount) return;
    roomState
      .getRoomInfo({ roomID: roomID.value })
      .then((info: any) => {
        if (needName && typeof info?.roomName === 'string' && info.roomName.length > 0) {
          roomName.value = info.roomName;
        }
        if (needOwner) {
          const owner = info?.roomOwner;
          const n = owner?.userName ?? owner?.userID ?? '';
          if (typeof n === 'string' && n.length > 0) ownerName.value = n;
        }
        if (needCount && typeof info?.participantCount === 'number' && info.participantCount > 0) {
          participantCount.value = info.participantCount;
        }
        if (callerName.value.length === 0 && ownerName.value.length > 0) {
          callerName.value = ownerName.value;
        }
      })
      .catch((e: any) => {
        console.warn('[invitation] getRoomInfo failed:', e);
      });
  }

  onMounted(() => {
    uni.setKeepScreenOn({ keepScreenOn: true });
    uni.$on(INVITATION_CLOSE_EVENT, onInviteClosed);
    startRinging();
  });

  onUnmounted(() => {
    uni.setKeepScreenOn({ keepScreenOn: false });
    uni.$off(INVITATION_CLOSE_EVENT, onInviteClosed);
    stopRinging();
  });

  onUnload(() => {
    clearPendingInvite();
  });
</script>

<style lang="scss">
  @import './invitation.scss';
</style>
