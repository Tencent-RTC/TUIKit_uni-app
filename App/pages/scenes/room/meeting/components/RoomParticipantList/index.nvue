<template>
  <view v-if="visible || micDialogState.visible || cameraDialogState.visible" class="list-root">
    <view class="list-mask" v-if="visible" @tap="onClose">
    <view class="list-sheet" @tap.stop="handleDismissKeyboard">
      <view class="drop-bar" @tap="onClose">
        <image class="drop-line" src="/static/images/room/room_lineImage.png" mode="aspectFit" />
      </view>

      <view class="search-row">
        <view class="search-wrap">
          <image class="search-icon" src="/static/images/room/room_search.png" mode="aspectFit" />
          <input
            ref="searchInputRef"
            class="search-input"
            :value="keyword"
            placeholder="搜索参会成员"
            placeholder-style="color: #6B7385; font-size: 28rpx;"
            @input="onKeywordInput"
          />
        </view>
      </view>

      <view class="tab-bar">
        <view class="tab-item" :class="{ 'tab-item-selected': currentTab === 'participant' }" @tap="setTab('participant')">
          <text class="tab-text" :class="{ 'tab-text-selected': currentTab === 'participant' }">{{ firstTabText }}</text>
        </view>
        <view class="tab-item" :class="{ 'tab-item-selected': currentTab === 'audience' }" @tap="setTab('audience')">
          <text class="tab-text" :class="{ 'tab-text-selected': currentTab === 'audience' }">{{ secondTabText }}</text>
        </view>
      </view>

      <view class="list-gap"></view>

      <list v-if="currentTab === 'participant'" class="list-scroll">
        <cell v-for="(p, idx) in filteredParticipantList" :key="p.userID">
          <ParticipantItem
            type="participant"
            :participant="p"
            :is-local="p.userID === localParticipant?.userID"
            :can-control="canControlParticipant(p)"
            :is-webinar="isWebinar"
            @press="emit('manage', p)"
          />
          <view v-if="idx < filteredParticipantList.length - 1" class="list-divider"></view>
        </cell>
      </list>
      <list v-else class="list-scroll">
        <cell v-for="(u, idx) in filteredSecondTabList" :key="u.userID">
          <ParticipantItem
            v-if="isWebinar"
            type="audience"
            :audience="u"
            :is-admin="isAdminUser(u.userID)"
            :is-local="u.userID === localParticipant?.userID"
            :can-control="isWebinar && canControlAudience(u)"
            :is-webinar="isWebinar"
            @press="isWebinar ? emit('manageAud', u) : undefined"
          />
          <ParticipantItem
            v-else
            type="notJoined"
            :not-joined-user="u"
            :is-calling="isUserCalling(u)"
            :is-rejected="isUserRejected(u)"
            @call="handleCall(u)"
            @cancelCall="handleCancelCall(u)"
          />
          <view v-if="idx < filteredSecondTabList.length - 1" class="list-divider"></view>
        </cell>
      </list>

      <view v-if="!isWebinar && currentTab === 'audience' && filteredSecondTabList.length === 0" class="list-empty">
        <text class="list-empty-text">暂无未进房成员</text>
      </view>

      <view v-if="!isWebinar && (isOwner || isAdmin) && currentTab === 'participant'" class="bottom-row">
        <view class="bottom-btn" @tap="handleAllMicToggle">
          <text
            class="bottom-btn-text"
            :style="allMicTextStyle"
          >{{ allMicText }}</text>
        </view>
        <view class="bottom-gap"></view>
        <view class="bottom-btn" @tap="handleAllCameraToggle">
          <text
            class="bottom-btn-text"
            :style="allCameraTextStyle"
          >{{ allCameraText }}</text>
        </view>
      </view>

      <view
        v-else-if="!isWebinar && currentTab === 'audience' && callAllTargets.length > 0"
        class="bottom-row"
      >
        <view class="bottom-btn" @tap="handleCallAll">
          <text class="bottom-btn-text bottom-btn-text-primary">呼叫所有人</text>
        </view>
      </view>

      <view class="bottom-safe"></view>
    </view>
  </view>

    <ConfirmDialog
      :model-value="micDialogState.visible"
      :title="micDialogState.title"
      cancel-text="取消"
      :confirm-text="micDialogState.confirmText"
      :message="micDialogState.content"
      @update:model-value="micDialogState.visible = $event"
      @confirm="confirmAllMicToggle"
    />

    <ConfirmDialog
      :model-value="cameraDialogState.visible"
      :title="cameraDialogState.title"
      cancel-text="取消"
      :confirm-text="cameraDialogState.confirmText"
      :message="cameraDialogState.content"
      @update:model-value="cameraDialogState.visible = $event"
      @confirm="confirmAllCameraToggle"
    />
  </view>
</template>

<script setup lang="ts">
  import { computed, ref, watch, onMounted, onBeforeUnmount } from 'vue';
  import type { PropType } from 'vue';
  import {
    useRoomState,
    useRoomParticipantState,
    DeviceStatus,
    DeviceType,
    RoomParticipantRole,
    RoomParticipantStatus,
    RoomEvent,
  } from '@/uni_modules/tuikit-atomic-x/state';
  import type { RoomParticipant } from '@/uni_modules/tuikit-atomic-x/types';
  import type { RoomUser } from '@/uni_modules/tuikit-atomic-x/types';
  import { RoomCallResult } from '@/uni_modules/tuikit-atomic-x/types/room';
  import ParticipantItem from './ParticipantItem/index.nvue';
  import ConfirmDialog from '@/uni_modules/tuikit-atomic-x/components/ConfirmDialog/ConfirmDialog.nvue';
  import { showErrorToast } from '@/uni_modules/tuikit-atomic-x/utils/roomErrorHandler';
  import { showToast } from '@/uni_modules/tuikit-atomic-x/utils/toast';
  import type { ToastType } from '@/uni_modules/tuikit-atomic-x/utils/toast';

  const props = defineProps({
    visible: { type: Boolean, default: false },
    roomID: { type: String, required: true },
    isWebinar: { type: Boolean, default: false },
  });

  const emit = defineEmits<{
    (e: 'close'): void
    (e: 'manage', participant: RoomParticipant): void
    (e: 'manageAud', audience: RoomUser): void
  }>();

  const {
    currentRoom,
    getRoomInfo,
    getScheduledAttendees,
    callUserToRoom,
    cancelCall,
    subscribeEvent,
    unsubscribeEvent,
  } = useRoomState();
  const roomParticipantState = useRoomParticipantState();
  const { participantList, audienceList, adminList, localParticipant, pendingParticipantList } = roomParticipantState;

  const currentTab = ref<'participant' | 'audience'>('participant');
  function setTab(t: 'participant' | 'audience') { currentTab.value = t; }

  const keyword = ref('');
  const searchInputRef = ref<any>(null);
  function onKeywordInput(e: any): void {
    keyword.value = (e?.detail?.value ?? '') as string;
  }

  function handleDismissKeyboard(): void {
    searchInputRef.value?.blur?.();
    uni.hideKeyboard();
  }

const participantCount = computed(() => {
    const fromRoom = currentRoom.value?.participantCount;
    const fromList = participantList.value?.length || 0;
    if (typeof fromRoom === 'number' && fromRoom > 0) return fromRoom;
    return fromList;
  });
  const audienceCount = computed(() => {
    const fromRoom = currentRoom.value?.audienceCount;
    const fromList = audienceList.value?.length || 0;
    if (typeof fromRoom === 'number' && fromRoom > 0) return fromRoom;
    return fromList;
  });

  function isUserCalling(u: RoomUser): boolean {
    return (u as RoomParticipant).roomStatus === RoomParticipantStatus.InCalling;
  }

  const REJECTED_HINT_MS = 3000;
  const rejectedSet = ref<Set<string>>(new Set());
  const rejectedTimers = new Map<string, number>();

  function isUserRejected(u: RoomUser): boolean {
    return rejectedSet.value.has(u.userID);
  }

  function markRejected(userID: string): void {
    if (typeof userID !== 'string' || userID.length === 0) return;
    const prev = rejectedTimers.get(userID);
    if (prev != null) clearTimeout(prev);

    const next = new Set(rejectedSet.value);
    next.add(userID);
    rejectedSet.value = next;

    const timer = setTimeout(() => {
      rejectedTimers.delete(userID);
      const cleared = new Set(rejectedSet.value);
      cleared.delete(userID);
      rejectedSet.value = cleared;
    }, REJECTED_HINT_MS) as unknown as number;
    rejectedTimers.set(userID, timer);
  }

  const onCallRejected = (opt: { roomInfo: any; call: any; reason: any }): void => {
    const userID = opt?.call?.callee?.userID;
    if (typeof userID !== 'string' || userID.length === 0) return;
    markRejected(userID);
  };

  onMounted((): void => {
    subscribeEvent(RoomEvent.onCallRejected, onCallRejected as any);
  });

  onBeforeUnmount((): void => {
    unsubscribeEvent(RoomEvent.onCallRejected, onCallRejected as any);
    rejectedTimers.forEach((t: number) => clearTimeout(t));
    rejectedTimers.clear();
  });

  const firstTabText = computed(() =>
    props.isWebinar ? `嘉宾(${participantCount.value})` : `已进房(${participantCount.value})`
  );
  const secondTabText = computed(() =>
    props.isWebinar ? `观众(${audienceCount.value})` : `未进房(${pendingParticipantList.value.length})`
  );

  const isOwner = computed(() => localParticipant.value?.role === RoomParticipantRole.Owner);
  const isAdmin = computed(() => localParticipant.value?.role === RoomParticipantRole.Admin);
  const isAllMicDisabled = computed(() => currentRoom.value?.isAllMicrophoneDisabled === true);
  const isAllCameraDisabled = computed(() => currentRoom.value?.isAllCameraDisabled === true);

  const allMicText = computed(() => (isAllMicDisabled.value ? '解除全体静音' : '全体静音'));
  const allMicTextStyle = computed(() => ({ color: isAllMicDisabled.value ? '#F2504B' : '#C5CCDC' }));
  const allCameraText = computed(() => (isAllCameraDisabled.value ? '解除全体禁画' : '全体禁画'));
  const allCameraTextStyle = computed(() => ({ color: isAllCameraDisabled.value ? '#F2504B' : '#C5CCDC' }));

  function compareBool(a: boolean, b: boolean): number {
    if (a === b) return 0;
    return a ? -1 : 1;
  }

  const sortedParticipantList = computed<RoomParticipant[]>(() => {
    const localId = localParticipant.value?.userID;
    const list = (participantList.value || []).slice();
    list.sort((a, b) => {
      let r = compareBool(a.userID === localId, b.userID === localId);
      if (r !== 0) return r;
      r = compareBool(a.role === RoomParticipantRole.Owner, b.role === RoomParticipantRole.Owner);
      if (r !== 0) return r;
      r = compareBool(a.role === RoomParticipantRole.Admin, b.role === RoomParticipantRole.Admin);
      if (r !== 0) return r;
      r = compareBool(a.screenShareStatus === DeviceStatus.ON, b.screenShareStatus === DeviceStatus.ON);
      if (r !== 0) return r;
      r = compareBool(
        a.cameraStatus === DeviceStatus.ON && a.microphoneStatus === DeviceStatus.ON,
        b.cameraStatus === DeviceStatus.ON && b.microphoneStatus === DeviceStatus.ON,
      );
      if (r !== 0) return r;
      r = compareBool(
        a.cameraStatus === DeviceStatus.ON && a.microphoneStatus !== DeviceStatus.ON,
        b.cameraStatus === DeviceStatus.ON && b.microphoneStatus !== DeviceStatus.ON,
      );
      if (r !== 0) return r;
      r = compareBool(
        a.cameraStatus !== DeviceStatus.ON && a.microphoneStatus === DeviceStatus.ON,
        b.cameraStatus !== DeviceStatus.ON && b.microphoneStatus === DeviceStatus.ON,
      );
      if (r !== 0) return r;
      return (a.userName || '').localeCompare(b.userName || '');
    });
    return list;
  });

  const sortedAudienceList = computed<RoomUser[]>(() => {
    const localId = localParticipant.value?.userID;
    const adminIds = new Set((adminList.value || []).map((u: RoomUser) => u.userID));
    const list = (audienceList.value || []).slice();
    list.sort((a, b) => {
      if (a.userID === localId) return -1;
      if (b.userID === localId) return 1;
      const r = compareBool(adminIds.has(a.userID), adminIds.has(b.userID));
      if (r !== 0) return r;
      return (a.userName || '').localeCompare(b.userName || '');
    });
    return list;
  });

  function matchKeyword(userName: string, userID: string): boolean {
    const kw = keyword.value.trim().toLowerCase();
    if (kw.length === 0) return true;
    return (userName || '').toLowerCase().indexOf(kw) > -1
      || (userID || '').toLowerCase().indexOf(kw) > -1;
  }

  const filteredParticipantList = computed<RoomParticipant[]>(() =>
    sortedParticipantList.value.filter((p) => matchKeyword(p.userName, p.userID))
  );

  const filteredSecondTabList = computed<RoomUser[]>(() => {
    const source: RoomUser[] = props.isWebinar ? sortedAudienceList.value : pendingParticipantList.value;
    return source.filter((u) => matchKeyword(u.userName, u.userID));
  });

  function isAdminUser(userID: string): boolean {
    return (adminList.value || []).some((u: RoomUser) => u.userID === userID);
  }

  function canControlParticipant(p: RoomParticipant): boolean {
    const me = localParticipant.value;
    if (!me || p.userID === me.userID) return false;
    if (me.role === RoomParticipantRole.Owner) return true;
    if (me.role === RoomParticipantRole.Admin && p.role === RoomParticipantRole.GeneralUser) return true;
    return false;
  }
  function canControlAudience(u: RoomUser): boolean {
    const me = localParticipant.value;
    if (!me || u.userID === me.userID) return false;
    if (me.role === RoomParticipantRole.Owner) return true;
    if (me.role === RoomParticipantRole.Admin && !isAdminUser(u.userID)) return true;
    return false;
  }

  const micDialogState = ref({ visible: false, title: '', content: '', confirmText: '', targetDisable: false });
  const cameraDialogState = ref({ visible: false, title: '', content: '', confirmText: '', targetDisable: false });

  function handleAllMicToggle() {
    const targetDisable = !isAllMicDisabled.value;
    micDialogState.value = {
      visible: true,
      title: targetDisable ? '所有及新加入的成员将被静音' : '所有成员将被解除静音',
      content: targetDisable ? '成员将无法开启麦克风' : '解除后用户可以自由开启麦克风',
      confirmText: targetDisable ? '全体静音' : '确认解除',
      targetDisable,
    };
  }

  async function confirmAllMicToggle() {
    const targetDisable = micDialogState.value.targetDisable;
    try {
      await roomParticipantState.disableAllDevices({ device: DeviceType.Microphone, disable: targetDisable });
    } catch (e) {
      showErrorToast(e);
    }
  }

  function handleAllCameraToggle() {
    const targetDisable = !isAllCameraDisabled.value;
    cameraDialogState.value = {
      visible: true,
      title: targetDisable ? '所有及新加入的成员将被禁止视频' : '所有成员将被解除禁止开启视频',
      content: targetDisable ? '成员将无法开启视频画面' : '解除后用户可以自由开启视频',
      confirmText: targetDisable ? '全体禁画' : '确认解除',
      targetDisable,
    };
  }

  async function confirmAllCameraToggle() {
    const targetDisable = cameraDialogState.value.targetDisable;
    try {
      await roomParticipantState.disableAllDevices({ device: DeviceType.Camera, disable: targetDisable });
    } catch (e) {
      showErrorToast(e);
    }
  }

  function onClose() { emit('close'); }

  watch(
    () => props.visible,
    (v) => {
      if (!v) return;
      roomParticipantState.getParticipantList({ cursor: '' }).catch(() => {});
      getRoomInfo({ roomID: props.roomID })
        .then((info) => {
          if (info && currentRoom.value) {
            currentRoom.value = { ...info, scheduleAttendees: currentRoom.value.scheduleAttendees };
          }
        })
        .catch(() => {});
    },
    { immediate: false },
  );

  function handleCall(u: RoomUser): Promise<void> {
    if (props.roomID.length === 0) return Promise.resolve();
    return callUserToRoom({ roomID: props.roomID, userIDList: [u.userID] })
      .then((results: Map<string, RoomCallResult>) => {
        const code = results.get(u.userID);
        let msg = '呼叫失败';
        let toastType: ToastType = 'none';
        if (code === RoomCallResult.Success) {
          msg = `已呼叫 ${u.userName || u.userID}`;
          toastType = 'success';
        } else if (code === RoomCallResult.AlreadyInCalling) {
          msg = '对方已在呼叫中';
        } else if (code === RoomCallResult.AlreadyInRoom) {
          msg = '对方已在房间中';
        }
        showToast({ message: msg, type: toastType });
      })
      .catch((e: any) => {
        showErrorToast(e, '呼叫失败');
      });
  }

  function handleCancelCall(u: RoomUser): void {
    if (props.roomID.length === 0) return;
    cancelCall({ roomID: props.roomID, userIDList: [u.userID] })
      .then(() => {
        showToast('已取消呼叫');
      })
      .catch((e: any) => {
        showErrorToast(e, '取消呼叫失败');
      });
  }

  const callAllTargets = computed<RoomUser[]>(() =>
    pendingParticipantList.value.filter((u: RoomParticipant) => !isUserCalling(u))
  );

  function handleCallAll(): void {
    if (props.roomID.length === 0) return;
    const ids = callAllTargets.value.map((u: RoomUser) => u.userID);
    if (ids.length === 0) {
      showToast('没有可呼叫的成员');
      return;
    }
    callUserToRoom({ roomID: props.roomID, userIDList: ids })
      .then(() => {
        showToast('邀请信息已发出，等待成员加入');
      })
      .catch((e: any) => {
        showErrorToast(e, '呼叫失败');
      });
  }
</script>

<style>
  .list-mask {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.4);
    flex-direction: column;
    justify-content: flex-end;
  }

  .list-sheet {
    background-color: #1F2229;
    border-top-left-radius: 40rpx;
    border-top-right-radius: 40rpx;
    height: 1000rpx;
  }

  .drop-bar {
    height: 70rpx;
    justify-content: center;
    align-items: center;
  }

  .drop-line {
    width: 48rpx;
    height: 48rpx;
  }

  .search-row {
    flex-direction: row;
    margin-left: 32rpx;
    margin-right: 32rpx;
    margin-top: 32rpx;
    height: 72rpx;
  }

  .search-wrap {
    flex: 1;
    height: 72rpx;
    border-radius: 12rpx;
    background-color: #2A2D38;
    flex-direction: row;
    align-items: center;
    padding-left: 20rpx;
    padding-right: 20rpx;
  }

  .search-icon {
    width: 32rpx;
    height: 32rpx;
    margin-right: 12rpx;
  }

  .search-input {
    flex: 1;
    height: 72rpx;
    font-size: 28rpx;
    color: #D5E0F2;
    padding: 0;
  }

  .tab-bar {
    margin-left: 32rpx;
    margin-right: 32rpx;
    margin-top: 24rpx;
    height: 72rpx;
    background-color: #2A2D38;
    border-radius: 12rpx;
    flex-direction: row;
    padding: 4rpx;
  }

  .tab-item {
    flex: 1;
    border-radius: 10rpx;
    justify-content: center;
    align-items: center;
  }

  .tab-item-selected {
    background-color: #4A5970;
  }

  .tab-text {
    color: #C5CCDC;
    font-size: 28rpx;
  }

  .tab-text-selected {
    color: #FFFFFF;
    font-weight: 500;
  }

  .list-gap {
    height: 30rpx;
  }

  .list-scroll {
    flex: 1;
  }

  .list-divider {
    height: 1rpx;
    background-color: #2A2D38;
    margin-left: 132rpx;
    margin-right: 32rpx;
  }

  .list-empty {
    flex: 1;
    justify-content: center;
    align-items: center;
    padding-top: 120rpx;
  }

  .list-empty-text {
    color: #6B7385;
    font-size: 28rpx;
  }

  .bottom-row {
    flex-direction: row;
    padding-left: 32rpx;
    padding-right: 32rpx;
    padding-top: 24rpx;
  }

  .bottom-btn {
    flex: 1;
    height: 80rpx;
    background-color: #2A2D38;
    border-radius: 12rpx;
    justify-content: center;
    align-items: center;
  }

  .bottom-btn-text {
    font-size: 28rpx;
  }

  .bottom-btn-text-primary {
    color: #FFFFFF;
  }

  .bottom-gap {
    width: 18rpx;
  }

  .bottom-safe {
    height: 68rpx;
  }
</style>
