<template>
  <view class="page" :style="{ height: safeArea.height + 'px' }">
    <view class="header">
      <view class="back-btn" @tap="handleBack">
        <image class="back-icon" src="/static/images/back-black.png" mode="aspectFit" />
      </view>
      <view class="user-info">
        <image class="user-avatar" :src="loginUserInfo?.avatarURL || defaultAvatarURL" mode="aspectFill" />
        <text class="user-name" :numberOfLines="1">{{ loginUserInfo?.nickname || loginUserInfo?.userID || '' }}</text>
      </view>
    </view>

    <view class="actions">
      <view class="action-btn" @tap="handleJoinRoom">
        <image class="action-btn-icon" src="/static/images/room/room_join.png" mode="aspectFit" />
        <text class="action-btn-text">加入房间</text>
      </view>
      <view class="action-btn-gap"></view>
      <view class="action-btn" @tap="handleCreateRoom">
        <image class="action-btn-icon" src="/static/images/room/room_create.png" mode="aspectFit" />
        <text class="action-btn-text">新建房间</text>
      </view>
      <view class="action-btn-gap"></view>
      <view class="action-btn" @tap="handleScheduleRoom">
        <image class="action-btn-icon" src="/static/images/room/room_schedule_room.png" mode="aspectFit" />
        <text class="action-btn-text">预定房间</text>
      </view>
    </view>

    <RoomScheduleList />
  </view>
</template>

<script setup>
  import { ref, onMounted, onUnmounted } from 'vue';
  import { onShow } from '@dcloudio/uni-app';
  import { useLoginState, useRoomState } from '@/uni_modules/tuikit-atomic-x/state';
  import { reportMetrics } from '@/uni_modules/tuikit-atomic-x';
  import { showErrorToast } from './utils/errorHandler';
  import RoomScheduleList from './components/RoomScheduleList/index.nvue';

  const { loginUserInfo } = useLoginState();
  const roomState = useRoomState();

  const defaultAvatarURL = 'https://web.sdk.qcloud.com/im/assets/all-in-one/user.png';

  const safeArea = ref({
    left: 0,
    right: 0,
    top: 0,
    bottom: 0,
    width: 375,
    height: 750,
  });

  onMounted(() => {
    reportMetrics('ROOM_SCENE');
    uni.getSystemInfo({
      success: (res) => {
        safeArea.value = res.safeArea;
      }
    });
    // 预定 / 修改 / 取消后由对应页面 emit；RoomScheduleList 组件也在监听并自刷新，
    // 这里再订阅一份以兜底组件 onShow 没命中的时序（比如预定页 → 直接回到首页）
    uni.$on('scheduledRoomListChanged', fetchScheduledRooms);
  });

  onUnmounted(() => {
    uni.$off('scheduledRoomListChanged', fetchScheduledRooms);
  });

  // 从预定页/详情页返回时也刷新一次，避免依赖单一 emit 时序
  onShow(() => {
    fetchScheduledRooms();
  });

  function fetchScheduledRooms() {
    roomState
      .getScheduledRoomList({ cursor: '' })
      .catch((e) => {
        showErrorToast(e, '获取预定房间失败');
      });
  }

  const handleBack = () => {
    uni.navigateBack({
      fail: () => {
        uni.switchTab({
          url: '/pages/scenes/chat/conversationList/conversationList'
        });
      }
    });
  }

  const handleJoinRoom = () => {
    uni.navigateTo({
      url: '/pages/scenes/room/join/index'
    });
  }

  const handleCreateRoom = () => {
    uni.navigateTo({
      url: '/pages/scenes/room/create/index'
    });
  }

  const handleScheduleRoom = () => {
    uni.navigateTo({
      url: '/pages/scenes/room/schedule/index'
    });
  }
</script>

<style>
  .page {
    flex: 1;
    background-color: #F8F9FB;
    flex-direction: column;
  }

  .header {
    flex-direction: row;
    align-items: center;
    padding-top: 96rpx;
    padding-bottom: 26rpx;
    padding-left: 40rpx;
    padding-right: 40rpx;
  }

  .back-btn {
    width: 44rpx;
    height: 44rpx;
    justify-content: center;
    align-items: center;
  }

  .back-icon {
    width: 32rpx;
    height: 32rpx;
  }

  .user-info {
    flex: 1;
    flex-direction: row;
    align-items: center;
    margin-left: 44rpx;
  }

  .user-avatar {
    width: 64rpx;
    height: 64rpx;
    border-radius: 32rpx;
    margin-right: 24rpx;
  }

  .user-name {
    font-size: 32rpx;
    font-weight: 500;
    color: #676C80;
    flex: 1;
  }


  /* 三个入口横排（设计图：加入 / 创建 / 预定） */
  .actions {
    flex-direction: row;
    margin: 0 40rpx;
    padding-left: 24rpx;
    padding-right: 24rpx;
    padding-top: 26rpx;
    padding-bottom: 40rpx;
    border-bottom: 1rpx solid #E7ECF6;
  }

  .action-btn {
    flex: 1;
    height: 160rpx;
    border-radius: 16rpx;
    background-color: #0468FC;
    flex-direction: column;
    justify-content: center;
    align-items: center;
  }

  .action-btn-gap {
    width: 40rpx;
  }

  .action-btn-icon {
    width: 48rpx;
    height: 48rpx;
    margin-bottom: 18rpx;
  }

  .action-btn-text {
    color: #FFFFFF;
    font-size: 28rpx;
    font-weight: 500;
  }
</style>
